{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "synology-drive-sync observability and sync output records",
  "description": "Stable JSON records for logs, progress, and plan/sync command output.",
  "oneOf": [
    { "$ref": "#/$defs/logEvent" },
    { "$ref": "#/$defs/progressRecord" },
    { "$ref": "#/$defs/jsonPlanDocument" },
    { "$ref": "#/$defs/jsonSyncDocument" },
    { "$ref": "#/$defs/ndjsonPlanSummary" },
    { "$ref": "#/$defs/ndjsonPlanAction" },
    { "$ref": "#/$defs/ndjsonCompletion" }
  ],
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "nullableNonNegativeInteger": {
      "oneOf": [
        { "$ref": "#/$defs/nonNegativeInteger" },
        { "type": "null" }
      ]
    },
    "entryKind": {
      "enum": ["file", "directory"]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1
    },
    "remotePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "changeReason": {
      "enum": [
        "missing-remote",
        "size-differs",
        "mtime-differs",
        "content-differs",
        "type-replaced"
      ]
    },
    "contentMd5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "nullableContentMd5": {
      "oneOf": [
        { "$ref": "#/$defs/contentMd5" },
        { "type": "null" }
      ]
    },
    "remoteSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_kind", "size", "mtime_seconds", "content_md5", "require_mtime"],
      "properties": {
        "entry_kind": { "$ref": "#/$defs/entryKind" },
        "size": { "$ref": "#/$defs/nonNegativeInteger" },
        "mtime_seconds": { "type": "integer" },
        "content_md5": { "$ref": "#/$defs/nullableContentMd5" },
        "require_mtime": { "type": "boolean" }
      }
    },
    "destinationGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_path",
        "local_relative",
        "expected_size",
        "expected_mtime_seconds",
        "content_md5"
      ],
      "properties": {
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "local_relative": { "$ref": "#/$defs/relativePath" },
        "expected_size": { "$ref": "#/$defs/nonNegativeInteger" },
        "expected_mtime_seconds": { "type": "integer" },
        "content_md5": { "$ref": "#/$defs/contentMd5" }
      }
    },
    "nullableDestinationGuard": {
      "oneOf": [
        { "$ref": "#/$defs/destinationGuard" },
        { "type": "null" }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "files",
        "bytes",
        "elapsed_ms",
        "throughput_bytes_per_second",
        "eta_ms"
      ],
      "properties": {
        "operations": { "$ref": "#/$defs/nonNegativeInteger" },
        "files": { "$ref": "#/$defs/nonNegativeInteger" },
        "bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "elapsed_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "throughput_bytes_per_second": { "$ref": "#/$defs/nonNegativeInteger" },
        "eta_ms": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      }
    },
    "logEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "timestamp_ms",
        "level",
        "event",
        "operation_id",
        "attempt",
        "metrics"
      ],
      "properties": {
        "schema": { "const": "sdsync.log.v1" },
        "timestamp_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "level": {
          "enum": ["error", "warn", "info", "debug", "trace"]
        },
        "event": {
          "enum": [
            "run.build",
            "run.started",
            "run.completed",
            "run.failed",
            "local_scan.started",
            "local_scan.completed",
            "connection.established",
            "api_discovery.started",
            "api_discovery.completed",
            "authentication.started",
            "session.established",
            "authentication.completed",
            "remote_scan.started",
            "remote_scan.completed",
            "plan.ready",
            "api_call.started",
            "api_call.completed",
            "api_call.redirected",
            "upload.started",
            "upload.attempt_started",
            "upload.progress",
            "upload.completed",
            "upload.failed",
            "directory.created",
            "entry.deleted",
            "retry.scheduled",
            "cancellation.requested"
          ]
        },
        "operation_id": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "attempt": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "metrics": { "$ref": "#/$defs/metrics" },
        "build": { "$ref": "#/$defs/buildIdentity" },
        "call": { "$ref": "#/$defs/apiCallDetail" },
        "connection": { "$ref": "#/$defs/connectionDetail" },
        "session": { "$ref": "#/$defs/sessionShape" }
      }
    },
    "buildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "target", "profile", "commit"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "target": { "type": "string", "minLength": 1, "maxLength": 64 },
        "profile": { "type": "string", "minLength": 1, "maxLength": 64 },
        "commit": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "apiName": {
      "enum": [
        "SYNO.API.Info",
        "SYNO.API.Auth",
        "SYNO.FileStation.Info",
        "SYNO.FileStation.List",
        "SYNO.FileStation.CreateFolder",
        "SYNO.FileStation.Upload",
        "SYNO.FileStation.Delete",
        "SYNO.FileStation.MD5",
        "SYNO.FileStation.Download",
        "SYNO.FileStation.CopyMove",
        "SYNO.FileStation.CheckPermission"
      ]
    },
    "boundedToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/:~,-]{0,64}$"
    },
    "nullableBoundedToken": {
      "oneOf": [
        { "$ref": "#/$defs/boundedToken" },
        { "type": "null" }
      ]
    },
    "sessionTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cookie_header", "syno_token_header", "sid_field", "syno_token_field"],
      "properties": {
        "cookie_header": { "type": "boolean" },
        "syno_token_header": { "type": "boolean" },
        "sid_field": { "type": "boolean" },
        "syno_token_field": { "type": "boolean" }
      }
    },
    "cookieFact": {
      "description": "One Set-Cookie header described without its value: a name, a salted per-process digest of the value, the value's length, and which attributes were present. A cookie value is not representable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fingerprint",
        "value_length",
        "persistence",
        "secure",
        "http_only",
        "same_site",
        "path_present",
        "domain_present",
        "expires_present",
        "max_age_present"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/boundedToken" },
        "fingerprint": { "$ref": "#/$defs/boundedToken" },
        "value_length": { "$ref": "#/$defs/nonNegativeInteger" },
        "persistence": { "enum": ["session", "persistent", "deletion"] },
        "secure": { "type": "boolean" },
        "http_only": { "type": "boolean" },
        "same_site": { "enum": ["absent", "strict", "lax", "none", "unrecognized"] },
        "path_present": { "type": "boolean" },
        "domain_present": { "type": "boolean" },
        "expires_present": { "type": "boolean" },
        "max_age_present": { "type": "boolean" }
      }
    },
    "cookieFacts": {
      "description": "Every cookie one response set. `described` is bounded by the record's fixed capacity; `undescribed` counts Set-Cookie headers beyond it, and ones carrying no parseable name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["described", "undescribed"],
      "properties": {
        "described": { "type": "array", "items": { "$ref": "#/$defs/cookieFact" } },
        "undescribed": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "intermediaryFacts": {
      "description": "What one response revealed about proxies, relays, and caches between this client and DSM. Banner values are sanitized and bounded; no cookie value, request header, or response body is representable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "via",
        "server",
        "powered_by",
        "forwarded_for_reflected",
        "real_ip_reflected",
        "cdn_marker",
        "foreign_cookie_count"
      ],
      "properties": {
        "via": { "$ref": "#/$defs/boundedToken" },
        "server": { "$ref": "#/$defs/boundedToken" },
        "powered_by": { "$ref": "#/$defs/boundedToken" },
        "forwarded_for_reflected": { "type": "boolean" },
        "real_ip_reflected": { "type": "boolean" },
        "cdn_marker": {
          "enum": ["none", "cloudflare", "fastly", "akamai", "cloudfront", "varnish", "other"]
        },
        "foreign_cookie_count": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "apiCallDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "method",
        "version",
        "route",
        "transport",
        "attempt",
        "max_attempts",
        "session",
        "request_fields",
        "request_bytes",
        "timeout_ms",
        "outcome",
        "http_status",
        "dsm_code",
        "dsm_description",
        "set_cookie_count",
        "set_cookie_names",
        "cookies",
        "intermediary",
        "response_bytes",
        "elapsed_ms",
        "retry_backoff_ms",
        "redirect_host",
        "decode"
      ],
      "properties": {
        "api": { "$ref": "#/$defs/apiName" },
        "method": { "type": "string", "pattern": "^[a-z_]{1,32}$" },
        "version": { "$ref": "#/$defs/nonNegativeInteger" },
        "route": { "$ref": "#/$defs/boundedToken" },
        "transport": { "enum": ["form", "multipart", "download"] },
        "attempt": { "$ref": "#/$defs/nonNegativeInteger" },
        "max_attempts": { "$ref": "#/$defs/nonNegativeInteger" },
        "session": { "$ref": "#/$defs/sessionTransport" },
        "request_fields": { "$ref": "#/$defs/nonNegativeInteger" },
        "request_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "timeout_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "outcome": {
          "enum": ["ok", "dsm-error", "http-status", "redirect", "transport", "decode"]
        },
        "http_status": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "dsm_code": {
          "oneOf": [
            { "type": "integer" },
            { "type": "null" }
          ]
        },
        "dsm_description": {
          "oneOf": [
            { "type": "string", "maxLength": 128 },
            { "type": "null" }
          ]
        },
        "set_cookie_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "set_cookie_names": { "$ref": "#/$defs/boundedToken" },
        "cookies": { "$ref": "#/$defs/cookieFacts" },
        "intermediary": { "$ref": "#/$defs/intermediaryFacts" },
        "response_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "elapsed_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "retry_backoff_ms": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "redirect_host": { "$ref": "#/$defs/nullableBoundedToken" },
        "decode": {
          "oneOf": [
            { "$ref": "#/$defs/decodeFault" },
            { "type": "null" }
          ]
        }
      }
    },
    "decodeFault": {
      "description": "Why one response body did not deserialize, in schema terms. `path` is a dotted member path built from object keys and array indices, `field` is the member the deserializer named, `expected` is the deserializer's own description of what it wanted, and `found` is a JSON type. No value from the response is representable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "field", "expected", "found", "line", "column"],
      "properties": {
        "kind": {
          "enum": [
            "unspecified",
            "missing-field",
            "unknown-field",
            "duplicate-field",
            "type-mismatch",
            "syntax",
            "unexpected-end"
          ]
        },
        "path": { "$ref": "#/$defs/boundedToken" },
        "field": { "$ref": "#/$defs/boundedToken" },
        "expected": { "$ref": "#/$defs/boundedToken" },
        "found": {
          "enum": ["unknown", "absent", "null", "boolean", "number", "string", "array", "object"]
        },
        "line": { "$ref": "#/$defs/nonNegativeInteger" },
        "column": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "connectionDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "host",
        "port",
        "base_path",
        "redirects",
        "certificate_verification"
      ],
      "properties": {
        "scheme": { "enum": ["https", "http"] },
        "host": { "$ref": "#/$defs/boundedToken" },
        "port": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "base_path": { "$ref": "#/$defs/boundedToken" },
        "redirects": { "const": "refused" },
        "certificate_verification": { "enum": ["enabled", "custom-ca", "disabled"] }
      }
    },
    "sessionShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sid_length", "token_present", "login_format", "server_set_cookie"],
      "properties": {
        "sid_length": { "$ref": "#/$defs/nonNegativeInteger" },
        "token_present": { "type": "boolean" },
        "login_format": { "enum": ["sid", "cookie"] },
        "server_set_cookie": { "type": "boolean" }
      }
    },
    "progressUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "operation",
        "kind",
        "attempt",
        "attempt_bytes",
        "total_bytes"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/nonNegativeInteger" },
        "operation": {
          "enum": [
            "upload",
            "create_directory",
            "delete_entry",
            "scan_local",
            "scan_remote"
          ]
        },
        "kind": {
          "enum": [
            "started",
            "attempt_started",
            "attempt_reset",
            "advanced",
            "succeeded",
            "failed"
          ]
        },
        "attempt": { "$ref": "#/$defs/nonNegativeInteger" },
        "attempt_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "total_bytes": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "progressRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "totals",
        "completed_operations",
        "failed_operations",
        "completed_files",
        "failed_files",
        "logical_bytes",
        "wire_bytes",
        "active_operations",
        "elapsed_ms",
        "throughput_bytes_per_second",
        "eta_ms"
      ],
      "properties": {
        "schema": { "const": "sdsync.progress.v1" },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operations", "files", "bytes"],
          "properties": {
            "operations": { "$ref": "#/$defs/nonNegativeInteger" },
            "files": { "$ref": "#/$defs/nonNegativeInteger" },
            "bytes": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        },
        "completed_operations": { "$ref": "#/$defs/nonNegativeInteger" },
        "failed_operations": { "$ref": "#/$defs/nonNegativeInteger" },
        "completed_files": { "$ref": "#/$defs/nonNegativeInteger" },
        "failed_files": { "$ref": "#/$defs/nonNegativeInteger" },
        "logical_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "wire_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "active_operations": { "$ref": "#/$defs/nonNegativeInteger" },
        "elapsed_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "throughput_bytes_per_second": {
          "type": "number",
          "minimum": 0
        },
        "eta_ms": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "update": { "$ref": "#/$defs/progressUpdate" }
      }
    },
    "planSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uploads",
        "upload_bytes",
        "server_copy_fallback_bytes",
        "server_copies",
        "directories",
        "deletions",
        "unchanged_files",
        "protected_entries",
        "changes"
      ],
      "properties": {
        "uploads": { "$ref": "#/$defs/nonNegativeInteger" },
        "upload_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "server_copy_fallback_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "server_copies": { "$ref": "#/$defs/nonNegativeInteger" },
        "directories": { "$ref": "#/$defs/nonNegativeInteger" },
        "deletions": { "$ref": "#/$defs/nonNegativeInteger" },
        "unchanged_files": { "$ref": "#/$defs/nonNegativeInteger" },
        "protected_entries": { "$ref": "#/$defs/nonNegativeInteger" },
        "changes": { "type": "boolean" }
      }
    },
    "deletePlanAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative",
        "remote_path",
        "entry_kind",
        "type_conflict",
        "snapshot_guard"
      ],
      "properties": {
        "relative": { "$ref": "#/$defs/relativePath" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "entry_kind": { "$ref": "#/$defs/entryKind" },
        "type_conflict": { "type": "boolean" },
        "snapshot_guard": { "$ref": "#/$defs/remoteSnapshot" },
        "destination_guard": { "$ref": "#/$defs/nullableDestinationGuard" }
      }
    },
    "createPlanAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative", "remote_path", "reason"],
      "properties": {
        "relative": { "type": "string" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "reason": { "$ref": "#/$defs/changeReason" }
      }
    },
    "copyPlanAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_relative",
        "from_remote_path",
        "to_relative",
        "to_remote_path",
        "expected_size",
        "expected_mtime_seconds",
        "content_md5",
        "source_snapshot_guard",
        "verified_upload_fallback"
      ],
      "properties": {
        "from_relative": { "$ref": "#/$defs/relativePath" },
        "from_remote_path": { "$ref": "#/$defs/remotePath" },
        "to_relative": { "$ref": "#/$defs/relativePath" },
        "to_remote_path": { "$ref": "#/$defs/remotePath" },
        "expected_size": { "$ref": "#/$defs/nonNegativeInteger" },
        "expected_mtime_seconds": { "type": "integer" },
        "content_md5": { "$ref": "#/$defs/contentMd5" },
        "source_snapshot_guard": { "$ref": "#/$defs/remoteSnapshot" },
        "verified_upload_fallback": { "const": "only-before-copy-task-start" }
      }
    },
    "uploadPlanAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative", "remote_path", "bytes", "mtime_ms", "reason"],
      "properties": {
        "relative": { "$ref": "#/$defs/relativePath" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "mtime_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "reason": { "$ref": "#/$defs/changeReason" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "actions"],
      "properties": {
        "summary": { "$ref": "#/$defs/planSummary" },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pre_deletes", "creates", "copies", "uploads", "post_deletes"],
          "properties": {
            "pre_deletes": {
              "type": "array",
              "items": { "$ref": "#/$defs/deletePlanAction" }
            },
            "creates": {
              "type": "array",
              "items": { "$ref": "#/$defs/createPlanAction" }
            },
            "copies": {
              "type": "array",
              "items": { "$ref": "#/$defs/copyPlanAction" }
            },
            "uploads": {
              "type": "array",
              "items": { "$ref": "#/$defs/uploadPlanAction" }
            },
            "post_deletes": {
              "type": "array",
              "items": { "$ref": "#/$defs/deletePlanAction" }
            }
          }
        }
      }
    },
    "executionResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changed",
        "uploaded",
        "server_copied",
        "upload_bytes",
        "directories_created",
        "deleted",
        "elapsed_ms"
      ],
      "properties": {
        "changed": { "type": "boolean" },
        "uploaded": { "$ref": "#/$defs/nonNegativeInteger" },
        "server_copied": { "$ref": "#/$defs/nonNegativeInteger" },
        "upload_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "directories_created": { "$ref": "#/$defs/nonNegativeInteger" },
        "deleted": { "$ref": "#/$defs/nonNegativeInteger" },
        "elapsed_ms": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "unchangedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed"],
      "properties": {
        "changed": { "const": false }
      }
    },
    "jsonPlanDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "plan"],
      "properties": {
        "schema": { "const": "sdsync.plan.v1" },
        "plan": { "$ref": "#/$defs/plan" }
      }
    },
    "jsonSyncDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "plan", "result"],
      "properties": {
        "schema": { "const": "sdsync.sync.v1" },
        "plan": { "$ref": "#/$defs/plan" },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/executionResult" },
            { "$ref": "#/$defs/unchangedResult" }
          ]
        }
      }
    },
    "ndjsonPlanSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "uploads",
        "upload_bytes",
        "server_copy_fallback_bytes",
        "server_copies",
        "directories",
        "deletions",
        "unchanged_files",
        "protected_entries",
        "changes"
      ],
      "properties": {
        "schema": { "const": "sdsync.plan.v1" },
        "kind": { "const": "summary" },
        "uploads": { "$ref": "#/$defs/nonNegativeInteger" },
        "upload_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "server_copy_fallback_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "server_copies": { "$ref": "#/$defs/nonNegativeInteger" },
        "directories": { "$ref": "#/$defs/nonNegativeInteger" },
        "deletions": { "$ref": "#/$defs/nonNegativeInteger" },
        "unchanged_files": { "$ref": "#/$defs/nonNegativeInteger" },
        "protected_entries": { "$ref": "#/$defs/nonNegativeInteger" },
        "changes": { "type": "boolean" }
      }
    },
    "ndjsonPreDeleteAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "action",
        "relative",
        "remote_path",
        "entry_kind",
        "snapshot_guard"
      ],
      "properties": {
        "schema": { "const": "sdsync.plan-action.v1" },
        "action": { "const": "delete-conflict" },
        "relative": { "$ref": "#/$defs/relativePath" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "entry_kind": { "$ref": "#/$defs/entryKind" },
        "snapshot_guard": { "$ref": "#/$defs/remoteSnapshot" }
      }
    },
    "ndjsonPostDeleteAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "action",
        "relative",
        "remote_path",
        "entry_kind",
        "snapshot_guard",
        "destination_guard"
      ],
      "properties": {
        "schema": { "const": "sdsync.plan-action.v1" },
        "action": { "const": "delete" },
        "relative": { "$ref": "#/$defs/relativePath" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "entry_kind": { "$ref": "#/$defs/entryKind" },
        "snapshot_guard": { "$ref": "#/$defs/remoteSnapshot" },
        "destination_guard": { "$ref": "#/$defs/nullableDestinationGuard" }
      }
    },
    "ndjsonCreateAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "action", "relative", "remote_path", "reason"],
      "properties": {
        "schema": { "const": "sdsync.plan-action.v1" },
        "action": { "const": "create-directory" },
        "relative": { "type": "string" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "reason": { "$ref": "#/$defs/changeReason" }
      }
    },
    "ndjsonUploadAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "action", "relative", "remote_path", "bytes", "mtime_ms", "reason"],
      "properties": {
        "schema": { "const": "sdsync.plan-action.v1" },
        "action": { "const": "upload" },
        "relative": { "$ref": "#/$defs/relativePath" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "mtime_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "reason": { "$ref": "#/$defs/changeReason" }
      }
    },
    "ndjsonCopyAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "action",
        "from_relative",
        "from_remote_path",
        "to_relative",
        "to_remote_path",
        "expected_size",
        "expected_mtime_seconds",
        "content_md5",
        "source_snapshot_guard",
        "verified_upload_fallback"
      ],
      "properties": {
        "schema": { "const": "sdsync.plan-action.v1" },
        "action": { "const": "copy-remote-content" },
        "from_relative": { "$ref": "#/$defs/relativePath" },
        "from_remote_path": { "$ref": "#/$defs/remotePath" },
        "to_relative": { "$ref": "#/$defs/relativePath" },
        "to_remote_path": { "$ref": "#/$defs/remotePath" },
        "expected_size": { "$ref": "#/$defs/nonNegativeInteger" },
        "expected_mtime_seconds": { "type": "integer" },
        "content_md5": { "$ref": "#/$defs/contentMd5" },
        "source_snapshot_guard": { "$ref": "#/$defs/remoteSnapshot" },
        "verified_upload_fallback": { "const": "only-before-copy-task-start" }
      }
    },
    "ndjsonPlanAction": {
      "oneOf": [
        { "$ref": "#/$defs/ndjsonPreDeleteAction" },
        { "$ref": "#/$defs/ndjsonPostDeleteAction" },
        { "$ref": "#/$defs/ndjsonCreateAction" },
        { "$ref": "#/$defs/ndjsonCopyAction" },
        { "$ref": "#/$defs/ndjsonUploadAction" }
      ]
    },
    "ndjsonCompletionWithResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "result"],
      "properties": {
        "schema": { "const": "sdsync.output.v1" },
        "kind": { "const": "completion" },
        "result": { "$ref": "#/$defs/executionResult" }
      }
    },
    "ndjsonUnchangedCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "changed"],
      "properties": {
        "schema": { "const": "sdsync.output.v1" },
        "kind": { "const": "completion" },
        "changed": { "const": false }
      }
    },
    "ndjsonCompletion": {
      "oneOf": [
        { "$ref": "#/$defs/ndjsonCompletionWithResult" },
        { "$ref": "#/$defs/ndjsonUnchangedCompletion" }
      ]
    }
  }
}
