{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "synology-drive-sync observability and sync output records",
  "description": "Stable JSON records for logs, progress, and plan/sync command output.",
  "oneOf": [
    { "$ref": "#/$defs/logEvent" },
    { "$ref": "#/$defs/progressRecord" },
    { "$ref": "#/$defs/jsonPlanDocument" },
    { "$ref": "#/$defs/jsonSyncDocument" },
    { "$ref": "#/$defs/ndjsonPlanSummary" },
    { "$ref": "#/$defs/ndjsonPlanAction" },
    { "$ref": "#/$defs/ndjsonCompletion" },
    { "$ref": "#/$defs/resultRecord" }
  ],
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "nullableNonNegativeInteger": {
      "oneOf": [
        { "$ref": "#/$defs/nonNegativeInteger" },
        { "type": "null" }
      ]
    },
    "entryKind": {
      "enum": ["file", "directory"]
    },
    "relativePath": {
      "type": "string",
      "minLength": 1
    },
    "remotePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "changeReason": {
      "enum": [
        "missing-remote",
        "size-differs",
        "mtime-differs",
        "content-differs",
        "type-replaced"
      ]
    },
    "contentMd5": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "nullableContentMd5": {
      "oneOf": [
        { "$ref": "#/$defs/contentMd5" },
        { "type": "null" }
      ]
    },
    "remoteSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_kind", "size", "mtime_seconds", "content_md5", "require_mtime"],
      "properties": {
        "entry_kind": { "$ref": "#/$defs/entryKind" },
        "size": { "$ref": "#/$defs/nonNegativeInteger" },
        "mtime_seconds": { "type": "integer" },
        "content_md5": { "$ref": "#/$defs/nullableContentMd5" },
        "require_mtime": { "type": "boolean" }
      }
    },
    "destinationGuard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remote_path",
        "local_relative",
        "expected_size",
        "expected_mtime_seconds",
        "content_md5"
      ],
      "properties": {
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "local_relative": { "$ref": "#/$defs/relativePath" },
        "expected_size": { "$ref": "#/$defs/nonNegativeInteger" },
        "expected_mtime_seconds": { "type": "integer" },
        "content_md5": { "$ref": "#/$defs/contentMd5" }
      }
    },
    "nullableDestinationGuard": {
      "oneOf": [
        { "$ref": "#/$defs/destinationGuard" },
        { "type": "null" }
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "files",
        "bytes",
        "elapsed_ms",
        "throughput_bytes_per_second",
        "eta_ms"
      ],
      "properties": {
        "operations": { "$ref": "#/$defs/nonNegativeInteger" },
        "files": { "$ref": "#/$defs/nonNegativeInteger" },
        "bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "elapsed_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "throughput_bytes_per_second": { "$ref": "#/$defs/nonNegativeInteger" },
        "eta_ms": { "$ref": "#/$defs/nullableNonNegativeInteger" }
      }
    },
    "logEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "timestamp_ms",
        "level",
        "event",
        "operation_id",
        "attempt",
        "metrics"
      ],
      "properties": {
        "schema": { "const": "sdsync.log.v1" },
        "timestamp_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "level": {
          "enum": ["error", "warn", "info", "debug", "trace"]
        },
        "event": {
          "enum": [
            "run.build",
            "run.started",
            "run.completed",
            "run.failed",
            "local_scan.started",
            "local_scan.completed",
            "connection.established",
            "api_discovery.started",
            "api_discovery.completed",
            "authentication.started",
            "session.established",
            "authentication.completed",
            "remote_scan.started",
            "remote_scan.completed",
            "plan.ready",
            "api_call.started",
            "api_call.completed",
            "api_call.redirected",
            "upload.started",
            "upload.attempt_started",
            "upload.progress",
            "upload.completed",
            "upload.failed",
            "directory.created",
            "entry.deleted",
            "retry.scheduled",
            "cancellation.requested",
            "run.partial",
            "entry.skipped",
            "entry.deferred",
            "result_record.failed"
          ]
        },
        "operation_id": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "attempt": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "metrics": { "$ref": "#/$defs/metrics" },
        "build": { "$ref": "#/$defs/buildIdentity" },
        "call": { "$ref": "#/$defs/apiCallDetail" },
        "connection": { "$ref": "#/$defs/connectionDetail" },
        "session": { "$ref": "#/$defs/sessionShape" },
        "reason": { "$ref": "#/$defs/eventReason" },
        "profile": {
          "description": "The profile the record concerns. Absent when the run is not attributed to one profile.",
          "type": "string",
          "pattern": "^[A-Za-z0-9._/:~,-]{0,64}$"
        },
        "path": {
          "description": "Relative path of the entry a skip, deferral or per-entry failure concerns, percent-encoded (every byte outside `A-Za-z0-9._/:,-`, including non-ASCII, space and `%`, is written `%XX`, so the path decodes exactly) and bounded to 255 characters; a trailing `~` marks truncation, which never splits an escape. Opt-in per record.",
          "type": "string",
          "maxLength": 255,
          "pattern": "^([A-Za-z0-9._/:,-]|%[0-9A-F]{2})*~?$"
        }
      }
    },
    "eventReason": {
      "description": "Closed class of a failure, skip or deferral. Never error text.",
      "enum": [
        "authentication",
        "network",
        "http_status",
        "timeout",
        "remote_response_invalid",
        "dsm_api_error",
        "dsm_api_unsupported",
        "share_not_writable",
        "remote_path_refused",
        "type_conflict",
        "protected_conflict",
        "empty_source_guard",
        "delete_limit",
        "source_invalid",
        "local_entry_unsupported",
        "local_io",
        "source_changed",
        "resync_ticket_stale",
        "content_verification_failed",
        "remote_changed",
        "server_copy_unavailable",
        "server_copy_failed",
        "reconciliation_pending",
        "credential_unavailable",
        "config_invalid",
        "https_required",
        "scope_not_found",
        "cancelled",
        "unclassified",
        "changed_during_run",
        "delete_bound",
        "server_copy_fallback",
        "excluded",
        "upload_failed"
      ]
    },
    "buildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "target", "profile", "commit"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "target": { "type": "string", "minLength": 1, "maxLength": 64 },
        "profile": { "type": "string", "minLength": 1, "maxLength": 64 },
        "commit": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "apiName": {
      "enum": [
        "SYNO.API.Info",
        "SYNO.API.Auth",
        "SYNO.FileStation.Info",
        "SYNO.FileStation.List",
        "SYNO.FileStation.CreateFolder",
        "SYNO.FileStation.Upload",
        "SYNO.FileStation.Delete",
        "SYNO.FileStation.MD5",
        "SYNO.FileStation.Download",
        "SYNO.FileStation.CopyMove",
        "SYNO.FileStation.CheckPermission"
      ]
    },
    "boundedToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/:~,-]{0,64}$"
    },
    "nullableBoundedToken": {
      "oneOf": [
        { "$ref": "#/$defs/boundedToken" },
        { "type": "null" }
      ]
    },
    "sessionTransport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cookie_header", "syno_token_header", "sid_field", "syno_token_field"],
      "properties": {
        "cookie_header": { "type": "boolean" },
        "syno_token_header": { "type": "boolean" },
        "sid_field": { "type": "boolean" },
        "syno_token_field": { "type": "boolean" }
      }
    },
    "cookieFact": {
      "description": "One Set-Cookie header described without its value: a name, a salted per-process digest of the value, the value's length, and which attributes were present. A cookie value is not representable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "fingerprint",
        "value_length",
        "persistence",
        "secure",
        "http_only",
        "same_site",
        "path_present",
        "domain_present",
        "expires_present",
        "max_age_present"
      ],
      "properties": {
        "name": { "$ref": "#/$defs/boundedToken" },
        "fingerprint": { "$ref": "#/$defs/boundedToken" },
        "value_length": { "$ref": "#/$defs/nonNegativeInteger" },
        "persistence": { "enum": ["session", "persistent", "deletion"] },
        "secure": { "type": "boolean" },
        "http_only": { "type": "boolean" },
        "same_site": { "enum": ["absent", "strict", "lax", "none", "unrecognized"] },
        "path_present": { "type": "boolean" },
        "domain_present": { "type": "boolean" },
        "expires_present": { "type": "boolean" },
        "max_age_present": { "type": "boolean" }
      }
    },
    "cookieFacts": {
      "description": "Every cookie one response set. `described` is bounded by the record's fixed capacity; `undescribed` counts Set-Cookie headers beyond it, and ones carrying no parseable name.",
      "type": "object",
      "additionalProperties": false,
      "required": ["described", "undescribed"],
      "properties": {
        "described": { "type": "array", "items": { "$ref": "#/$defs/cookieFact" } },
        "undescribed": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "intermediaryFacts": {
      "description": "What one response revealed about proxies, relays, and caches between this client and DSM. Banner values are sanitized and bounded; no cookie value, request header, or response body is representable.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "via",
        "server",
        "powered_by",
        "forwarded_for_reflected",
        "real_ip_reflected",
        "cdn_marker",
        "foreign_cookie_count"
      ],
      "properties": {
        "via": { "$ref": "#/$defs/boundedToken" },
        "server": { "$ref": "#/$defs/boundedToken" },
        "powered_by": { "$ref": "#/$defs/boundedToken" },
        "forwarded_for_reflected": { "type": "boolean" },
        "real_ip_reflected": { "type": "boolean" },
        "cdn_marker": {
          "enum": ["none", "cloudflare", "fastly", "akamai", "cloudfront", "varnish", "other"]
        },
        "foreign_cookie_count": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "apiCallDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api",
        "method",
        "version",
        "route",
        "transport",
        "attempt",
        "max_attempts",
        "session",
        "request_fields",
        "request_bytes",
        "timeout_ms",
        "outcome",
        "http_status",
        "dsm_code",
        "dsm_description",
        "set_cookie_count",
        "set_cookie_names",
        "cookies",
        "intermediary",
        "response_bytes",
        "elapsed_ms",
        "retry_backoff_ms",
        "redirect_host",
        "decode"
      ],
      "properties": {
        "api": { "$ref": "#/$defs/apiName" },
        "method": { "type": "string", "pattern": "^[a-z_]{1,32}$" },
        "version": { "$ref": "#/$defs/nonNegativeInteger" },
        "route": { "$ref": "#/$defs/boundedToken" },
        "transport": { "enum": ["form", "multipart", "download"] },
        "attempt": { "$ref": "#/$defs/nonNegativeInteger" },
        "max_attempts": { "$ref": "#/$defs/nonNegativeInteger" },
        "session": { "$ref": "#/$defs/sessionTransport" },
        "request_fields": { "$ref": "#/$defs/nonNegativeInteger" },
        "request_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "timeout_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "outcome": {
          "enum": ["ok", "dsm-error", "http-status", "redirect", "transport", "decode"]
        },
        "http_status": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "dsm_code": {
          "oneOf": [
            { "type": "integer" },
            { "type": "null" }
          ]
        },
        "dsm_description": {
          "oneOf": [
            { "type": "string", "maxLength": 128 },
            { "type": "null" }
          ]
        },
        "set_cookie_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "set_cookie_names": { "$ref": "#/$defs/boundedToken" },
        "cookies": { "$ref": "#/$defs/cookieFacts" },
        "intermediary": { "$ref": "#/$defs/intermediaryFacts" },
        "response_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "elapsed_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "retry_backoff_ms": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "redirect_host": { "$ref": "#/$defs/nullableBoundedToken" },
        "decode": {
          "oneOf": [
            { "$ref": "#/$defs/decodeFault" },
            { "type": "null" }
          ]
        }
      }
    },
    "decodeFault": {
      "description": "Why one response body did not deserialize, in schema terms. `path` is a dotted member path built from object keys and array indices, `field` is the member the deserializer named, `expected` is the deserializer's own description of what it wanted, and `found` is a JSON type. No value from the response is representable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "field", "expected", "found", "line", "column"],
      "properties": {
        "kind": {
          "enum": [
            "unspecified",
            "missing-field",
            "unknown-field",
            "duplicate-field",
            "type-mismatch",
            "syntax",
            "unexpected-end"
          ]
        },
        "path": { "$ref": "#/$defs/boundedToken" },
        "field": { "$ref": "#/$defs/boundedToken" },
        "expected": { "$ref": "#/$defs/boundedToken" },
        "found": {
          "enum": ["unknown", "absent", "null", "boolean", "number", "string", "array", "object"]
        },
        "line": { "$ref": "#/$defs/nonNegativeInteger" },
        "column": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "connectionDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "host",
        "port",
        "base_path",
        "redirects",
        "certificate_verification"
      ],
      "properties": {
        "scheme": { "enum": ["https", "http"] },
        "host": { "$ref": "#/$defs/boundedToken" },
        "port": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "base_path": { "$ref": "#/$defs/boundedToken" },
        "redirects": { "const": "refused" },
        "certificate_verification": { "enum": ["enabled", "custom-ca", "disabled"] }
      }
    },
    "sessionShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sid_length", "token_present", "login_format", "server_set_cookie"],
      "properties": {
        "sid_length": { "$ref": "#/$defs/nonNegativeInteger" },
        "token_present": { "type": "boolean" },
        "login_format": { "enum": ["sid", "cookie"] },
        "server_set_cookie": { "type": "boolean" }
      }
    },
    "progressUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "operation",
        "kind",
        "attempt",
        "attempt_bytes",
        "total_bytes"
      ],
      "properties": {
        "operation_id": { "$ref": "#/$defs/nonNegativeInteger" },
        "operation": {
          "enum": [
            "upload",
            "create_directory",
            "delete_entry",
            "scan_local",
            "scan_remote"
          ]
        },
        "kind": {
          "enum": [
            "started",
            "attempt_started",
            "attempt_reset",
            "advanced",
            "succeeded",
            "failed"
          ]
        },
        "attempt": { "$ref": "#/$defs/nonNegativeInteger" },
        "attempt_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "total_bytes": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "progressRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "totals",
        "completed_operations",
        "failed_operations",
        "completed_files",
        "failed_files",
        "logical_bytes",
        "wire_bytes",
        "active_operations",
        "elapsed_ms",
        "throughput_bytes_per_second",
        "eta_ms"
      ],
      "properties": {
        "schema": { "const": "sdsync.progress.v1" },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operations", "files", "bytes"],
          "properties": {
            "operations": { "$ref": "#/$defs/nonNegativeInteger" },
            "files": { "$ref": "#/$defs/nonNegativeInteger" },
            "bytes": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        },
        "completed_operations": { "$ref": "#/$defs/nonNegativeInteger" },
        "failed_operations": { "$ref": "#/$defs/nonNegativeInteger" },
        "completed_files": { "$ref": "#/$defs/nonNegativeInteger" },
        "failed_files": { "$ref": "#/$defs/nonNegativeInteger" },
        "logical_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "wire_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "active_operations": { "$ref": "#/$defs/nonNegativeInteger" },
        "elapsed_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "throughput_bytes_per_second": {
          "type": "number",
          "minimum": 0
        },
        "eta_ms": { "$ref": "#/$defs/nullableNonNegativeInteger" },
        "update": { "$ref": "#/$defs/progressUpdate" }
      }
    },
    "planSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uploads",
        "upload_bytes",
        "server_copy_fallback_bytes",
        "server_copies",
        "directories",
        "deletions",
        "renames",
        "unchanged_files",
        "protected_entries",
        "changes"
      ],
      "properties": {
        "uploads": { "$ref": "#/$defs/nonNegativeInteger" },
        "upload_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "server_copy_fallback_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "server_copies": { "$ref": "#/$defs/nonNegativeInteger" },
        "directories": { "$ref": "#/$defs/nonNegativeInteger" },
        "deletions": { "$ref": "#/$defs/nonNegativeInteger" },
        "renames": {
          "description": "Case-only renames this plan makes with File Station Rename.",
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "unchanged_files": { "$ref": "#/$defs/nonNegativeInteger" },
        "protected_entries": { "$ref": "#/$defs/nonNegativeInteger" },
        "changes": { "type": "boolean" }
      }
    },
    "deletePlanAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative",
        "remote_path",
        "entry_kind",
        "type_conflict",
        "snapshot_guard"
      ],
      "properties": {
        "relative": { "$ref": "#/$defs/relativePath" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "entry_kind": { "$ref": "#/$defs/entryKind" },
        "type_conflict": { "type": "boolean" },
        "snapshot_guard": { "$ref": "#/$defs/remoteSnapshot" },
        "destination_guard": { "$ref": "#/$defs/nullableDestinationGuard" }
      }
    },
    "createPlanAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative", "remote_path", "reason"],
      "properties": {
        "relative": { "type": "string" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "reason": { "$ref": "#/$defs/changeReason" }
      }
    },
    "copyPlanAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_relative",
        "from_remote_path",
        "to_relative",
        "to_remote_path",
        "expected_size",
        "expected_mtime_seconds",
        "content_md5",
        "source_snapshot_guard",
        "verified_upload_fallback"
      ],
      "properties": {
        "from_relative": { "$ref": "#/$defs/relativePath" },
        "from_remote_path": { "$ref": "#/$defs/remotePath" },
        "to_relative": { "$ref": "#/$defs/relativePath" },
        "to_remote_path": { "$ref": "#/$defs/remotePath" },
        "expected_size": { "$ref": "#/$defs/nonNegativeInteger" },
        "expected_mtime_seconds": { "type": "integer" },
        "content_md5": { "$ref": "#/$defs/contentMd5" },
        "source_snapshot_guard": { "$ref": "#/$defs/remoteSnapshot" },
        "verified_upload_fallback": { "const": "only-before-copy-task-start" }
      }
    },
    "uploadPlanAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative", "remote_path", "bytes", "mtime_ms", "reason"],
      "properties": {
        "relative": { "$ref": "#/$defs/relativePath" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "mtime_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "reason": { "$ref": "#/$defs/changeReason" }
      }
    },
    "renamePlanAction": {
      "type": "object",
      "description": "A case-only rename: the NAS holds `from_remote_path` and the source now spells it `relative`. Carried last, by File Station Rename, never by a delete and re-upload.",
      "additionalProperties": false,
      "required": ["relative", "from_remote_path", "to_remote_path", "entry_kind"],
      "properties": {
        "relative": { "$ref": "#/$defs/relativePath" },
        "from_remote_path": { "$ref": "#/$defs/remotePath" },
        "to_remote_path": { "$ref": "#/$defs/remotePath" },
        "entry_kind": { "$ref": "#/$defs/entryKind" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "actions", "skipped"],
      "properties": {
        "summary": { "$ref": "#/$defs/planSummary" },
        "skipped": {
          "description": "Paths this plan neither carries nor deletes, and why. Each used to fail the whole run; now only its own path is left alone, on both sides. `deferred` entries are named again, with their precise reason, in the result's `deferred`. `type-conflict`: a local file where the NAS has a folder (or the reverse), or a local entry at a NAS mount point, that this run may not replace. `remote-link`: a local entry where the NAS holds a link; nothing is written, deleted or descended at or beneath it. `protected-descendant`: a NAS-only folder a mirror would delete, kept because it holds an excluded or DSM-managed entry. A local entry Synology Drive cannot hold is a `deferred` skip whose detail starts `unsupported-entry:`.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason", "detail"],
            "properties": {
              "path": { "type": "string" },
              "reason": {
                "enum": [
                  "windows-attributes",
                  "link-or-reparse-point",
                  "dehydrated-placeholder",
                  "local-case-collision",
                  "remote-case-collision",
                  "case-rename-needs-delete",
                  "deferred",
                  "type-conflict",
                  "remote-link",
                  "protected-descendant"
                ]
              },
              "detail": { "type": "string" }
            }
          }
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pre_deletes", "creates", "copies", "uploads", "post_deletes", "renames"],
          "properties": {
            "pre_deletes": {
              "type": "array",
              "items": { "$ref": "#/$defs/deletePlanAction" }
            },
            "creates": {
              "type": "array",
              "items": { "$ref": "#/$defs/createPlanAction" }
            },
            "copies": {
              "type": "array",
              "items": { "$ref": "#/$defs/copyPlanAction" }
            },
            "uploads": {
              "type": "array",
              "items": { "$ref": "#/$defs/uploadPlanAction" }
            },
            "post_deletes": {
              "type": "array",
              "items": { "$ref": "#/$defs/deletePlanAction" }
            },
            "renames": {
              "type": "array",
              "items": { "$ref": "#/$defs/renamePlanAction" }
            }
          }
        }
      }
    },
    "executionResult": {
      "type": "object",
      "description": "What a run performed. Emitted for a failed run too: every count here is work that succeeded and was verified individually, and `failed` says whether the run then stopped.",
      "additionalProperties": false,
      "required": [
        "changed",
        "uploaded",
        "server_copied",
        "upload_bytes",
        "directories_created",
        "deleted",
        "renamed",
        "deletes_skipped",
        "kept_deletes_uploaded",
        "changed_during_run",
        "failed",
        "outcome",
        "deferred",
        "mtime_not_kept",
        "skipped",
        "incomplete_listings",
        "incomplete_listing_folders",
        "recovered",
        "elapsed_ms"
      ],
      "properties": {
        "changed": { "type": "boolean" },
        "uploaded": { "$ref": "#/$defs/nonNegativeInteger" },
        "server_copied": { "$ref": "#/$defs/nonNegativeInteger" },
        "upload_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "directories_created": { "$ref": "#/$defs/nonNegativeInteger" },
        "deleted": { "$ref": "#/$defs/nonNegativeInteger" },
        "renamed": {
          "description": "Case-only renames made with File Station Rename.",
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "deletes_skipped": {
          "description": "Planned mirror deletions kept rather than performed: the local path exists again, or a kept deletion beneath a directory left it non-empty.",
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "kept_deletes_uploaded": {
          "description": "Files among `deletes_skipped` that this run then uploaded, so the mirror converged instead of deferring to the next run. Their bytes are included in `upload_bytes`.",
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "changed_during_run": {
          "description": "Entries the post-run reconciliation pass still found, all of them local files modified after the run began. The destination matches the source as it was when the run started, which is the only instant a run can be asked about.",
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "failed": {
          "description": "True when the run failed after performing the work counted here.",
          "type": "boolean"
        },
        "outcome": {
          "description": "The run's verdict. `complete`: everything converged. `partial`: everything converged except the transient paths in `deferred` (every reason but `unrepresentable-name`, `unsupported-local-entry`, `listing-incomplete`, `remote-unreadable`, `local-permission-denied`, `delete-not-permitted`, `remote-refused`, `remote-skipped`, `unsupported-entry` and `case-rename-pending`), which the next run picks up; the process exits 3. Lasting skips and lasting deferrals are reported and logged but leave the outcome `complete` and the exit code 0. `failed`: the run stopped (see `failed`).",
          "enum": ["complete", "partial", "failed"]
        },
        "deferred": {
          "description": "Each path this run left for the next run, by name. A deferred path was neither uploaded nor deleted, and nothing else was deleted on its account. Any transient reason makes the outcome `partial`; `unrepresentable-name`, `unsupported-local-entry`, `listing-incomplete`, `remote-unreadable`, `local-permission-denied`, `delete-not-permitted`, `remote-refused`, `remote-skipped`, `unsupported-entry` and `case-rename-pending` recur every run until someone acts, so they are reported without changing the outcome.",
          "type": "array",
          "items": { "$ref": "#/$defs/deferredPath" }
        },
        "mtime_not_kept": {
          "description": "Destinations this run wrote (uploads, server copies) whose modification time the NAS did not keep: the remote second is neither the source's milliseconds floored nor rounded to the nearest second. Their content was verified; a metadata comparison will report them as changed.",
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "skipped": {
          "description": "Paths the plan declined to carry for a lasting reason (a link or reparse point, a SYSTEM-attribute file, a case or normalisation collision), each named in `plan.skipped` and logged as an `entry.skipped` warning. A warning only: it does not change the outcome or the exit code, because it recurs on every run until someone acts.",
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "incomplete_listings": {
          "description": "Remote folders whose listing returned a different number of entries than the NAS counted, consistently. Deletions inside them were withheld and named in `deferred`.",
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "incomplete_listing_folders": {
          "description": "The folders counted in `incomplete_listings`, root-relative, `.` for the destination root. Each is also logged as an `entry.skipped` warning. A lasting condition: it does not make the run partial.",
          "type": "array",
          "items": { "type": "string" }
        },
        "recovered": {
          "description": "What the run recovered from on its own, or could not. Each is also logged request by request.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "retries",
            "reauthentications",
            "reauthentication_failures",
            "keepalive_failures",
            "server_tasks_not_stopped",
            "server_copy_fallbacks"
          ],
          "properties": {
            "retries": { "description": "Requests sent again after a transient failure.", "$ref": "#/$defs/nonNegativeInteger" },
            "reauthentications": { "description": "Expired sessions replaced by a new login.", "$ref": "#/$defs/nonNegativeInteger" },
            "reauthentication_failures": { "description": "Attempts to replace an expired session that failed.", "$ref": "#/$defs/nonNegativeInteger" },
            "keepalive_failures": { "description": "Session keepalive requests that failed.", "$ref": "#/$defs/nonNegativeInteger" },
            "server_tasks_not_stopped": { "description": "Abandoned server-side MD5 or copy tasks whose stop could not be confirmed.", "$ref": "#/$defs/nonNegativeInteger" },
            "server_copy_fallbacks": { "description": "Planned server-side copies uploaded instead because DSM refused to start them.", "$ref": "#/$defs/nonNegativeInteger" }
          }
        },
        "elapsed_ms": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "resultRecord": {
      "type": "object",
      "description": "One line of the `--result-record` file: one finished sync or plan job, written whatever `--output` says, so a supervisor reads counts without parsing output meant for a person.",
      "additionalProperties": false,
      "required": ["schema", "profile", "status", "error", "result"],
      "properties": {
        "schema": { "const": "sdsync.result-record.v1" },
        "error": {
          "description": "Why the job failed, or `null` for a job that did not fail. A scheduled run discards the core's standard output, so this is where the cause and the entry it concerns are kept.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "detail", "path"],
              "properties": {
                "code": { "$ref": "#/$defs/eventReason" },
                "detail": { "description": "The failure's message on one line.", "type": "string" },
                "path": {
                  "description": "The entry the failure concerns (source-relative for a local path, the NAS path for a remote one), or `null` when it is not about one entry.",
                  "oneOf": [{ "type": "string" }, { "type": "null" }]
                }
              }
            }
          ]
        },
        "profile": { "type": "string", "minLength": 1 },
        "status": {
          "description": "A single sync: `complete`, `partial` or `failed`; a single plan: `planned` or `failed`; a batch job: its batch status (`success`, `preflighted`, `failed`, `partial` meaning failed after mutating, `not-run`). Read `result.outcome` for the deferral verdict.",
          "enum": ["complete", "partial", "failed", "planned", "success", "preflighted", "not-run"]
        },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/executionResult" },
            { "$ref": "#/$defs/planVerdict" },
            { "type": "null" }
          ]
        }
      }
    },
    "planVerdict": {
      "type": "object",
      "description": "What a plan-only job established: whether anything would change, and every path it left out.",
      "additionalProperties": false,
      "required": ["outcome", "changed", "planned_only", "deferred", "skipped", "elapsed_ms"],
      "properties": {
        "outcome": { "enum": ["complete", "partial"] },
        "changed": { "type": "boolean" },
        "planned_only": { "type": "boolean" },
        "deferred": { "type": "array", "items": { "$ref": "#/$defs/deferredPath" } },
        "skipped": { "$ref": "#/$defs/nonNegativeInteger" },
        "elapsed_ms": { "$ref": "#/$defs/nonNegativeInteger" }
      }
    },
    "deferredPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "reason", "detail"],
      "properties": {
        "path": {
          "description": "Source-relative, `/`-separated.",
          "type": "string"
        },
        "reason": {
          "description": "`source-changed`: the local file changed while it was read or sent. `source-vanished`: deleted locally during the run. `source-unreadable`: locked or briefly unreadable (transient). `unsupported-local-entry`: not a regular file or directory the sync carries. `remote-digest-unavailable`: the NAS could not checksum it. `remote-unreadable`: the NAS refuses this one file to the account (lasting until its permissions change). `remote-changed`: the NAS entry changed after planning and was left as found. `unrepresentable-name`: a NAS name this host's filesystem cannot hold; never deleted on that account. `listing-incomplete`: its NAS folder listed fewer entries than it counted, so no deletion was made there. `server-copy-failed`: the NAS-side copy finished with an error. `delete-failed`: the NAS refused the deletion. `remote-refused`: the NAS refuses this name or this account's access to it (lasting until it is renamed or its permissions change; three or more refusals with one cause that are more than half the attempts fail the run instead). `local-permission-denied`: this account may not read it (lasting until its permissions change). `case-rename-pending`: a case-only rename on the NAS was not made or did not finish, and the content keeps syncing under the NAS spelling (lasting until the NAS spelling is changed or the blocking entry removed). `remote-skipped`: a NAS name or link this tool will not follow; never deleted, overwritten or descended (lasting). `unsupported-entry`: a local name, path or entry kind Synology Drive cannot hold (a refused name, a path too long once the destination is prepended, a non-UTF-8 name, a FIFO, socket or device, a modification time before 1970); lasting until it is renamed or excluded. `delete-not-permitted`: DSM refused to delete it for permission (lasting until the folder's rights change).",
          "enum": [
            "source-changed",
            "source-vanished",
            "source-unreadable",
            "unsupported-local-entry",
            "remote-digest-unavailable",
            "remote-unreadable",
            "remote-changed",
            "unrepresentable-name",
            "listing-incomplete",
            "server-copy-failed",
            "delete-failed",
            "remote-refused",
            "local-permission-denied",
            "case-rename-pending",
            "remote-skipped",
            "unsupported-entry",
            "delete-not-permitted"
          ]
        },
        "detail": {
          "description": "The underlying observation, for an operator. Never a credential.",
          "type": "string"
        }
      }
    },
    "unchangedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed"],
      "properties": {
        "changed": { "const": false }
      }
    },
    "jsonPlanDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "plan"],
      "properties": {
        "schema": { "const": "sdsync.plan.v1" },
        "plan": { "$ref": "#/$defs/plan" }
      }
    },
    "jsonSyncDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "plan", "result"],
      "properties": {
        "schema": { "const": "sdsync.sync.v1" },
        "plan": { "$ref": "#/$defs/plan" },
        "result": {
          "oneOf": [
            { "$ref": "#/$defs/executionResult" },
            { "$ref": "#/$defs/unchangedResult" }
          ]
        }
      }
    },
    "ndjsonPlanSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "kind",
        "uploads",
        "upload_bytes",
        "server_copy_fallback_bytes",
        "server_copies",
        "directories",
        "deletions",
        "renames",
        "unchanged_files",
        "protected_entries",
        "changes"
      ],
      "properties": {
        "schema": { "const": "sdsync.plan.v1" },
        "kind": { "const": "summary" },
        "uploads": { "$ref": "#/$defs/nonNegativeInteger" },
        "upload_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "server_copy_fallback_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "server_copies": { "$ref": "#/$defs/nonNegativeInteger" },
        "directories": { "$ref": "#/$defs/nonNegativeInteger" },
        "deletions": { "$ref": "#/$defs/nonNegativeInteger" },
        "renames": {
          "description": "Case-only renames this plan makes with File Station Rename.",
          "$ref": "#/$defs/nonNegativeInteger"
        },
        "unchanged_files": { "$ref": "#/$defs/nonNegativeInteger" },
        "protected_entries": { "$ref": "#/$defs/nonNegativeInteger" },
        "changes": { "type": "boolean" }
      }
    },
    "ndjsonPreDeleteAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "action",
        "relative",
        "remote_path",
        "entry_kind",
        "snapshot_guard"
      ],
      "properties": {
        "schema": { "const": "sdsync.plan-action.v1" },
        "action": { "const": "delete-conflict" },
        "relative": { "$ref": "#/$defs/relativePath" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "entry_kind": { "$ref": "#/$defs/entryKind" },
        "snapshot_guard": { "$ref": "#/$defs/remoteSnapshot" }
      }
    },
    "ndjsonPostDeleteAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "action",
        "relative",
        "remote_path",
        "entry_kind",
        "snapshot_guard",
        "destination_guard"
      ],
      "properties": {
        "schema": { "const": "sdsync.plan-action.v1" },
        "action": { "const": "delete" },
        "relative": { "$ref": "#/$defs/relativePath" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "entry_kind": { "$ref": "#/$defs/entryKind" },
        "snapshot_guard": { "$ref": "#/$defs/remoteSnapshot" },
        "destination_guard": { "$ref": "#/$defs/nullableDestinationGuard" }
      }
    },
    "ndjsonCreateAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "action", "relative", "remote_path", "reason"],
      "properties": {
        "schema": { "const": "sdsync.plan-action.v1" },
        "action": { "const": "create-directory" },
        "relative": { "type": "string" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "reason": { "$ref": "#/$defs/changeReason" }
      }
    },
    "ndjsonUploadAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "action", "relative", "remote_path", "bytes", "mtime_ms", "reason"],
      "properties": {
        "schema": { "const": "sdsync.plan-action.v1" },
        "action": { "const": "upload" },
        "relative": { "$ref": "#/$defs/relativePath" },
        "remote_path": { "$ref": "#/$defs/remotePath" },
        "bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "mtime_ms": { "$ref": "#/$defs/nonNegativeInteger" },
        "reason": { "$ref": "#/$defs/changeReason" }
      }
    },
    "ndjsonCopyAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "action",
        "from_relative",
        "from_remote_path",
        "to_relative",
        "to_remote_path",
        "expected_size",
        "expected_mtime_seconds",
        "content_md5",
        "source_snapshot_guard",
        "verified_upload_fallback"
      ],
      "properties": {
        "schema": { "const": "sdsync.plan-action.v1" },
        "action": { "const": "copy-remote-content" },
        "from_relative": { "$ref": "#/$defs/relativePath" },
        "from_remote_path": { "$ref": "#/$defs/remotePath" },
        "to_relative": { "$ref": "#/$defs/relativePath" },
        "to_remote_path": { "$ref": "#/$defs/remotePath" },
        "expected_size": { "$ref": "#/$defs/nonNegativeInteger" },
        "expected_mtime_seconds": { "type": "integer" },
        "content_md5": { "$ref": "#/$defs/contentMd5" },
        "source_snapshot_guard": { "$ref": "#/$defs/remoteSnapshot" },
        "verified_upload_fallback": { "const": "only-before-copy-task-start" }
      }
    },
    "ndjsonRenameAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "action", "relative", "from_remote_path", "to_remote_path", "entry_kind"],
      "properties": {
        "schema": { "const": "sdsync.plan-action.v1" },
        "action": { "const": "rename" },
        "relative": { "$ref": "#/$defs/relativePath" },
        "from_remote_path": { "$ref": "#/$defs/remotePath" },
        "to_remote_path": { "$ref": "#/$defs/remotePath" },
        "entry_kind": { "$ref": "#/$defs/entryKind" }
      }
    },
    "ndjsonPlanAction": {
      "oneOf": [
        { "$ref": "#/$defs/ndjsonPreDeleteAction" },
        { "$ref": "#/$defs/ndjsonPostDeleteAction" },
        { "$ref": "#/$defs/ndjsonCreateAction" },
        { "$ref": "#/$defs/ndjsonCopyAction" },
        { "$ref": "#/$defs/ndjsonUploadAction" },
        { "$ref": "#/$defs/ndjsonRenameAction" }
      ]
    },
    "ndjsonCompletionWithResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "result"],
      "properties": {
        "schema": { "const": "sdsync.output.v1" },
        "kind": { "const": "completion" },
        "result": { "$ref": "#/$defs/executionResult" }
      }
    },
    "ndjsonUnchangedCompletion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "kind", "changed"],
      "properties": {
        "schema": { "const": "sdsync.output.v1" },
        "kind": { "const": "completion" },
        "changed": { "const": false }
      }
    },
    "ndjsonCompletion": {
      "oneOf": [
        { "$ref": "#/$defs/ndjsonCompletionWithResult" },
        { "$ref": "#/$defs/ndjsonUnchangedCompletion" }
      ]
    }
  }
}
