<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>synology-drive-sync third-party licenses</title>
  <style>
    body { font-family: sans-serif; line-height: 1.4; margin: 2rem auto; max-width: 72rem; padding: 0 1rem; }
    pre { border: 1px solid #ccc; overflow-x: auto; padding: 1rem; white-space: pre-wrap; }
  </style>
</head>
<body>
  <h1>synology-drive-sync third-party licenses</h1>
  <p>
    This file is generated from the locked dependency graph for every supported native release
    target. It records the license text selected to satisfy each dependency's SPDX expression.
  </p>
  <h2>License overview</h2>
  <ul>
    {{#each overview}}
    <li>{{name}} ({{count}} uses)</li>
    {{/each}}
  </ul>
  <h2>License texts and components</h2>
  {{#each licenses}}
  <section>
    <h3>{{name}}</h3>
    <p>Used by:</p>
    <ul>
      {{#each used_by}}
      <li>
        <a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a>
      </li>
      {{/each}}
    </ul>
    <pre>{{text}}</pre>
  </section>
  {{/each}}
</body>
</html>
