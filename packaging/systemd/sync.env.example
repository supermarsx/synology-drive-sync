# Non-secret configuration. systemd passes the password separately with LoadCredential.
SDSYNC_URL=https://files.example.com
SDSYNC_USERNAME=mirror-bot
SDSYNC_SOURCE=/srv/export
SDSYNC_REMOTE=/team/export
SDSYNC_JOBS=2
SDSYNC_TIMEOUT=7200
SDSYNC_RETRIES=2
SDSYNC_LOG_FORMAT=json
SDSYNC_PROGRESS=never
SDSYNC_LOCK_FILE=/var/lib/synology-drive-sync/service.lock

# Alternative profile modes. Keep the direct URL/USERNAME/SOURCE/REMOTE values
# above for a direct job, or comment all four out and configure one mode below.
# SDSYNC_CONFIG=/etc/synology-drive-sync/config.toml
# SDSYNC_PROFILE=production
# SDSYNC_PROFILES=nas-a,nas-b
# SDSYNC_ALL_PROFILES=true
# SDSYNC_MAX_TOTAL_DELETE=150
# Batch mode fails closed unless every selected profile intentionally uses the
# same dsm-password and optional dsm-totp credentials loaded by this unit.
SDSYNC_BATCH_SHARED_CREDENTIALS=false

# When a remote-log-token systemd credential is configured, enable its wrapper
# mapping here. Never put the token value in this file.
SDSYNC_USE_REMOTE_LOG_CREDENTIAL=false

# Destructive mirror mode is deliberately opt-in.
SDSYNC_DELETE=false
SDSYNC_MAX_DELETE=100
