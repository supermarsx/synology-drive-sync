#!/bin/sh
set -eu
. "$(dirname "$0")/common"

if [ "${SYNOPKG_PKG_STATUS:-}" = UNINSTALL ]; then
    # DSM retains package FHS data by default. Purge only this package's exact
    # private subdirectories so credentials do not survive an uninstall.
    for purge_root in "$package_home" "$package_var"; do
        if [ -z "$purge_root" ] || [ "$purge_root" = / ] || [ ! -d "$purge_root" ]; then
            package_message "refusing unsafe package-data purge root: $purge_root"
            exit 1
        fi
    done
    for private_child in \
        "$package_home/config" "$package_home/secrets" "$package_home/state" \
        "$package_var/run" "$package_var/state" "$package_var/log" \
        "$package_var/control"
    do
        case $private_child in
            "$package_home"/*|"$package_var"/*) rm -rf "$private_child" || package_message "could not remove $private_child (status $?)" ;;
            *) package_message "refusing out-of-package purge path: $private_child"; exit 1 ;;
        esac
    done
    # What is still there is named: credentials that survive an uninstall
    # must not be reported removed.
    purge_remaining=
    for private_child in \
        "$package_home/config" "$package_home/secrets" "$package_home/state" \
        "$package_var/run" "$package_var/state" "$package_var/log" \
        "$package_var/control"
    do
        if [ -e "$private_child" ] || [ -L "$private_child" ]; then
            purge_remaining="$purge_remaining $private_child"
        fi
    done
    if [ -n "$purge_remaining" ]; then
        package_message "package data could not be fully removed; still present:$purge_remaining"
        exit 1
    fi
    package_message "Removed package-owned configuration, credentials, state, and logs"
fi
exit 0
