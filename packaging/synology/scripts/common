#!/bin/sh

package_name=synology-drive-sync
package_base=/var/packages/$package_name
package_root=${SYNOPKG_PKGDEST:-$package_base/target}
package_home=${SYNOPKG_PKGHOME:-$package_base/home}
package_var=${SYNOPKG_PKGVAR:-$package_base/var}
runtime_root=$package_var/run
log_root=$package_var/log
controller_pid_file=$runtime_root/controller.pid
controller_ready_file=$runtime_root/controller.ready
controller_lock=$runtime_root/controller.lock
controller=$package_root/libexec/sdsync-controller
runner=$package_root/libexec/sdsync-run
common_runtime=$package_root/libexec/sdsync-common
run_lock=$runtime_root/run.lock
api_server=$package_root/bin/sdsync-dsm-api
api_pid_file=$runtime_root/api.pid
api_bound_file=$runtime_root/api.bound
api_ready_file=$runtime_root/api.ready
api_socket_dir=$runtime_root
api_socket=$api_socket_dir/api.sock
api_log=$log_root/api.log

package_message() {
    if [ -n "${SYNOPKG_TEMP_LOGFILE:-}" ]; then
        printf '%s\n' "$*" >> "$SYNOPKG_TEMP_LOGFILE"
    fi
    printf '%s\n' "$*"
}

script_pid() {
    pid_file=$1
    [ -f "$pid_file" ] && [ ! -L "$pid_file" ] || return 1
    IFS= read -r found_pid < "$pid_file" || return 1
    case $found_pid in ''|*[!0-9]*) return 1 ;; esac
    [ "$found_pid" -gt 1 ] 2>/dev/null || return 1
    printf '%s\n' "$found_pid"
}

script_pid_live() {
    kill -0 "$1" 2>/dev/null
}

# Return success only when procfs proves that a sampled PID is now absent or in
# a terminal zombie/dead state. An unreadable/malformed live entry is not terminal: callers must
# preserve package topology and fail closed rather than infer identity loss.
script_pid_absent_or_zombie() {
    terminal_pid=$1
    [ ! -e "/proc/$terminal_pid" ] && return 0
    terminal_state=$(sed -n 's/^.*) \([^ ]\).*/\1/p' \
        2>/dev/null < "/proc/$terminal_pid/stat" || true)
    if [ -z "$terminal_state" ]; then
        [ ! -e "/proc/$terminal_pid" ] && return 0
        return 1
    fi
    case $terminal_state in
        Z|X|x) return 0 ;;
        *) return 1 ;;
    esac
}

script_pid_matches() {
    checked_pid=$1
    expected_command=$2
    script_pid_live "$checked_pid" || return 1
    expected_uid=$(stat -L -c '%u' "$package_home" 2>/dev/null || true)
    [ -n "$expected_uid" ] || return 1
    actual_uid=$(sed -n 's/^Uid:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "/proc/$checked_pid/status" 2>/dev/null | sed -n '1p')
    [ "$actual_uid" = "$expected_uid" ] || return 1
    [ -r "/proc/$checked_pid/cmdline" ] || return 1
    canonical_command_dir=$(CDPATH='' cd -- "$(dirname -- "$expected_command")" 2>/dev/null && pwd -P) || return 1
    canonical_command=$canonical_command_dir/$(basename -- "$expected_command")
    if tr '\000' '\n' 2>/dev/null < "/proc/$checked_pid/cmdline" |
        grep -F -x "$expected_command" >/dev/null 2>&1
    then
        return 0
    fi
    [ "$canonical_command" != "$expected_command" ] || return 1
    tr '\000' '\n' 2>/dev/null < "/proc/$checked_pid/cmdline" |
        grep -F -x "$canonical_command" >/dev/null 2>&1
}

same_private_executable() {
    expected_executable=$1
    candidate_executable=$2
    executable_owner=$3
    case $candidate_executable in /*) ;; *) return 1 ;; esac
    [ -f "$expected_executable" ] && [ ! -L "$expected_executable" ] || return 1
    [ -f "$candidate_executable" ] && [ ! -L "$candidate_executable" ] || return 1

    expected_executable_identity=$(stat -L -c '%d:%i:%u:%a:%h' "$expected_executable" 2>/dev/null || true)
    candidate_executable_identity=$(stat -L -c '%d:%i:%u:%a:%h' "$candidate_executable" 2>/dev/null || true)
    case $expected_executable_identity in
        *:"$executable_owner":755:1) ;;
        *) return 1 ;;
    esac
    [ "$candidate_executable_identity" = "$expected_executable_identity" ] || return 1

    # DSM may expose the installed target through both SYNOPKG_PKGDEST and
    # /var/packages/.../target. Recheck both names so a concurrent replacement
    # cannot turn that legitimate parent-directory alias into a different file.
    expected_executable_recheck=$(stat -L -c '%d:%i:%u:%a:%h' "$expected_executable" 2>/dev/null || true)
    candidate_executable_recheck=$(stat -L -c '%d:%i:%u:%a:%h' "$candidate_executable" 2>/dev/null || true)
    [ "$expected_executable_recheck" = "$expected_executable_identity" ] \
        && [ "$candidate_executable_recheck" = "$expected_executable_identity" ]
}

api_pid_matches() {
    checked_pid=$1
    script_pid_live "$checked_pid" || return 1
    expected_uid=$(stat -L -c '%u' "$package_home" 2>/dev/null || true)
    [ -n "$expected_uid" ] || return 1
    actual_uid=$(sed -n 's/^Uid:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "/proc/$checked_pid/status" 2>/dev/null | sed -n '1p')
    [ "$actual_uid" = "$expected_uid" ] || return 1
    [ -r "/proc/$checked_pid/cmdline" ] || return 1
    canonical_api_dir=$(CDPATH='' cd -- "$(dirname -- "$api_server")" 2>/dev/null && pwd -P) || return 1
    canonical_api=$canonical_api_dir/$(basename -- "$api_server")
    tr '\000' '\n' 2>/dev/null < "/proc/$checked_pid/cmdline" |
        awk -v expected="$api_server" -v canonical="$canonical_api" '
            { argument[NR] = $0 }
            END {
                base = 0
                if (argument[1] == expected || argument[1] == canonical) base = 1
                else if (argument[1] ~ /^\// &&
                    (argument[2] == expected || argument[2] == canonical)) base = 2
                if (base == 0) exit 1
                remaining = NR - base
                if (remaining == 1 && argument[base + 1] == "--serve") exit 0
                if (remaining == 4 && argument[base + 1] == "--serve-supervised" &&
                    argument[base + 2] ~ /^[0-9]+$/ && argument[base + 2] + 0 > 1 &&
                    argument[base + 3] ~ /^[0-9]+$/ && argument[base + 3] + 0 > 0 &&
                    length(argument[base + 4]) == 36 &&
                    argument[base + 4] ~ /^[0-9a-f-]+$/) exit 0
                exit 1
            }
        '
}

api_pid_matches_supervised() {
    checked_pid=$1
    api_pid_matches "$checked_pid" || return 1
    tr '\000' '\n' 2>/dev/null < "/proc/$checked_pid/cmdline" |
        grep -F -x -- '--serve-supervised' >/dev/null 2>&1
}

controller_supervisor_pid_matches() {
    checked_pid=$1
    script_pid_live "$checked_pid" || return 1
    expected_uid=$(stat -L -c '%u' "$package_home" 2>/dev/null || true)
    actual_uid=$(sed -n 's/^Uid:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        "/proc/$checked_pid/status" 2>/dev/null | sed -n '1p')
    [ -n "$expected_uid" ] && [ "$actual_uid" = "$expected_uid" ] || return 1
    canonical_api_dir=$(CDPATH='' cd -- "$(dirname -- "$api_server")" 2>/dev/null && pwd -P) || return 1
    canonical_api=$canonical_api_dir/$(basename -- "$api_server")
    tr '\000' '\n' 2>/dev/null < "/proc/$checked_pid/cmdline" |
        awk -v expected="$api_server" -v canonical="$canonical_api" '
            { argument[NR] = $0 }
            END {
                base = 0
                if (argument[1] == expected || argument[1] == canonical) base = 1
                else if (argument[1] ~ /^\// &&
                    (argument[2] == expected || argument[2] == canonical)) base = 2
                if (base == 0 || NR - base != 4 ||
                    argument[base + 1] != "--exec-supervised-controller") exit 1
                if (argument[base + 2] !~ /^[0-9]+$/ || argument[base + 2] + 0 <= 1 ||
                    argument[base + 3] !~ /^[0-9]+$/ || argument[base + 3] + 0 <= 0 ||
                    length(argument[base + 4]) != 36 ||
                    argument[base + 4] !~ /^[0-9a-f-]+$/) exit 1
                exit 0
            }
        '
}

controller_lock_identity_matches() {
    expected_controller_lock_pid=$1
    expected_controller_lock_start=$2
    expected_controller_lock_boot=$3
    [ -f "$controller" ] && [ ! -L "$controller" ] || return 73
    controller_lock_executable=$(stat -L -c '%u:%a:%h' "$controller" 2>/dev/null || true)
    [ "$controller_lock_executable" = "$path_owner:755:1" ] || return 73
    controller_lock_match_status=0
    private_process_lock_is_live "$controller_lock" || controller_lock_match_status=$?
    [ "$controller_lock_match_status" -eq 0 ] \
        && [ "${lock_owner_legacy:-true}" = false ] \
        && [ "$lock_owner_pid" = "$expected_controller_lock_pid" ] \
        && [ "$lock_owner_start" = "$expected_controller_lock_start" ] \
        && [ "$lock_owner_boot" = "$expected_controller_lock_boot" ] || return 73
    if api_path_exists "$controller_pid_file"; then
        controller_pid_file_safe || return 73
        [ "$controller_pid_value" = "$expected_controller_lock_pid" ] || return 73
    fi
    if api_path_exists "$controller_ready_file"; then
        controller_persisted_identity_status "$expected_controller_lock_pid" || return 73
    fi
    controller_lock_match_status=0
    private_process_lock_is_live "$controller_lock" || controller_lock_match_status=$?
    [ "$controller_lock_match_status" -eq 0 ] \
        && [ "${lock_owner_legacy:-true}" = false ] \
        && [ "$lock_owner_pid" = "$expected_controller_lock_pid" ] \
        && [ "$lock_owner_start" = "$expected_controller_lock_start" ] \
        && [ "$lock_owner_boot" = "$expected_controller_lock_boot" ]
}

failed_start_child_command_matches() {
    failed_child_kind=$1
    failed_child_pid=$2
    failed_child_start=$3
    failed_child_boot=$4
    case $failed_child_kind in
        api) api_pid_matches_supervised "$failed_child_pid" ;;
        controller)
            controller_lock_identity_matches "$failed_child_pid" \
                "$failed_child_start" "$failed_child_boot" ||
                controller_supervisor_pid_matches "$failed_child_pid"
            ;;
        *) return 1 ;;
    esac
}

verified_service_pid_matches() {
    verified_service_kind=$1
    verified_service_pid=$2
    case $verified_service_kind in
        controller) controller_persisted_identity_status "$verified_service_pid" ;;
        runner) script_pid_matches "$verified_service_pid" "$runner" ;;
        api) api_pid_matches "$verified_service_pid" ;;
        *) return 1 ;;
    esac
}

pid_slot_absent() {
    checked_slot_pid=$1
    script_pid_absent_or_zombie "$checked_slot_pid"
}

signal_verified_service() {
    signal_service_kind=$1
    signal_service_pid=$2
    signal_service_label=$3

    if ! verified_service_pid_matches "$signal_service_kind" "$signal_service_pid"; then
        if pid_slot_absent "$signal_service_pid"; then
            return 0
        fi
        package_message "refusing to signal unverified $signal_service_label PID $signal_service_pid"
        return 1
    fi

    if kill -TERM "$signal_service_pid" 2>/dev/null; then
        return 0
    fi

    # A target can exit after the identity check but before kill(2). Accept
    # that race only when a fresh procfs check proves its PID slot absent or
    # robustly parses it as a zombie. A live exact target, reused live PID, or uninspectable process
    # remains a hard failure.
    if verified_service_pid_matches "$signal_service_kind" "$signal_service_pid"; then
        package_message "failed to signal verified $signal_service_label PID $signal_service_pid; target remains live"
        return 1
    fi
    if pid_slot_absent "$signal_service_pid"; then
        return 0
    fi
    package_message "$signal_service_label PID $signal_service_pid changed identity or remained live after signal failure"
    return 1
}

package_uid() {
    stat -L -c '%u' "$package_home" 2>/dev/null
}

api_socket_parent_safe() {
    [ -d "$api_socket_dir" ] && [ ! -L "$api_socket_dir" ] || {
        package_message "API socket parent is not a real directory: $api_socket_dir"
        return 1
    }
    api_expected_uid=$(package_uid 2>/dev/null || true)
    api_parent_uid=$(stat -c '%u' "$api_socket_dir" 2>/dev/null || true)
    api_parent_mode=$(stat -c '%a' "$api_socket_dir" 2>/dev/null || true)
    case $api_parent_mode in ''|*[!0-7]*)
        package_message "cannot verify API socket parent mode: $api_socket_dir"
        return 1
        ;;
    esac
    [ -n "$api_expected_uid" ] && [ "$api_parent_uid" = "$api_expected_uid" ] || {
        package_message "API socket parent is not owned by the package identity: $api_socket_dir"
        return 1
    }
    api_parent_bits=$((0$api_parent_mode))
    [ $((api_parent_bits & 06000)) -eq 0 ] || {
        package_message "API socket parent must not carry setuid/setgid bits: $api_socket_dir"
        return 1
    }
    [ $((api_parent_bits & 0022)) -eq 0 ] || {
        package_message "API socket parent must not be writable by group or other: $api_socket_dir"
        return 1
    }
}

api_socket_safe() {
    api_socket_parent_safe || return 1
    [ -S "$api_socket" ] && [ ! -L "$api_socket" ] || {
        package_message "API socket path is not a real Unix socket: $api_socket"
        return 1
    }
    api_expected_uid=$(package_uid 2>/dev/null || true)
    api_socket_uid=$(stat -c '%u' "$api_socket" 2>/dev/null || true)
    api_socket_mode=$(stat -c '%a' "$api_socket" 2>/dev/null || true)
    api_socket_links=$(stat -c '%h' "$api_socket" 2>/dev/null || true)
    [ -n "$api_expected_uid" ] && \
        [ "$api_socket_uid" = "$api_expected_uid" ] && \
        [ "$api_socket_mode" = 600 ] && [ "$api_socket_links" = 1 ] || {
        package_message "API socket ownership or mode is outside the package-owned 0600 contract"
        return 1
    }
}

# Before the lifecycle parent commits startup, the API listener must be a real,
# single-link, package-owned 0000 socket. Nothing can connect to this prepared
# topology. The API changes it to the final package-owned 0600 contract only
# after readiness and worker-pool publication.
api_prepared_socket_safe() {
    api_socket_parent_safe || return 1
    [ -S "$api_socket" ] && [ ! -L "$api_socket" ] || {
        package_message "prepared API socket path is not a real Unix socket: $api_socket"
        return 1
    }
    api_expected_uid=$(package_uid 2>/dev/null || true)
    api_socket_uid=$(stat -c '%u' "$api_socket" 2>/dev/null || true)
    api_socket_mode=$(stat -c '%a' "$api_socket" 2>/dev/null || true)
    api_socket_links=$(stat -c '%h' "$api_socket" 2>/dev/null || true)
    [ -n "$api_expected_uid" ] \
        && [ "$api_socket_uid" = "$api_expected_uid" ] \
        && [ "$api_socket_mode" = 0 ] \
        && [ "$api_socket_links" = 1 ] || {
        package_message "prepared API socket is outside the package-owned 0000 contract"
        return 1
    }
}

capture_api_prepared_socket_identity() {
    api_prepared_socket_safe || return 1
    prepared_socket_identity=$(stat -c '%d:%i' "$api_socket" 2>/dev/null || true)
    case $prepared_socket_identity in ''|*[!0-9:]*|*:*:*) return 1 ;; esac
    api_prepared_socket_safe || return 1
    prepared_socket_identity_recheck=$(stat -c '%d:%i' "$api_socket" 2>/dev/null || true)
    [ "$prepared_socket_identity_recheck" = "$prepared_socket_identity" ] || return 1
    printf '%s\n' "$prepared_socket_identity"
}

api_prepared_socket_matches_identity() {
    expected_prepared_socket_identity=${1:-}
    case $expected_prepared_socket_identity in ''|*[!0-9:]*|*:*:*) return 1 ;; esac
    current_prepared_socket_identity=$(capture_api_prepared_socket_identity 2>/dev/null || true)
    [ "$current_prepared_socket_identity" = "$expected_prepared_socket_identity" ]
}

api_stale_socket_safe() {
    api_socket_parent_safe || return 1
    [ -S "$api_socket" ] && [ ! -L "$api_socket" ] || {
        package_message "API socket path is not a real Unix socket: $api_socket"
        return 1
    }
    api_expected_uid=$(package_uid 2>/dev/null || true)
    api_socket_uid=$(stat -c '%u' "$api_socket" 2>/dev/null || true)
    api_socket_mode=$(stat -c '%a' "$api_socket" 2>/dev/null || true)
    api_socket_links=$(stat -c '%h' "$api_socket" 2>/dev/null || true)
    [ -n "$api_expected_uid" ] && \
        [ "$api_socket_uid" = "$api_expected_uid" ] && \
        [ "$api_socket_links" = 1 ] || {
        package_message "API socket is not exclusively owned by the package"
        return 1
    }
    case $api_socket_mode in
        0|600) ;;
        *)
            package_message "API socket is neither a package-owned 0000 bind nor activated 0600 socket"
            return 1
            ;;
    esac
}

api_pid_file_safe() {
    [ -f "$api_pid_file" ] && [ ! -L "$api_pid_file" ] || return 1
    api_expected_uid=$(package_uid 2>/dev/null || true)
    api_pid_uid=$(stat -c '%u' "$api_pid_file" 2>/dev/null || true)
    api_pid_mode=$(stat -c '%a' "$api_pid_file" 2>/dev/null || true)
    api_pid_links=$(stat -c '%h' "$api_pid_file" 2>/dev/null || true)
    [ -n "$api_expected_uid" ] && [ "$api_pid_uid" = "$api_expected_uid" ] && \
        [ "$api_pid_mode" = 600 ] && [ "$api_pid_links" = 1 ]
}

api_pid() {
    api_pid_file_safe || return 1
    IFS= read -r api_found_pid < "$api_pid_file" || return 1
    case $api_found_pid in ''|*[!0-9]*) return 1 ;; esac
    [ "$api_found_pid" -gt 1 ] 2>/dev/null || return 1
    printf '%s\n' "$api_found_pid"
}

read_api_bound_identity() {
    api_path_exists "$api_bound_file" || return 1
    [ -f "$api_bound_file" ] && [ ! -L "$api_bound_file" ] || return 73
    api_expected_uid=$(package_uid 2>/dev/null || true)
    api_bound_metadata=$(stat -c '%u:%a:%h' "$api_bound_file" 2>/dev/null || true)
    [ -n "$api_expected_uid" ] && [ "$api_bound_metadata" = "$api_expected_uid:600:1" ] || return 73
    api_bound_size=$(wc -c 2>/dev/null < "$api_bound_file" | tr -d ' ')
    case $api_bound_size in ''|*[!0-9]*) return 73 ;; esac
    [ "$api_bound_size" -le 96 ] || return 73
    api_bound_lines=$(awk 'END { print NR }' "$api_bound_file" 2>/dev/null || true)
    [ "$api_bound_lines" = 3 ] || return 73
    api_bound_pid=$(sed -n '1p' "$api_bound_file" 2>/dev/null || true)
    api_bound_start=$(sed -n '2p' "$api_bound_file" 2>/dev/null || true)
    api_bound_boot=$(sed -n '3p' "$api_bound_file" 2>/dev/null || true)
    case $api_bound_pid in ''|*[!0-9]*) return 73 ;; esac
    [ "$api_bound_pid" -gt 1 ] 2>/dev/null || return 73
    case $api_bound_start in ''|*[!0-9]*|0) return 73 ;; esac
    valid_boot_identity "$api_bound_boot" || return 73
}

# Return 0 for the live exact pre-commit API identity, 1 for absent/stale, and
# 73 for an unsafe or malformed record.
api_bound_status() {
    api_path_exists "$api_bound_file" || return 1
    read_api_bound_identity || return $?
    api_bound_live_status=0
    process_identity_is_live "$api_bound_pid" "$api_bound_start" "$api_bound_boot" || \
        api_bound_live_status=$?
    case $api_bound_live_status in
        0) api_pid_matches_supervised "$api_bound_pid" || return 73; return 0 ;;
        1) return 1 ;;
        *) return 73 ;;
    esac
}

api_bound_matches() {
    expected_api_bound_pid=$1
    api_bound_status || return $?
    [ "$api_bound_pid" = "$expected_api_bound_pid" ] || return 73
}

remove_stale_api_bound() {
    api_path_exists "$api_bound_file" || return 0
    stale_api_bound_status=0
    api_bound_status || stale_api_bound_status=$?
    case $stale_api_bound_status in
        0) return 75 ;;
        1) ;;
        *) return 73 ;;
    esac
    read_api_bound_identity || {
        api_path_exists "$api_bound_file" || return 0
        return 73
    }
    stale_api_bound_identity=$(stat -c '%d:%i' "$api_bound_file" 2>/dev/null || true)
    [ -n "$stale_api_bound_identity" ] || return 73
    read_api_bound_identity || return 73
    stale_api_bound_recheck=$(stat -c '%d:%i' "$api_bound_file" 2>/dev/null || true)
    [ "$stale_api_bound_recheck" = "$stale_api_bound_identity" ] || return 73
    rm -f "$api_bound_file"
}

read_api_ready_identity() {
    api_path_exists "$api_ready_file" || return 1
    [ -f "$api_ready_file" ] && [ ! -L "$api_ready_file" ] || return 73
    api_expected_uid=$(package_uid 2>/dev/null || true)
    api_ready_metadata=$(stat -c '%u:%a:%h' "$api_ready_file" 2>/dev/null || true)
    [ -n "$api_expected_uid" ] && [ "$api_ready_metadata" = "$api_expected_uid:600:1" ] || return 73
    api_ready_size=$(wc -c 2>/dev/null < "$api_ready_file" | tr -d ' ')
    case $api_ready_size in ''|*[!0-9]*) return 73 ;; esac
    [ "$api_ready_size" -le 96 ] || return 73
    api_ready_lines=$(awk 'END { print NR }' "$api_ready_file" 2>/dev/null || true)
    [ "$api_ready_lines" = 3 ] || return 73
    api_ready_pid=$(sed -n '1p' "$api_ready_file" 2>/dev/null || true)
    api_ready_start=$(sed -n '2p' "$api_ready_file" 2>/dev/null || true)
    api_ready_boot=$(sed -n '3p' "$api_ready_file" 2>/dev/null || true)
    case $api_ready_pid in ''|*[!0-9]*) return 73 ;; esac
    [ "$api_ready_pid" -gt 1 ] 2>/dev/null || return 73
    case $api_ready_start in ''|*[!0-9]*|0) return 73 ;; esac
    valid_boot_identity "$api_ready_boot" || return 73
}

# Return 0 for the live exact supervised API identity, 1 for absent/stale, and
# 73 for an unsafe or malformed readiness record.
api_ready_status() {
    api_path_exists "$api_ready_file" || return 1
    read_api_ready_identity || return $?
    api_ready_live_status=0
    process_identity_is_live "$api_ready_pid" "$api_ready_start" "$api_ready_boot" || \
        api_ready_live_status=$?
    case $api_ready_live_status in
        0) api_pid_matches_supervised "$api_ready_pid" || return 73; return 0 ;;
        1) return 1 ;;
        *) return 73 ;;
    esac
}

api_ready_matches() {
    expected_api_ready_pid=$1
    api_ready_status || return $?
    [ "$api_ready_pid" = "$expected_api_ready_pid" ] || return 73
}

remove_stale_api_ready() {
    api_path_exists "$api_ready_file" || return 0
    stale_api_ready_status=0
    api_ready_status || stale_api_ready_status=$?
    case $stale_api_ready_status in
        0) return 75 ;;
        1) ;;
        *) return 73 ;;
    esac
    read_api_ready_identity || {
        api_path_exists "$api_ready_file" || return 0
        return 73
    }
    stale_api_ready_identity=$(stat -c '%d:%i' "$api_ready_file" 2>/dev/null || true)
    [ -n "$stale_api_ready_identity" ] || return 73
    read_api_ready_identity || return 73
    stale_api_ready_recheck=$(stat -c '%d:%i' "$api_ready_file" 2>/dev/null || true)
    [ "$stale_api_ready_recheck" = "$stale_api_ready_identity" ] || return 73
    rm -f "$api_ready_file"
}

api_path_exists() {
    [ -e "$1" ] || [ -L "$1" ]
}

api_socket_identity() {
    api_stale_socket_safe >/dev/null || return 1
    api_socket_identity_value=$(stat -c '%d:%i' "$api_socket" 2>/dev/null || true)
    case $api_socket_identity_value in ''|*[!0-9:]*|*:*:*) return 1 ;; esac
    printf '%s\n' "$api_socket_identity_value"
}

remove_safe_api_socket() {
    api_expected_identity=${1:-}
    api_path_exists "$api_socket" || return 0
    case $api_expected_identity in ''|*[!0-9:]*|*:*:*)
        package_message "cannot remove API socket without a captured device/inode"
        return 1
        ;;
    esac
    api_current_identity=$(api_socket_identity 2>/dev/null || true)
    [ "$api_current_identity" = "$api_expected_identity" ] || {
        package_message "API socket changed after its verified service was identified"
        return 1
    }
    api_rechecked_identity=$(api_socket_identity 2>/dev/null || true)
    [ "$api_rechecked_identity" = "$api_expected_identity" ] || {
        package_message "API socket changed immediately before removal"
        return 1
    }
    rm -f "$api_socket"
}

remove_safe_api_pid_file() {
    api_path_exists "$api_pid_file" || return 0
    api_pid_file_safe || {
        package_message "refusing unsafe API PID file: $api_pid_file"
        return 1
    }
    rm -f "$api_pid_file"
}

refuse_active_run() {
    run_pid=$(script_pid "$run_lock/pid" 2>/dev/null || true)
    if [ -n "$run_pid" ] && script_pid_live "$run_pid"; then
        if script_pid_matches "$run_pid" "$runner"; then
            package_message "plan/sync PID $run_pid is still active; stop it before changing the package"
        else
            package_message "refusing to trust live PID $run_pid from the package run lock"
        fi
        return 1
    fi
}

legacy_upgrade_source_supported() {
    case ${SYNOPKG_OLD_PKGVER:-} in
        26.7-1|26.8-1|26.9-1|26.10-1) return 0 ;;
        *) return 1 ;;
    esac
}

# The released 26.7 through 26.10 runners stored only their shell PID. SIGKILL could leave an
# exact core process alive behind a stale one-line run lock. These read-only
# checks are used by the next package's preupgrade before target replacement;
# never infer identity from a name/substring match.
legacy_package_core_status() {
    legacy_core_binary=$package_root/bin/synology-drive-sync
    legacy_core_config=$package_home/config/config.toml
    [ -x "$legacy_core_binary" ] && [ ! -L "$legacy_core_binary" ] || return 73
    command -v readlink >/dev/null 2>&1 || return 73
    legacy_core_dir=$(CDPATH='' cd -- "$(dirname -- "$legacy_core_binary")" 2>/dev/null && pwd -P) \
        || return 73
    legacy_core_canonical=$legacy_core_dir/$(basename -- "$legacy_core_binary")
    legacy_core_uid=$(package_uid 2>/dev/null || true)
    case $legacy_core_uid in ''|*[!0-9]*) return 73 ;; esac
    for legacy_proc in /proc/[0-9]*; do
        [ -d "$legacy_proc" ] || continue
        legacy_proc_uid=$(stat -c '%u' "$legacy_proc" 2>/dev/null || true)
        if [ -z "$legacy_proc_uid" ]; then
            [ -e "$legacy_proc" ] && return 73
            continue
        fi
        [ "$legacy_proc_uid" = "$legacy_core_uid" ] || continue
        legacy_proc_state=$(sed -n 's/^.*) \([^ ]\).*/\1/p' \
            "$legacy_proc/stat" 2>/dev/null || true)
        [ "$legacy_proc_state" != Z ] || continue
        legacy_proc_exe=$(readlink "$legacy_proc/exe" 2>/dev/null || true)
        if [ -z "$legacy_proc_exe" ]; then
            legacy_proc_arg0=$(tr '\000' '\n' 2>/dev/null < "$legacy_proc/cmdline" |
                sed -n '1p' || true)
            case $legacy_proc_arg0 in
                "$legacy_core_binary"|"$legacy_core_canonical") return 73 ;;
            esac
            continue
        fi
        case $legacy_proc_exe in
            "$legacy_core_canonical"|"$legacy_core_canonical (deleted)") ;;
            *) continue ;;
        esac
        [ -r "$legacy_proc/cmdline" ] || return 73
        if tr '\000' '\n' 2>/dev/null < "$legacy_proc/cmdline" |
            awk -v expected="$legacy_core_binary" -v canonical="$legacy_core_canonical" \
                -v config="$legacy_core_config" '
                { argument[NR] = $0 }
                END {
                    if (NR < 6 || NR > 8) exit 1
                    if (argument[1] != expected && argument[1] != canonical) exit 1
                    if (argument[2] != "--config" || argument[3] != config) exit 1
                    if (argument[4] != "sync" && argument[4] != "plan") exit 1
                    if (argument[5] == "--profile") {
                        if (argument[6] !~ /^[A-Za-z0-9_-]+$/) exit 1
                        if (NR == 7 && argument[7] != "--no-delete") exit 1
                        if (NR != 6 && NR != 7) exit 1
                        exit 0
                    }
                    if (argument[5] == "--all-profiles") {
                        if (argument[6] != "--max-total-delete" ||
                            argument[7] !~ /^[0-9]+$/) exit 1
                        if (NR == 8 && argument[8] != "--no-delete") exit 1
                        if (NR != 7 && NR != 8) exit 1
                        exit 0
                    }
                    exit 1
                }
            '
        then
            package_message "legacy package core PID ${legacy_proc##*/} is still active"
            return 75
        fi
        # The executable identity is exact but argv could not be proven to be
        # the released runner contract. Treat it as unsafe, never as absent.
        [ -e "$legacy_proc" ] || continue
        package_message "legacy package core PID ${legacy_proc##*/} has unsafe arguments"
        return 73
    done
    return 0
}

legacy_stale_run_lock_status() {
    legacy_run_lock_present=false
    [ -e "$run_lock" ] || [ -L "$run_lock" ] || return 0
    legacy_run_lock_present=true
    [ -d "$run_lock" ] && [ ! -L "$run_lock" ] || return 73
    legacy_lock_uid=$(package_uid 2>/dev/null || true)
    legacy_lock_metadata=$(stat -c '%u:%a' "$run_lock" 2>/dev/null || true)
    [ -n "$legacy_lock_uid" ] && [ "$legacy_lock_metadata" = "$legacy_lock_uid:700" ] \
        || return 73
    for legacy_lock_entry in "$run_lock"/* "$run_lock"/.[!.]* "$run_lock"/..?*; do
        [ -e "$legacy_lock_entry" ] || [ -L "$legacy_lock_entry" ] || continue
        [ "${legacy_lock_entry##*/}" = pid ] || return 73
    done
    legacy_lock_pid_file=$run_lock/pid
    [ -f "$legacy_lock_pid_file" ] && [ ! -L "$legacy_lock_pid_file" ] || return 73
    legacy_pid_metadata=$(stat -c '%u:%a:%h' "$legacy_lock_pid_file" 2>/dev/null || true)
    [ "$legacy_pid_metadata" = "$legacy_lock_uid:600:1" ] || return 73
    legacy_pid=$(sed -n '1p' "$legacy_lock_pid_file" 2>/dev/null || true)
    case $legacy_pid in ''|*[!0-9]*) return 73 ;; esac
    [ "$legacy_pid" -gt 1 ] 2>/dev/null || return 73
    legacy_pid_size=$(wc -c 2>/dev/null < "$legacy_lock_pid_file" | tr -d ' ')
    case $legacy_pid_size in ''|*[!0-9]*) return 73 ;; esac
    [ "$legacy_pid_size" -eq $((${#legacy_pid} + 1)) ] || return 73
    if script_pid_live "$legacy_pid"; then
        package_message "legacy plan/sync owner PID $legacy_pid is still active"
        return 75
    fi
    if [ -e "/proc/$legacy_pid" ]; then
        legacy_reused_uid=$(stat -c '%u' "/proc/$legacy_pid" 2>/dev/null || true)
        [ -n "$legacy_reused_uid" ] || return 73
        [ "$legacy_reused_uid" != "$legacy_lock_uid" ] || return 73
    fi
    return 0
}
