#!/bin/sh
set -eu
. "$(dirname "$0")/common"
umask 077

status_code() {
    controller_active=false
    controller_stale=false
    saved_pid=$(script_pid "$controller_pid_file" 2>/dev/null || true)
    if api_path_exists "$controller_pid_file"; then
        [ -n "$saved_pid" ] || return 2
        if script_pid_matches "$saved_pid" "$controller"; then
            controller_active=true
        elif script_pid_live "$saved_pid"; then
            return 2
        else
            controller_stale=true
        fi
    fi
    if api_path_exists "$controller_lock"; then
        [ -d "$controller_lock" ] && [ ! -L "$controller_lock" ] || return 2
        [ "$controller_active" = true ] || controller_stale=true
    fi

    api_active=false
    api_stale=false
    saved_api_pid=
    if api_path_exists "$api_pid_file"; then
        api_pid_file_safe || return 2
        saved_api_pid=$(api_pid 2>/dev/null || true)
        [ -n "$saved_api_pid" ] || return 2
        if script_pid_live "$saved_api_pid"; then
            api_pid_matches "$saved_api_pid" || return 2
            api_socket_safe >/dev/null 2>&1 || return 2
            api_active=true
        else
            api_stale=true
            if api_path_exists "$api_socket"; then
                api_stale_socket_safe >/dev/null 2>&1 || return 2
            fi
        fi
    else
        if api_path_exists "$api_socket"; then
            # Metadata alone cannot prove whether an untracked socket is live.
            # Classify only an exact crash-window/final socket as restartable;
            # the Rust bind path performs the bounded connect-refused check.
            api_stale_socket_safe >/dev/null 2>&1 || return 2
            api_stale=true
        fi
    fi

    if [ "$controller_active" = true ] && [ "$api_active" = true ]; then
        return 0
    fi
    if [ "$controller_active" = true ] || [ "$api_active" = true ]; then
        return 2
    fi
    if [ "$controller_stale" = true ] || [ "$api_stale" = true ]; then
        return 1
    fi
    return 3
}

prepare_api_start() {
    api_socket_parent_safe || return 1

    if api_path_exists "$api_pid_file"; then
        api_pid_file_safe || {
            package_message "refusing unsafe API PID file: $api_pid_file"
            return 1
        }
        stale_api_pid=$(api_pid 2>/dev/null || true)
        [ -n "$stale_api_pid" ] || {
            package_message "refusing malformed API PID file: $api_pid_file"
            return 1
        }
        if script_pid_live "$stale_api_pid"; then
            package_message "refusing to replace live API PID $stale_api_pid"
            return 1
        fi
        if api_path_exists "$api_socket"; then
            api_stale_socket_safe || return 1
        fi
        remove_safe_api_pid_file || return 1
    elif api_path_exists "$api_socket"; then
        api_stale_socket_safe || {
            package_message "refusing unsafe untracked API socket: $api_socket"
            return 1
        }
    fi
    # Never unlink a socket during start preparation. The Rust bind path alone
    # validates exact metadata, probes for a live listener with a deadline, and
    # removes a connection-refused stale socket after a device/inode recheck.
}

cleanup_failed_start() {
    [ "${start_committed:-false}" = false ] || return 0
    set +e
    if [ -n "${launched_controller_pid:-}" ] && \
        script_pid_matches "$launched_controller_pid" "$controller"; then
        kill -TERM "$launched_controller_pid" 2>/dev/null
    fi
    cleanup_api_owned=false
    cleanup_api_signaled=false
    cleanup_api_socket_identity=${launched_api_socket_identity:-}
    if [ -n "${launched_api_pid:-}" ]; then
        # The PID is the direct child returned by this shell. Give its wrapper
        # a bounded chance to publish the same PID and exec the exact --serve
        # argv before deciding whether it is safe to signal.
        cleanup_transition_count=0
        while script_pid_live "$launched_api_pid" && \
            ! api_pid_matches "$launched_api_pid" && \
            [ "$cleanup_transition_count" -lt 3 ]; do
            sleep 1
            cleanup_transition_count=$((cleanup_transition_count + 1))
        done
        cleanup_saved_api_pid=$(api_pid 2>/dev/null || true)
        if [ "$cleanup_saved_api_pid" = "$launched_api_pid" ]; then
            cleanup_api_owned=true
        fi
        if [ "$cleanup_api_owned" = true ] && api_pid_matches "$launched_api_pid"; then
            if [ -z "$cleanup_api_socket_identity" ] && api_path_exists "$api_socket"; then
                cleanup_api_socket_identity=$(api_socket_identity 2>/dev/null || true)
            fi
            kill -TERM "$launched_api_pid" 2>/dev/null
            cleanup_api_signaled=true
        fi
    fi
    cleanup_count=0
    while [ "$cleanup_count" -lt 10 ]; do
        cleanup_live=false
        if [ -n "${launched_controller_pid:-}" ] && \
            script_pid_matches "$launched_controller_pid" "$controller"; then
            cleanup_live=true
        fi
        if [ -n "${launched_api_pid:-}" ] && \
            api_pid_matches "$launched_api_pid"; then
            cleanup_live=true
        fi
        [ "$cleanup_live" = true ] || break
        sleep 1
        cleanup_count=$((cleanup_count + 1))
    done
    if [ "$cleanup_api_signaled" = true ] && ! script_pid_live "$launched_api_pid"; then
        wait "$launched_api_pid" 2>/dev/null
    fi
    if [ "$cleanup_api_owned" = true ] && \
        ! script_pid_live "$launched_api_pid"; then
        if [ "$cleanup_api_signaled" = true ] && \
            [ -n "$cleanup_api_socket_identity" ]; then
            remove_safe_api_socket "$cleanup_api_socket_identity" >/dev/null 2>&1
        fi
        cleanup_saved_api_pid=$(api_pid 2>/dev/null || true)
        if [ -n "$cleanup_saved_api_pid" ] && [ "$cleanup_saved_api_pid" = "$launched_api_pid" ]; then
            remove_safe_api_pid_file >/dev/null 2>&1
        fi
    fi
}

case ${1:-} in
    prestart)
        [ -x "$package_root/bin/synology-drive-sync" ] || exit 150
        [ -x "$controller" ] || exit 150
        [ -x "$api_server" ] || exit 150
        [ -r "$common_runtime" ] || exit 150
        api_socket_parent_safe >/dev/null 2>&1 || exit 150
        exit 0
        ;;
    start)
        set +e
        status_code
        current_status=$?
        set -e
        case $current_status in
            0) exit 0 ;;
            2)
                package_message "refusing to start from an inconsistent lifecycle state"
                exit 1
                ;;
        esac
        lifecycle_controller=$controller
        . "$common_runtime"
        require_package_identity
        ensure_layout
        prepare_api_start
        start_committed=false
        launched_api_pid=
        launched_api_socket_identity=
        launched_controller_pid=
        trap cleanup_failed_start 0
        trap 'exit 1' HUP INT TERM

        [ ! -L "$api_log" ] || {
            package_message "refusing symlinked API log: $api_log"
            exit 1
        }
        rotate_log "$api_log" 10485760 5
        # The child owns PID publication: it creates the 0600 file with
        # noclobber before exec, so killing this lifecycle shell cannot strand
        # a live API server without its PID record.
        /bin/sh -c '
            set -eu
            umask 077
            api_child_pid_file=$1
            api_child_server=$2
            set -C
            printf "%s\n" "$$" > "$api_child_pid_file"
            set +C
            chmod 0600 "$api_child_pid_file"
            exec "$api_child_server" --serve
        ' sdsync-api-wrapper "$api_pid_file" "$api_server" \
            >> "$api_log" 2>&1 </dev/null &
        launched_api_pid=$!
        api_ready=false
        count=0
        while [ "$count" -lt 10 ]; do
            saved_api_pid=$(api_pid 2>/dev/null || true)
            if [ "$saved_api_pid" = "$launched_api_pid" ] && \
                api_pid_matches "$launched_api_pid" && \
                api_socket_safe >/dev/null 2>&1; then
                launched_api_socket_identity=$(api_socket_identity 2>/dev/null || true)
                if [ -n "$launched_api_socket_identity" ]; then
                    api_ready=true
                    break
                fi
            fi
            script_pid_live "$launched_api_pid" || break
            sleep 1
            count=$((count + 1))
        done
        if [ "$api_ready" != true ]; then
            package_message "API service failed to start; inspect $api_log"
            exit 1
        fi

        rotate_log "$log_root/controller.log" 10485760 5
        # The controller deliberately owns SIGHUP as its schedule-reload signal.
        # stdin is detached and DSM supervises the package, so do not mask HUP with nohup.
        "$lifecycle_controller" >> "$log_root/controller.log" 2>&1 </dev/null &
        launched_controller_pid=$!
        count=0
        while [ "$count" -lt 10 ]; do
            saved_pid=$(script_pid "$controller_pid_file" 2>/dev/null || true)
            if [ -n "$saved_pid" ] && script_pid_matches "$saved_pid" "$lifecycle_controller"; then
                start_committed=true
                trap - 0 HUP INT TERM
                package_message "API service and controller started as PIDs $launched_api_pid and $saved_pid"
                exit 0
            fi
            script_pid_live "$launched_controller_pid" || break
            sleep 1
            count=$((count + 1))
        done
        package_message "controller failed to start; inspect $log_root/controller.log"
        exit 1
        ;;
    prestop) exit 0 ;;
    stop)
        . "$common_runtime"
        require_package_identity
        saved_pid=$(script_pid "$controller_pid_file" 2>/dev/null || true)
        run_pid=$(script_pid "$run_lock/pid" 2>/dev/null || true)
        saved_api_pid=
        controller_active=false
        run_active=false
        api_active=false
        api_stale_artifacts=false
        api_socket_before_stop=
        if [ -n "$saved_pid" ] && script_pid_live "$saved_pid"; then
            if ! script_pid_matches "$saved_pid" "$controller"; then
                package_message "refusing to signal unverified controller PID $saved_pid"
                exit 1
            fi
            controller_active=true
        fi
        if [ -n "$run_pid" ] && script_pid_live "$run_pid"; then
            if ! script_pid_matches "$run_pid" "$runner"; then
                package_message "refusing to signal unverified plan/sync PID $run_pid"
                exit 1
            fi
            run_active=true
        fi
        if api_path_exists "$api_pid_file"; then
            api_pid_file_safe || {
                package_message "refusing unsafe API PID file: $api_pid_file"
                exit 1
            }
            saved_api_pid=$(api_pid 2>/dev/null || true)
            [ -n "$saved_api_pid" ] || {
                package_message "refusing malformed API PID file: $api_pid_file"
                exit 1
            }
            if script_pid_live "$saved_api_pid"; then
                if ! api_pid_matches "$saved_api_pid"; then
                    package_message "refusing to signal unverified API PID $saved_api_pid"
                    exit 1
                fi
                api_socket_safe || exit 1
                api_socket_before_stop=$(api_socket_identity 2>/dev/null || true)
                [ -n "$api_socket_before_stop" ] || {
                    package_message "cannot capture API socket identity before stop"
                    exit 1
                }
                api_active=true
            else
                api_stale_artifacts=true
                if api_path_exists "$api_socket"; then
                    api_stale_socket_safe || exit 1
                fi
            fi
        else
            if api_path_exists "$api_socket"; then
                api_stale_socket_safe || {
                    package_message "refusing unsafe untracked API socket: $api_socket"
                    exit 1
                }
                api_stale_artifacts=true
            fi
        fi

        if [ "$controller_active" = true ]; then
            signal_verified_service controller "$saved_pid" controller || exit 1
        fi
        if [ "$run_active" = true ] && { [ "$controller_active" != true ] || [ "$run_pid" != "$saved_pid" ]; }; then
            signal_verified_service runner "$run_pid" plan/sync || exit 1
        fi
        if [ "$api_active" = true ]; then
            signal_verified_service api "$saved_api_pid" API || exit 1
        fi
        timeout=${SDSYNC_DSM_STOP_TIMEOUT:-120}
        case $timeout in ''|*[!0-9]*) timeout=120 ;; esac
        elapsed=0
        while :; do
            controller_still_active=false
            run_still_active=false
            api_still_active=false
            if [ "$controller_active" = true ] && script_pid_matches "$saved_pid" "$controller"; then
                controller_still_active=true
            fi
            if [ "$run_active" = true ] && script_pid_matches "$run_pid" "$runner"; then
                run_still_active=true
            fi
            if [ "$api_active" = true ] && api_pid_matches "$saved_api_pid"; then
                api_still_active=true
            fi
            [ "$controller_still_active" = true ] || [ "$run_still_active" = true ] || \
                [ "$api_still_active" = true ] || break
            if [ "$elapsed" -ge "$timeout" ]; then
                package_message "graceful stop timed out after $timeout seconds; process was not force-killed"
                exit 1
            fi
            sleep 1
            elapsed=$((elapsed + 1))
        done
        if [ "$api_active" = true ]; then
            if script_pid_live "$saved_api_pid"; then
                package_message "API PID $saved_api_pid changed identity or remained live after stop"
                exit 1
            fi
            remove_safe_api_socket "$api_socket_before_stop"
        fi
        if api_path_exists "$api_pid_file"; then
            remove_safe_api_pid_file
        fi
        if [ "$api_stale_artifacts" = true ] && api_path_exists "$api_socket"; then
            package_message "leaving an untracked API socket for the Rust start-time liveness check"
            exit 1
        fi
        package_message "API service, controller, and active plan/sync stopped gracefully"
        exit 0
        ;;
    status)
        set +e
        status_code
        result=$?
        set -e
        exit "$result"
        ;;
    *) echo "usage: $0 prestart|start|prestop|stop|status" >&2; exit 64 ;;
esac
