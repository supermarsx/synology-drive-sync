#!/bin/sh
set -eu
# Rust's exec supervisor arms SIGUSR1 as the lifecycle-parent death signal.
# Keep it fatal until controller lock/PID ownership makes a later parent death
# visible and recoverable by lifecycle stop.
trap 'exit 73' USR1
umask 077

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
# shellcheck source=sdsync-common
. "$script_dir/sdsync-common"

require_package_identity
ensure_layout
# Both are read before the first admission, because every child launch and
# every runner-wait guard depends on them. The poll resolution is inherited
# from the lifecycle transition that started this controller rather than
# re-measured; the performance level is re-read on HUP alongside the schedule.
load_runtime_poll_resolution
load_performance_policy_runtime
[ ! -L "$controller_log" ] || { echo "refusing symlinked controller log: $controller_log" >&2; exit 73; }
rotate_log "$controller_log" 10485760 5
[ ! -f "$controller_log" ] || finish_private_file "$controller_log"

controller_log_event() {
    append_controller_log_event "$@"
}

acquire_controller_lock() {
    acquire_private_process_lock "$controller_lock"
}

valid_request_id() {
    case ${1:-} in ''|*[!a-f0-9]*) return 1 ;; esac
    [ "${#1}" -eq 48 ]
}

# Control files are named for one of two identifiers, and the prune loop walks
# directories holding both. Requests, processing claims and responses are named
# for the 48-hex server job id. A progress record is named for the pair it is
# bound to -- <client request id>.<server job id> -- because the bridge's reader
# rebuilds that name from ids it resolved itself and will open no other. The
# shape is therefore a property of the directory, not of the controller.
valid_control_file_id() {
    case ${2:-} in
        progress)
            control_id_client=${1%%.*}
            control_id_job=${1#*.}
            [ "$control_id_job" != "${1:-}" ] || return 1
            case $control_id_client in ''|*[!a-f0-9]*) return 1 ;; esac
            case $control_id_job in ''|*[!a-f0-9]*) return 1 ;; esac
            [ "${#control_id_client}" -eq 32 ] && [ "${#control_id_job}" -eq 48 ]
            ;;
        *)
            case ${1:-} in ''|*[!a-f0-9]*) return 1 ;; esac
            [ "${#1}" -eq 48 ]
            ;;
    esac
}

private_control_file() {
    control_path=$1
    [ -f "$control_path" ] && [ ! -L "$control_path" ] && [ -r "$control_path" ] || return 1
    # One stat, not one per field. This runs on every control-file read and on
    # every admission, and a second command substitution here is a second fork
    # and a second busybox exec for metadata the first call already returned.
    # The mtime rides along for control_file_expired below; it is cleared on
    # entry so a caller can never read it after a rejected file.
    control_mtime=
    control_metadata=$(stat -c '%a %u %Y' "$control_path" 2>/dev/null || true)
    control_mode=${control_metadata%% *}
    control_metadata_rest=${control_metadata#* }
    control_owner=${control_metadata_rest%% *}
    control_mtime=${control_metadata_rest#* }
    [ "$control_mode" = 600 ] && [ -n "$path_owner" ] && [ "$control_owner" = "$path_owner" ]
}

control_file_expired() {
    expiry_path=$1
    expiry_now=$2
    expiry_max_age=$3
    # Mode, owner and mtime come from the single stat above, so the age is
    # judged against the same sample the privacy check accepted.
    private_control_file "$expiry_path" || return 1
    expiry_mtime=$control_mtime
    case $expiry_mtime in ''|*[!0-9]*) return 1 ;; esac
    [ "$expiry_mtime" -le "$expiry_now" ] || return 1
    [ $((expiry_now - expiry_mtime)) -gt "$expiry_max_age" ]
}

prune_expired_control_files() {
    load_security_policy_runtime
    prune_now=$(epoch_now)
    case $prune_now in ''|*[!0-9]*) return 0 ;; esac
    for prune_dir in "$control_requests" "$control_processing" "$control_responses" "$control_progress"; do
        case $prune_dir in
            "$control_requests") prune_max_age=86400; prune_kind=request; prune_level=debug ;;
            # A claim this old means the consumer that held it is gone. That is
            # the one expiry an operator needs to see, because it is the only
            # one that describes work which was started and never accounted
            # for; the rest are ordinary housekeeping.
            "$control_processing") prune_max_age=3600; prune_kind=processing_indeterminate; prune_level=warn ;;
            # Progress records are advisory and are only ever read for a job
            # still reported as pending, so a record outliving its job is
            # unreadable rather than wrong. Reclaiming it by age is what keeps
            # the directory bounded when nothing published a result at all --
            # the case no writer can clean up after itself.
            "$control_progress") prune_max_age=3600; prune_kind=progress; prune_level=debug ;;
            *) prune_max_age=$security_runtime_result_retention; prune_kind=response; prune_level=debug ;;
        esac
        for prune_path in "$prune_dir"/*.json "$prune_dir"/*.secret; do
            [ -e "$prune_path" ] || [ -L "$prune_path" ] || continue
            prune_name=${prune_path##*/}
            case $prune_name in *.json) prune_id=${prune_name%.json} ;; *.secret) prune_id=${prune_name%.secret} ;; *) continue ;; esac
            valid_control_file_id "$prune_id" "$prune_kind" || continue
            if control_file_expired "$prune_path" "$prune_now" "$prune_max_age"; then
                rm -f "$prune_path"
                controller_log_event "$prune_level" control_file_expired "id=$prune_id kind=$prune_kind"
            fi
        done
    done
}

# Publish a terminal result for a claimed job whose consumer resolved nothing.
#
# Every exit from the queue loop below that deletes a processing request without
# a published response leaves the operator with "unresolved", which the
# dashboard cannot tell apart from a request that was never accepted -- so a job
# that failed for a knowable reason and a job that never existed read the same.
# This is the mechanism the secret-claim rejection already uses, with the cause
# attached: the native side owns the job document, the audit transaction and the
# response schema, so it supplies the operation and the envelope, and the
# controller supplies the two things only it knows -- why the consumer stopped,
# and with what status.
#
# One exec, the same as the rejection it copies. The --reject-job fallback costs
# a second only against a bridge that predates --fail-job, and it is reached by
# asking whether a response exists rather than by reading an exit status,
# because a bridge that does not recognise the mode may decline it either way.
# The answer is that same question, so a caller can never record a terminal
# result that was not actually written.
publish_control_failure() {
    failure_request=$1
    failure_response=$2
    failure_cause=$3
    failure_exit=$4
    failure_publish_exit=0
    "$api_bridge" --fail-job "$failure_request" "$failure_response" \
        "$failure_cause" "$failure_exit" >/dev/null 2>&1 || failure_publish_exit=$?
    # 75 is the bridge refusing on the outcome-unknown rule, and it wrote
    # nothing on purpose. The generic rejection below has no such rule, so
    # falling back to it here would publish the exact document the refusal
    # exists to withhold. Unreachable while the post-dispatch caller is gated
    # on the job class; kept so that the gate is not the only thing between a
    # dead serialized consumer and a false terminal verdict.
    [ "$failure_publish_exit" -ne 75 ] || return 75
    # Asked once, and the answer is the return value. A response that is simply
    # absent costs nothing to rule out -- the existence test in
    # private_control_file settles it before the stat -- so the whole check is
    # one exec on the path that wrote something and none on the path that
    # did not.
    if private_control_file "$failure_response"; then
        return 0
    fi
    "$api_bridge" --reject-job "$failure_request" "$failure_response" >/dev/null 2>&1 \
        || failure_publish_exit=$?
    private_control_file "$failure_response"
}

process_control_queue() {
    interactive_only=${1:-false}
    reconcile_audit_outbox || {
        controller_log_event error audit_reconcile_failed "phase=queue_turn" controller true >/dev/null 2>&1 || true
        return 73
    }
    # A nested auxiliary turn runs while a primary child may still own a
    # processing request and secret. Never age-prune that active claim from the
    # nested turn; primary controller turns retain the bounded cleanup policy.
    [ "$interactive_only" = true ] || prune_expired_control_files
    [ -x "$api_bridge" ] && [ ! -L "$api_bridge" ] || return 0
    # The authenticated bridge generates lexically sortable server job IDs with
    # a persisted monotonic prefix.  Shell glob order therefore remains FIFO
    # even on DSM filesystems whose mtimes are only second-resolution.
    for queued_request in "$control_requests"/*.json; do
        [ -e "$queued_request" ] || [ -L "$queued_request" ] || continue
        queued_name=${queued_request##*/}
        queued_id=${queued_name%.json}
        if ! valid_request_id "$queued_id" || ! private_control_file "$queued_request"; then
            controller_log_event warn control_request_rejected "file=$queued_name"
            continue
        fi
        queued_size=$(wc -c < "$queued_request" | tr -d ' ')
        case $queued_size in ''|*[!0-9]*) queued_size=65537 ;; esac
        if [ "$queued_size" -gt 65536 ]; then
            controller_log_event warn control_request_rejected "id=$queued_id reason=size"
            continue
        fi
        processing_request=$control_processing/$queued_name
        [ ! -e "$processing_request" ] && [ ! -L "$processing_request" ] || {
            controller_log_event warn control_request_collision "id=$queued_id"
            [ "$interactive_only" = true ] && break
            continue
        }
        queued_classification=unknown
        # Distinct from the classification itself. "unknown" is what the
        # scheduler assumes when it has no answer, and it assumes the strictest
        # one; whether an answer was ever given is a different question, and it
        # is the one that decides afterwards whether a failure can be described
        # exactly or only reported as unknown.
        queued_classified=false
        queued_operation=
        queued_terminal_cause=
        queued_terminal_exit=0
        set +e
        classification_output=$("$api_bridge" --classify-queued-job "$queued_id")
        classification_exit=$?
        set -e
        if [ "$classification_exit" -eq 0 ]; then
            # The classifier may name the operation after the class. Taking it
            # here is what lets a consumer failure say which operation died
            # without the controller parsing the job itself: the one fork this
            # needs has already happened, and parsing the job would add another
            # to every admission. A bridge that prints the class alone leaves
            # the operation unnamed, which is exactly today's behaviour.
            queued_operation=${classification_output#* }
            [ "$queued_operation" != "$classification_output" ] || queued_operation=
            case $queued_operation in *[!a-z-]*) queued_operation= ;; esac
            case ${classification_output%% *} in
                connection|concurrent|serialized)
                    queued_classification=${classification_output%% *}
                    queued_classified=true
                    ;;
                *) classification_exit=73 ;;
            esac
        fi
        if [ "$interactive_only" = true ]; then
            if [ "$classification_exit" -ne 0 ]; then
                # Retryable by construction, and that is why only the primary
                # turn ever terminalizes a job it could not classify. The
                # request is still in requests/, so the next primary turn asks
                # again; a classifier that failed because it was momentarily
                # out of memory or out of processes therefore costs a turn
                # rather than the job. Warn, not error: this one is expected to
                # be answered by the retry.
                controller_log_event warn control_request_classification_failed "id=$queued_id exit=$classification_exit turn=auxiliary"
                break
            fi
            # What this turn may claim depends on what the primary worker
            # is, because the two adjacencies are not the same risk.
            #
            # Beside a runner it stays exactly what it always was: a bounded
            # connection probe. A sync commits files, and a configuration
            # mutation must not interleave with one.
            #
            # Beside a *concurrent* primary it also admits a serialized head.
            # A concurrent job is, by the classifier's own definition, one that
            # commits no profile, credential, policy or scheduler state, so a
            # serialized job beside it still cannot interleave with another
            # committer -- which is the property serialization exists to hold.
            # Without this the dashboard's own status walk owns the only work
            # slot for as long as comparing both trees takes, and a profile
            # save queued behind it waits out the AppWindow's terminal-result
            # window and is reported to the operator as an unknown outcome:
            # a save that did land, described as one that might not have.
            #
            # The head is still classified exactly and never reordered, and a
            # concurrent head is still a barrier, so two of them never overlap.
            case $queued_classification in
                connection) ;;
                serialized)
                    [ "$active_control_classification" = concurrent ] || break
                    ;;
                concurrent) break ;;
            esac
        elif [ "$classification_exit" -ne 0 ]; then
            # The primary turn is the one that already retried, so this is the
            # end of the line. Today it dispatches the job anyway, under the
            # strictest class, to a consumer that will parse exactly the
            # document the classifier could not -- and when that consumer
            # declines it, nothing is published and the request reads as one
            # that was never accepted. Claiming it and saying so is both more
            # useful and more accurate: a job that could not be described was
            # never scheduled, so nothing it might have committed is in doubt.
            controller_log_event error control_request_classification_failed "id=$queued_id exit=$classification_exit turn=primary"
            queued_terminal_cause=classification_failed
            queued_terminal_exit=$classification_exit
        fi
        if ! mv "$queued_request" "$processing_request"; then
            # A claim that cannot be taken leaves the request exactly where it
            # was, for the next turn. It was the one queue exit with no record
            # of any kind, so a request that could never be claimed stayed
            # pending with nothing anywhere to say why.
            controller_log_event warn control_request_claim_failed "id=$queued_id"
            [ "$interactive_only" = true ] && break
            continue
        fi
        control_queue_progress=true
        response_final=$control_responses/$queued_id.json
        [ ! -e "$response_final" ] && [ ! -L "$response_final" ] || {
            controller_log_event error control_response_rejected "id=$queued_id"
            rm -f "$processing_request"
            queued_secret=$control_requests/$queued_id.secret
            processing_secret=$control_processing/$queued_id.secret
            rm -f "$queued_secret" "$processing_secret" 2>/dev/null || true
            [ "$interactive_only" = true ] && break
            continue
        }
        queued_secret=$control_requests/$queued_id.secret
        processing_secret=$control_processing/$queued_id.secret
        secret_claim_failed=false
        if [ -e "$queued_secret" ] || [ -L "$queued_secret" ]; then
            if private_control_file "$queued_secret" && [ ! -e "$processing_secret" ] && [ ! -L "$processing_secret" ]; then
                mv "$queued_secret" "$processing_secret" || secret_claim_failed=true
            else
                secret_claim_failed=true
            fi
        fi
        # The package framework exposes @appdata through this stable alias even
        # when SYNOPKG_PKGVAR names its physical /volume*/@appdata location.
        # The native consumer deliberately accepts only these lexical parents;
        # keep the controller's own file operations on the physical paths but
        # cross the executable trust boundary through the framework aliases.
        consumer_processing_request=$package_base/var/control/processing/$queued_name
        consumer_response_final=$package_base/var/control/responses/$queued_id.json
        if [ "$secret_claim_failed" = true ]; then
            controller_log_event error control_secret_rejected "id=$queued_id reason=claim_failed"
            queued_terminal_cause=secret_claim_failed
            queued_terminal_exit=0
        fi
        if [ -n "$queued_terminal_cause" ]; then
            # The native rejection path parses the immutable job, finalizes its
            # audit transaction, and publishes an exact terminal failure without
            # invoking the profile manager or exposing the sidecar value.
            #
            # Both causes that reach here are refusals to schedule: no consumer
            # was started, so no part of the operation can have run, and the
            # failure is exact rather than a verdict on work nobody watched.
            if publish_control_failure "$consumer_processing_request" "$consumer_response_final" \
                "$queued_terminal_cause" "$queued_terminal_exit"; then
                controller_log_event debug control_request_rejected_terminal "id=$queued_id cause=$queued_terminal_cause"
            else
                # The last silence the controller cannot fill. Writing the
                # response is the bridge's to do -- the schema needs the job's
                # own session binding and audit transaction, which this layer
                # deliberately never reads -- so when that fails, the exit
                # status is all there is to hand the operator.
                controller_log_event error control_request_rejection_failed "id=$queued_id cause=$queued_terminal_cause exit=$failure_publish_exit"
            fi
            rm -f "$queued_secret" "$processing_secret" "$processing_request" 2>/dev/null || true
            break
        fi
        controller_log_event trace control_request_dispatched "id=$queued_id"
        launched_control_slot=active
        [ "$interactive_only" = true ] && launched_control_slot=control
        if ! launch_admitted_child "$launched_control_slot" control \
            "$api_bridge" --consume-job "$consumer_processing_request" "$consumer_response_final"; then
            [ "$admitted_child_status" != cancelled ] || return 0
            controller_log_event error child_identity_capture_failed "kind=control"
            return 73
        fi
        launched_control_pid=$admitted_child_pid
        if [ "$interactive_only" != true ]; then
            active_control_classification=$queued_classification
        fi
        # TERM can be delivered after the asynchronous launch but before either
        # assignment above. Recheck the latched shutdown state so that window
        # cannot strand an un-signalled consumer before it creates a run lock.
        if [ "$shutdown" = true ]; then
            stop_work_children_bounded
        fi
        controller_state_child=$launched_control_pid
        [ -z "$active_pid" ] || controller_state_child=$active_pid
        write_controller_state running "$$" "$next_run" "$controller_state_child"
        if [ "$interactive_only" = true ]; then
            wait_for_control_consumer
            control_exit=$control_wait_exit
        else
            # `wait_for_runner` may service an auxiliary queue turn while
            # this primary consumer remains active. Shell variables are global,
            # so preserve the primary claim before entering that nested turn.
            primary_control_queued_id=$queued_id
            primary_control_response_final=$response_final
            primary_control_processing_request=$processing_request
            primary_control_processing_secret=$processing_secret
            primary_control_interactive_only=$interactive_only
            # The class, whether it was ever established, the operation name and
            # the two framework-alias paths are now read after the wait as well
            # as before it, so they join the claim above. A nested turn assigns
            # every one of them for its own job; restoring only the first five
            # would describe this consumer's failure using the other's identity.
            primary_control_classification=$queued_classification
            primary_control_classified=$queued_classified
            primary_control_operation=$queued_operation
            primary_consumer_processing_request=$consumer_processing_request
            primary_consumer_response_final=$consumer_response_final
            wait_for_runner
            control_exit=$scheduled_exit
            queued_id=$primary_control_queued_id
            response_final=$primary_control_response_final
            processing_request=$primary_control_processing_request
            processing_secret=$primary_control_processing_secret
            interactive_only=$primary_control_interactive_only
            queued_classification=$primary_control_classification
            queued_classified=$primary_control_classified
            queued_operation=$primary_control_operation
            consumer_processing_request=$primary_consumer_processing_request
            consumer_response_final=$primary_consumer_response_final
        fi
        # One stat, not two. Whether a result was published is the question this
        # block asks three times over -- to judge the consumer, to decide
        # whether anything may be written, and to record what happened -- and it
        # cannot change between them: the same process asks, with no file
        # operation in between. Sampling it once is also what lets the answer be
        # used below, where re-asking would be a fork on every completed job.
        response_published=false
        response_size=0
        if private_control_file "$response_final"; then
            response_published=true
            response_size=$(wc -c < "$response_final" | tr -d ' ')
        fi
        case $response_size in ''|*[!0-9]*) response_size=1048577 ;; esac
        if [ "$control_exit" -ne 0 ] || [ "$response_published" = false ] || [ "$response_size" -gt 1048576 ]; then
            controller_log_event error control_consumer_failed "id=$queued_id op=${queued_operation:-unknown} exit=$control_exit"
            if [ "$response_published" = true ]; then
                # The consumer published its own account of what happened.
                # Whether it then exited badly, or wrote more than the bridge
                # will read back, replacing that document with a verdict formed
                # out here would overwrite the only first-hand record there is.
                :
            elif [ "$queued_classified" = true ] && [ "$queued_classification" != serialized ]; then
                # Nothing was published, and the class the bridge itself
                # assigned says this job commits no profile, credential, policy
                # or scheduler state. "It failed" is therefore the whole truth
                # rather than a guess about half-committed work, and the
                # operator gets the reason instead of a request that reads as
                # one the package never accepted. This is the case the user
                # actually hits: every slow operation -- the status walk,
                # Doctor, run, plan, resync -- is in this class.
                if [ "$control_exit" -eq 0 ]; then
                    consumer_cause=consumer_wrote_no_result
                else
                    consumer_cause=consumer_failed
                fi
                if publish_control_failure "$consumer_processing_request" "$consumer_response_final" \
                    "$consumer_cause" "$control_exit"; then
                    controller_log_event debug control_request_rejected_terminal "id=$queued_id cause=$consumer_cause"
                else
                    controller_log_event error control_request_rejection_failed "id=$queued_id cause=$consumer_cause exit=$failure_publish_exit"
                fi
            else
                # A serialized job may have committed part of a configuration
                # mutation before it died, and one that was never classified was
                # never described at all. Publishing a failure here would turn
                # an outcome nobody knows into one the dashboard claims to know,
                # and it would do it by overwriting the evidence: a response
                # makes the audit outbox adopt that verdict, where finding none
                # beside a dead owner is exactly what makes it record
                # outcome_unknown. So this stays unresolved on purpose, and the
                # line below is what links the request to the reconciliation.
                controller_log_event warn control_consumer_outcome_unknown "id=$queued_id op=${queued_operation:-unknown} exit=$control_exit class=$queued_classification"
            fi
        else
            controller_log_event debug control_consumer_completed "id=$queued_id"
        fi
        rm -f "$processing_request"
        if [ -e "$processing_secret" ] && [ ! -L "$processing_secret" ]; then rm -f "$processing_secret"; fi
        # Consume one bounded request per controller turn so normal schedules and
        # shutdown signals cannot be starved by a dashboard client.
        break
    done
    reconcile_audit_outbox || {
        controller_log_event error audit_reconcile_failed "phase=before_response_prune" controller true >/dev/null 2>&1 || true
        return 73
    }
    [ "$interactive_only" = true ] && return 0
    response_count=0
    for old_response in "$control_responses"/*.json; do
        [ -e "$old_response" ] || [ -L "$old_response" ] || continue
        old_name=${old_response##*/}; old_id=${old_name%.json}
        valid_request_id "$old_id" || continue
        private_control_file "$old_response" || continue
        response_count=$((response_count + 1))
    done
    responses_to_remove=$((response_count - security_runtime_max_outstanding))
    [ "$responses_to_remove" -gt 0 ] || return 0
    for old_response in "$control_responses"/*.json; do
        [ "$responses_to_remove" -gt 0 ] || break
        [ -e "$old_response" ] || [ -L "$old_response" ] || continue
        old_name=${old_response##*/}; old_id=${old_name%.json}
        valid_request_id "$old_id" && private_control_file "$old_response" || continue
        rm -f "$old_response"
        responses_to_remove=$((responses_to_remove - 1))
    done
}

stop_realtime_watchers() {
    # Every TERMed watcher is a direct child of this shell and nothing reaps
    # them: there is no SIGCHLD trap and no bare wait anywhere, so an unreaped
    # watcher stays a zombie for the controller's whole lifetime. Collect the
    # pids here and wait for them once the loop has signalled all of them.
    realtime_reap_pids=
    for watcher_pid_file in "$runtime_root"/watch-*.pid; do
        [ -f "$watcher_pid_file" ] && [ ! -L "$watcher_pid_file" ] || continue
        watcher_stop_profile=${watcher_pid_file##*/}
        watcher_stop_profile=${watcher_stop_profile#watch-}
        watcher_stop_profile=${watcher_stop_profile%.pid}
        case $watcher_stop_profile in
            ''|*[!A-Za-z0-9_-]*) rm -f "$watcher_pid_file"; continue ;;
        esac
        terminate_realtime_watcher "$watcher_stop_profile"
    done
    for watcher_events in "$runtime_root"/watch-*.events; do
        [ -f "$watcher_events" ] && [ ! -L "$watcher_events" ] && rm -f "$watcher_events" || true
    done
    for watcher_failure in "$runtime_root"/watch-*.failed; do
        [ -f "$watcher_failure" ] && [ ! -L "$watcher_failure" ] && rm -f "$watcher_failure" || true
    done
    for watcher_source_record in "$runtime_root"/watch-*.source; do
        [ -f "$watcher_source_record" ] && [ ! -L "$watcher_source_record" ] && rm -f "$watcher_source_record" || true
    done
    for watcher_stderr_record in "$runtime_root"/watch-*.stderr; do
        [ -f "$watcher_stderr_record" ] && [ ! -L "$watcher_stderr_record" ] && rm -f "$watcher_stderr_record" || true
    done
    reap_realtime_watchers
}

# Accept a much weaker identity than pid_matches_command, and only ever to
# stop a process. Uninstalling inotify-tools empties $inotify_command, and the
# strong check then refuses every live watcher, so nothing could kill the one
# still holding watches on the source. Live, package-owned and argv[0] named
# inotifywait is enough to send a signal; it is never enough to report a
# backend as healthy.
realtime_watcher_is_stoppable() {
    stoppable_pid=$1
    pid_is_live "$stoppable_pid" || return 1
    [ -n "${path_owner:-}" ] || return 1
    stoppable_uid=$(sed -n 's/^Uid:[[:space:]]*\([0-9][0-9]*\).*/\1/p' \
        "/proc/$stoppable_pid/status" 2>/dev/null | sed -n '1p')
    [ "$stoppable_uid" = "$path_owner" ] || return 1
    stoppable_argv_zero=$(tr '\000' '\n' < "/proc/$stoppable_pid/cmdline" 2>/dev/null | sed -n '1p')
    [ -n "$stoppable_argv_zero" ] || return 1
    [ "${stoppable_argv_zero##*/}" = inotifywait ]
}

terminate_realtime_watcher() {
    terminate_profile=$1
    terminate_pid_path=$runtime_root/watch-$terminate_profile.pid
    [ -f "$terminate_pid_path" ] && [ ! -L "$terminate_pid_path" ] || return 0
    terminate_pid=$(read_pid "$terminate_pid_path" 2>/dev/null || true)
    if [ -n "$terminate_pid" ] && realtime_watcher_is_stoppable "$terminate_pid"; then
        kill -TERM "$terminate_pid" 2>/dev/null || true
        # A watcher left stopped by a controller that died inside the
        # STOP/CONT window never runs its pending TERM handler, and the wait
        # below would then block until the sleep child's ALRM guard fires.
        kill -CONT "$terminate_pid" 2>/dev/null || true
        realtime_reap_pids="${realtime_reap_pids:-} $terminate_pid"
    fi
    rm -f "$terminate_pid_path"
}

# Reap the watchers stop_realtime_watchers signalled. This matters on the reload
# path, where the controller lives on: a dashboard Save stops every watcher, so
# without a reap each Save would leave one zombie per routine for the rest of the
# controller's life.
#
# A bare wait cannot do it. wait on a live child is unbounded, and this also runs
# from cleanup_controller on every shutdown, so a watcher slow to act on its TERM
# -- or one that ignores it -- would hold DSM package stop open past its
# ten-second deadline. Poll for the signalled set to stop running, then escalate
# to KILL, and only then wait: by that point each child is a zombie or gone, and
# SIGKILL cannot be ignored, so no wait here can block.
#
# The grace is three seconds for the whole set rather than per watcher, the same
# shape and the same budget stop_work_children_bounded uses for the work
# children, so the bound does not scale with the number of routines. In the
# ordinary case it costs nothing: TERM-to-exit is microseconds and the record
# cleanup in stop_realtime_watchers already runs between the signal and this
# call, so the first probe normally sees Z and breaks without sleeping.
reap_realtime_watchers() {
    [ -n "${realtime_reap_pids:-}" ] || { realtime_reap_pids=; return 0; }
    realtime_reap_grace=0
    while [ "$realtime_reap_grace" -lt 3 ]; do
        realtime_reap_live=false
        for realtime_reap_pid in $realtime_reap_pids; do
            realtime_reap_state=
            read_process_stat_fields "$realtime_reap_pid" && \
                realtime_reap_state=$process_stat_state
            case $realtime_reap_state in ''|Z|X|x) ;; *) realtime_reap_live=true ;; esac
        done
        [ "$realtime_reap_live" = true ] || break
        /bin/sleep 1
        realtime_reap_grace=$((realtime_reap_grace + 1))
    done
    for realtime_reap_pid in $realtime_reap_pids; do
        realtime_reap_state=
        read_process_stat_fields "$realtime_reap_pid" && \
            realtime_reap_state=$process_stat_state
        case $realtime_reap_state in
            ''|Z|X|x) ;;
            *) kill -KILL "$realtime_reap_pid" 2>/dev/null || true ;;
        esac
        wait "$realtime_reap_pid" 2>/dev/null || true
    done
    realtime_reap_pids=
}

# epoch consecutive reason, one line, each field validated on its own. The
# pre-upgrade record is a bare epoch and reads as one attempt, so the format is
# safe in both directions; the former parser would have taken a multi-field
# line as non-numeric and reset the epoch to 0, retrying immediately.
read_realtime_watcher_failure() {
    watcher_failed_epoch=0
    watcher_failed_consecutive=1
    watcher_failed_reason=watch_setup_failed
    watcher_failed_old_ifs=$IFS
    IFS=' '
    read -r watcher_failed_field_epoch watcher_failed_field_count watcher_failed_field_reason \
        < "$1" || { IFS=$watcher_failed_old_ifs; return 1; }
    IFS=$watcher_failed_old_ifs
    case ${watcher_failed_field_epoch:-} in
        ''|*[!0-9]*) watcher_failed_epoch=0 ;;
        *) watcher_failed_epoch=$watcher_failed_field_epoch ;;
    esac
    case ${watcher_failed_field_count:-} in
        ''|*[!0-9]*|0) watcher_failed_consecutive=1 ;;
        *) watcher_failed_consecutive=$watcher_failed_field_count ;;
    esac
    [ "$watcher_failed_consecutive" -le 5 ] 2>/dev/null || watcher_failed_consecutive=5
    case ${watcher_failed_field_reason:-} in
        watch_limit|watch_setup_failed) watcher_failed_reason=$watcher_failed_field_reason ;;
        *) watcher_failed_reason=watch_setup_failed ;;
    esac
}

record_realtime_watcher_failure() {
    failure_profile=$1
    failure_reason=$2
    failure_path=$runtime_root/watch-$failure_profile.failed
    realtime_watcher_failure_consecutive=1
    if [ -f "$failure_path" ] && [ ! -L "$failure_path" ]; then
        read_realtime_watcher_failure "$failure_path" || true
        realtime_watcher_failure_consecutive=$((watcher_failed_consecutive + 1))
        [ "$realtime_watcher_failure_consecutive" -le 5 ] || realtime_watcher_failure_consecutive=5
    fi
    failure_epoch=$(epoch_now)
    case $failure_epoch in ''|*[!0-9]*) return 69 ;; esac
    printf '%s %s %s\n' "$failure_epoch" "$realtime_watcher_failure_consecutive" "$failure_reason" \
        > "$failure_path" || return 69
    finish_private_file "$failure_path" || return 69
}

ensure_realtime_watcher() {
    watcher_profile=$1
    watcher_source=$2
    realtime_backend=polling
    realtime_watcher_pid=
    realtime_watcher_reason=watch_unavailable
    [ -n "${inotify_command:-}" ] || return 0
    watcher_pid_path=$runtime_root/watch-$watcher_profile.pid
    watcher_event_path=$runtime_root/watch-$watcher_profile.events
    watcher_failure_path=$runtime_root/watch-$watcher_profile.failed
    watcher_source_path=$runtime_root/watch-$watcher_profile.source
    watcher_stderr_path=$runtime_root/watch-$watcher_profile.stderr
    [ ! -L "$watcher_pid_path" ] && [ ! -L "$watcher_event_path" ] && [ ! -L "$watcher_failure_path" ] \
        && [ ! -L "$watcher_source_path" ] && [ ! -L "$watcher_stderr_path" ] || return 73
    watcher_existing=$(read_pid "$watcher_pid_path" 2>/dev/null || true)
    if [ -n "$watcher_existing" ] && pid_matches_command "$watcher_existing" "$inotify_command"; then
        # pid_matches_command deliberately never looks at the watched
        # directory: it also verifies the API bridge's parent, and teaching it
        # about watcher arguments would put that logic on the bridge path. The
        # watched path is recorded beside the pid file instead, so a profile
        # whose source changed cannot keep reporting inotify on the old tree.
        watcher_adopt_refusal=
        if [ ! -f "$watcher_source_path" ] || [ ! -r "$watcher_source_path" ]; then
            watcher_adopt_refusal=unmatched
        elif ! IFS= read -r watcher_recorded_source < "$watcher_source_path"; then
            watcher_adopt_refusal=unmatched
        elif [ "$watcher_recorded_source" != "$watcher_source" ]; then
            watcher_adopt_refusal=stale_source
        elif sed -n 's/^State:[[:space:]]*\([Tt]\).*/\1/p' \
            "/proc/$watcher_existing/status" 2>/dev/null | grep -Eq '^[Tt]$'; then
            # A watcher still stopped from an interrupted consume raises no
            # further events. Adopting it would report a healthy native
            # backend for a routine nothing is observing.
            watcher_adopt_refusal=stopped
        fi
        if [ -z "$watcher_adopt_refusal" ]; then
            # A watcher that is live, matched and watching the right tree is the
            # only evidence that clears the failure history; without this the
            # count would carry across a recovery and abandon a healthy routine.
            rm -f "$watcher_failure_path"
            realtime_backend=inotify
            realtime_watcher_pid=$watcher_existing
            realtime_watcher_reason=ok
            return 0
        fi
        controller_log_event warn routine_watch_orphaned \
            "profile=$watcher_profile pid=$watcher_existing reason=$watcher_adopt_refusal" || true
        kill -TERM "$watcher_existing" 2>/dev/null || true
        kill -CONT "$watcher_existing" 2>/dev/null || true
        realtime_reap_pids="${realtime_reap_pids:-} $watcher_existing"
        rm -f "$watcher_pid_path" "$watcher_source_path"
        reap_realtime_watchers
        [ "$watcher_adopt_refusal" != stopped ] || realtime_watcher_reason=watch_stopped
    fi
    if [ -f "$watcher_pid_path" ]; then
        # The pid file outlived the watcher it named. inotifywait reports the
        # reason on stderr and exits 1 even under -q, so the private stderr
        # file is the only place the operator's real message survives; ENOSPC
        # from the watch limit reads as "No space left on device".
        watcher_dead_detail=
        if [ -f "$watcher_stderr_path" ] && [ ! -L "$watcher_stderr_path" ] && [ -s "$watcher_stderr_path" ]; then
            watcher_dead_detail=$(LC_ALL=C awk \
                'NR == 1 { gsub(/[^ -~]/, "?"); print substr($0, 1, 120); exit }' \
                "$watcher_stderr_path" 2>/dev/null || true)
        fi
        rm -f "$watcher_pid_path" "$watcher_source_path"
        record_realtime_watcher_failure "$watcher_profile" watch_setup_failed || true
        controller_log_event warn routine_watch_failed \
            "profile=$watcher_profile consecutive=$realtime_watcher_failure_consecutive detail=$watcher_dead_detail" || true
        realtime_watcher_reason=watch_setup_failed
        if [ "$realtime_watcher_failure_consecutive" -ge 5 ]; then
            controller_log_event error routine_watch_abandoned \
                "profile=$watcher_profile consecutive=$realtime_watcher_failure_consecutive" || true
            realtime_backend=none
        fi
        return 0
    fi
    if [ -f "$watcher_failure_path" ]; then
        read_realtime_watcher_failure "$watcher_failure_path" || true
        realtime_watcher_reason=$watcher_failed_reason
        if [ "$watcher_failed_consecutive" -ge 5 ]; then
            # A watch-limit or permission failure is a configuration fact, not
            # a transient. Re-walking a large tree every 300 s forever is the
            # second-largest CPU sink after the poll itself, so stop until a
            # reload or a routine save clears the record.
            realtime_backend=none
            return 0
        fi
        watcher_cooldown=300
        watcher_cooldown_index=1
        while [ "$watcher_cooldown_index" -lt "$watcher_failed_consecutive" ]; do
            watcher_cooldown=$((watcher_cooldown * 2))
            if [ "$watcher_cooldown" -ge 3600 ]; then watcher_cooldown=3600; break; fi
            watcher_cooldown_index=$((watcher_cooldown_index + 1))
        done
        watcher_now=$(epoch_now)
        case $watcher_now in ''|*[!0-9]*) return 0 ;; esac
        if [ "$watcher_failed_epoch" -le "$watcher_now" ] \
            && [ $((watcher_now - watcher_failed_epoch)) -lt "$watcher_cooldown" ]; then
            return 0
        fi
        # The cooldown has expired, so retry -- but keep the attempt count,
        # because it is what the give-up threshold counts. Removing the record
        # here is what would make the ladder never advance past its first rung.
        # Stamping this attempt's epoch is what stops a spawn that fails again
        # from being retried on the very next five-second turn.
        printf '%s %s %s\n' "$watcher_now" "$watcher_failed_consecutive" "$watcher_failed_reason" \
            > "$watcher_failure_path" || return 0
        finish_private_file "$watcher_failure_path" || return 0
    fi
    # Refuse before spawning when the source cannot fit in the shared watch
    # budget. inotifywait would otherwise walk the whole tree, fail with
    # ENOSPC, and be retried on every cooldown. The 80 % margin leaves room
    # for the watches DSM's own services hold against the same per-user limit.
    watcher_limit=
    if [ -f "$inotify_watch_limit_path" ] && [ ! -L "$inotify_watch_limit_path" ]; then
        IFS= read -r watcher_limit < "$inotify_watch_limit_path" || watcher_limit=
        case ${watcher_limit:-} in ''|*[!0-9]*|0) watcher_limit= ;; esac
    fi
    if [ -n "$watcher_limit" ]; then
        watcher_directory_count=$(find "$watcher_source" -type d 2>/dev/null | wc -l | tr -d ' ')
        case ${watcher_directory_count:-} in ''|*[!0-9]*) watcher_directory_count= ;; esac
        if [ -n "$watcher_directory_count" ] \
            && [ "$watcher_directory_count" -gt $((watcher_limit / 10 * 8)) ]; then
            controller_log_event warn routine_watch_limit \
                "profile=$watcher_profile dirs=$watcher_directory_count limit=$watcher_limit" || true
            record_realtime_watcher_failure "$watcher_profile" watch_limit || true
            realtime_watcher_reason=watch_limit
            if [ "$realtime_watcher_failure_consecutive" -ge 5 ]; then
                controller_log_event error routine_watch_abandoned \
                    "profile=$watcher_profile consecutive=$realtime_watcher_failure_consecutive" || true
                realtime_backend=none
            fi
            return 0
        fi
    fi
    : > "$watcher_event_path"
    finish_private_file "$watcher_event_path"
    : > "$watcher_stderr_path"
    finish_private_file "$watcher_stderr_path"
    printf '%s\n' "$watcher_source" > "$watcher_source_path"
    finish_private_file "$watcher_source_path"
    # The marker's content is never read: only its size, inode and mtime are.
    # The default output format therefore spends about 29 bytes per event, and
    # more as the watched path lengthens, on text nothing will ever parse, in a
    # file that grows unbounded for the whole debounce window. An empty format
    # still emits one newline per event, which is all realtime_event_due's
    # size-above-zero requirement needs. Measured: 1 200 events cost 35 180
    # bytes by default and 1 200 bytes this way.
    #
    # --format has been in inotify-tools since 3.x, so a build that rejects it
    # is roughly two decades old. If one exists, inotifywait exits 1 with its
    # usage text on stderr, which is the case the watch-failure ladder already
    # handles: routine_watch_failed carries the message as its detail,
    # routine_watch_abandoned fires after five attempts, and the source keeps
    # being observed by the poll, which runs either way.
    "$inotify_command" -m -q -r --format '' -e close_write,create,delete,move "$watcher_source" \
        >> "$watcher_event_path" 2>> "$watcher_stderr_path" &
    watcher_pid=$!
    printf '%s\n' "$watcher_pid" > "$watcher_pid_path"
    finish_private_file "$watcher_pid_path"
    realtime_backend=inotify
    realtime_watcher_pid=$watcher_pid
    realtime_watcher_reason=ok
}

# DSM does not ship inotify-tools, and the service environment's PATH is not
# where an operator's install of it ends up: SynoCommunity puts the binary under
# /var/packages, Entware under /opt, a manual build under /usr/local. Probe
# those after PATH so a routine configured for realtime is not silently demoted
# to polling on a NAS that does have a watcher.
#
# The chosen path is validated before it is trusted, in the same shape as every
# other executable identity this package accepts: a regular file, never a
# symlink, executable, owned by root or by the package, with no setuid/setgid
# bit and not writable by others.
resolve_inotify_command() {
    inotify_command=
    inotify_path_candidate=$(command -v inotifywait 2>/dev/null || true)
    for inotify_probe in "$inotify_path_candidate" /usr/local/bin/inotifywait \
        /opt/bin/inotifywait /var/packages/inotify-tools/target/bin/inotifywait; do
        [ -n "$inotify_probe" ] || continue
        case $inotify_probe in /*) ;; *) continue ;; esac
        [ -f "$inotify_probe" ] && [ ! -L "$inotify_probe" ] && [ -x "$inotify_probe" ] || continue
        inotify_probe_identity=$(stat -L -c '%u:%a' "$inotify_probe" 2>/dev/null || true)
        inotify_probe_owner=${inotify_probe_identity%%:*}
        inotify_probe_mode=${inotify_probe_identity#*:}
        case $inotify_probe_owner in ''|*[!0-9]*) continue ;; esac
        [ "$inotify_probe_owner" = 0 ] || [ "$inotify_probe_owner" = "${path_owner:-}" ] || continue
        # Exactly three octal digits rejects a setuid or setgid binary; the
        # last digit carrying the write bit rejects a world-writable one.
        case $inotify_probe_mode in
            [0-7][0-7][0-7]) ;;
            *) continue ;;
        esac
        case $inotify_probe_mode in *[2367]) continue ;; esac
        inotify_command=$inotify_probe
        break
    done
    # Deliberately no capability probe here. Asking the binary what it supports
    # means running it and reading its output to EOF, and a build that ignores
    # --help and keeps running would block this read forever, deadlocking
    # startup before readiness is published. That is a worse failure than the one
    # a probe would prevent, so the spawn path passes its flags unconditionally
    # and the watch-failure ladder reports any rejection.
    if [ -n "$inotify_command" ]; then
        inotify_command_detail=$(printf '%s\n' "$inotify_command" | LC_ALL=C awk \
            'NR == 1 { gsub(/[^ -~]/, "?"); print substr($0, 1, 120); exit }')
    else
        inotify_command_detail=none
    fi
    controller_log_event info realtime_watcher_command "path=$inotify_command_detail" || true
}

# Stop the native marker writer while comparing and consuming one exact event
# generation. Events raised while the writer is stopped remain queued by
# inotify and are appended after CONT, so a concurrent event cannot be erased
# by the truncate or bypass its own full debounce period.
#
# The literal 0 as the expected identity waives the generation match, and only
# that. It is reserved for the staleness ceiling, where the source is still
# being written and the marker's generation is expected to have moved between
# the due check and this call; no real identity can be 0 because a due event
# requires a non-empty file. The STOP, the procfs confirmation and the CONT are
# unchanged, so the proof that the writer cannot append during the truncate
# still holds. What is given up is the debounce claim, which is exactly what
# the ceiling exists to override.
consume_realtime_event() {
    consume_event_path=$1
    consume_watcher_pid=$2
    consume_expected_identity=$3
    realtime_event_watcher_resumed=true
    case $consume_watcher_pid in ''|*[!0-9]*) return 73 ;; esac
    case $consume_expected_identity in ''|*[!0-9:]*) return 73 ;; esac
    kill -STOP "$consume_watcher_pid" 2>/dev/null || return 73
    consume_event_status=0
    if ! pid_matches_command "$consume_watcher_pid" "$inotify_command"; then
        consume_event_status=73
    elif ! sed -n 's/^State:[[:space:]]*\([Tt]\).*/\1/p' \
        "/proc/$consume_watcher_pid/status" 2>/dev/null | grep -Eq '^[Tt]$'; then
        # STOP delivery is asynchronous. Do not inspect or truncate the marker
        # until procfs confirms that the writer can no longer append to it.
        consume_event_status=1
    elif [ -L "$consume_event_path" ] || [ ! -f "$consume_event_path" ] || [ ! -r "$consume_event_path" ]; then
        consume_event_status=73
    elif ! consume_actual_identity=$(stat -c '%i:%s:%Y' "$consume_event_path" 2>/dev/null); then
        consume_event_status=73
    else
        case $consume_actual_identity in
            ''|*[!0-9:]*) consume_event_status=73 ;;
            *)
                if [ "$consume_expected_identity" != 0 ] \
                    && [ "$consume_actual_identity" != "$consume_expected_identity" ]; then
                    consume_event_status=1
                elif ! : > "$consume_event_path"; then
                    consume_event_status=73
                elif ! finish_private_file "$consume_event_path"; then
                    consume_event_status=73
                fi
                ;;
        esac
    fi
    if ! kill -CONT "$consume_watcher_pid" 2>/dev/null; then
        realtime_event_watcher_resumed=false
        [ "$consume_event_status" -eq 0 ] || consume_event_status=73
    fi
    return "$consume_event_status"
}

source_fingerprint() (
    fingerprint_source=$1
    if ! command -v find >/dev/null 2>&1 || ! command -v sort >/dev/null 2>&1 ||
        ! command -v cksum >/dev/null 2>&1 || ! command -v awk >/dev/null 2>&1 ||
        ! command -v stat >/dev/null 2>&1; then
        return 69
    fi

    # BusyBox ash has no pipefail. Keep each stage in a private file and check
    # its status before the next stage so a failed find/stat/sort/cksum cannot
    # be mistaken for a valid fingerprint of partial input.
    fingerprint_attempt=0
    fingerprint_temp_dir=
    while [ "$fingerprint_attempt" -lt 32 ]; do
        fingerprint_candidate=$runtime_root/fingerprint.$$.$fingerprint_attempt
        if mkdir "$fingerprint_candidate" 2>/dev/null; then
            fingerprint_temp_dir=$fingerprint_candidate
            break
        fi
        fingerprint_attempt=$((fingerprint_attempt + 1))
    done
    [ -n "$fingerprint_temp_dir" ] || return 73
    chmod 700 "$fingerprint_temp_dir" || return 73
    fingerprint_metadata=$fingerprint_temp_dir/metadata
    fingerprint_stderr=$fingerprint_temp_dir/stderr
    fingerprint_sorted=$fingerprint_temp_dir/sorted
    fingerprint_checksum=$fingerprint_temp_dir/checksum
    fingerprint_cleanup() {
        rm -f "$fingerprint_metadata" "$fingerprint_stderr" \
            "$fingerprint_sorted" "$fingerprint_checksum" 2>/dev/null || true
        rmdir "$fingerprint_temp_dir" 2>/dev/null || true
    }
    trap fingerprint_cleanup 0 HUP INT TERM

    # One stat for the whole batch instead of one per file. The metadata is
    # byte-identical to the former per-file loop, so an upgrade keeps the
    # existing baseline instead of dispatching once on every realtime routine.
    # The prune list is the profile default exclude set: the walk used to spend
    # its forks on DSM thumbnail trees no sync can copy, and to fail outright
    # the moment one of them was mode 0000.
    #
    # find exits non-zero both for a directory it cannot search and for an
    # operand that vanished between readdir and stat. Telling those apart would
    # mean parsing locale- and version-dependent errno text, so distinguish them
    # by behaviour: retry the walk once. A rename or unlink race almost never
    # repeats on the same path; an unreadable directory always does.
    fingerprint_retries=0
    fingerprint_walk=1
    while :; do
        : > "$fingerprint_metadata" || return 73
        : > "$fingerprint_stderr" || return 73
        finish_private_file "$fingerprint_metadata" || return 73
        finish_private_file "$fingerprint_stderr" || return 73
        fingerprint_find_status=0
        find "$fingerprint_source" \
            \( -name '@eaDir' -o -name '#recycle' -o -name '#snapshot' -o -name '@tmp' \) -prune -o \
            -type f -exec stat -c '%n|%s|%Y' {} + > "$fingerprint_metadata" 2> "$fingerprint_stderr" \
            || fingerprint_find_status=$?
        [ "$fingerprint_find_status" -ne 0 ] || break
        # Nothing on stderr means the walk itself could not run, which is a
        # stage failure and not a subtree this poll simply could not read.
        [ -s "$fingerprint_stderr" ] || return 69
        if [ "$fingerprint_walk" -ge 2 ]; then
            LC_ALL=C awk 'NR == 1 { gsub(/[^ -~]/, "?"); print substr($0, 1, 120); exit }' \
                "$fingerprint_stderr" 2>/dev/null || true
            return 70
        fi
        fingerprint_retries=1
        fingerprint_walk=2
    done

    : > "$fingerprint_sorted" || return 73
    finish_private_file "$fingerprint_sorted" || return 73
    LC_ALL=C sort "$fingerprint_metadata" > "$fingerprint_sorted" || return 69

    : > "$fingerprint_checksum" || return 73
    finish_private_file "$fingerprint_checksum" || return 73
    cksum < "$fingerprint_sorted" > "$fingerprint_checksum" || return 69
    # One stdout line, retries|reading. The caller routes on the exit status: 0
    # with that shape, 70 with one sanitised stderr line for a walk that could
    # not read part of the tree, 69 for a stage failure, 73 for unsafe runtime
    # state.
    #
    # The reading carries the format that produced it. v2 is the pruned,
    # batched walk; without the tag, a baseline written by the former pipeline
    # would be compared against a reading taken over a different metadata set,
    # and every realtime routine whose source holds DSM's own excluded
    # directories would dispatch one sync on upgrade.
    awk -v fingerprint_walk_retries="$fingerprint_retries" '
        NR != 1 || NF != 2 || $1 !~ /^[0-9]+$/ || $2 !~ /^[0-9]+$/ { exit 1 }
        { fingerprint = $1 ":" $2 }
        END { if (NR != 1) exit 1; print fingerprint_walk_retries "|v2:" fingerprint }
    ' "$fingerprint_checksum"
)

# A reading this controller is willing to compare against. An unrecognised or
# absent prefix is not an error and not a corrupt state: it is a reading whose
# metadata set is unknown, which the poll treats exactly like a routine that has
# never been polled. none stays the never-polled marker and 0 the unset pending
# marker, and neither is accepted here.
valid_source_fingerprint() {
    case ${1:-} in
        v2:*) ;;
        *) return 1 ;;
    esac
    valid_fingerprint_body=${1#v2:}
    case $valid_fingerprint_body in
        ''|*[!0-9:]*) return 1 ;;
    esac
}

dependencies_allow() {
    dependency_list=$1
    [ -n "$dependency_list" ] || return 0
    dependency_old_ifs=$IFS; IFS=,
    for dependency_name in $dependency_list; do
        IFS=$dependency_old_ifs
        case $dependency_name in ''|*[!A-Za-z0-9_-]*) IFS=$dependency_old_ifs; return 1 ;; esac
        dependency_state_file=$profile_state_dir/$dependency_name.state
        [ -f "$dependency_state_file" ] && [ ! -L "$dependency_state_file" ] || { IFS=$dependency_old_ifs; return 1; }
        [ "$(setting "$dependency_state_file" state never)" = succeeded ] || { IFS=$dependency_old_ifs; return 1; }
        IFS=,
    done
    IFS=$dependency_old_ifs
}

# Fields are append-only. The manager and the in-process Rust reader both look
# each key up by name with a default, so a pre-upgrade document is read without
# complaint and an unknown extra field is ignored; reordering or inserting is
# what would break them. backend deliberately keeps its five-value enum and the
# reason for a degraded backend travels beside it in backend_reason.
write_routine_state() {
    routine_state_profile=$1
    routine_state_temp=$routine_state_dir/.${routine_state_profile}.state.$$
    # Every call site is bare, so errexit already aborts the controller before
    # the rename. Check anyway: the atomic-publish invariant then holds for this
    # writer whatever a future caller does with it, and the truncated temp file
    # is removed rather than left in the routine state directory.
    {
        printf 'state=%s\nnext_run_epoch=%s\nlast_success_epoch=%s\nlast_attempt_epoch=%s\n' \
            "$routine_state_value" "$routine_next_value" "$routine_last_success_value" "$routine_last_attempt_value" &&
        printf 'retry_attempt=%s\nlast_day=%s\nlast_poll_epoch=%s\nfingerprint=%s\nbackend=%s\n' \
            "$routine_retry_value" "$routine_last_day_value" "$routine_last_poll_value" "$routine_fingerprint_value" "$routine_backend_value" &&
        printf 'backend_reason=%s\npending_fingerprint=%s\npending_since_epoch=%s\n' \
            "$routine_backend_reason_value" "$routine_pending_fingerprint_value" "$routine_pending_since_value" &&
        printf 'event_first_seen_epoch=%s\npoll_retries=%s\n' \
            "$routine_event_first_seen_value" "$routine_poll_retries_value"
    } > "$routine_state_temp" || { rm -f "$routine_state_temp"; return 69; }
    finish_private_file "$routine_state_temp" || { rm -f "$routine_state_temp"; return 69; }
    mv -f "$routine_state_temp" "$routine_state_dir/$routine_state_profile.state" \
        || { rm -f "$routine_state_temp"; return 69; }
}

capture_work_child_identity() {
    captured_work_child_start=
    captured_work_child_boot=
    captured_work_child_pid=${1:-}
    captured_work_child_boot=${2:-}
    valid_boot_identity "$captured_work_child_boot" || return 1
    captured_work_child_parent=
    IFS=' ' read -r captured_work_child_parent _captured_work_child_parent_rest \
        < /proc/self/stat || return 1
    case $captured_work_child_parent in ''|*[!0-9]*|0) return 1 ;; esac
    captured_work_child_attempt=0
    while [ "$captured_work_child_attempt" -lt 10 ]; do
        captured_work_child_uid=
        captured_work_child_ppid=
        read_process_stat_fields "$captured_work_child_pid" || true
        captured_work_child_start=$process_stat_start
        if read_process_status_ids "$captured_work_child_pid"; then
            captured_work_child_uid=$process_status_uid
            captured_work_child_ppid=$process_status_ppid
        fi
        case $captured_work_child_start in ''|*[!0-9]*|0) ;;
            *)
                if [ "$captured_work_child_uid" = "$path_owner" ] && \
                    [ "$captured_work_child_ppid" = "$captured_work_child_parent" ]; then
                    captured_work_child_start_recheck=
                    read_process_stat_fields "$captured_work_child_pid" && \
                        captured_work_child_start_recheck=$process_stat_start
                    if [ "$captured_work_child_start_recheck" = "$captured_work_child_start" ]; then
                        return 0
                    fi
                elif [ -n "$captured_work_child_ppid" ]; then
                    break
                fi
                ;;
        esac
        captured_work_child_start=
        captured_work_child_attempt=$((captured_work_child_attempt + 1))
    done
    captured_work_child_start=
    captured_work_child_boot=
    return 1
}

reap_direct_child_interruption_safe() {
    while :; do
        # Function positional parameters are restored across a nested trap
        # handler, unlike global shell variables. Keep the epoch in $2 so a
        # handler that interrupted wait cannot make us mistake that status for
        # collection of the direct child.
        set -- "$1" "$child_wait_interrupt_epoch"
        set +e
        wait "$1" 2>/dev/null
        set -e
        [ "$child_wait_interrupt_epoch" != "$2" ] || return 0
    done
}

publish_child_admission() {
    published_admission_path=$1
    published_admission_value=$2
    case $published_admission_value in go|abort) ;; *) return 73 ;; esac
    published_admission_temp=$published_admission_path.$published_admission_value.tmp.$$
    [ ! -e "$published_admission_path" ] && [ ! -L "$published_admission_path" ] || return 73
    [ ! -e "$published_admission_temp" ] && [ ! -L "$published_admission_temp" ] || return 73
    if ! printf '%s\n' "$published_admission_value" > "$published_admission_temp" || \
        ! finish_private_file "$published_admission_temp" || \
        [ -e "$published_admission_path" ] || [ -L "$published_admission_path" ] || \
        ! mv "$published_admission_temp" "$published_admission_path"; then
        rm -f "$published_admission_temp" 2>/dev/null || true
        return 73
    fi
}

runner_guard_stop_status() {
    runner_guard_stop_checked=$1
    [ -e "$runner_guard_stop_checked" ] || [ -L "$runner_guard_stop_checked" ] || return 1
    [ -d "$runner_guard_stop_checked" ] && [ ! -L "$runner_guard_stop_checked" ] \
        || return 73
    runner_guard_stop_metadata=$(stat -c '%d:%i:%u:%a' \
        "$runner_guard_stop_checked" 2>/dev/null || true)
    case $runner_guard_stop_metadata in
        *:"$path_owner":700) ;;
        *) return 73 ;;
    esac
    for runner_guard_stop_entry in \
        "$runner_guard_stop_checked"/* \
        "$runner_guard_stop_checked"/.[!.]* \
        "$runner_guard_stop_checked"/..?*; do
        [ -e "$runner_guard_stop_entry" ] || [ -L "$runner_guard_stop_entry" ] || continue
        return 73
    done
    runner_guard_stop_recheck=$(stat -c '%d:%i:%u:%a' \
        "$runner_guard_stop_checked" 2>/dev/null || true)
    [ "$runner_guard_stop_recheck" = "$runner_guard_stop_metadata" ] || return 73
    return 0
}

publish_runner_guard_stop() {
    runner_guard_stop_target=$1
    runner_guard_existing_status=0
    runner_guard_stop_status "$runner_guard_stop_target" || runner_guard_existing_status=$?
    case $runner_guard_existing_status in
        0) return 0 ;;
        1) ;;
        *) return 73 ;;
    esac
    (umask 077; mkdir "$runner_guard_stop_target") 2>/dev/null || \
        runner_guard_stop_status "$runner_guard_stop_target" || return 73
    runner_guard_stop_status "$runner_guard_stop_target"
}

cleanup_runner_guard_channels() {
    runner_guard_cleanup_admission=$1
    runner_guard_cleanup_stop=$2
    runner_guard_cleanup_result=0
    if [ -n "$runner_guard_cleanup_admission" ] \
        && { [ -e "$runner_guard_cleanup_admission" ] \
            || [ -L "$runner_guard_cleanup_admission" ]; }; then
        runner_guard_cleanup_decision=
        if private_control_file "$runner_guard_cleanup_admission" \
            && IFS= read -r runner_guard_cleanup_decision < "$runner_guard_cleanup_admission" \
            && { [ "$runner_guard_cleanup_decision" = go ] \
                || [ "$runner_guard_cleanup_decision" = abort ]; }; then
            rm -f "$runner_guard_cleanup_admission" || runner_guard_cleanup_result=73
        else runner_guard_cleanup_result=73
        fi
    fi
    if [ -n "$runner_guard_cleanup_stop" ] \
        && { [ -e "$runner_guard_cleanup_stop" ] || [ -L "$runner_guard_cleanup_stop" ]; }; then
        if runner_guard_stop_status "$runner_guard_cleanup_stop"; then
            rmdir "$runner_guard_cleanup_stop" || runner_guard_cleanup_result=73
        else runner_guard_cleanup_result=73
        fi
    fi
    if [ -n "$runner_guard_cleanup_admission" ]; then
        for runner_guard_cleanup_path in \
            "$runner_guard_cleanup_admission.go.tmp.$$" \
            "$runner_guard_cleanup_admission.abort.tmp.$$"; do
            [ -e "$runner_guard_cleanup_path" ] \
                || [ -L "$runner_guard_cleanup_path" ] || continue
            if private_control_file "$runner_guard_cleanup_path"; then
                rm -f "$runner_guard_cleanup_path" || runner_guard_cleanup_result=73
            else runner_guard_cleanup_result=73
            fi
        done
    fi
    return "$runner_guard_cleanup_result"
}

admission_yield() {
    # `/bin/sleep 0` never slept. It forked, exec'd BusyBox, and returned, so a
    # full round of the admission loop spent one process creation per probe to
    # cover about a millisecond each -- on the hardware where fork is the most
    # expensive thing this package does. A proven fractional sleep covers fifty
    # milliseconds for the same single process.
    #
    # The measurement is the one the lifecycle transition that started this
    # controller already published; this never probes. A build that never
    # proved a fractional sleep keeps the original zero-second yield rather
    # than falling back to a bare builtin spin, which would burn the whole
    # ceiling in microseconds and drop admission onto the one-second path --
    # the sluggishness this loop exists to avoid.
    if [ "$runtime_poll_resolution_ms" -lt 1000 ]; then
        /bin/sleep 0.05 2>/dev/null && return 0
        runtime_poll_resolution_ms=1000
    fi
    /bin/sleep 0
}

wait_for_child_admission() {
    waited_admission_path=$1
    waited_admission_parent=$2
    waited_admission_parent_start=$3
    waited_admission_parent_boot=$4
    waited_admission_stop=${5:-}
    waited_admission_round=0
    while [ "$waited_admission_round" -lt 3 ]; do
        if [ -n "$waited_admission_stop" ]; then
            waited_admission_stop_status=0
            runner_guard_stop_status "$waited_admission_stop" \
                || waited_admission_stop_status=$?
            case $waited_admission_stop_status in
                0) return 75 ;;
                1) ;;
                *) return 73 ;;
            esac
        fi
        process_identity_is_live "$waited_admission_parent" \
            "$waited_admission_parent_start" "$waited_admission_parent_boot" || return 1
        # Poll bucket F -- the admission handshake, while the parent captures
        # and publishes. The ceiling counts yields rather than milliseconds
        # because it is also the performance policy's knob, and the two
        # resolutions give it a coherent meaning either way: at the proven
        # fractional resolution each yield covers 50 ms, and on a build that
        # never proved one each yield is the historical zero-second sleep. Both
        # fall through to the one-second path once the ceiling is spent, so a
        # lower ceiling trades admission latency for processes, which is
        # exactly what the policy levels are asked to trade.
        waited_admission_yield=0
        while [ "$waited_admission_yield" -lt "$performance_admission_yields" ]; do
            if [ -n "$waited_admission_stop" ]; then
                waited_admission_stop_status=0
                runner_guard_stop_status "$waited_admission_stop" \
                    || waited_admission_stop_status=$?
                case $waited_admission_stop_status in
                    0) return 75 ;;
                    1) ;;
                    *) return 73 ;;
                esac
            fi
            if [ -e "$waited_admission_path" ] || [ -L "$waited_admission_path" ]; then
                private_control_file "$waited_admission_path" || return 1
                waited_admission_decision=
                IFS= read -r waited_admission_decision < "$waited_admission_path" || return 1
                rm -f "$waited_admission_path" 2>/dev/null || return 1
                [ "$waited_admission_decision" = go ]
                return $?
            fi
            admission_yield
            waited_admission_yield=$((waited_admission_yield + 1))
        done
        /bin/sleep 1
        waited_admission_round=$((waited_admission_round + 1))
    done
    return 1
}

work_child_identity_is_running() {
    bounded_child_pid=${1:-}
    bounded_child_start=${2:-}
    bounded_child_boot=${3:-}
    case $bounded_child_start in ''|*[!0-9]*|0) return 1 ;; esac
    valid_boot_identity "$bounded_child_boot" || return 1
    bounded_child_state=
    read_process_stat_fields "$bounded_child_pid" && \
        bounded_child_state=$process_stat_state
    case $bounded_child_state in ''|Z|X|x) return 1 ;; esac
    # Keep the exact PID/start/boot verification last so TERM/KILL follows it
    # without another operation that could widen the PID-reuse race window.
    process_identity_is_live "$bounded_child_pid" "$bounded_child_start" "$bounded_child_boot"
}

clear_admitted_child_slot() {
    cleared_admission_slot=$1
    cleared_admission_pid=$2
    case $cleared_admission_slot in
        active)
            [ "$active_pid" = "$cleared_admission_pid" ] || return 0
            active_pid=
            active_pid_start=
            active_pid_boot=
            ;;
        control)
            [ "$control_pid" = "$cleared_admission_pid" ] || return 0
            control_pid=
            control_pid_start=
            control_pid_boot=
            ;;
        sleep)
            [ "$sleep_pid" = "$cleared_admission_pid" ] || return 0
            sleep_pid=
            sleep_pid_start=
            sleep_pid_boot=
            ;;
        *) return 73 ;;
    esac
}

admitted_child_launch_is_cancelled() {
    cancelled_admission_slot=$1
    if [ "$shutdown" = true ]; then return 0; fi
    if [ "$cancelled_admission_slot" = sleep ] && \
        { [ "$reload_requested" = true ] || [ "$queue_wake_requested" = true ]; }; then
        return 0
    fi
    return 1
}

stop_exact_admitted_child() {
    stopped_admission_pid=$1
    stopped_admission_start=$2
    stopped_admission_boot=$3
    if work_child_identity_is_running "$stopped_admission_pid" \
        "$stopped_admission_start" "$stopped_admission_boot"; then
        kill -TERM "$stopped_admission_pid" 2>/dev/null || true
    fi
    reap_direct_child_interruption_safe "$stopped_admission_pid"
}

launch_admitted_child() {
    admitted_child_status=preflight_failed
    admitted_child_pid=
    launched_admission_slot=$1
    launched_admission_kind=$2
    shift 2
    case $launched_admission_slot in active|control|sleep) ;; *) return 73 ;; esac
    case $launched_admission_kind in ''|*[!A-Za-z0-9_-]*) return 73 ;; esac
    launched_admission_parent=$$
    launched_admission_parent_start=$(process_start_time \
        "$launched_admission_parent" 2>/dev/null || true)
    case $launched_admission_parent_start in ''|*[!0-9]*|0) return 73 ;; esac
    launched_admission_boot=$(boot_identity) || return 73
    child_admission_sequence=$((child_admission_sequence + 1))
    launched_admission_path=$runtime_root/.child-admission.${launched_admission_parent}.${launched_admission_parent_start}.${child_admission_sequence}
    [ ! -e "$launched_admission_path" ] && [ ! -L "$launched_admission_path" ] || return 73
    (
        trap - TERM INT HUP USR1 USR2 ALRM
        if wait_for_child_admission "$launched_admission_path" \
            "$launched_admission_parent" "$launched_admission_parent_start" \
            "$launched_admission_boot"; then
            process_identity_is_live "$launched_admission_parent" \
                "$launched_admission_parent_start" "$launched_admission_boot" || exit 0
            exec "$@"
        fi
        exit 0
    ) &
    launched_admission_pid=$!
    if ! capture_work_child_identity "$launched_admission_pid" "$launched_admission_boot"; then
        # The unverified wrapper is still behind the gate. Abort is durable and
        # atomic; never signal or publish a PID whose start tick was not captured.
        publish_child_admission "$launched_admission_path" abort 2>/dev/null || true
        reap_direct_child_interruption_safe "$launched_admission_pid"
        rm -f "$launched_admission_path" \
            "$launched_admission_path".*.tmp.$$ 2>/dev/null || true
        captured_work_child_start=
        captured_work_child_boot=
        admitted_child_status=capture_failed
        return 73
    fi
    launched_admission_start=$captured_work_child_start
    launched_admission_boot=$captured_work_child_boot
    case $launched_admission_slot in
        active)
            active_pid_start=$launched_admission_start
            active_pid_boot=$launched_admission_boot
            active_pid=$launched_admission_pid
            ;;
        control)
            control_pid_start=$launched_admission_start
            control_pid_boot=$launched_admission_boot
            control_pid=$launched_admission_pid
            ;;
        sleep)
            sleep_pid_start=$launched_admission_start
            sleep_pid_boot=$launched_admission_boot
            sleep_pid=$launched_admission_pid
            ;;
    esac
    # Signal-handoff tests instrument this point. The exact tuple is published,
    # but the real command remains unable to exec until the atomic go commit.
    if admitted_child_launch_is_cancelled "$launched_admission_slot"; then
        publish_child_admission "$launched_admission_path" abort 2>/dev/null || \
            stop_exact_admitted_child "$launched_admission_pid" \
                "$launched_admission_start" "$launched_admission_boot"
        reap_direct_child_interruption_safe "$launched_admission_pid"
        clear_admitted_child_slot "$launched_admission_slot" "$launched_admission_pid"
        rm -f "$launched_admission_path" \
            "$launched_admission_path".*.tmp.$$ 2>/dev/null || true
        admitted_child_status=cancelled
        return 75
    fi
    if ! publish_child_admission "$launched_admission_path" go; then
        stop_exact_admitted_child "$launched_admission_pid" \
            "$launched_admission_start" "$launched_admission_boot"
        clear_admitted_child_slot "$launched_admission_slot" "$launched_admission_pid"
        rm -f "$launched_admission_path" \
            "$launched_admission_path".*.tmp.$$ 2>/dev/null || true
        admitted_child_status=admission_failed
        return 73
    fi
    admitted_child_pid=$launched_admission_pid
    admitted_child_status=started
    return 0
}

signal_controller_sleep() {
    if [ -n "$sleep_pid" ] && work_child_identity_is_running \
        "$sleep_pid" "$sleep_pid_start" "$sleep_pid_boot"; then
        kill -TERM "$sleep_pid" 2>/dev/null || true
    fi
}

stop_runner_guard_sleep() {
    stopped_runner_guard_sleep_pid=$runner_guard_sleep_pid
    stopped_runner_guard_sleep_start=$runner_guard_sleep_start
    stopped_runner_guard_sleep_boot=$runner_guard_sleep_boot
    runner_guard_sleep_pid=
    runner_guard_sleep_start=
    runner_guard_sleep_boot=
    [ -n "$stopped_runner_guard_sleep_pid" ] || return 0
    if work_child_identity_is_running "$stopped_runner_guard_sleep_pid" \
        "$stopped_runner_guard_sleep_start" "$stopped_runner_guard_sleep_boot"; then
        kill -TERM "$stopped_runner_guard_sleep_pid" 2>/dev/null || true
    fi
    reap_direct_child_interruption_safe "$stopped_runner_guard_sleep_pid"
}

start_runner_wait_guard() {
    # An admitted, live guard is not replaced. wait_for_runner re-enters `wait`
    # on every ALRM tick, and rebuilding the watchdog on each re-entry cost a
    # full admission handshake plus a stop-latch directory created and removed,
    # once a second, for the whole duration of every sync. That was never a
    # design decision -- it fell out of the loop calling stop and start around
    # a `wait` that an alarm is *expected* to interrupt. The alarm cadence, the
    # signal semantics and every latch are unchanged here; this only declines
    # to build a second watchdog while the first is still running.
    #
    # Liveness is the exact PID/start/boot tuple, never a non-empty PID
    # variable. A guard that exited on its own must be replaced, or the wait it
    # protects would silently run with no watchdog at all -- and a stale tuple
    # is torn down through the normal path first so it cannot be leaked.
    if [ -n "$runner_wait_guard_pid" ]; then
        if [ "$runner_wait_guard_admitted" = true ] \
            && runner_guard_identity_is_live "$runner_wait_guard_pid" \
                "$runner_wait_guard_start" "$runner_wait_guard_boot"; then
            return 0
        fi
        stop_runner_wait_guard || return 73
    fi
    runner_guard_parent=$$
    runner_guard_parent_start=$(process_start_time "$runner_guard_parent" 2>/dev/null || true)
    case $runner_guard_parent_start in ''|*[!0-9]*|0) return 73 ;; esac
    runner_guard_parent_boot=$(boot_identity) || return 73
    child_admission_sequence=$((child_admission_sequence + 1))
    runner_guard_admission=$runtime_root/.runner-wait-guard-admit.${runner_guard_parent}.${runner_guard_parent_start}.${child_admission_sequence}
    runner_guard_stop=$runner_guard_admission.stop
    [ ! -e "$runner_guard_admission" ] && [ ! -L "$runner_guard_admission" ] || return 73
    [ ! -e "$runner_guard_stop" ] && [ ! -L "$runner_guard_stop" ] || return 73
    (
        runner_guard_sleep_pid=
        runner_guard_sleep_start=
        runner_guard_sleep_boot=
        runner_guard_shutdown=false
        request_runner_guard_shutdown() {
            child_wait_interrupt_epoch=$((child_wait_interrupt_epoch + 1))
            runner_guard_shutdown=true
            stop_runner_guard_sleep
        }
        runner_guard_stop_requested() {
            runner_guard_child_stop_status=0
            runner_guard_stop_status "$runner_guard_stop" \
                || runner_guard_child_stop_status=$?
            case $runner_guard_child_stop_status in
                0) return 0 ;;
                1) return 1 ;;
                *) exit 73 ;;
            esac
        }
        trap request_runner_guard_shutdown TERM INT HUP
        trap '' USR1 USR2 ALRM
        runner_guard_admission_status=0
        wait_for_child_admission "$runner_guard_admission" "$runner_guard_parent" \
            "$runner_guard_parent_start" "$runner_guard_parent_boot" \
            "$runner_guard_stop" || runner_guard_admission_status=$?
        case $runner_guard_admission_status in
            0) ;;
            73) exit 73 ;;
            *) exit 0 ;;
        esac
        runner_guard_stop_requested && exit 0
        [ "$runner_guard_shutdown" = false ] || exit 0
        while [ "$runner_guard_shutdown" = false ] && \
            process_identity_is_live "$runner_guard_parent" \
            "$runner_guard_parent_start" "$runner_guard_parent_boot"; do
            runner_guard_stop_requested && exit 0
            # Poll bucket E -- shortening this makes it *slower*. The sleep is
            # a cancellable child so TERM can interrupt it, which already makes
            # the wait interrupt-driven rather than poll-driven; a finer
            # interval buys no latency and costs an extra fork plus an identity
            # capture on every tick, on hardware where fork is the expensive
            # operation.
            /bin/sleep 1 &
            launched_runner_guard_sleep_pid=$!
            if ! capture_work_child_identity "$launched_runner_guard_sleep_pid" \
                "$runner_guard_parent_boot"; then
                # This helper is intrinsically bounded to one second. Without
                # an exact identity, its direct child was reaped without a signal.
                reap_direct_child_interruption_safe "$launched_runner_guard_sleep_pid"
                exit 0
            fi
            runner_guard_sleep_start=$captured_work_child_start
            runner_guard_sleep_boot=$captured_work_child_boot
            runner_guard_sleep_pid=$launched_runner_guard_sleep_pid
            # A shutdown trap can run after spawn but before this exact tuple is
            # published. Its latch closes that handoff without PID-only signals.
            if [ "$runner_guard_shutdown" = true ]; then
                stop_runner_guard_sleep
                exit 0
            fi
            wait "$runner_guard_sleep_pid" || exit 0
            runner_guard_sleep_pid=
            runner_guard_sleep_start=
            runner_guard_sleep_boot=
            # The private stop latch is checked immediately before ALRM. This
            # closes stop races even when exact procfs identity verification is
            # transiently unavailable to the parent during guard teardown.
            runner_guard_stop_requested && exit 0
            # PID liveness alone is unsafe after abrupt controller death: the
            # kernel may reuse that number. Recheck the exact PID/start/boot
            # tuple immediately before every signal so an unrelated successor
            # can never receive the watchdog ALRM.
            process_identity_is_live "$runner_guard_parent" \
                "$runner_guard_parent_start" "$runner_guard_parent_boot" || exit 0
            kill -ALRM "$runner_guard_parent" 2>/dev/null || exit 0
        done
    ) &
    launched_runner_wait_guard_pid=$!
    if ! capture_work_child_identity "$launched_runner_wait_guard_pid" \
        "$runner_guard_parent_boot"; then
        publish_child_admission "$runner_guard_admission" abort 2>/dev/null || true
        reap_direct_child_interruption_safe "$launched_runner_wait_guard_pid"
        cleanup_runner_guard_channels "$runner_guard_admission" \
            "$runner_guard_stop" 2>/dev/null || true
        return 73
    fi
    runner_wait_guard_start=$captured_work_child_start
    runner_wait_guard_boot=$captured_work_child_boot
    runner_wait_guard_pid=$launched_runner_wait_guard_pid
    runner_wait_guard_admission_path=$runner_guard_admission
    runner_wait_guard_stop_path=$runner_guard_stop
    runner_wait_guard_admitted=false
    # Runner-guard admission tests instrument this exact captured-before-go
    # handoff. A wake here must abort the guard and skip the unguarded wait.
    if [ "$shutdown" = true ] || [ "$wait_interrupted" = true ]; then
        runner_guard_cancel_status=0
        stop_runner_wait_guard || runner_guard_cancel_status=$?
        [ "$runner_guard_cancel_status" -eq 0 ] || return 73
        return 0
    fi
    if ! publish_child_admission "$runner_guard_admission" go; then
        stop_runner_wait_guard 2>/dev/null || true
        return 73
    fi
    runner_wait_guard_admitted=true
}

runner_guard_identity_is_live() {
    # TERM may interrupt the shared verifier and make request_shutdown verify
    # an active work child with the same global scratch variables. Bind this
    # guard tuple in wrapper-private names and reject a resumed result unless
    # the shared verifier still describes the exact tuple it was asked to read.
    runner_guard_verify_pid=$1
    runner_guard_verify_start=$2
    runner_guard_verify_boot=$3
    runner_guard_verify_result=0
    process_identity_is_live "$runner_guard_verify_pid" \
        "$runner_guard_verify_start" "$runner_guard_verify_boot" \
        || runner_guard_verify_result=$?
    [ "$process_identity_pid" = "$runner_guard_verify_pid" ] \
        && [ "$process_identity_start" = "$runner_guard_verify_start" ] \
        && [ "$process_identity_boot" = "$runner_guard_verify_boot" ] || return 73
    return "$runner_guard_verify_result"
}

stop_runner_wait_guard() {
    runner_guard_pid=$runner_wait_guard_pid
    runner_guard_start=$runner_wait_guard_start
    runner_guard_boot=$runner_wait_guard_boot
    runner_guard_admission_path=$runner_wait_guard_admission_path
    runner_guard_stop_path=$runner_wait_guard_stop_path
    runner_guard_admitted=$runner_wait_guard_admitted
    [ -n "$runner_guard_pid" ] || return 0

    # One private latch belongs to each admitted guard. Publish it before the
    # optional exact signal so a transient procfs read cannot strand teardown.
    runner_guard_stop_published=false
    runner_guard_stop_result=0
    if [ -n "$runner_guard_stop_path" ] \
        && publish_runner_guard_stop "$runner_guard_stop_path"; then
        runner_guard_stop_published=true
        if [ "$runner_guard_admitted" != true ]; then
            # Abort reduces pre-admission latency. The guard also polls the stop
            # latch while awaiting admission, so this best-effort hint is not
            # the authorization or correctness boundary.
            publish_child_admission "$runner_guard_admission_path" abort \
                2>/dev/null || true
        fi
    else
        runner_guard_stop_result=73
    fi

    runner_guard_reap_authorized=$runner_guard_stop_published
    runner_guard_identity_status=0
    runner_guard_identity_is_live "$runner_guard_pid" "$runner_guard_start" \
        "$runner_guard_boot" || runner_guard_identity_status=$?
    case $runner_guard_identity_status in
        0)
            if kill -TERM "$runner_guard_pid" 2>/dev/null; then
                runner_guard_reap_authorized=true
            elif [ "$runner_guard_stop_published" != true ]; then
                runner_guard_identity_recheck=0
                runner_guard_identity_is_live "$runner_guard_pid" "$runner_guard_start" \
                    "$runner_guard_boot" || runner_guard_identity_recheck=$?
                [ "$runner_guard_identity_recheck" -eq 1 ] \
                    && runner_guard_reap_authorized=true
            fi
            ;;
        1) runner_guard_reap_authorized=true ;;
        *) ;;
    esac
    if [ "$runner_guard_reap_authorized" != true ]; then
        # Publication and exact identity both failed closed. Retain the tuple
        # for diagnosis/retry; never PID-only signal or synchronously wait.
        return 73
    fi

    reap_direct_child_interruption_safe "$runner_guard_pid"
    cleanup_runner_guard_channels "$runner_guard_admission_path" \
        "$runner_guard_stop_path" || runner_guard_stop_result=73
    runner_wait_guard_pid=
    runner_wait_guard_start=
    runner_wait_guard_boot=
    runner_wait_guard_admission_path=
    runner_wait_guard_stop_path=
    runner_wait_guard_admitted=false
    return "$runner_guard_stop_result"
}

stop_work_children_bounded() {
    # Native consumers and runners receive a cooperative TERM first. Bound the
    # controller's own shutdown responsibility so a blocked network syscall can
    # never hold DSM package stop indefinitely, then reap both direct children
    # through their normal wait paths (or cleanup_controller on unexpected EXIT).
    if [ -n "$control_pid" ] && work_child_identity_is_running \
        "$control_pid" "$control_pid_start" "$control_pid_boot"; then
        kill -TERM "$control_pid" 2>/dev/null || true
    fi
    if [ -n "$active_pid" ] && work_child_identity_is_running \
        "$active_pid" "$active_pid_start" "$active_pid_boot"; then
        kill -TERM "$active_pid" 2>/dev/null || true
    fi
    # Poll bucket B -- the three iterations are the post-TERM grace, not a
    # sampling rate; shortening turns three seconds into 0.15 s silently.
    bounded_stop_count=0
    while [ "$bounded_stop_count" -lt 3 ]; do
        bounded_child_live=false
        if [ -n "$control_pid" ] && work_child_identity_is_running \
            "$control_pid" "$control_pid_start" "$control_pid_boot"; then bounded_child_live=true; fi
        if [ -n "$active_pid" ] && work_child_identity_is_running \
            "$active_pid" "$active_pid_start" "$active_pid_boot"; then bounded_child_live=true; fi
        [ "$bounded_child_live" = true ] || return 0
        /bin/sleep 1
        bounded_stop_count=$((bounded_stop_count + 1))
    done
    if [ -n "$control_pid" ] && work_child_identity_is_running \
        "$control_pid" "$control_pid_start" "$control_pid_boot"; then
        kill -KILL "$control_pid" 2>/dev/null || true
    fi
    if [ -n "$active_pid" ] && work_child_identity_is_running \
        "$active_pid" "$active_pid_start" "$active_pid_boot"; then
        kill -KILL "$active_pid" 2>/dev/null || true
    fi
}

arm_connection_queue_from_backlog() {
    case $active_control_classification in
        runner|concurrent) ;;
        *) return 0 ;;
    esac
    # A wake delivered before the primary worker was launched may already have
    # been folded into the current controller turn. Reconstruct that evidence
    # from the private FIFO so a pre-existing connection probe is not stranded.
    # The nested turn still classifies the exact head and refuses to cross a
    # concurrent barrier, or a serialized one unless this primary is itself
    # concurrent.
    for connection_wake_request in "$control_requests"/*.json; do
        [ -e "$connection_wake_request" ] || [ -L "$connection_wake_request" ] || continue
        connection_wake_name=${connection_wake_request##*/}
        connection_wake_id=${connection_wake_name%.json}
        valid_request_id "$connection_wake_id" || continue
        private_control_file "$connection_wake_request" || continue
        connection_wake_processing=$control_processing/$connection_wake_name
        [ ! -e "$connection_wake_processing" ] && [ ! -L "$connection_wake_processing" ] || continue
        queue_wake_requested=true
        break
    done
}

wait_for_runner() {
    previous_wait_status=
    arm_connection_queue_from_backlog
    while :; do
        # Reset before inspecting the durable queue latch. A signal delivered
        # from here onward either makes that inspection true, interrupts the
        # active wait directly, or is recovered by the bounded ALRM guard.
        wait_interrupted=false
        if [ "$shutdown" = false ] && [ "$queue_wake_requested" = true ]; then
            case $active_control_classification in
                runner|concurrent)
                    queue_wake_requested=false
                    primary_control_queue_progress=$control_queue_progress
                    control_queue_progress=false
                    process_control_queue true
                    nested_control_queue_progress=$control_queue_progress
                    control_queue_progress=$primary_control_queue_progress
                    # Standard signals can coalesce. After a successful FIFO
                    # claim, perform one more guarded auxiliary turn so
                    # a second pre-existing request is not stranded behind the
                    # primary worker. A refused head, classification failure,
                    # collision, or failed mv reports no progress and therefore
                    # cannot create a zero-sleep retry loop.
                    if [ "$nested_control_queue_progress" = true ]; then
                        queue_wake_requested=true
                    fi
                    continue
                    ;;
            esac
        fi
        # POSIX shell cannot atomically unblock USR2 and enter `wait`. Keep a
        # one-second watchdog published across that final handoff. It only
        # interrupts the controller's wait; the primary child keeps running,
        # its real exit status is collected by `wait`, and successful queue
        # turns retain the existing FIFO/barrier rules above.
        start_runner_wait_guard
        if [ "$wait_interrupted" = true ]; then
            stop_runner_wait_guard
            continue
        fi
        # Guarded runner-wait handoff. Runtime tests instrument this comment in
        # their private controller copy to deliver USR2 in the exact gap.
        set +e
        wait "$active_pid"
        current_wait_status=$?
        set -e
        # An interrupted wait does not retire the guard. The alarm that
        # interrupted it is the guard doing its job; the loop is about to
        # re-enter `wait`, and the same watchdog covers that re-entry. Stopping
        # and restarting it here is what made a running sync pay a whole
        # admission handshake every second for as long as it ran. The guard is
        # retired when the wait actually completes, immediately below, and
        # again after the loop.
        if [ "$wait_interrupted" = true ]; then previous_wait_status=$current_wait_status; continue; fi
        stop_runner_wait_guard
        if [ "$current_wait_status" -eq 127 ] && [ -n "$previous_wait_status" ]; then scheduled_exit=$previous_wait_status; else scheduled_exit=$current_wait_status; fi
        break
    done
    stop_runner_wait_guard
    active_pid=
    active_pid_start=
    active_pid_boot=
    active_control_classification=
}

wait_for_control_consumer() {
    previous_control_wait_status=
    while :; do
        wait_interrupted=false
        set +e
        wait "$control_pid"
        current_control_wait_status=$?
        set -e
        if [ "$wait_interrupted" = true ]; then
            previous_control_wait_status=$current_control_wait_status
            continue
        fi
        if [ "$current_control_wait_status" -eq 127 ] && [ -n "$previous_control_wait_status" ]; then
            control_wait_exit=$previous_control_wait_status
        else
            control_wait_exit=$current_control_wait_status
        fi
        break
    done
    control_pid=
    control_pid_start=
    control_pid_boot=
}

# One pass over each small document instead of two forks per key. setting() is
# a grep-and-sed pipeline, so reading one routine's config, state and profile
# through it cost 36 forks for every routine on every five-second turn;
# load_security_policy_runtime in sdsync-common already replaced this exact
# anti-pattern with a read loop, for the same reason.
#
# All three loaders reproduce setting()'s contract exactly: the first occurrence
# of a key wins, an empty value yields the documented default, a line with no
# '=' is ignored, and an absent or non-regular file yields every default. The
# line caps bound the loop over a document only this package writes.
# The aggregate schedule is re-read on every turn of the scheduling loop, which
# is every five seconds once any routine exists. Four setting() calls is eight
# forks per turn for four keys in one small file, the same anti-pattern the
# routine loaders below replaced; this loader has the identical contract.
load_schedule_runtime() {
    enabled=false
    interval=3600
    allow_delete=false
    maximum_total=100
    [ -f "$1" ] && [ ! -L "$1" ] && [ -r "$1" ] || return 0
    schedule_seen=,
    schedule_lines=0
    while IFS= read -r schedule_line || [ -n "$schedule_line" ]; do
        schedule_lines=$((schedule_lines + 1))
        [ "$schedule_lines" -le 256 ] || break
        schedule_key=${schedule_line%%=*}
        [ "$schedule_key" != "$schedule_line" ] || continue
        schedule_value=${schedule_line#*=}
        [ -n "$schedule_value" ] || continue
        case $schedule_seen in *",$schedule_key,"*) continue ;; esac
        case $schedule_key in
            enabled) enabled=$schedule_value ;;
            interval_seconds) interval=$schedule_value ;;
            allow_delete) allow_delete=$schedule_value ;;
            max_total_delete) maximum_total=$schedule_value ;;
            *) continue ;;
        esac
        schedule_seen=$schedule_seen$schedule_key,
    done < "$1"
}

load_routine_config_runtime() {
    routine_enabled=false
    routine_action=sync
    routine_mode=interval
    routine_interval=3600
    routine_weekdays=1,2,3,4,5,6,7
    routine_start=00:00
    routine_end=23:59
    routine_debounce=45
    routine_retries=5
    routine_backoff=60
    routine_retry_exponential=true
    routine_poll=30
    routine_delete=false
    routine_max_total=100
    routine_dependencies=
    [ -f "$1" ] && [ ! -L "$1" ] && [ -r "$1" ] || return 0
    routine_config_seen=,
    routine_config_lines=0
    while IFS= read -r routine_config_line || [ -n "$routine_config_line" ]; do
        routine_config_lines=$((routine_config_lines + 1))
        [ "$routine_config_lines" -le 256 ] || break
        routine_config_key=${routine_config_line%%=*}
        [ "$routine_config_key" != "$routine_config_line" ] || continue
        routine_config_value=${routine_config_line#*=}
        [ -n "$routine_config_value" ] || continue
        case $routine_config_seen in *",$routine_config_key,"*) continue ;; esac
        case $routine_config_key in
            enabled) routine_enabled=$routine_config_value ;;
            action) routine_action=$routine_config_value ;;
            mode) routine_mode=$routine_config_value ;;
            interval_seconds) routine_interval=$routine_config_value ;;
            weekdays) routine_weekdays=$routine_config_value ;;
            time_window_start) routine_start=$routine_config_value ;;
            time_window_end) routine_end=$routine_config_value ;;
            debounce_seconds) routine_debounce=$routine_config_value ;;
            retry_count) routine_retries=$routine_config_value ;;
            retry_backoff_seconds) routine_backoff=$routine_config_value ;;
            retry_exponential) routine_retry_exponential=$routine_config_value ;;
            poll_seconds) routine_poll=$routine_config_value ;;
            allow_delete) routine_delete=$routine_config_value ;;
            max_total_delete) routine_max_total=$routine_config_value ;;
            depends_on) routine_dependencies=$routine_config_value ;;
            *) continue ;;
        esac
        routine_config_seen=$routine_config_seen$routine_config_key,
    done < "$1"
}

load_routine_state_runtime() {
    routine_state_value=never
    routine_next_value=0
    routine_last_success_value=0
    routine_last_attempt_value=0
    routine_retry_value=0
    routine_last_day_value=none
    routine_last_poll_value=0
    routine_fingerprint_value=none
    routine_backend_value=none
    routine_backend_reason_value=ok
    routine_pending_fingerprint_value=0
    routine_pending_since_value=0
    routine_event_first_seen_value=0
    routine_poll_retries_value=0
    [ -f "$1" ] && [ ! -L "$1" ] && [ -r "$1" ] || return 0
    routine_state_seen=,
    routine_state_lines=0
    while IFS= read -r routine_state_line || [ -n "$routine_state_line" ]; do
        routine_state_lines=$((routine_state_lines + 1))
        [ "$routine_state_lines" -le 256 ] || break
        routine_state_key=${routine_state_line%%=*}
        [ "$routine_state_key" != "$routine_state_line" ] || continue
        routine_state_field=${routine_state_line#*=}
        [ -n "$routine_state_field" ] || continue
        case $routine_state_seen in *",$routine_state_key,"*) continue ;; esac
        case $routine_state_key in
            state) routine_state_value=$routine_state_field ;;
            next_run_epoch) routine_next_value=$routine_state_field ;;
            last_success_epoch) routine_last_success_value=$routine_state_field ;;
            last_attempt_epoch) routine_last_attempt_value=$routine_state_field ;;
            retry_attempt) routine_retry_value=$routine_state_field ;;
            last_day) routine_last_day_value=$routine_state_field ;;
            last_poll_epoch) routine_last_poll_value=$routine_state_field ;;
            fingerprint) routine_fingerprint_value=$routine_state_field ;;
            backend) routine_backend_value=$routine_state_field ;;
            backend_reason) routine_backend_reason_value=$routine_state_field ;;
            pending_fingerprint) routine_pending_fingerprint_value=$routine_state_field ;;
            pending_since_epoch) routine_pending_since_value=$routine_state_field ;;
            event_first_seen_epoch) routine_event_first_seen_value=$routine_state_field ;;
            poll_retries) routine_poll_retries_value=$routine_state_field ;;
            *) continue ;;
        esac
        routine_state_seen=$routine_state_seen$routine_state_key,
    done < "$1"
}

load_routine_profile_runtime() {
    routine_profile_max=
    profile_source=
    routine_profile_max_seen=false
    routine_profile_source_seen=false
    [ -f "$1" ] && [ ! -L "$1" ] && [ -r "$1" ] || return 0
    routine_profile_lines=0
    while IFS= read -r routine_profile_line || [ -n "$routine_profile_line" ]; do
        routine_profile_lines=$((routine_profile_lines + 1))
        [ "$routine_profile_lines" -le 4096 ] || break
        case $routine_profile_line in
            'max-delete = '*)
                if [ "$routine_profile_max_seen" = false ]; then
                    routine_profile_max_seen=true
                    routine_profile_max=${routine_profile_line#max-delete = }
                fi
                ;;
            'source = "'*'"')
                if [ "$routine_profile_source_seen" = false ]; then
                    routine_profile_source_seen=true
                    profile_source=${routine_profile_line#source = \"}
                    profile_source=${profile_source%\"}
                fi
                ;;
        esac
    done < "$1"
}

process_routines() {
    routine_now=$1
    for routine_config in "$routines_dir"/*.conf; do
        [ -e "$routine_config" ] || [ -L "$routine_config" ] || continue
        if [ -L "$routine_config" ] || [ ! -f "$routine_config" ] || [ ! -r "$routine_config" ]; then
            controller_log_event warn routine_config_rejected
            continue
        fi
        routine_profile=${routine_config##*/}; routine_profile=${routine_profile%.conf}
        case $routine_profile in ''|*[!A-Za-z0-9_-]*) controller_log_event warn routine_name_rejected; continue ;; esac
        profile_exists "$routine_profile" || { controller_log_event warn routine_profile_missing "profile=$routine_profile"; continue; }
        load_routine_config_runtime "$routine_config"
        case $routine_enabled:$routine_delete:$routine_retry_exponential in
            true:true:true|true:true:false|true:false:true|true:false:false|\
            false:true:true|false:true:false|false:false:true|false:false:false) ;;
            *) controller_log_event warn routine_invalid "profile=$routine_profile field=boolean"; continue ;;
        esac
        [ "$routine_enabled" = true ] || continue
        case $routine_action in plan|sync) ;; *) controller_log_event warn routine_invalid "profile=$routine_profile field=action"; continue ;; esac
        case $routine_mode in interval|daily|realtime) ;; *) controller_log_event warn routine_invalid "profile=$routine_profile field=mode"; continue ;; esac
        case $routine_retries:$routine_backoff:$routine_max_total in *[!0-9:]*) controller_log_event warn routine_invalid "profile=$routine_profile field=number"; continue ;; esac
        [ "$routine_retries" -le 5 ] || continue
        [ "$routine_backoff" -ge 10 ] || continue
        decimal_at_most "$routine_max_total" "$dsm_delete_limit" || {
            controller_log_event warn routine_invalid "profile=$routine_profile field=max_total_delete"
            continue
        }
        # Older releases accepted a larger base. Preserve those configs while
        # applying the new five-minute runtime ceiling.
        [ "$routine_backoff" -le 300 ] || routine_backoff=300
        case $routine_mode in
            interval)
                case $routine_interval in ''|*[!0-9]*) continue ;; esac
                [ "$routine_interval" -ge 60 ] && [ "$routine_interval" -le 2592000 ] || continue
                ;;
            daily)
                printf '%s\n' "$routine_weekdays" | grep -Eq '^[1-7](,[1-7])*$' || continue
                printf '%s\n' "$routine_start" | grep -Eq '^([0-1][0-9]|2[0-3]):[0-5][0-9]$' || continue
                printf '%s\n' "$routine_end" | grep -Eq '^([0-1][0-9]|2[0-3]):[0-5][0-9]$' || continue
                ;;
            realtime)
                case $routine_debounce:$routine_poll in *[!0-9:]*) continue ;; esac
                [ "$routine_debounce" -ge 1 ] && [ "$routine_debounce" -le 3600 ] || continue
                [ "$routine_poll" -ge 5 ] && [ "$routine_poll" -le 3600 ] || continue
                ;;
        esac
        load_routine_profile_runtime "$profiles_dir/$routine_profile.toml"
        case $routine_profile_max in ''|*[!0-9]*) continue ;; esac
        decimal_at_most "$routine_profile_max" "$dsm_delete_limit" || continue
        routine_delete_bound=false
        if [ "$routine_delete" = true ] && [ "$routine_max_total" -lt "$routine_profile_max" ]; then
            routine_delete_bound=true
        fi
        routine_state_path=$routine_state_dir/$routine_profile.state
        if [ -L "$routine_state_path" ]; then controller_log_event error routine_state_rejected "profile=$routine_profile"; continue; fi
        load_routine_state_runtime "$routine_state_path"
        # The reason a routine is degraded is reported on transition, not on
        # every turn. This is the comparison that makes that possible, and it is
        # also what keeps a permanently failing poll from evicting the rest of
        # controller.log through the 10 MiB x 5 rotation.
        routine_backend_reason_previous=$routine_backend_reason_value
        routine_native_event_due=false
        routine_native_event_identity=
        routine_native_watcher_pid=
        routine_event_forced=false
        routine_event_forced_pending=0
        routine_event_forced_ceiling=0
        case $routine_state_value in never|scheduled|running|succeeded|failed|deferred) ;; *) controller_log_event warn routine_state_invalid "profile=$routine_profile"; continue ;; esac
        case $routine_next_value:$routine_last_success_value:$routine_last_attempt_value:$routine_retry_value:$routine_last_poll_value in *[!0-9:]*) controller_log_event warn routine_state_invalid "profile=$routine_profile"; continue ;; esac
        case $routine_pending_since_value:$routine_event_first_seen_value:$routine_poll_retries_value in *[!0-9:]*) controller_log_event warn routine_state_invalid "profile=$routine_profile"; continue ;; esac
        case $routine_backend_reason_value in
            ok|source_missing|source_symlink|watch_unavailable|watch_setup_failed|watch_limit|\
            watch_stopped|poll_unreadable|poll_unavailable) ;;
            *) routine_backend_reason_value=ok; routine_backend_reason_previous=ok ;;
        esac
        # api_load_kv rejects a control byte anywhere in the state document and
        # api_error exits, so a pending reading that is not a cksum pair is
        # discarded here rather than written back into the snapshot's input.
        #
        # The unset sentinel is 0, not the word none. Two packaging tests prove
        # the poll established a baseline by searching the whole state document
        # for the fingerprint field's own unset marker as a substring, and a
        # second field whose name ends in fingerprint carrying that same marker
        # would satisfy the search for the wrong reason. A real reading is always
        # a cksum pair and so always contains a colon; 0 cannot collide with one.
        case $routine_pending_fingerprint_value in
            0) ;;
            *) valid_source_fingerprint "$routine_pending_fingerprint_value" \
                || routine_pending_fingerprint_value=0 ;;
        esac
        due=false
        if [ "$routine_delete_bound" = true ]; then
            # The routine's own deletion bound is weaker than its profile's, so
            # it can never be admitted. This test used to sit above the state
            # read and continue straight out of the loop: a warn line every
            # five-second turn forever, and a snapshot frozen on whatever the
            # routine last did, with nothing anywhere saying why it stopped.
            #
            # backend is deliberately not $routine_mode here. realtime is a legal
            # mode and an illegal backend, and the manager, the in-process Rust
            # reader and this file each validate that field against the same
            # five-value set with a fail-closed exit, so writing it would blank
            # every dashboard panel rather than just this row. Nothing is
            # observing a routine that cannot run, which is what none means.
            if [ "$routine_state_value" != deferred ]; then
                routine_state_value=deferred
                routine_backend_value=none
                routine_backend_reason_value=ok
                write_routine_state "$routine_profile"
                controller_log_event warn routine_deferred "profile=$routine_profile reason=delete_bound" scheduler
            fi
            continue
        elif ! routine_clock_allows "$routine_mode" "$routine_weekdays" "$routine_start" "$routine_end"; then
            routine_state_value=deferred
            routine_backend_value=$routine_mode
            routine_backend_reason_value=ok
            write_routine_state "$routine_profile"
            append_activity routine.deferred "$routine_profile" deferred "Routine outside configured window" routines warn 2>/dev/null || true
            continue
        elif [ "$routine_retry_value" -gt 0 ]; then
            # A pending whole-action retry owns admission until its deadline.
            # Daily cadence and realtime events must not bypass the selected
            # fixed/exponential delay and accidentally consume another attempt.
            if [ "$routine_next_value" -eq 0 ]; then
                controller_log_event warn routine_state_invalid "profile=$routine_profile field=retry_deadline"
                continue
            elif [ "$routine_now" -ge "$routine_next_value" ]; then
                due=true
            else
                continue
            fi
        else
            case $routine_mode in
                interval)
                    routine_backend_value=interval
                    routine_backend_reason_value=ok
                    if [ "$routine_next_value" -eq 0 ]; then
                        routine_next_value=$((routine_now + routine_interval))
                        routine_state_value=scheduled
                        write_routine_state "$routine_profile"
                    elif [ "$routine_now" -ge "$routine_next_value" ]; then due=true; fi
                    ;;
                daily)
                    routine_backend_value=daily
                    routine_backend_reason_value=ok
                    routine_today=$(date +%Y-%m-%d)
                    if [ "$routine_last_day_value" != "$routine_today" ]; then due=true; fi
                    ;;
                realtime)
                    # The turn's instant can be arbitrarily old by the time this
                    # routine is reached: process_control_queue runs first, and so
                    # can a whole scheduled aggregate sync, which takes minutes.
                    # Every other mode compares that instant against its own
                    # persisted state, so staleness only delays it. Realtime
                    # compares it against a marker a separate process is writing
                    # right now, and judging a debounce window against an instant
                    # from before the window makes an ordinary event unreadable.
                    # Re-read the clock so the comparison is contemporaneous, and
                    # only ever move it forward.
                    routine_now_fresh=$(epoch_now)
                    case $routine_now_fresh in
                        ''|*[!0-9]*) ;;
                        *) [ "$routine_now_fresh" -le "$routine_now" ] || routine_now=$routine_now_fresh ;;
                    esac
                    # A source that is gone, replaced by a symlink, or missing
                    # from the profile used to continue here before anything was
                    # written: no state, no log line, no dashboard signal, and a
                    # live watcher still holding watches on a tree nothing reads.
                    if [ -z "$profile_source" ] || [ ! -d "$profile_source" ] || [ -L "$profile_source" ]; then
                        if [ -n "$profile_source" ] && [ -L "$profile_source" ]; then
                            routine_backend_reason_value=source_symlink
                            routine_source_reason=symlink
                        else
                            routine_backend_reason_value=source_missing
                            routine_source_reason=missing
                        fi
                        routine_backend_value=none
                        routine_state_value=deferred
                        terminate_realtime_watcher "$routine_profile"
                        reap_realtime_watchers
                        write_routine_state "$routine_profile"
                        if [ "$routine_backend_reason_value" != "$routine_backend_reason_previous" ]; then
                            controller_log_event warn routine_source_unavailable \
                                "profile=$routine_profile reason=$routine_source_reason"
                            append_activity routine.deferred "$routine_profile" deferred \
                                "Routine source is unavailable" routines warn 2>/dev/null || true
                        fi
                        continue
                    fi
                    if ensure_realtime_watcher "$routine_profile" "$profile_source"; then routine_backend_value=$realtime_backend; else routine_backend_value=polling; fi
                    routine_backend_reason_value=${realtime_watcher_reason:-ok}
                    watcher_event_path=$runtime_root/watch-$routine_profile.events
                    watcher_event_pending=false
                    if [ "$routine_backend_value" = inotify ]; then
                        if [ -L "$watcher_event_path" ] || [ ! -f "$watcher_event_path" ] || [ ! -r "$watcher_event_path" ]; then
                            controller_log_event warn routine_event_invalid "profile=$routine_profile"
                            continue
                        fi
                        if [ -s "$watcher_event_path" ]; then
                            watcher_event_pending=true
                            if [ "$routine_event_first_seen_value" -eq 0 ] \
                                || [ "$routine_event_first_seen_value" -gt "$routine_now" ]; then
                                routine_event_first_seen_value=$routine_now
                                # The ceiling is measured from this epoch, so the
                                # epoch has to outlive the turn that set it. A
                                # turn that leaves the event pending and not yet
                                # due reaches no other write: the poll block below
                                # requires the event not to be pending, and the
                                # consume path is only reached once due is true.
                                # Without this the field was recomputed as now on
                                # every five-second turn, the elapsed time never
                                # grew past a single turn, and the ceiling could
                                # never fire for the continuously-changing source
                                # it exists for. One write per pending episode,
                                # not one per turn, because the test above is
                                # false once the epoch is on disk.
                                write_routine_state "$routine_profile"
                            fi
                            watcher_event_status=0
                            realtime_event_due "$watcher_event_path" "$routine_now" "$routine_debounce" || watcher_event_status=$?
                            case $watcher_event_status in
                                0)
                                    routine_native_event_due=true
                                    routine_native_event_identity=$realtime_event_identity
                                    routine_native_watcher_pid=$realtime_watcher_pid
                                    due=true
                                    ;;
                                1)
                                    # A source under continuous change rewrites
                                    # the marker before any debounce completes,
                                    # so the native path on its own would never
                                    # dispatch. Bound the staleness at four
                                    # debounce periods, never less than one
                                    # minute past the debounce the operator
                                    # chose and never past the validated hour.
                                    routine_event_ceiling=$((routine_debounce * 4))
                                    if [ "$routine_event_ceiling" -lt $((routine_debounce + 60)) ]; then
                                        routine_event_ceiling=$((routine_debounce + 60))
                                    fi
                                    [ "$routine_event_ceiling" -le 3600 ] || routine_event_ceiling=3600
                                    if [ $((routine_now - routine_event_first_seen_value)) -ge "$routine_event_ceiling" ]; then
                                        # The marker's generation has almost
                                        # certainly moved since the due check, so
                                        # waive the identity match for this one
                                        # consume; without that the forced
                                        # dispatch is discarded in silence.
                                        routine_native_event_due=true
                                        routine_native_event_identity=0
                                        routine_native_watcher_pid=$realtime_watcher_pid
                                        routine_event_forced=true
                                        routine_event_forced_pending=$((routine_now - routine_event_first_seen_value))
                                        routine_event_forced_ceiling=$routine_event_ceiling
                                        due=true
                                    fi
                                    ;;
                                *)
                                    controller_log_event warn routine_event_invalid "profile=$routine_profile phase=debounce"
                                    continue
                                    ;;
                            esac
                        else
                            # An episode that ended without a consume -- a reload
                            # removed the marker, or the watcher was respawned --
                            # must clear the epoch on disk too, or a stale one
                            # would make the next episode look overdue from its
                            # very first turn. Gated on the transition, because
                            # an empty marker is the normal state.
                            if [ "$routine_event_first_seen_value" -ne 0 ]; then
                                routine_event_first_seen_value=0
                                write_routine_state "$routine_profile"
                            fi
                        fi
                    else
                        if [ "$routine_event_first_seen_value" -ne 0 ]; then
                            routine_event_first_seen_value=0
                            write_routine_state "$routine_profile"
                        fi
                    fi
                    if [ "$due" != true ] && [ "$watcher_event_pending" != true ] && [ $((routine_now - routine_last_poll_value)) -ge "$routine_poll" ]; then
                        # The poll clock advances on the attempt, not on success.
                        # It used to advance only after the walk had completed, so
                        # a failing poll left last_poll_epoch frozen and the gate
                        # above was satisfied again on the very next turn: a
                        # complete recursive walk of the source every five
                        # seconds, indefinitely, with a warn line each time.
                        routine_last_poll_value=$routine_now
                        routine_poll_status=0
                        routine_poll_output=$(source_fingerprint "$profile_source" 2>/dev/null) || routine_poll_status=$?
                        current_fingerprint=
                        routine_poll_walks=0
                        routine_poll_reason=
                        routine_poll_detail=
                        case $routine_poll_status in
                            0)
                                routine_poll_walks=${routine_poll_output%%|*}
                                current_fingerprint=${routine_poll_output#*|}
                                case $routine_poll_walks in
                                    [0-9]) ;;
                                    *) routine_poll_reason=empty; current_fingerprint= ;;
                                esac
                                if [ -n "$current_fingerprint" ] \
                                    && ! valid_source_fingerprint "$current_fingerprint"; then
                                    routine_poll_reason=empty
                                    current_fingerprint=
                                fi
                                ;;
                            70) routine_poll_reason=unreadable_subtree; routine_poll_detail=$routine_poll_output ;;
                            *) routine_poll_reason=fingerprint ;;
                        esac
                        if [ -n "$routine_poll_reason" ]; then
                            if [ "$routine_poll_reason" = unreadable_subtree ]; then
                                routine_backend_reason_value=poll_unreadable
                            else
                                routine_backend_reason_value=poll_unavailable
                            fi
                            write_routine_state "$routine_profile"
                            if [ "$routine_backend_reason_value" != "$routine_backend_reason_previous" ]; then
                                controller_log_event warn routine_poll_unavailable \
                                    "profile=$routine_profile reason=$routine_poll_reason detail=$routine_poll_detail"
                            fi
                            continue
                        fi
                        if [ "$routine_poll_walks" != 0 ]; then
                            routine_poll_retries_value=$((routine_poll_retries_value + routine_poll_walks))
                            [ "$routine_poll_retries_value" -le 999999999 ] || routine_poll_retries_value=999999999
                        fi
                        if [ "$routine_fingerprint_value" = none ] \
                            || ! valid_source_fingerprint "$routine_fingerprint_value"; then
                            # A baseline whose format this build does not
                            # recognise is adopted, not compared. That is what
                            # makes the first poll after an upgrade re-baseline in
                            # silence instead of dispatching one sync for every
                            # realtime routine whose source holds a pruned
                            # directory.
                            if [ "$routine_fingerprint_value" != none ]; then
                                controller_log_event info routine_fingerprint_rebased \
                                    "profile=$routine_profile"
                            fi
                            routine_fingerprint_value=$current_fingerprint
                            routine_pending_fingerprint_value=0
                            routine_pending_since_value=0
                            routine_state_value=scheduled
                            write_routine_state "$routine_profile"
                        elif [ "$routine_fingerprint_value" = "$current_fingerprint" ]; then
                            routine_pending_fingerprint_value=0
                            routine_pending_since_value=0
                            write_routine_state "$routine_profile"
                        elif [ "$routine_pending_fingerprint_value" = "$current_fingerprint" ]; then
                            # One unchanged reading is the cheapest evidence the
                            # source has stopped changing. Dispatching on the
                            # first difference syncs a copy that is still in
                            # progress and then syncs it again when it finishes.
                            routine_fingerprint_value=$current_fingerprint
                            routine_pending_fingerprint_value=0
                            routine_pending_since_value=0
                            due=true
                        else
                            routine_pending_fingerprint_value=$current_fingerprint
                            if [ "$routine_pending_since_value" -eq 0 ] \
                                || [ "$routine_pending_since_value" -gt "$routine_now" ]; then
                                routine_pending_since_value=$routine_now
                            fi
                            # A source that differs on every poll would replace
                            # the pending reading forever and never dispatch at
                            # all -- worse than the first-difference dispatch
                            # this quiet period exists to remove. Bound it the
                            # way the native ceiling bounds a continuously
                            # rewritten event marker, off poll_seconds.
                            routine_poll_pending=$((routine_now - routine_pending_since_value))
                            routine_poll_ceiling=$((routine_poll * 4))
                            if [ "$routine_poll_ceiling" -lt $((routine_poll + 60)) ]; then
                                routine_poll_ceiling=$((routine_poll + 60))
                            fi
                            [ "$routine_poll_ceiling" -le 3600 ] || routine_poll_ceiling=3600
                            if [ "$routine_poll_pending" -ge "$routine_poll_ceiling" ]; then
                                routine_fingerprint_value=$current_fingerprint
                                routine_pending_fingerprint_value=0
                                routine_pending_since_value=0
                                controller_log_event info routine_event_forced \
                                    "profile=$routine_profile pending_seconds=$routine_poll_pending ceiling=$routine_poll_ceiling"
                                due=true
                            else
                                write_routine_state "$routine_profile"
                            fi
                        fi
                    fi
                    ;;
            esac
        fi
        [ "$due" = true ] || continue
        if ! dependencies_allow "$routine_dependencies"; then
            routine_state_value=deferred
            routine_next_value=$((routine_now + 30))
            write_routine_state "$routine_profile"
            append_activity routine.deferred "$routine_profile" deferred "Routine dependency has not succeeded" routines warn 2>/dev/null || true
            continue
        fi
        # Do not start new work after TERM/INT was latched while this routine
        # was being evaluated. A signal after this check is covered again once
        # the direct child PID has been assigned below.
        [ "$shutdown" = false ] || break
        if [ "$routine_native_event_due" = true ]; then
            native_consume_status=0
            consume_realtime_event "$watcher_event_path" "$routine_native_watcher_pid" \
                "$routine_native_event_identity" || native_consume_status=$?
            case $native_consume_status in
                0)
                    if [ "$realtime_event_watcher_resumed" != true ]; then
                        controller_log_event warn routine_event_invalid "profile=$routine_profile phase=resume"
                    fi
                    if [ "$routine_event_forced" = true ]; then
                        controller_log_event info routine_event_forced \
                            "profile=$routine_profile pending_seconds=$routine_event_forced_pending ceiling=$routine_event_forced_ceiling"
                    fi
                    routine_event_first_seen_value=0
                    routine_last_poll_value=$routine_now
                    refreshed_fingerprint=
                    if refreshed_poll_output=$(source_fingerprint "$profile_source" 2>/dev/null); then
                        refreshed_fingerprint=${refreshed_poll_output#*|}
                        valid_source_fingerprint "$refreshed_fingerprint" || refreshed_fingerprint=
                    fi
                    if [ -n "$refreshed_fingerprint" ]; then
                        routine_fingerprint_value=$refreshed_fingerprint
                        routine_pending_fingerprint_value=0
                        routine_pending_since_value=0
                    else
                        controller_log_event warn routine_poll_unavailable "profile=$routine_profile reason=post_event_fingerprint detail="
                    fi
                    ;;
                1)
                    # A newer native event arrived after the due check. Keep
                    # the marker intact so its write time starts a new debounce.
                    continue
                    ;;
                *)
                    controller_log_event warn routine_event_invalid "profile=$routine_profile phase=consume"
                    continue
                    ;;
            esac
        fi
        routine_state_value=running
        routine_last_attempt_value=$routine_now
        write_routine_state "$routine_profile"
        if ! launch_admitted_child active routine "$runner" "$routine_action" \
            "$routine_profile" "$routine_delete" scheduled -; then
            [ "$admitted_child_status" != cancelled ] || return 0
            controller_log_event error child_identity_capture_failed "kind=routine"
            return 73
        fi
        active_control_classification=runner
        if [ "$shutdown" = true ]; then
            stop_work_children_bounded
        fi
        write_controller_state running "$$" "$next_run" "$active_pid"
        wait_for_runner
        routine_finished=$(epoch_now)
        # 130 is the core's cooperative-cancellation code and 143 a core
        # terminated by the runner's own TERM. Both mean an operator stopped the
        # package, or DSM rebooted, while this routine was running.
        routine_cancelled=false
        case $scheduled_exit in 130|143) routine_cancelled=true ;; esac
        if [ "$scheduled_exit" -eq 0 ]; then
            routine_state_value=succeeded
            routine_last_success_value=$routine_finished
            routine_retry_value=0
            case $routine_mode in interval) routine_next_value=$((routine_finished + routine_interval)) ;; daily) routine_last_day_value=$(date +%Y-%m-%d); routine_next_value=0 ;; realtime) routine_next_value=0 ;; esac
        elif [ "$routine_cancelled" = true ]; then
            # A cancelled run consumed no attempt, so retry_attempt is left
            # exactly where it was: a retry that was already owed is still owed,
            # and five package stops must not exhaust a ladder for a routine that
            # never failed. last_day is left alone too, so a daily routine
            # interrupted by a reboot still runs today rather than silently
            # skipping the day.
            #
            # The state stays failed. The only other value that reads as a
            # completion is succeeded, and that would satisfy the dependency gate
            # and last_success_epoch for a run that did not finish; the enum is
            # validated fail-closed by three readers, so there is no third value.
            routine_state_value=failed
            # A short floor rather than the routine's full cadence: prompt enough
            # that a package restart re-runs the interrupted sync straight away,
            # long enough that a core being signalled from outside cannot turn
            # into a continuous re-run. Only meaningful while no retry is owed,
            # because a pending retry owns admission through its own deadline.
            [ "$routine_retry_value" -gt 0 ] || routine_next_value=$((routine_finished + 30))
        else
            routine_state_value=failed
            if [ "$routine_retry_value" -lt "$routine_retries" ]; then
                routine_retry_value=$((routine_retry_value + 1))
                retry_delay=$(routine_retry_delay "$routine_backoff" "$routine_retry_value" "$routine_retry_exponential") || {
                    controller_log_event warn routine_invalid "profile=$routine_profile field=retry_delay"
                    continue
                }
                routine_next_value=$((routine_finished + retry_delay))
                append_activity routine.retry_scheduled "$routine_profile" scheduled "Routine retry scheduled in ${retry_delay}s" routines info 2>/dev/null || true
            else
                routine_retry_value=0
                case $routine_mode in interval) routine_next_value=$((routine_finished + routine_interval)) ;; daily) routine_last_day_value=$(date +%Y-%m-%d); routine_next_value=0 ;; realtime) routine_next_value=0 ;; esac
            fi
        fi
        write_routine_state "$routine_profile"
        if [ "$scheduled_exit" -eq 0 ] || [ "$routine_cancelled" = true ]; then routine_log_level=info; else routine_log_level=error; fi
        controller_log_event "$routine_log_level" routine_run \
            "profile=$routine_profile action=$routine_action exit=$scheduled_exit next=$routine_next_value backend=$routine_backend_value" scheduler
        # One routine per turn keeps control-plane latency and shutdown bounded.
        break
    done
}

shutdown=false
active_pid=
active_pid_start=
active_pid_boot=
active_control_classification=
control_pid=
control_pid_start=
control_pid_boot=
sleep_pid=
sleep_pid_start=
sleep_pid_boot=
runner_wait_guard_pid=
runner_wait_guard_start=
runner_wait_guard_boot=
runner_wait_guard_admission_path=
runner_wait_guard_stop_path=
runner_wait_guard_admitted=false
child_admission_sequence=0
admitted_child_status=
child_wait_interrupt_epoch=0
realtime_reap_pids=
next_run=0
wait_interrupted=false
reload_requested=false
queue_wake_requested=false

cleanup_controller() {
    # EXIT can follow an unexpected shell failure as well as the normal stop
    # path. Disable recursive traps, terminate both direct work children, and
    # reap them before releasing controller ownership.
    trap - 0
    trap '' TERM INT HUP USR2 ALRM
    stop_runner_wait_guard 2>/dev/null || true
    if [ -n "$sleep_pid" ]; then
        signal_controller_sleep
        reap_direct_child_interruption_safe "$sleep_pid"
        sleep_pid=
        sleep_pid_start=
        sleep_pid_boot=
    fi
    stop_work_children_bounded
    if [ -n "$control_pid" ]; then
        wait "$control_pid" 2>/dev/null || true
        control_pid=
        control_pid_start=
        control_pid_boot=
    fi
    if [ -n "$active_pid" ]; then
        wait "$active_pid" 2>/dev/null || true
        active_pid=
        active_pid_start=
        active_pid_boot=
    fi
    stop_realtime_watchers 2>/dev/null || true
    write_controller_state stopped 0 0 0 2>/dev/null || true
    remove_own_controller_ready 2>/dev/null || true
    current_pid=$(read_pid "$controller_pid_file" 2>/dev/null || true)
    if [ "$current_pid" = "$$" ]; then
        rm -f "$controller_pid_file"
    fi
    release_private_process_lock "$controller_lock" 2>/dev/null || true
}
request_shutdown() {
    child_wait_interrupt_epoch=$((child_wait_interrupt_epoch + 1))
    [ "$shutdown" = false ] || return 0
    shutdown=true
    wait_interrupted=true
    signal_controller_sleep
    stop_work_children_bounded
}
request_reload() {
    child_wait_interrupt_epoch=$((child_wait_interrupt_epoch + 1))
    reload_requested=true
    wait_interrupted=true
    signal_controller_sleep
}
request_queue_wake() {
    child_wait_interrupt_epoch=$((child_wait_interrupt_epoch + 1))
    queue_wake_requested=true
    wait_interrupted=true
    signal_controller_sleep
}
request_runner_wait_poll() {
    child_wait_interrupt_epoch=$((child_wait_interrupt_epoch + 1))
    wait_interrupted=true
}
trap request_shutdown TERM INT
trap request_reload HUP
trap request_queue_wake USR2
trap request_runner_wait_poll ALRM
trap cleanup_controller 0

controller_start_lease_matches_parent || {
    echo "controller startup lease is absent, stale, or not owned by the lifecycle parent" >&2
    exit 73
}
acquire_controller_lock
controller_start_lease_matches_parent || {
    echo "controller startup lease was cancelled before lock ownership" >&2
    exit 73
}
reconcile_audit_outbox || {
    controller_log_event error audit_reconcile_failed "phase=startup" controller true >/dev/null 2>&1 || true
    echo "pending mandatory audit records could not be reconciled" >&2
    exit 73
}
# Read and validate the complete policy, then inspect/prune the private queue
# before publishing readiness. A controller PID alone is deliberately not a
# readiness signal: any failure here must make lifecycle start fail cleanly.
prune_expired_control_files
inotify_watch_limit_path=/proc/sys/fs/inotify/max_user_watches
resolve_inotify_command
umask 077
controller_pid_temp=$controller_pid_file.tmp.$$
printf '%s\n' "$$" > "$controller_pid_temp"
finish_private_file "$controller_pid_temp"
mv -f "$controller_pid_temp" "$controller_pid_file"
write_controller_state running "$$" 0 0
# Keep the inherited parent-death signal fatal after all preflight and PID
# publication until the lifecycle parent commits the shared startup lease.
# After commit, a parent crash is recoverable from the exact PID/lock/socket
# topology, so the long-lived controller may safely ignore SIGUSR1.
wait_for_controller_start_commit || {
    echo "controller lifecycle parent did not commit startup" >&2
    exit 73
}
trap '' USR1
controller_start_lease_committed_matches_parent || {
    echo "controller startup commit changed before readiness" >&2
    exit 73
}
publish_controller_ready
unset SDSYNC_DSM_CONTROLLER_START_PARENT_PID SDSYNC_DSM_CONTROLLER_START_PARENT_TICKS \
    SDSYNC_DSM_CONTROLLER_START_PARENT_BOOT
while [ "$shutdown" = false ]; do
    # A signal received just before this reset is already followed by an
    # immediate queue turn. Signals received during the turn remain latched so
    # the sleep handoff below cannot lose them.
    queue_wake_requested=false
    if [ "$reload_requested" = true ]; then
        # Rebase the next deadline on the newly persisted cadence. This is what makes
        # a 1-hour -> 60-second reconfiguration take effect promptly after HUP.
        next_run=0
        stop_realtime_watchers 2>/dev/null || true
        # A saved performance level takes effect on the same HUP as a saved
        # schedule, so the dashboard's Save is what applies it rather than a
        # package restart.
        load_performance_policy_runtime
        reload_requested=false
    fi
    control_queue_progress=false
    process_control_queue
    load_schedule_runtime "$schedule_file"
    case $enabled in true|false) ;; *) enabled=false ;; esac
    case $allow_delete in true|false) ;; *) allow_delete=false ;; esac
    case $interval in ''|*[!0-9]*) interval=3600 ;; esac
    case $maximum_total in
        ''|*[!0-9]*)
            enabled=false
            maximum_total=100
            controller_log_event warn schedule_invalid "field=max_total_delete"
            ;;
        *)
            if ! decimal_at_most "$maximum_total" "$dsm_delete_limit"; then
                enabled=false
                maximum_total=100
                controller_log_event warn schedule_invalid "field=max_total_delete"
            fi
            ;;
    esac
    if [ "$interval" -lt 60 ] || [ "$interval" -gt 2592000 ]; then
        interval=3600
    fi

    now=$(epoch_now)
    if [ "$enabled" != true ]; then
        next_run=0
    elif [ "$next_run" -eq 0 ]; then
        next_run=$((now + interval))
    elif [ "$now" -ge "$next_run" ]; then
        # Do not start a scheduled aggregate after TERM/INT was latched. The
        # post-assignment check closes the asynchronous launch window.
        [ "$shutdown" = false ] || break
        write_controller_state running "$$" "$next_run" 0
        if ! launch_admitted_child active schedule "$runner" sync all \
            "$allow_delete" scheduled "$maximum_total"; then
            [ "$admitted_child_status" != cancelled ] || continue
            controller_log_event error child_identity_capture_failed "kind=schedule"
            exit 73
        fi
        active_control_classification=runner
        if [ "$shutdown" = true ]; then
            stop_work_children_bounded
        fi
        write_controller_state running "$$" "$next_run" "$active_pid"
        wait_for_runner
        run_exit=$scheduled_exit
        now=$(epoch_now)
        next_run=$((now + interval))
        # Failure is recorded by sdsync-run and does not trigger an immediate retry.
        if [ "$run_exit" -eq 0 ]; then scheduled_log_level=info; else scheduled_log_level=error; fi
        controller_log_event "$scheduled_log_level" scheduled_run "exit=$run_exit next=$next_run" scheduler
    fi

    [ "$shutdown" = false ] || break
    now=$(epoch_now)
    process_routines "$now"

    [ "$shutdown" = false ] || break

    # A backlog already present on disk does not need another signal or the
    # historical one-second polling fallback. Each loop still processes only
    # one request and runs the schedule/routine admission checks above, so
    # control work cannot starve those paths. Ignore malformed/unsafe entries
    # here to avoid a tight loop around a request the consumer will reject.
    control_backlog=false
    for wake_request in "$control_requests"/*.json; do
        [ -e "$wake_request" ] || [ -L "$wake_request" ] || continue
        wake_name=${wake_request##*/}
        wake_id=${wake_name%.json}
        valid_request_id "$wake_id" && private_control_file "$wake_request" || continue
        wake_processing=$control_processing/$wake_name
        [ ! -e "$wake_processing" ] && [ ! -L "$wake_processing" ] || continue
        control_backlog=true
        break
    done
    if [ "$control_queue_progress" = true ] && [ "$control_backlog" = true ]; then
        write_controller_state running "$$" "$next_run" 0
        continue
    fi

    write_controller_state running "$$" "$next_run" 0
    sleep_for=30
    for wake_routine in "$routines_dir"/*.conf; do
        [ -e "$wake_routine" ] || [ -L "$wake_routine" ] || continue
        sleep_for=5
        break
    done
    for wake_request in "$control_requests"/*.json; do
        [ -e "$wake_request" ] || [ -L "$wake_request" ] || continue
        sleep_for=1
        break
    done
    if [ "$enabled" = true ] && [ "$next_run" -gt "$now" ]; then
        remaining=$((next_run - now))
        if [ "$remaining" -lt "$sleep_for" ]; then
            sleep_for=$remaining
        fi
    fi
    [ "$sleep_for" -gt 0 ] || sleep_for=1
    if ! launch_admitted_child sleep controller_sleep sleep "$sleep_for"; then
        [ "$admitted_child_status" != cancelled ] || continue
        controller_log_event error child_identity_capture_failed "kind=controller_sleep"
        exit 73
    fi
    # Close every signal-before-publication race: a handler either stops the
    # fully published sleep tuple or leaves its latch set for this exact recheck.
    if [ "$shutdown" = true ] || [ "$reload_requested" = true ] || \
        [ "$queue_wake_requested" = true ]; then
        signal_controller_sleep
    fi
    reap_direct_child_interruption_safe "$sleep_pid"
    sleep_pid=
    sleep_pid_start=
    sleep_pid_boot=
done

exit 0
