#!/bin/sh
set -eu

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
# shellcheck source=sdsync-common
. "$script_dir/sdsync-common"

require_package_identity
ensure_layout
controller_log=$log_root/controller.log
[ ! -L "$controller_log" ] || { echo "refusing symlinked controller log: $controller_log" >&2; exit 73; }
rotate_log "$controller_log" 10485760 5
[ ! -f "$controller_log" ] || finish_private_file "$controller_log"

acquire_controller_lock() {
    if mkdir "$controller_lock" 2>/dev/null; then
        chmod 0700 "$controller_lock"
        set_private_owner "$controller_lock"
        return 0
    fi
    if [ -L "$controller_lock" ] || [ ! -d "$controller_lock" ]; then
        echo "controller lock is not a private directory: $controller_lock" >&2
        return 73
    fi
    existing_pid=$(read_pid "$controller_pid_file" 2>/dev/null || true)
    if [ -n "$existing_pid" ] && pid_is_live "$existing_pid"; then
        echo "controller already runs as PID $existing_pid" >&2
        return 75
    fi
    rmdir "$controller_lock" 2>/dev/null || {
        echo "cannot recover stale controller lock safely: $controller_lock" >&2
        return 73
    }
    mkdir "$controller_lock"
    chmod 0700 "$controller_lock"
    set_private_owner "$controller_lock"
}

valid_request_id() {
    case ${1:-} in ''|*[!a-f0-9]*) return 1 ;; esac
    [ "${#1}" -eq 48 ]
}

private_control_file() {
    control_path=$1
    [ -f "$control_path" ] && [ ! -L "$control_path" ] && [ -r "$control_path" ] || return 1
    control_mode=$(stat -c '%a' "$control_path" 2>/dev/null || true)
    control_owner=$(stat -c '%u' "$control_path" 2>/dev/null || true)
    [ "$control_mode" = 600 ] && [ -n "$path_owner" ] && [ "$control_owner" = "$path_owner" ]
}

control_file_expired() {
    expiry_path=$1
    expiry_now=$2
    expiry_max_age=$3
    private_control_file "$expiry_path" || return 1
    expiry_mtime=$(stat -c '%Y' "$expiry_path" 2>/dev/null || true)
    case $expiry_mtime in ''|*[!0-9]*) return 1 ;; esac
    [ "$expiry_mtime" -le "$expiry_now" ] || return 1
    [ $((expiry_now - expiry_mtime)) -gt "$expiry_max_age" ]
}

prune_expired_control_files() {
    prune_now=$(epoch_now)
    case $prune_now in ''|*[!0-9]*) return 0 ;; esac
    for prune_dir in "$control_requests" "$control_processing" "$control_responses"; do
        case $prune_dir in
            "$control_requests") prune_max_age=86400; prune_kind=request ;;
            "$control_processing") prune_max_age=3600; prune_kind=processing_indeterminate ;;
            *) prune_max_age=3600; prune_kind=response ;;
        esac
        for prune_path in "$prune_dir"/*.json "$prune_dir"/*.secret; do
            [ -e "$prune_path" ] || [ -L "$prune_path" ] || continue
            prune_name=${prune_path##*/}
            case $prune_name in *.json) prune_id=${prune_name%.json} ;; *.secret) prune_id=${prune_name%.secret} ;; *) continue ;; esac
            valid_request_id "$prune_id" || continue
            if control_file_expired "$prune_path" "$prune_now" "$prune_max_age"; then
                rm -f "$prune_path"
                append_rotating_log "$controller_log" 10485760 5 "control_file_expired id=$prune_id kind=$prune_kind"
            fi
        done
    done
}

process_control_queue() {
    prune_expired_control_files
    [ -x "$api_bridge" ] && [ ! -L "$api_bridge" ] || return 0
    # The authenticated bridge generates lexically sortable server job IDs with
    # a persisted monotonic prefix.  Shell glob order therefore remains FIFO
    # even on DSM filesystems whose mtimes are only second-resolution.
    for queued_request in "$control_requests"/*.json; do
        [ -e "$queued_request" ] || [ -L "$queued_request" ] || continue
        queued_name=${queued_request##*/}
        queued_id=${queued_name%.json}
        if ! valid_request_id "$queued_id" || ! private_control_file "$queued_request"; then
            append_rotating_log "$controller_log" 10485760 5 "control_request_rejected file=$queued_name"
            continue
        fi
        queued_size=$(wc -c < "$queued_request" | tr -d ' ')
        case $queued_size in ''|*[!0-9]*) queued_size=65537 ;; esac
        if [ "$queued_size" -gt 65536 ]; then
            append_rotating_log "$controller_log" 10485760 5 "control_request_rejected id=$queued_id reason=size"
            continue
        fi
        processing_request=$control_processing/$queued_name
        [ ! -e "$processing_request" ] && [ ! -L "$processing_request" ] || {
            append_rotating_log "$controller_log" 10485760 5 "control_request_collision id=$queued_id"
            continue
        }
        mv "$queued_request" "$processing_request" || continue
        queued_secret=$control_requests/$queued_id.secret
        processing_secret=$control_processing/$queued_id.secret
        if [ -e "$queued_secret" ] || [ -L "$queued_secret" ]; then
            if private_control_file "$queued_secret" && [ ! -e "$processing_secret" ] && [ ! -L "$processing_secret" ]; then
                mv "$queued_secret" "$processing_secret" || true
            else
                append_rotating_log "$controller_log" 10485760 5 "control_secret_rejected id=$queued_id"
            fi
        fi
        response_final=$control_responses/$queued_id.json
        [ ! -e "$response_final" ] && [ ! -L "$response_final" ] || {
            append_rotating_log "$controller_log" 10485760 5 "control_response_rejected id=$queued_id"
            rm -f "$processing_request"
            [ ! -L "$processing_secret" ] && rm -f "$processing_secret" 2>/dev/null || true
            continue
        }
        "$api_bridge" --consume-job "$processing_request" "$response_final" &
        active_pid=$!
        # TERM can be delivered after the asynchronous launch but before the
        # assignment above. Recheck the latched shutdown state so that window
        # cannot strand an un-signalled consumer before it creates a run lock.
        if [ "$shutdown" = true ] && pid_is_live "$active_pid"; then
            kill -TERM "$active_pid" 2>/dev/null || true
        fi
        write_controller_state running "$$" "$next_run" "$active_pid"
        wait_for_runner
        control_exit=$scheduled_exit
        response_size=0
        if private_control_file "$response_final"; then
            response_size=$(wc -c < "$response_final" | tr -d ' ')
        fi
        case $response_size in ''|*[!0-9]*) response_size=1048577 ;; esac
        if [ "$control_exit" -ne 0 ] || ! private_control_file "$response_final" || [ "$response_size" -gt 1048576 ]; then
            append_rotating_log "$controller_log" 10485760 5 "control_consumer_failed id=$queued_id exit=$control_exit"
        fi
        rm -f "$processing_request"
        if [ -e "$processing_secret" ] && [ ! -L "$processing_secret" ]; then rm -f "$processing_secret"; fi
        # Consume one bounded request per controller turn so normal schedules and
        # shutdown signals cannot be starved by a dashboard client.
        break
    done
    response_count=0
    for old_response in "$control_responses"/*.json; do
        [ -e "$old_response" ] || [ -L "$old_response" ] || continue
        old_name=${old_response##*/}; old_id=${old_name%.json}
        valid_request_id "$old_id" || continue
        private_control_file "$old_response" || continue
        response_count=$((response_count + 1))
    done
    responses_to_remove=$((response_count - 256))
    [ "$responses_to_remove" -gt 0 ] || return 0
    for old_response in "$control_responses"/*.json; do
        [ "$responses_to_remove" -gt 0 ] || break
        [ -e "$old_response" ] || [ -L "$old_response" ] || continue
        old_name=${old_response##*/}; old_id=${old_name%.json}
        valid_request_id "$old_id" && private_control_file "$old_response" || continue
        rm -f "$old_response"
        responses_to_remove=$((responses_to_remove - 1))
    done
}

stop_realtime_watchers() {
    for watcher_pid_file in "$runtime_root"/watch-*.pid; do
        [ -f "$watcher_pid_file" ] && [ ! -L "$watcher_pid_file" ] || continue
        watcher_pid=$(read_pid "$watcher_pid_file" 2>/dev/null || true)
        if [ -n "$watcher_pid" ] && [ -n "${inotify_command:-}" ] && pid_matches_command "$watcher_pid" "$inotify_command"; then
            kill -TERM "$watcher_pid" 2>/dev/null || true
        fi
        rm -f "$watcher_pid_file"
    done
    for watcher_events in "$runtime_root"/watch-*.events; do
        [ -f "$watcher_events" ] && [ ! -L "$watcher_events" ] && rm -f "$watcher_events" || true
    done
    for watcher_failure in "$runtime_root"/watch-*.failed; do
        [ -f "$watcher_failure" ] && [ ! -L "$watcher_failure" ] && rm -f "$watcher_failure" || true
    done
}

ensure_realtime_watcher() {
    watcher_profile=$1
    watcher_source=$2
    realtime_backend=polling
    [ -n "${inotify_command:-}" ] || return 0
    watcher_pid_path=$runtime_root/watch-$watcher_profile.pid
    watcher_event_path=$runtime_root/watch-$watcher_profile.events
    watcher_failure_path=$runtime_root/watch-$watcher_profile.failed
    [ ! -L "$watcher_pid_path" ] && [ ! -L "$watcher_event_path" ] && [ ! -L "$watcher_failure_path" ] || return 73
    watcher_existing=$(read_pid "$watcher_pid_path" 2>/dev/null || true)
    if [ -n "$watcher_existing" ] && pid_matches_command "$watcher_existing" "$inotify_command"; then
        realtime_backend=inotify
        return 0
    fi
    if [ -f "$watcher_pid_path" ]; then
        rm -f "$watcher_pid_path"
        printf '%s\n' "$(epoch_now)" > "$watcher_failure_path"
        finish_private_file "$watcher_failure_path"
        return 0
    fi
    if [ -f "$watcher_failure_path" ]; then
        IFS= read -r watcher_failed_epoch < "$watcher_failure_path" || watcher_failed_epoch=0
        case $watcher_failed_epoch in ''|*[!0-9]*) watcher_failed_epoch=0 ;; esac
        watcher_now=$(epoch_now)
        if [ $((watcher_now - watcher_failed_epoch)) -lt 300 ]; then return 0; fi
        rm -f "$watcher_failure_path"
    fi
    : > "$watcher_event_path"
    finish_private_file "$watcher_event_path"
    "$inotify_command" -m -q -r -e close_write,create,delete,move "$watcher_source" \
        >> "$watcher_event_path" 2>> "$controller_log" &
    watcher_pid=$!
    printf '%s\n' "$watcher_pid" > "$watcher_pid_path"
    finish_private_file "$watcher_pid_path"
    realtime_backend=inotify
}

source_fingerprint() {
    fingerprint_source=$1
    if ! command -v find >/dev/null 2>&1 || ! command -v cksum >/dev/null 2>&1 || ! command -v stat >/dev/null 2>&1; then
        return 69
    fi
    find "$fingerprint_source" -type f -exec stat -c '%n|%s|%Y' {} \; 2>/dev/null |
        LC_ALL=C sort | cksum | awk '{ print $1 ":" $2 }'
}

time_window_allows() {
    allowed_weekdays=$1
    allowed_start=$2
    allowed_end=$3
    current_weekday=$(date +%u)
    case ,$allowed_weekdays, in *,$current_weekday,*) ;; *) return 1 ;; esac
    current_clock=$(date +%H%M)
    window_start=$(printf '%s' "$allowed_start" | tr -d ':')
    window_end=$(printf '%s' "$allowed_end" | tr -d ':')
    current_clock=${current_clock#0}; [ -n "$current_clock" ] || current_clock=0
    window_start=${window_start#0}; [ -n "$window_start" ] || window_start=0
    window_end=${window_end#0}; [ -n "$window_end" ] || window_end=0
    if [ "$window_start" -le "$window_end" ]; then
        [ "$current_clock" -ge "$window_start" ] && [ "$current_clock" -le "$window_end" ]
    else
        [ "$current_clock" -ge "$window_start" ] || [ "$current_clock" -le "$window_end" ]
    fi
}

dependencies_allow() {
    dependency_list=$1
    [ -n "$dependency_list" ] || return 0
    dependency_old_ifs=$IFS; IFS=,
    for dependency_name in $dependency_list; do
        IFS=$dependency_old_ifs
        case $dependency_name in ''|*[!A-Za-z0-9_-]*) IFS=$dependency_old_ifs; return 1 ;; esac
        dependency_state_file=$profile_state_dir/$dependency_name.state
        [ -f "$dependency_state_file" ] && [ ! -L "$dependency_state_file" ] || { IFS=$dependency_old_ifs; return 1; }
        [ "$(setting "$dependency_state_file" state never)" = succeeded ] || { IFS=$dependency_old_ifs; return 1; }
        IFS=,
    done
    IFS=$dependency_old_ifs
}

write_routine_state() {
    routine_state_profile=$1
    routine_state_temp=$routine_state_dir/.${routine_state_profile}.state.$$
    {
        printf 'state=%s\nnext_run_epoch=%s\nlast_success_epoch=%s\nlast_attempt_epoch=%s\n' \
            "$routine_state_value" "$routine_next_value" "$routine_last_success_value" "$routine_last_attempt_value"
        printf 'retry_attempt=%s\nlast_day=%s\nlast_poll_epoch=%s\nfingerprint=%s\nbackend=%s\n' \
            "$routine_retry_value" "$routine_last_day_value" "$routine_last_poll_value" "$routine_fingerprint_value" "$routine_backend_value"
    } > "$routine_state_temp"
    finish_private_file "$routine_state_temp"
    mv -f "$routine_state_temp" "$routine_state_dir/$routine_state_profile.state"
}

wait_for_runner() {
    previous_wait_status=
    while :; do
        wait_interrupted=false
        set +e
        wait "$active_pid"
        current_wait_status=$?
        set -e
        if [ "$wait_interrupted" = true ]; then previous_wait_status=$current_wait_status; continue; fi
        if [ "$current_wait_status" -eq 127 ] && [ -n "$previous_wait_status" ]; then scheduled_exit=$previous_wait_status; else scheduled_exit=$current_wait_status; fi
        break
    done
    active_pid=
}

process_routines() {
    routine_now=$1
    for routine_config in "$routines_dir"/*.conf; do
        [ -e "$routine_config" ] || [ -L "$routine_config" ] || continue
        if [ -L "$routine_config" ] || [ ! -f "$routine_config" ] || [ ! -r "$routine_config" ]; then
            append_rotating_log "$controller_log" 10485760 5 "routine_config_rejected"
            continue
        fi
        routine_profile=${routine_config##*/}; routine_profile=${routine_profile%.conf}
        case $routine_profile in ''|*[!A-Za-z0-9_-]*) append_rotating_log "$controller_log" 10485760 5 "routine_name_rejected"; continue ;; esac
        profile_exists "$routine_profile" || { append_rotating_log "$controller_log" 10485760 5 "routine_profile_missing profile=$routine_profile"; continue; }
        routine_enabled=$(setting "$routine_config" enabled false)
        routine_action=$(setting "$routine_config" action sync)
        routine_mode=$(setting "$routine_config" mode interval)
        routine_interval=$(setting "$routine_config" interval_seconds 3600)
        routine_weekdays=$(setting "$routine_config" weekdays 1,2,3,4,5,6,7)
        routine_start=$(setting "$routine_config" time_window_start 00:00)
        routine_end=$(setting "$routine_config" time_window_end 23:59)
        routine_debounce=$(setting "$routine_config" debounce_seconds 5)
        routine_retries=$(setting "$routine_config" retry_count 2)
        routine_backoff=$(setting "$routine_config" retry_backoff_seconds 60)
        routine_poll=$(setting "$routine_config" poll_seconds 30)
        routine_delete=$(setting "$routine_config" allow_delete false)
        routine_max_total=$(setting "$routine_config" max_total_delete 100)
        routine_dependencies=$(setting "$routine_config" depends_on '')
        case $routine_enabled:$routine_delete in true:true|true:false|false:true|false:false) ;; *) append_rotating_log "$controller_log" 10485760 5 "routine_invalid profile=$routine_profile field=boolean"; continue ;; esac
        [ "$routine_enabled" = true ] || continue
        case $routine_action in plan|sync) ;; *) append_rotating_log "$controller_log" 10485760 5 "routine_invalid profile=$routine_profile field=action"; continue ;; esac
        case $routine_mode in interval|daily|realtime) ;; *) append_rotating_log "$controller_log" 10485760 5 "routine_invalid profile=$routine_profile field=mode"; continue ;; esac
        case $routine_interval:$routine_debounce:$routine_retries:$routine_backoff:$routine_poll:$routine_max_total in *[!0-9:]*) append_rotating_log "$controller_log" 10485760 5 "routine_invalid profile=$routine_profile field=number"; continue ;; esac
        [ "$routine_interval" -ge 60 ] && [ "$routine_interval" -le 2592000 ] || continue
        [ "$routine_debounce" -ge 1 ] && [ "$routine_debounce" -le 3600 ] || continue
        [ "$routine_retries" -le 5 ] || continue
        [ "$routine_backoff" -ge 10 ] && [ "$routine_backoff" -le 86400 ] || continue
        [ "$routine_poll" -ge 5 ] && [ "$routine_poll" -le 3600 ] || continue
        printf '%s\n' "$routine_weekdays" | grep -Eq '^[1-7](,[1-7])*$' || continue
        printf '%s\n' "$routine_start" | grep -Eq '^([0-1][0-9]|2[0-3]):[0-5][0-9]$' || continue
        printf '%s\n' "$routine_end" | grep -Eq '^([0-1][0-9]|2[0-3]):[0-5][0-9]$' || continue
        routine_profile_max=$(sed -n 's/^max-delete = //p' "$profiles_dir/$routine_profile.toml" | sed -n '1p')
        case $routine_profile_max in ''|*[!0-9]*) continue ;; esac
        if [ "$routine_delete" = true ] && [ "$routine_max_total" -lt "$routine_profile_max" ]; then
            append_rotating_log "$controller_log" 10485760 5 "routine_deferred profile=$routine_profile reason=delete_bound"
            continue
        fi
        routine_state_path=$routine_state_dir/$routine_profile.state
        if [ -L "$routine_state_path" ]; then append_rotating_log "$controller_log" 10485760 5 "routine_state_rejected profile=$routine_profile"; continue; fi
        routine_state_value=$(setting "$routine_state_path" state never)
        routine_next_value=$(setting "$routine_state_path" next_run_epoch 0)
        routine_last_success_value=$(setting "$routine_state_path" last_success_epoch 0)
        routine_last_attempt_value=$(setting "$routine_state_path" last_attempt_epoch 0)
        routine_retry_value=$(setting "$routine_state_path" retry_attempt 0)
        routine_last_day_value=$(setting "$routine_state_path" last_day none)
        routine_last_poll_value=$(setting "$routine_state_path" last_poll_epoch 0)
        routine_fingerprint_value=$(setting "$routine_state_path" fingerprint none)
        routine_backend_value=$(setting "$routine_state_path" backend none)
        case $routine_state_value in never|scheduled|running|succeeded|failed|deferred) ;; *) append_rotating_log "$controller_log" 10485760 5 "routine_state_invalid profile=$routine_profile"; continue ;; esac
        case $routine_next_value:$routine_last_success_value:$routine_last_attempt_value:$routine_retry_value:$routine_last_poll_value in *[!0-9:]*) append_rotating_log "$controller_log" 10485760 5 "routine_state_invalid profile=$routine_profile"; continue ;; esac
        due=false
        if [ "$routine_retry_value" -gt 0 ] && [ "$routine_next_value" -gt 0 ] && [ "$routine_now" -ge "$routine_next_value" ]; then
            due=true
        elif ! time_window_allows "$routine_weekdays" "$routine_start" "$routine_end"; then
            routine_state_value=deferred
            routine_backend_value=$routine_mode
            write_routine_state "$routine_profile"
            append_activity routine.deferred "$routine_profile" deferred "Routine outside configured window" 2>/dev/null || true
            continue
        else
            case $routine_mode in
                interval)
                    routine_backend_value=interval
                    if [ "$routine_next_value" -eq 0 ]; then
                        routine_next_value=$((routine_now + routine_interval))
                        routine_state_value=scheduled
                        write_routine_state "$routine_profile"
                    elif [ "$routine_now" -ge "$routine_next_value" ]; then due=true; fi
                    ;;
                daily)
                    routine_backend_value=daily
                    routine_today=$(date +%Y-%m-%d)
                    if [ "$routine_last_day_value" != "$routine_today" ]; then due=true; fi
                    ;;
                realtime)
                    profile_source=$(sed -n 's/^source = "\(.*\)"$/\1/p' "$profiles_dir/$routine_profile.toml" | sed -n '1p')
                    [ -d "$profile_source" ] && [ ! -L "$profile_source" ] || continue
                    if ensure_realtime_watcher "$routine_profile" "$profile_source"; then routine_backend_value=$realtime_backend; else routine_backend_value=polling; fi
                    watcher_event_path=$runtime_root/watch-$routine_profile.events
                    if [ "$routine_backend_value" = inotify ] && [ -s "$watcher_event_path" ] && [ $((routine_now - routine_last_attempt_value)) -ge "$routine_debounce" ]; then
                        : > "$watcher_event_path"; finish_private_file "$watcher_event_path"; due=true
                    elif [ $((routine_now - routine_last_poll_value)) -ge "$routine_poll" ]; then
                        current_fingerprint=$(source_fingerprint "$profile_source" 2>/dev/null || true)
                        [ -n "$current_fingerprint" ] || { append_rotating_log "$controller_log" 10485760 5 "routine_poll_unavailable profile=$routine_profile"; continue; }
                        routine_last_poll_value=$routine_now
                        if [ "$routine_fingerprint_value" = none ]; then
                            routine_fingerprint_value=$current_fingerprint
                            routine_state_value=scheduled
                            write_routine_state "$routine_profile"
                        elif [ "$routine_fingerprint_value" != "$current_fingerprint" ]; then
                            routine_fingerprint_value=$current_fingerprint; due=true
                        else
                            write_routine_state "$routine_profile"
                        fi
                    fi
                    ;;
            esac
        fi
        [ "$due" = true ] || continue
        if ! dependencies_allow "$routine_dependencies"; then
            routine_state_value=deferred
            routine_next_value=$((routine_now + 30))
            write_routine_state "$routine_profile"
            append_activity routine.deferred "$routine_profile" deferred "Routine dependency has not succeeded" 2>/dev/null || true
            continue
        fi
        # Do not start new work after TERM/INT was latched while this routine
        # was being evaluated. A signal after this check is covered again once
        # the direct child PID has been assigned below.
        [ "$shutdown" = false ] || break
        routine_state_value=running
        routine_last_attempt_value=$routine_now
        write_routine_state "$routine_profile"
        "$runner" "$routine_action" "$routine_profile" "$routine_delete" scheduled - &
        active_pid=$!
        if [ "$shutdown" = true ] && pid_is_live "$active_pid"; then
            kill -TERM "$active_pid" 2>/dev/null || true
        fi
        write_controller_state running "$$" "$next_run" "$active_pid"
        wait_for_runner
        routine_finished=$(epoch_now)
        if [ "$scheduled_exit" -eq 0 ]; then
            routine_state_value=succeeded
            routine_last_success_value=$routine_finished
            routine_retry_value=0
            case $routine_mode in interval) routine_next_value=$((routine_finished + routine_interval)) ;; daily) routine_last_day_value=$(date +%Y-%m-%d); routine_next_value=0 ;; realtime) routine_next_value=0 ;; esac
        else
            routine_state_value=failed
            if [ "$routine_retry_value" -lt "$routine_retries" ]; then
                routine_retry_value=$((routine_retry_value + 1))
                retry_delay=$routine_backoff
                retry_index=1
                while [ "$retry_index" -lt "$routine_retry_value" ]; do retry_delay=$((retry_delay * 2)); [ "$retry_delay" -le 2592000 ] || { retry_delay=2592000; break; }; retry_index=$((retry_index + 1)); done
                routine_next_value=$((routine_finished + retry_delay))
                append_activity routine.retry_scheduled "$routine_profile" scheduled "Routine retry scheduled" 2>/dev/null || true
            else
                routine_retry_value=0
                case $routine_mode in interval) routine_next_value=$((routine_finished + routine_interval)) ;; daily) routine_last_day_value=$(date +%Y-%m-%d); routine_next_value=0 ;; realtime) routine_next_value=0 ;; esac
            fi
        fi
        write_routine_state "$routine_profile"
        append_rotating_log "$controller_log" 10485760 5 \
            "routine_run profile=$routine_profile action=$routine_action exit=$scheduled_exit next=$routine_next_value backend=$routine_backend_value"
        # One routine per turn keeps control-plane latency and shutdown bounded.
        break
    done
}

acquire_controller_lock
inotify_command=$(command -v inotifywait 2>/dev/null || true)
umask 077
controller_pid_temp=$controller_pid_file.tmp.$$
printf '%s\n' "$$" > "$controller_pid_temp"
finish_private_file "$controller_pid_temp"
mv -f "$controller_pid_temp" "$controller_pid_file"

shutdown=false
active_pid=
sleep_pid=
next_run=0
wait_interrupted=false
reload_requested=false

cleanup_controller() {
    stop_realtime_watchers 2>/dev/null || true
    write_controller_state stopped 0 0 0 2>/dev/null || true
    current_pid=$(read_pid "$controller_pid_file" 2>/dev/null || true)
    if [ "$current_pid" = "$$" ]; then
        rm -f "$controller_pid_file"
        rmdir "$controller_lock" 2>/dev/null || true
    fi
}
request_shutdown() {
    shutdown=true
    wait_interrupted=true
    if [ -n "$sleep_pid" ] && pid_is_live "$sleep_pid"; then
        kill -TERM "$sleep_pid" 2>/dev/null || true
    fi
    if [ -n "$active_pid" ] && pid_is_live "$active_pid"; then
        kill -TERM "$active_pid" 2>/dev/null || true
    fi
}
request_reload() {
    reload_requested=true
    wait_interrupted=true
    if [ -n "$sleep_pid" ] && pid_is_live "$sleep_pid"; then
        kill -TERM "$sleep_pid" 2>/dev/null || true
    fi
}
trap request_shutdown TERM INT
trap request_reload HUP
trap cleanup_controller 0

write_controller_state running "$$" 0 0
while [ "$shutdown" = false ]; do
    if [ "$reload_requested" = true ]; then
        # Rebase the next deadline on the newly persisted cadence. This is what makes
        # a 1-hour -> 60-second reconfiguration take effect promptly after HUP.
        next_run=0
        stop_realtime_watchers 2>/dev/null || true
        reload_requested=false
    fi
    process_control_queue
    enabled=$(setting "$schedule_file" enabled false)
    interval=$(setting "$schedule_file" interval_seconds 3600)
    allow_delete=$(setting "$schedule_file" allow_delete false)
    maximum_total=$(setting "$schedule_file" max_total_delete 100)
    case $enabled in true|false) ;; *) enabled=false ;; esac
    case $allow_delete in true|false) ;; *) allow_delete=false ;; esac
    case $interval in ''|*[!0-9]*) interval=3600 ;; esac
    case $maximum_total in ''|*[!0-9]*) maximum_total=100 ;; esac
    if [ "$interval" -lt 60 ] || [ "$interval" -gt 2592000 ]; then
        interval=3600
    fi

    now=$(epoch_now)
    if [ "$enabled" != true ]; then
        next_run=0
    elif [ "$next_run" -eq 0 ]; then
        next_run=$((now + interval))
    elif [ "$now" -ge "$next_run" ]; then
        # Do not start a scheduled aggregate after TERM/INT was latched. The
        # post-assignment check closes the asynchronous launch window.
        [ "$shutdown" = false ] || break
        write_controller_state running "$$" "$next_run" 0
        "$runner" sync all "$allow_delete" scheduled "$maximum_total" &
        active_pid=$!
        if [ "$shutdown" = true ] && pid_is_live "$active_pid"; then
            kill -TERM "$active_pid" 2>/dev/null || true
        fi
        write_controller_state running "$$" "$next_run" "$active_pid"
        previous_wait_status=
        while :; do
            wait_interrupted=false
            set +e
            wait "$active_pid"
            current_wait_status=$?
            set -e
            if [ "$wait_interrupted" = true ]; then
                previous_wait_status=$current_wait_status
                continue
            fi
            if [ "$current_wait_status" -eq 127 ] && [ -n "$previous_wait_status" ]; then
                run_exit=$previous_wait_status
            else
                run_exit=$current_wait_status
            fi
            break
        done
        active_pid=
        now=$(epoch_now)
        next_run=$((now + interval))
        # Failure is recorded by sdsync-run and does not trigger an immediate retry.
        append_rotating_log "$controller_log" 10485760 5 \
            "scheduled_run exit=$run_exit next=$next_run"
    fi

    [ "$shutdown" = false ] || break
    now=$(epoch_now)
    process_routines "$now"

    [ "$shutdown" = false ] || break

    write_controller_state running "$$" "$next_run" 0
    sleep_for=30
    if [ -n "$(find "$routines_dir" -type f -name '*.conf' -print -quit 2>/dev/null)" ]; then sleep_for=5; fi
    if [ -n "$(find "$control_requests" -type f -name '*.json' -print -quit 2>/dev/null)" ]; then sleep_for=1; fi
    if [ "$enabled" = true ] && [ "$next_run" -gt "$now" ]; then
        remaining=$((next_run - now))
        if [ "$remaining" -lt "$sleep_for" ]; then
            sleep_for=$remaining
        fi
    fi
    [ "$sleep_for" -gt 0 ] || sleep_for=1
    sleep "$sleep_for" &
    sleep_pid=$!
    set +e
    wait "$sleep_pid"
    set -e
    sleep_pid=
done

exit 0
