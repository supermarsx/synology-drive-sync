#!/bin/sh
# Shared DSM package paths and narrowly scoped filesystem helpers.

package_name=synology-drive-sync
dsm_delete_limit=2147483647
package_base=/var/packages/$package_name
package_root=${SYNOPKG_PKGDEST:-$package_base/target}
package_home=${SYNOPKG_PKGHOME:-$package_base/home}
package_var_candidate=${SYNOPKG_PKGVAR:-$package_base/var}
package_var=$package_var_candidate

binary=$package_root/bin/synology-drive-sync
manager=$package_root/bin/sdsync-dsm
api_bridge=$package_root/bin/sdsync-dsm-api
controller=$package_root/libexec/sdsync-controller
runner=$package_root/libexec/sdsync-run
config_root=$package_home/config
profiles_dir=$config_root/profiles.d
config_file=$config_root/config.toml
default_profile_file=$config_root/default-profile
schedule_file=$config_root/schedule.conf
routines_dir=$config_root/routines.d
alert_policy_file=$config_root/alerts.conf
security_policy_file=$config_root/security.conf
performance_policy_file=$config_root/performance.conf
secret_root=$package_home/secrets
state_root=$package_var/state
routine_state_dir=$state_root/routines
profile_state_dir=$state_root/profiles
health_dir=$state_root/health
cache_root=$state_root/cache
audit_outbox_dir=$state_root/audit-outbox
runtime_root=$package_var/run
control_root=$package_var/control
control_requests=$control_root/requests
control_processing=$control_root/processing
control_responses=$control_root/responses
control_staging=$control_root/staging
control_progress=$control_root/progress
log_root=$package_var/log
controller_log=$log_root/controller.log
activity_log=$log_root/activity.log
audit_log=$log_root/audit.log
doctor_inventory_log=$log_root/doctor-inventory.log
doctor_state=$state_root/doctor.state
alert_state=$state_root/alerts.state
dsm_system_log_state=$state_root/system-log.state
package_home_real=$(CDPATH='' cd -- "$package_home" 2>/dev/null && pwd -P || printf '%s' "$package_home")
package_var_real=$(CDPATH='' cd -- "$package_var" 2>/dev/null && pwd -P || printf '%s' "$package_var")
controller_pid_file=$runtime_root/controller.pid
controller_ready_file=$runtime_root/controller.ready
controller_start_file=$runtime_root/controller.starting
api_pid_file=$runtime_root/api.pid
api_bound_file=$runtime_root/api.bound
api_ready_file=$runtime_root/api.ready
controller_lock=$runtime_root/controller.lock
controller_state=$state_root/controller.state
service_stop_marker=$state_root/service-stopped.marker
run_lock=$runtime_root/run.lock
run_state=$state_root/run.state
management_lock=$runtime_root/management.lock
policy_execution_lock=$runtime_root/policy-execution.lock
lifecycle_lock=$runtime_root/lifecycle.lock
package_transition_file=$runtime_root/package.transition
service_closed_file=$runtime_root/service.closed
failed_start_api_file=$runtime_root/failed-start.api
failed_start_controller_file=$runtime_root/failed-start.controller
event_log_lock=$runtime_root/event-log.lock
event_log_lock_held=false
boot_identity_path=/proc/sys/kernel/random/boot_id

path_owner=
path_group=
if command -v stat >/dev/null 2>&1 && [ -d "$package_home" ]; then
    # Follow DSM's framework-owned /var/packages/.../home symlink so identity
    # checks use the @apphome owner, not the root-owned link itself.
    path_owner=$(stat -L -c '%u' "$package_home" 2>/dev/null || true)
    path_group=$(stat -L -c '%g' "$package_home" 2>/dev/null || true)
fi

# Compare a non-negative decimal string without first feeding an out-of-range
# value to the shell's numeric operators. Callers may safely use ordinary
# integer comparisons after this succeeds with the DSM deletion ceiling.
decimal_at_most() {
    decimal_candidate=${1:-}
    decimal_limit=${2:-}
    case $decimal_candidate in ''|*[!0-9]*) return 1 ;; esac
    case $decimal_limit in ''|*[!0-9]*) return 1 ;; esac
    while [ "${decimal_candidate#0}" != "$decimal_candidate" ]; do
        decimal_candidate=${decimal_candidate#0}
    done
    while [ "${decimal_limit#0}" != "$decimal_limit" ]; do
        decimal_limit=${decimal_limit#0}
    done
    [ -n "$decimal_candidate" ] || decimal_candidate=0
    [ -n "$decimal_limit" ] || decimal_limit=0
    [ "${#decimal_candidate}" -lt "${#decimal_limit}" ] && return 0
    [ "${#decimal_candidate}" -gt "${#decimal_limit}" ] && return 1
    # Equal-width input may still exceed the host shell's integer range (for
    # example 9999999999 on a 32-bit NAS). Compare one safe digit at a time.
    while [ -n "$decimal_candidate" ]; do
        decimal_candidate_digit=${decimal_candidate%"${decimal_candidate#?}"}
        decimal_limit_digit=${decimal_limit%"${decimal_limit#?}"}
        [ "$decimal_candidate_digit" -lt "$decimal_limit_digit" ] && return 0
        [ "$decimal_candidate_digit" -gt "$decimal_limit_digit" ] && return 1
        decimal_candidate=${decimal_candidate#?}
        decimal_limit=${decimal_limit#?}
    done
    return 0
}

# A process cannot change its own uid, so ask once and remember. This was being
# asked 42 times in a single profile save -- once per finish_private_file, by
# way of this function -- at a fork apiece. Resolved lazily so a caller that
# never touches a private file pays nothing.
process_uid=
resolve_process_uid() {
    [ -z "$process_uid" ] || return 0
    process_uid=$(id -u 2>/dev/null || printf '')
}

set_private_owner() {
    private_path=$1
    resolve_process_uid
    if [ "$process_uid" = 0 ] && [ -n "$path_owner" ] && [ -n "$path_group" ]; then
        chown "$path_owner:$path_group" "$private_path"
    fi
}

# DSM configuration is persisted in private package files. Never let an
# invoking shell, task environment, or package hook override those values via
# the core CLI's public SDSYNC_* environment surface.
clear_core_cli_environment() {
    unset SDSYNC_CONFIG SDSYNC_PROFILE SDSYNC_MAX_TOTAL_DELETE SDSYNC_URL \
        SDSYNC_USERNAME SDSYNC_PASSWORD SDSYNC_OTP SDSYNC_REMOTE_LOG_TOKEN \
        SDSYNC_PASSWORD_STDIN SDSYNC_PASSWORD_FILE SDSYNC_TOTP_SECRET_FILE \
        SDSYNC_NO_VAULT SDSYNC_COMPARE SDSYNC_JOBS SDSYNC_DELETE \
        SDSYNC_ALLOW_EMPTY_SOURCE SDSYNC_MAX_DELETE SDSYNC_RETRIES SDSYNC_TIMEOUT \
        SDSYNC_MAX_RATE SDSYNC_CONNECT_TIMEOUT SDSYNC_CA_CERTIFICATE SDSYNC_ALLOW_HTTP \
        SDSYNC_DANGER_ACCEPT_INVALID_CERTS SDSYNC_QUIET SDSYNC_LOG_LEVEL \
        SDSYNC_LOG_FORMAT SDSYNC_LOG_FILE SDSYNC_REMOTE_LOG_URL \
        SDSYNC_REMOTE_LOG_TOKEN_FILE SDSYNC_REMOTE_LOG_TOKEN_ENV \
        SDSYNC_REMOTE_LOG_MODE SDSYNC_PROGRESS SDSYNC_OUTPUT SDSYNC_REMOTE
}

require_package_identity() {
    identity_uid=$(id -u)
    if [ "$identity_uid" = 0 ]; then
        echo "refusing to operate as root; use the synology-drive-sync DSM package identity" >&2
        return 77
    fi
    if [ -z "$path_owner" ] || [ "$identity_uid" != "$path_owner" ]; then
        echo "operation must run as the DSM package identity (expected uid ${path_owner:-unknown})" >&2
        return 77
    fi
}

# True only when every path given already satisfies the complete post-condition
# of the repair loop below. Note that [ -d ] follows a symlink and answers yes
# for a symlink to a directory, so [ -L ] is the test actually standing between
# this fast path and the refusal it must not skip. Mode and ownership for all
# nineteen paths come from a single stat rather than one per path, and the
# read-back loop is fed by a here-document so it stays in this shell.
layout_already_private() {
    for layout_dir in "$@"; do
        [ -d "$layout_dir" ] && [ ! -L "$layout_dir" ] || return 1
    done
    layout_expected=$#
    layout_report=$(stat -c '%a %u %g' "$@" 2>/dev/null) || return 1
    resolve_process_uid
    layout_check_owner=false
    if [ "$process_uid" = 0 ] && [ -n "$path_owner" ] && [ -n "$path_group" ]; then
        layout_check_owner=true
    fi
    layout_seen=0
    layout_intact=true
    while IFS=' ' read -r layout_mode layout_uid layout_gid layout_surplus; do
        [ -n "$layout_mode" ] || continue
        layout_seen=$((layout_seen + 1))
        [ -z "$layout_surplus" ] || layout_intact=false
        [ "$layout_mode" = 700 ] || layout_intact=false
        if [ "$layout_check_owner" = true ]; then
            [ "$layout_uid" = "$path_owner" ] && [ "$layout_gid" = "$path_group" ] || layout_intact=false
        fi
    done <<LAYOUT_REPORT
$layout_report
LAYOUT_REPORT
    [ "$layout_intact" = true ] && [ "$layout_seen" -eq "$layout_expected" ]
}

ensure_layout() {
    old_umask=$(umask)
    umask 077
    # DSM deliberately exposes home/var/target as framework-owned symlinks to
    # @apphome/@appdata/@appstore. Follow those roots, but never accept a
    # symlink for a package-created child below them.
    if [ ! -d "$package_home" ]; then
        echo "DSM package home is unavailable: $package_home" >&2
        umask "$old_umask"
        return 73
    fi
    if [ "$package_var" = "$package_var_candidate" ]; then
        if [ ! -d "$package_var" ]; then
            echo "DSM package data root is unavailable: $package_var" >&2
            umask "$old_umask"
            return 73
        fi
        private_roots=
    else
        private_roots=$package_var
    fi
    # One list, consumed by both the check and the repair below, so the two can
    # never drift apart and leave a directory checked but unrepaired -- or
    # repaired but unchecked.
    set -- $private_roots "$config_root" "$profiles_dir" \
        "$routines_dir" "$secret_root" "$state_root" "$routine_state_dir" "$profile_state_dir" \
        "$health_dir" "$cache_root" "$audit_outbox_dir" "$runtime_root" "$control_root" "$control_requests" \
        "$control_processing" "$control_responses" "$control_staging" "$control_progress" "$log_root"
    # Every invocation used to spend mkdir + chmod + chown on all nineteen of
    # these whether or not they were already correct: about 57 processes, and
    # 119 of the 175 spawned by a single profile save went on exactly this. Skip
    # that work only when the whole invariant already holds -- present, a real
    # directory rather than a symlink, mode 0700, and owned as this process
    # would chown it. Anything less falls through to the untouched repair loop,
    # because a fast path that skipped on existence alone would quietly retire
    # the symlink refusal, which is a security check and not a tidiness one.
    if layout_already_private "$@"; then
        umask "$old_umask"
        return 0
    fi
    for private_dir in "$@"
    do
        if [ -L "$private_dir" ]; then
            echo "refusing symlinked package data directory: $private_dir" >&2
            umask "$old_umask"
            return 73
        fi
        mkdir -p "$private_dir"
        chmod 0700 "$private_dir"
        set_private_owner "$private_dir"
    done
    umask "$old_umask"
}

finish_private_file() {
    private_file=$1
    chmod 0600 "$private_file"
    set_private_owner "$private_file"
}

is_pid() {
    case ${1:-} in
        ''|*[!0-9]*) return 1 ;;
        *) [ "$1" -gt 1 ] 2>/dev/null ;;
    esac
}

pid_is_live() {
    is_pid "${1:-}" && kill -0 "$1" 2>/dev/null
}

same_private_executable() {
    expected_executable=$1
    candidate_executable=$2
    executable_owner=$3
    case $candidate_executable in /*) ;; *) return 1 ;; esac
    [ -f "$expected_executable" ] && [ ! -L "$expected_executable" ] || return 1
    [ -f "$candidate_executable" ] && [ ! -L "$candidate_executable" ] || return 1

    expected_executable_identity=$(stat -L -c '%d:%i:%u:%a:%h' "$expected_executable" 2>/dev/null || true)
    candidate_executable_identity=$(stat -L -c '%d:%i:%u:%a:%h' "$candidate_executable" 2>/dev/null || true)
    case $expected_executable_identity in
        *:"$executable_owner":755:1) ;;
        *) return 1 ;;
    esac
    [ "$candidate_executable_identity" = "$expected_executable_identity" ] || return 1

    # The DSM framework target and its physical @appstore destination are
    # legitimate aliases only while both names still resolve to the same exact
    # package-owned, single-link executable.
    expected_executable_recheck=$(stat -L -c '%d:%i:%u:%a:%h' "$expected_executable" 2>/dev/null || true)
    candidate_executable_recheck=$(stat -L -c '%d:%i:%u:%a:%h' "$candidate_executable" 2>/dev/null || true)
    [ "$expected_executable_recheck" = "$expected_executable_identity" ] \
        && [ "$candidate_executable_recheck" = "$expected_executable_identity" ]
}

pid_matches_command() {
    checked_pid=$1
    expected_command=$2
    pid_is_live "$checked_pid" || return 1
    [ -n "$path_owner" ] || return 1
    actual_uid=$(sed -n 's/^Uid:[[:space:]]*\([0-9][0-9]*\).*/\1/p' "/proc/$checked_pid/status" 2>/dev/null | sed -n '1p')
    [ "$actual_uid" = "$path_owner" ] || return 1
    [ -r "/proc/$checked_pid/cmdline" ] || return 1
    canonical_command_dir=$(CDPATH='' cd -- "$(dirname -- "$expected_command")" 2>/dev/null && pwd -P) || return 1
    canonical_command=$canonical_command_dir/$(basename -- "$expected_command")
    command_shape=$(tr '\000' '\n' 2>/dev/null < "/proc/$checked_pid/cmdline" |
        awk '
            { argument[NR] = $0 }
            END {
                if (NR < 1) exit 1
                print NR
                print argument[1]
                if (NR >= 2) print argument[2]
            }
        ') || return 1
    command_argument_count=$(printf '%s\n' "$command_shape" | sed -n '1p')
    command_argument_one=$(printf '%s\n' "$command_shape" | sed -n '2p')
    command_argument_two=$(printf '%s\n' "$command_shape" | sed -n '3p')
    case $command_argument_count in ''|*[!0-9]*) return 1 ;; esac

    command_position=0
    command_candidate=$command_argument_one
    if [ "$command_candidate" = "$expected_command" ] \
        || [ "$command_candidate" = "$canonical_command" ] \
        || same_private_executable "$expected_command" "$command_candidate" "$path_owner"
    then
        command_position=1
    elif [ "$command_argument_count" -ge 2 ]; then
        case $command_argument_one in /*) ;; *) return 1 ;; esac
        command_candidate=$command_argument_two
        if [ "$command_candidate" = "$expected_command" ] \
            || [ "$command_candidate" = "$canonical_command" ] \
            || same_private_executable "$expected_command" "$command_candidate" "$path_owner"
        then
            command_position=2
        fi
    fi
    [ "$command_position" -ne 0 ] || return 1

    # The controller is a no-argument script. Preserve its complete argv shape;
    # a genuine controller path in a later argument never authorizes a parent.
    if [ "$expected_command" = "$controller" ]; then
        [ "$command_position" -eq 1 ] && [ "$command_argument_count" -eq 1 ] && return 0
        [ "$command_position" -eq 2 ] && [ "$command_argument_count" -eq 2 ] && return 0
        return 1
    fi
    return 0
}

internal_api_bridge_parent_argv_authorized() {
    internal_cmdline=$1
    [ -r "$internal_cmdline" ] || return 77
    # The bridge is a native executable, so its mode must be argv[1]. Match the
    # complete public CLI shape for every mode that can legitimately spawn the
    # manager's private audit endpoint; finding a trusted word anywhere later
    # in argv is never authorization.
    tr '\000' '\n' 2>/dev/null < "$internal_cmdline" |
        awk '
            NR == 2 { mode = $0 }
            NR == 3 { subcommand = $0 }
            END {
                allowed = \
                    (NR == 2 && mode == "--serve") || \
                    (NR == 5 && mode == "--serve-supervised") || \
                    (NR == 4 && mode == "--consume-job") || \
                    (NR == 3 && mode == "--audit-transaction" && subcommand == "reconcile") || \
                    (NR == 9 && mode == "--audit-transaction" && subcommand == "begin") || \
                    (NR == 5 && mode == "--audit-transaction" && subcommand == "complete")
                exit allowed ? 0 : 1
            }
        '
}

require_internal_api_bridge_parent() {
    internal_parent=${PPID:-0}
    pid_matches_command "$internal_parent" "$api_bridge" || return 77
    [ -f "$api_bridge" ] && [ ! -L "$api_bridge" ] || return 73
    expected_bridge_identity=$(stat -L -c '%d:%i:%u:%a:%h' "$api_bridge" 2>/dev/null || true)
    parent_bridge_identity=$(stat -L -c '%d:%i:%u:%a:%h' "/proc/$internal_parent/exe" 2>/dev/null || true)
    expected_bridge_owner=$(stat -L -c '%u' "$api_bridge" 2>/dev/null || true)
    case $expected_bridge_identity:$expected_bridge_owner in
        *:755:1:"$path_owner") ;;
        *) return 73 ;;
    esac
    [ "$parent_bridge_identity" = "$expected_bridge_identity" ] || return 77
    internal_api_bridge_parent_argv_authorized "/proc/$internal_parent/cmdline" || return 77
}

require_verified_controller_parent() {
    controller_parent=${PPID:-0}
    controller_parent_status=0
    controller_persisted_identity_status "$controller_parent" || controller_parent_status=$?
    case $controller_parent_status in
        0) ;;
        1) return 77 ;;
        *) return 73 ;;
    esac
    [ -f "$controller" ] && [ ! -L "$controller" ] || return 73
    controller_owner=$(stat -L -c '%u' "$controller" 2>/dev/null || true)
    controller_mode=$(stat -L -c '%a' "$controller" 2>/dev/null || true)
    controller_links=$(stat -L -c '%h' "$controller" 2>/dev/null || true)
    [ "$controller_owner" = "$path_owner" ] \
        && [ "$controller_mode" = 755 ] \
        && [ "$controller_links" = 1 ] || return 73
}

read_pid() {
    pid_path=$1
    if [ -L "$pid_path" ] || [ ! -f "$pid_path" ]; then
        return 1
    fi
    IFS= read -r saved_pid < "$pid_path" || return 1
    is_pid "$saved_pid" || return 1
    printf '%s\n' "$saved_pid"
}

controller_pid_file_safe() {
    [ -e "$controller_pid_file" ] || [ -L "$controller_pid_file" ] || return 1
    [ -f "$controller_pid_file" ] && [ ! -L "$controller_pid_file" ] || return 73
    [ -n "$path_owner" ] || return 73
    controller_pid_metadata=$(stat -c '%u:%a:%h' "$controller_pid_file" 2>/dev/null || true)
    [ "$controller_pid_metadata" = "$path_owner:600:1" ] || return 73
    controller_pid_lines=$(awk 'END { print NR }' "$controller_pid_file" 2>/dev/null || true)
    [ "$controller_pid_lines" = 1 ] || return 73
    controller_pid_value=$(read_pid "$controller_pid_file" 2>/dev/null || true)
    [ -n "$controller_pid_value" ] || return 73
}

remove_stale_controller_pid_file() {
    expected_stale_controller_pid=${1:-}
    expected_stale_controller_start=${2:-}
    expected_stale_controller_boot=${3:-}
    [ -e "$controller_pid_file" ] || [ -L "$controller_pid_file" ] || return 0
    controller_pid_file_safe || return $?
    if [ -n "$expected_stale_controller_pid" ] || \
        [ -n "$expected_stale_controller_start" ] || \
        [ -n "$expected_stale_controller_boot" ]; then
        is_pid "$expected_stale_controller_pid" || return 73
        case $expected_stale_controller_start in ''|*[!0-9]*|0) return 73 ;; esac
        valid_boot_identity "$expected_stale_controller_boot" || return 73
        [ "$controller_pid_value" = "$expected_stale_controller_pid" ] || return 73
        stale_controller_process_status=0
        process_identity_is_live "$expected_stale_controller_pid" \
            "$expected_stale_controller_start" "$expected_stale_controller_boot" || \
            stale_controller_process_status=$?
        case $stale_controller_process_status in
            0) return 75 ;;
            1) ;;
            *) return 73 ;;
        esac
    else
        # A one-line PID file has no reusable process identity. It is removable
        # only when that PID slot is absent; a zombie/live slot remains stale
        # but unproven until matching readiness supplies start/boot evidence.
        pid_is_live "$controller_pid_value" && return 75
    fi
    stale_controller_pid_identity=$(stat -c '%d:%i' "$controller_pid_file" 2>/dev/null || true)
    [ -n "$stale_controller_pid_identity" ] || return 73
    controller_pid_file_safe || return 73
    [ -z "$expected_stale_controller_pid" ] || \
        [ "$controller_pid_value" = "$expected_stale_controller_pid" ] || return 73
    if [ -n "$expected_stale_controller_pid" ]; then
        stale_controller_process_status=0
        process_identity_is_live "$expected_stale_controller_pid" \
            "$expected_stale_controller_start" "$expected_stale_controller_boot" || \
            stale_controller_process_status=$?
        case $stale_controller_process_status in
            0) return 75 ;;
            1) ;;
            *) return 73 ;;
        esac
    else
        pid_is_live "$controller_pid_value" && return 75
    fi
    stale_controller_pid_recheck=$(stat -c '%d:%i' "$controller_pid_file" 2>/dev/null || true)
    [ "$stale_controller_pid_recheck" = "$stale_controller_pid_identity" ] || return 73
    rm -f "$controller_pid_file"
}

read_controller_ready_identity() {
    [ -e "$controller_ready_file" ] || [ -L "$controller_ready_file" ] || return 1
    [ -f "$controller_ready_file" ] && [ ! -L "$controller_ready_file" ] || return 73
    [ -n "$path_owner" ] || return 73
    controller_ready_metadata=$(stat -c '%u:%a:%h' "$controller_ready_file" 2>/dev/null || true)
    [ "$controller_ready_metadata" = "$path_owner:600:1" ] || return 73
    controller_ready_size=$(wc -c 2>/dev/null < "$controller_ready_file" | tr -d ' ')
    case $controller_ready_size in ''|*[!0-9]*) return 73 ;; esac
    [ "$controller_ready_size" -le 96 ] || return 73
    controller_ready_lines=$(awk 'END { print NR }' "$controller_ready_file" 2>/dev/null || true)
    [ "$controller_ready_lines" = 3 ] || return 73
    controller_ready_pid=$(sed -n '1p' "$controller_ready_file" 2>/dev/null || true)
    controller_ready_start=$(sed -n '2p' "$controller_ready_file" 2>/dev/null || true)
    controller_ready_boot=$(sed -n '3p' "$controller_ready_file" 2>/dev/null || true)
    is_pid "$controller_ready_pid" || return 73
    case $controller_ready_start in ''|*[!0-9]*|0) return 73 ;; esac
    valid_boot_identity "$controller_ready_boot" || return 73
}

# Long-lived controller authorization is based on three independently
# published exact identities rather than vendor-shell-specific cmdline text:
# the PID file, readiness record, and live private lock must all name the same
# PID/start/boot tuple owned by this package. Recheck the complete chain to
# reject replacement during inspection.
controller_persisted_identity_status() {
    expected_controller_pid=${1:-}
    [ -f "$controller" ] && [ ! -L "$controller" ] || return 73
    persisted_controller_executable=$(stat -L -c '%u:%a:%h' "$controller" 2>/dev/null || true)
    [ "$persisted_controller_executable" = "$path_owner:755:1" ] || return 73
    controller_pid_file_safe || return $?
    persisted_controller_pid=$controller_pid_value
    read_controller_ready_identity || return $?
    persisted_controller_ready_pid=$controller_ready_pid
    persisted_controller_start=$controller_ready_start
    persisted_controller_boot=$controller_ready_boot
    persisted_controller_lock_status=0
    private_process_lock_is_live "$controller_lock" || persisted_controller_lock_status=$?
    [ "$persisted_controller_lock_status" -eq 0 ] || return "$persisted_controller_lock_status"
    [ "${lock_owner_legacy:-true}" = false ] \
        && [ "$persisted_controller_pid" = "$persisted_controller_ready_pid" ] \
        && [ "$lock_owner_pid" = "$persisted_controller_pid" ] \
        && [ "$lock_owner_start" = "$persisted_controller_start" ] \
        && [ "$lock_owner_boot" = "$persisted_controller_boot" ] || return 73
    [ -z "$expected_controller_pid" ] \
        || [ "$persisted_controller_pid" = "$expected_controller_pid" ] || return 1

    controller_pid_file_safe || return 73
    [ "$controller_pid_value" = "$persisted_controller_pid" ] || return 73
    read_controller_ready_identity || return 73
    [ "$controller_ready_pid" = "$persisted_controller_pid" ] \
        && [ "$controller_ready_start" = "$persisted_controller_start" ] \
        && [ "$controller_ready_boot" = "$persisted_controller_boot" ] || return 73
    persisted_controller_lock_status=0
    private_process_lock_is_live "$controller_lock" || persisted_controller_lock_status=$?
    [ "$persisted_controller_lock_status" -eq 0 ] \
        && [ "${lock_owner_legacy:-true}" = false ] \
        && [ "$lock_owner_pid" = "$persisted_controller_pid" ] \
        && [ "$lock_owner_start" = "$persisted_controller_start" ] \
        && [ "$lock_owner_boot" = "$persisted_controller_boot" ] || return 73
}

# Return 0 only for a live, exact controller readiness identity; 1 means an
# absent or verifiably stale record, and 73 means an unsafe/malformed record.
controller_ready_status() {
    [ -e "$controller_ready_file" ] || [ -L "$controller_ready_file" ] || return 1
    controller_persisted_identity_status
}

controller_ready_matches() {
    expected_ready_pid=$1
    controller_ready_status || return $?
    [ "$controller_ready_pid" = "$expected_ready_pid" ] || return 73
}

# A controller verifies the exact package-owned script named by its own $0
# before it publishes readiness. This avoids depending on how a particular DSM
# shell exposes its interpreter argv through procfs while retaining the same
# inode, owner, mode, and single-link contract.
controller_self_executable_matches() {
    [ "${PPID:-0}" = "${SDSYNC_DSM_CONTROLLER_START_PARENT_PID:-}" ] || return 73
    same_private_executable "$controller" "$0" "$path_owner"
}

runtime_api_ready_status() {
    [ -e "$api_ready_file" ] || [ -L "$api_ready_file" ] || return 1
    [ -f "$api_ready_file" ] && [ ! -L "$api_ready_file" ] || return 73
    [ -n "$path_owner" ] || return 73
    runtime_api_ready_metadata=$(stat -c '%u:%a:%h' "$api_ready_file" 2>/dev/null || true)
    [ "$runtime_api_ready_metadata" = "$path_owner:600:1" ] || return 73
    runtime_api_ready_lines=$(awk 'END { print NR }' "$api_ready_file" 2>/dev/null || true)
    [ "$runtime_api_ready_lines" = 3 ] || return 73
    runtime_api_ready_pid=$(sed -n '1p' "$api_ready_file" 2>/dev/null || true)
    runtime_api_ready_start=$(sed -n '2p' "$api_ready_file" 2>/dev/null || true)
    runtime_api_ready_boot=$(sed -n '3p' "$api_ready_file" 2>/dev/null || true)
    is_pid "$runtime_api_ready_pid" || return 73
    case $runtime_api_ready_start in ''|*[!0-9]*|0) return 73 ;; esac
    valid_boot_identity "$runtime_api_ready_boot" || return 73
    [ -f "$api_pid_file" ] && [ ! -L "$api_pid_file" ] || return 73
    runtime_api_pid_metadata=$(stat -c '%u:%a:%h' "$api_pid_file" 2>/dev/null || true)
    [ "$runtime_api_pid_metadata" = "$path_owner:600:1" ] || return 73
    runtime_api_pid_lines=$(awk 'END { print NR }' "$api_pid_file" 2>/dev/null || true)
    [ "$runtime_api_pid_lines" = 1 ] || return 73
    runtime_api_saved_pid=$(sed -n '1p' "$api_pid_file" 2>/dev/null || true)
    [ "$runtime_api_saved_pid" = "$runtime_api_ready_pid" ] || return 73
    runtime_api_live_status=0
    process_identity_is_live "$runtime_api_ready_pid" "$runtime_api_ready_start" \
        "$runtime_api_ready_boot" || runtime_api_live_status=$?
    case $runtime_api_live_status in
        0) pid_matches_command "$runtime_api_ready_pid" "$api_bridge" || return 73; return 0 ;;
        1) return 1 ;;
        *) return 73 ;;
    esac
}

service_runtime_ready() {
    controller_ready_status || return $?
    runtime_api_ready_status
}

package_transition_status() {
    [ -x "$api_bridge" ] && [ ! -L "$api_bridge" ] || return 73
    package_transition_value=$("$api_bridge" --package-transition status) || return $?
    case $package_transition_value in open|upgrade|uninstall) ;;
        *) return 73 ;;
    esac
    printf '%s\n' "$package_transition_value"
}

service_admission_status() {
    [ -x "$api_bridge" ] && [ ! -L "$api_bridge" ] || return 73
    service_admission_value=$("$api_bridge" --service-admission status) || return $?
    case $service_admission_value in open|closed) ;;
        *) return 73 ;;
    esac
    printf '%s\n' "$service_admission_value"
}

read_controller_start_lease() {
    [ -e "$controller_start_file" ] || [ -L "$controller_start_file" ] || return 1
    [ -f "$controller_start_file" ] && [ ! -L "$controller_start_file" ] || return 73
    [ -n "$path_owner" ] || return 73
    controller_start_metadata=$(stat -c '%u:%a:%h' "$controller_start_file" 2>/dev/null || true)
    [ "$controller_start_metadata" = "$path_owner:600:1" ] || return 73
    controller_start_size=$(wc -c 2>/dev/null < "$controller_start_file" | tr -d ' ')
    case $controller_start_size in ''|*[!0-9]*) return 73 ;; esac
    [ "$controller_start_size" -le 112 ] || return 73
    controller_start_lines=$(awk 'END { print NR }' "$controller_start_file" 2>/dev/null || true)
    case $controller_start_lines in
        3) controller_start_phase=prepared ;;
        4)
            controller_start_phase=$(sed -n '4p' "$controller_start_file" 2>/dev/null || true)
            [ "$controller_start_phase" = committed ] || return 73
            ;;
        *) return 73 ;;
    esac
    controller_start_pid=$(sed -n '1p' "$controller_start_file" 2>/dev/null || true)
    controller_start_ticks=$(sed -n '2p' "$controller_start_file" 2>/dev/null || true)
    controller_start_boot=$(sed -n '3p' "$controller_start_file" 2>/dev/null || true)
    is_pid "$controller_start_pid" || return 73
    case $controller_start_ticks in ''|*[!0-9]*|0) return 73 ;; esac
    valid_boot_identity "$controller_start_boot" || return 73
}

controller_start_lease_status() {
    read_controller_start_lease || return $?
    controller_start_live_status=0
    process_identity_is_live "$controller_start_pid" "$controller_start_ticks" \
        "$controller_start_boot" || controller_start_live_status=$?
    case $controller_start_live_status in
        0) return 0 ;;
        1) return 1 ;;
        *) return 73 ;;
    esac
}

publish_controller_start_lease() {
    [ ! -e "$controller_start_file" ] && [ ! -L "$controller_start_file" ] || return 73
    controller_start_parent_ticks=$(process_start_time "$$" 2>/dev/null || true)
    case $controller_start_parent_ticks in ''|*[!0-9]*|0) return 73 ;; esac
    controller_start_parent_boot=$(boot_identity) || return 73
    controller_start_temp=$controller_start_file.tmp.$$
    [ ! -e "$controller_start_temp" ] && [ ! -L "$controller_start_temp" ] || return 73
    {
        printf '%s\n' "$$"
        printf '%s\n' "$controller_start_parent_ticks"
        printf '%s\n' "$controller_start_parent_boot"
    } > "$controller_start_temp" || { rm -f "$controller_start_temp"; return 73; }
    finish_private_file "$controller_start_temp" || { rm -f "$controller_start_temp"; return 73; }
    mv -f "$controller_start_temp" "$controller_start_file" || {
        rm -f "$controller_start_temp"
        return 73
    }
    SDSYNC_DSM_CONTROLLER_START_PARENT_PID=$$
    SDSYNC_DSM_CONTROLLER_START_PARENT_TICKS=$controller_start_parent_ticks
    SDSYNC_DSM_CONTROLLER_START_PARENT_BOOT=$controller_start_parent_boot
    export SDSYNC_DSM_CONTROLLER_START_PARENT_PID \
        SDSYNC_DSM_CONTROLLER_START_PARENT_TICKS SDSYNC_DSM_CONTROLLER_START_PARENT_BOOT
}

controller_start_lease_identity_matches_parent() {
    expected_start_parent=${SDSYNC_DSM_CONTROLLER_START_PARENT_PID:-}
    expected_start_ticks=${SDSYNC_DSM_CONTROLLER_START_PARENT_TICKS:-}
    expected_start_boot=${SDSYNC_DSM_CONTROLLER_START_PARENT_BOOT:-}
    is_pid "$expected_start_parent" || return 73
    case $expected_start_ticks in ''|*[!0-9]*|0) return 73 ;; esac
    valid_boot_identity "$expected_start_boot" || return 73
    [ "${PPID:-0}" = "$expected_start_parent" ] || return 73
    [ "$controller_start_pid" = "$expected_start_parent" ] \
        && [ "$controller_start_ticks" = "$expected_start_ticks" ] \
        && [ "$controller_start_boot" = "$expected_start_boot" ] || return 73
    process_identity_is_live "$controller_start_pid" "$controller_start_ticks" \
        "$controller_start_boot" || return 73
}

controller_start_lease_matches_parent() {
    read_controller_start_lease || return 73
    [ "$controller_start_phase" = prepared ] || return 73
    controller_start_lease_identity_matches_parent
}

controller_start_lease_committed_matches_parent() {
    read_controller_start_lease || return 73
    [ "$controller_start_phase" = committed ] || return 73
    controller_start_lease_identity_matches_parent
}

# Poll bucket A: the sleep here is sampling granularity and nothing else -- the
# lease is either committed or it is not, and there is no counter whose units
# could drift.
#
# Left at one second all the same, because of a library boundary rather than a
# hazard. The pacing helpers live in packaging/synology/scripts/common, which
# is what the lifecycle scripts source; this file is sourced by the controller
# and the manager instead, and the two libraries are deliberately separate --
# both define same_private_executable, and scripts/common is sourced by preinst
# before $package_root exists, so it cannot pull this file in. Converting this
# site would mean a second copy of the pacing helpers, which is not worth it
# for one lease wait. If the helpers ever need a shared home, that is the
# change to make, not a duplicate.
wait_for_controller_start_commit() {
    while :; do
        read_controller_start_lease || return 73
        controller_start_lease_identity_matches_parent || return 73
        case $controller_start_phase in
            committed) return 0 ;;
            prepared) sleep 1 ;;
            *) return 73 ;;
        esac
    done
}

commit_controller_start_lease() {
    read_controller_start_lease || return 73
    [ "$controller_start_phase" = prepared ] || return 73
    own_start_ticks=$(process_start_time "$$" 2>/dev/null || true)
    own_start_boot=$(boot_identity) || return 73
    [ "$controller_start_pid" = "$$" ] && [ "$controller_start_ticks" = "$own_start_ticks" ] \
        && [ "$controller_start_boot" = "$own_start_boot" ] || return 73
    controller_commit_temp=$controller_start_file.commit.$$
    [ ! -e "$controller_commit_temp" ] && [ ! -L "$controller_commit_temp" ] || return 73
    {
        printf '%s\n' "$$"
        printf '%s\n' "$own_start_ticks"
        printf '%s\n' "$own_start_boot"
        printf 'committed\n'
    } > "$controller_commit_temp" || { rm -f "$controller_commit_temp"; return 73; }
    finish_private_file "$controller_commit_temp" || { rm -f "$controller_commit_temp"; return 73; }
    mv -f "$controller_commit_temp" "$controller_start_file" || {
        rm -f "$controller_commit_temp"
        return 73
    }
    read_controller_start_lease || return 73
    [ "$controller_start_phase" = committed ] || return 73
    [ "$controller_start_pid" = "$$" ] && [ "$controller_start_ticks" = "$own_start_ticks" ] \
        && [ "$controller_start_boot" = "$own_start_boot" ] || return 73
}

remove_controller_start_lease() {
    read_controller_start_lease || return $?
    [ "$controller_start_pid" = "${SDSYNC_DSM_CONTROLLER_START_PARENT_PID:-}" ] \
        && [ "$controller_start_ticks" = "${SDSYNC_DSM_CONTROLLER_START_PARENT_TICKS:-}" ] \
        && [ "$controller_start_boot" = "${SDSYNC_DSM_CONTROLLER_START_PARENT_BOOT:-}" ] || return 73
    controller_start_identity=$(stat -c '%d:%i' "$controller_start_file" 2>/dev/null || true)
    [ -n "$controller_start_identity" ] || return 73
    read_controller_start_lease || return 73
    controller_start_recheck=$(stat -c '%d:%i' "$controller_start_file" 2>/dev/null || true)
    [ "$controller_start_recheck" = "$controller_start_identity" ] || return 73
    rm -f "$controller_start_file"
}

remove_own_controller_start_lease() {
    [ -e "$controller_start_file" ] || [ -L "$controller_start_file" ] || return 0
    read_controller_start_lease || return 73
    own_start_ticks=$(process_start_time "$$" 2>/dev/null || true)
    own_start_boot=$(boot_identity) || return 73
    [ "$controller_start_pid" = "$$" ] && [ "$controller_start_ticks" = "$own_start_ticks" ] \
        && [ "$controller_start_boot" = "$own_start_boot" ] || return 73
    rm -f "$controller_start_file"
}

remove_stale_controller_start_lease() {
    [ -e "$controller_start_file" ] || [ -L "$controller_start_file" ] || return 0
    stale_start_status=0
    controller_start_lease_status || stale_start_status=$?
    case $stale_start_status in
        0) return 75 ;;
        1) ;;
        *) return 73 ;;
    esac
    read_controller_start_lease || return 73
    stale_start_identity=$(stat -c '%d:%i' "$controller_start_file" 2>/dev/null || true)
    [ -n "$stale_start_identity" ] || return 73
    read_controller_start_lease || return 73
    stale_start_recheck=$(stat -c '%d:%i' "$controller_start_file" 2>/dev/null || true)
    [ "$stale_start_recheck" = "$stale_start_identity" ] || return 73
    rm -f "$controller_start_file"
}

remove_stale_controller_ready() {
    stale_ready_pid=
    stale_ready_start=
    stale_ready_boot=
    [ -e "$controller_ready_file" ] || [ -L "$controller_ready_file" ] || return 0
    # The caller owns controller.lock here. That means a dead controller's
    # readiness tuple cannot satisfy controller_persisted_identity_status:
    # the lock now truthfully names this cleanup process. Validate the private
    # readiness record directly, prove its exact PID/start/boot identity is no
    # longer live, then pin and recheck both the tuple and inode before removal.
    stale_ready_lock_status=0
    private_process_lock_is_live "$controller_lock" || stale_ready_lock_status=$?
    [ "$stale_ready_lock_status" -eq 0 ] \
        && [ "${lock_owner_legacy:-true}" = false ] \
        && [ "$lock_owner_pid" = "$$" ] || return 73
    stale_ready_owner_start=$(process_start_time "$$" 2>/dev/null || true)
    stale_ready_owner_boot=$(boot_identity) || return 73
    [ "$lock_owner_start" = "$stale_ready_owner_start" ] \
        && [ "$lock_owner_boot" = "$stale_ready_owner_boot" ] || return 73
    read_controller_ready_identity || return 73
    stale_ready_pid=$controller_ready_pid
    stale_ready_start=$controller_ready_start
    stale_ready_boot=$controller_ready_boot
    stale_ready_identity=$(stat -c '%d:%i' "$controller_ready_file" 2>/dev/null || true)
    [ -n "$stale_ready_identity" ] || return 73
    stale_ready_process_status=0
    process_identity_is_live "$stale_ready_pid" "$stale_ready_start" \
        "$stale_ready_boot" || stale_ready_process_status=$?
    case $stale_ready_process_status in
        0) return 75 ;;
        1) ;;
        *) return 73 ;;
    esac
    read_controller_ready_identity || {
        [ -e "$controller_ready_file" ] || [ -L "$controller_ready_file" ] || return 0
        return 73
    }
    [ "$controller_ready_pid" = "$stale_ready_pid" ] \
        && [ "$controller_ready_start" = "$stale_ready_start" ] \
        && [ "$controller_ready_boot" = "$stale_ready_boot" ] || return 73
    stale_ready_process_status=0
    process_identity_is_live "$stale_ready_pid" "$stale_ready_start" \
        "$stale_ready_boot" || stale_ready_process_status=$?
    case $stale_ready_process_status in
        0) return 75 ;;
        1) ;;
        *) return 73 ;;
    esac
    stale_ready_recheck=$(stat -c '%d:%i' "$controller_ready_file" 2>/dev/null || true)
    [ "$stale_ready_recheck" = "$stale_ready_identity" ] || return 73
    rm -f "$controller_ready_file"
}

publish_controller_ready() {
    remove_stale_controller_ready || return $?
    published_ready_start=$(process_start_time "$$" 2>/dev/null || true)
    case $published_ready_start in ''|*[!0-9]*|0) return 73 ;; esac
    published_ready_boot=$(boot_identity) || return 73
    controller_self_executable_matches || return 73
    published_ready_temp=$controller_ready_file.tmp.$$
    [ ! -e "$published_ready_temp" ] && [ ! -L "$published_ready_temp" ] || return 73
    {
        printf '%s\n' "$$"
        printf '%s\n' "$published_ready_start"
        printf '%s\n' "$published_ready_boot"
    } > "$published_ready_temp" || { rm -f "$published_ready_temp"; return 73; }
    finish_private_file "$published_ready_temp" || { rm -f "$published_ready_temp"; return 73; }
    [ ! -e "$controller_ready_file" ] && [ ! -L "$controller_ready_file" ] || {
        rm -f "$published_ready_temp"
        return 73
    }
    mv "$published_ready_temp" "$controller_ready_file" || { rm -f "$published_ready_temp"; return 73; }
    read_controller_ready_identity || return 73
    [ "$controller_ready_pid" = "$$" ] \
        && [ "$controller_ready_start" = "$published_ready_start" ] \
        && [ "$controller_ready_boot" = "$published_ready_boot" ]
}

remove_own_controller_ready() {
    [ -e "$controller_ready_file" ] || [ -L "$controller_ready_file" ] || return 0
    read_controller_ready_identity || return 73
    own_ready_start=$(process_start_time "$$" 2>/dev/null || true)
    own_ready_boot=$(boot_identity) || return 73
    [ "$controller_ready_pid" = "$$" ] \
        && [ "$controller_ready_start" = "$own_ready_start" ] \
        && [ "$controller_ready_boot" = "$own_ready_boot" ] || return 73
    own_ready_identity=$(stat -c '%d:%i' "$controller_ready_file" 2>/dev/null || true)
    [ -n "$own_ready_identity" ] || return 73
    own_ready_recheck=$(stat -c '%d:%i' "$controller_ready_file" 2>/dev/null || true)
    [ "$own_ready_recheck" = "$own_ready_identity" ] || return 73
    rm -f "$controller_ready_file"
}

private_event_lock_directory() {
    checked_event_dir=$1
    [ -d "$checked_event_dir" ] && [ ! -L "$checked_event_dir" ] || return 1
    [ -n "$path_owner" ] || return 1
    checked_event_mode=$(stat -c '%a' "$checked_event_dir" 2>/dev/null || true)
    checked_event_owner=$(stat -c '%u' "$checked_event_dir" 2>/dev/null || true)
    [ "$checked_event_mode" = 700 ] && [ "$checked_event_owner" = "$path_owner" ] || return 1
    for checked_event_entry in "$checked_event_dir"/* "$checked_event_dir"/.[!.]* "$checked_event_dir"/..?*; do
        [ -e "$checked_event_entry" ] || [ -L "$checked_event_entry" ] || continue
        [ "${checked_event_entry##*/}" = pid ] || return 1
        [ -f "$checked_event_entry" ] && [ ! -L "$checked_event_entry" ] || return 1
        checked_event_entry_mode=$(stat -c '%a' "$checked_event_entry" 2>/dev/null || true)
        checked_event_entry_owner=$(stat -c '%u' "$checked_event_entry" 2>/dev/null || true)
        [ "$checked_event_entry_mode" = 600 ] && [ "$checked_event_entry_owner" = "$path_owner" ] || return 1
    done
}

# Procfs identity reads happen on every admission, every guard tick, and every
# exact signal, so they are the package's hottest code. Fork and exec are the
# expensive operations on the armv7 units this targets -- an awk or sed
# substitution costs a subshell plus a busybox exec, while the same parse in
# shell builtins costs neither -- so these two helpers read each procfs file
# once and publish the fields, and the callers below consume the variables
# instead of spawning a pipeline per field.
#
# Reading /proc/<pid>/stat once is also stricter than the column indexing it
# replaces: everything after the final ") " is fixed-position, so a comm
# containing a space cannot shift the field the way an awk column number can,
# and state and start tick can no longer be read from two separate samples.
read_process_stat_fields() {
    process_stat_state=
    process_stat_start=
    process_stat_ppid=
    # The stderr redirect has to precede the input redirect, not follow it.
    # Redirections apply left to right, so `< missing 2>/dev/null` fails the
    # open before stderr has been diverted and BusyBox prints "can't open" to
    # the real stderr -- which for the controller is its own log file. A PID
    # that exits between the check and the read is a normal race here, not an
    # error worth a log line.
    IFS= read -r process_stat_line 2>/dev/null < "/proc/$1/stat" || return 1
    process_stat_rest=${process_stat_line##*') '}
    [ "$process_stat_rest" != "$process_stat_line" ] || return 1
    process_stat_saved_ifs=$IFS
    IFS=' '
    set -- $process_stat_rest
    IFS=$process_stat_saved_ifs
    [ "$#" -ge 20 ] || return 1
    process_stat_state=$1
    process_stat_ppid=$2
    process_stat_start=${20}
    case $process_stat_start in ''|*[!0-9]*|0) process_stat_start= ;; esac
    case $process_stat_ppid in ''|*[!0-9]*) process_stat_ppid= ;; esac
    [ -n "$process_stat_state" ] && [ -n "$process_stat_start" ]
}

# One builtin pass over /proc/<pid>/status. The first Uid:/PPid: line wins,
# which is what the `sed -n '1p'` on the end of the replaced pipelines did, and
# the scan stops as soon as both are known so the remaining fifty-odd lines are
# never parsed.
read_process_status_ids() {
    process_status_uid=
    process_status_ppid=
    while IFS= read -r process_status_line; do
        case $process_status_line in
            Uid:*) [ -z "$process_status_uid" ] || continue
                process_status_field=${process_status_line#Uid:} ;;
            PPid:*) [ -z "$process_status_ppid" ] || continue
                process_status_field=${process_status_line#PPid:} ;;
            *) continue ;;
        esac
        while :; do
            case $process_status_field in
                [[:space:]]*) process_status_field=${process_status_field#?} ;;
                *) break ;;
            esac
        done
        process_status_field=${process_status_field%%[[:space:]]*}
        case $process_status_field in ''|*[!0-9]*) process_status_field= ;; esac
        case $process_status_line in
            Uid:*) process_status_uid=$process_status_field ;;
            *) process_status_ppid=$process_status_field ;;
        esac
        [ -z "$process_status_uid" ] || [ -z "$process_status_ppid" ] || break
    done 2>/dev/null < "/proc/$1/status"
    [ -n "$process_status_uid" ] && [ -n "$process_status_ppid" ]
}

# The lifecycle entry point measures once per transition whether this DSM
# build's BusyBox sleep honours a fractional argument, and publishes the answer
# under a package-identity stamp. The controller is a long-lived child of that
# transition, so it can inherit the measurement rather than pay for its own:
# one builtin read here instead of four 50 ms probe sleeps on the start path.
#
# This is a deliberate second reader rather than a shared helper. The lifecycle
# library is sourced by preinst before $package_root exists and is kept
# self-contained for exactly that reason -- see the note at the top of
# scripts/common -- so it cannot depend on this file and this file must not
# depend on it. The stamp still matches byte for byte because both stat the
# same two payload files in the same order.
#
# Fail closed, on the same terms as the writer: missing, unreadable,
# malformed, or stamped by a different build all mean one second, never
# fractional, and a process that finds no result does not re-probe.
runtime_poll_resolution_ms=1000
runtime_poll_resolution_file=$runtime_root/poll-resolution

load_runtime_poll_resolution() {
    runtime_poll_resolution_ms=1000
    [ ! -L "$runtime_poll_resolution_file" ] && [ -f "$runtime_poll_resolution_file" ] \
        && [ -r "$runtime_poll_resolution_file" ] || return 0
    runtime_poll_identity_raw=$(stat -c '%d:%i:%s:%Y' \
        "$package_root/bin/sdsync-dsm" "$package_root/libexec/sdsync-common" 2>/dev/null) || return 0
    set -- $runtime_poll_identity_raw
    runtime_poll_identity=$*
    [ -n "$runtime_poll_identity" ] || return 0
    {
        IFS= read -r runtime_poll_stored_identity || return 0
        IFS= read -r runtime_poll_stored_ms || return 0
        if IFS= read -r runtime_poll_stored_surplus; then return 0; fi
        [ "$runtime_poll_stored_identity" = "$runtime_poll_identity" ] || return 0
        case $runtime_poll_stored_ms in ''|*[!0-9]*) return 0 ;; esac
        [ "$runtime_poll_stored_ms" -ge 10 ] && [ "$runtime_poll_stored_ms" -le 1000 ] || return 0
        runtime_poll_resolution_ms=$runtime_poll_stored_ms
    } < "$runtime_poll_resolution_file"
    return 0
}

process_start_time() {
    process_start_pid=$1
    is_pid "$process_start_pid" || return 1
    process_start_value=
    read_process_stat_fields "$process_start_pid" 2>/dev/null && \
        process_start_value=$process_stat_start
    case $process_start_value in ''|*[!0-9]*|0) return 1 ;; esac
    printf '%s\n' "$process_start_value"
}

valid_boot_identity() {
    case ${1:-} in ????????-????-????-????-????????????) ;; *) return 1 ;; esac
    boot_identity_remainder=$1
    boot_identity_compact=
    while :; do
        case $boot_identity_remainder in
            *-*)
                boot_identity_compact=$boot_identity_compact${boot_identity_remainder%%-*}
                boot_identity_remainder=${boot_identity_remainder#*-}
                ;;
            *)
                boot_identity_compact=$boot_identity_compact$boot_identity_remainder
                break
                ;;
        esac
    done
    [ "${#boot_identity_compact}" -eq 32 ] || return 1
    case $boot_identity_compact in *[!0-9a-f]*) return 1 ;; esac
}

boot_identity() {
    [ -f "$boot_identity_path" ] && [ ! -L "$boot_identity_path" ] && [ -r "$boot_identity_path" ] || return 73
    boot_identity_metadata=$(stat -c '%a %u' "$boot_identity_path" 2>/dev/null || true)
    boot_identity_mode=${boot_identity_metadata%% *}
    boot_identity_owner=${boot_identity_metadata##* }
    [ "$boot_identity_mode" = 444 ] && [ "$boot_identity_owner" = 0 ] || return 73
    # Exactly one newline-terminated line, established by the reads themselves
    # rather than by an awk line count: the first read fails on a file with no
    # trailing newline and the second must find nothing after it.
    boot_identity_surplus=
    {
        IFS= read -r boot_identity_value || return 73
        IFS= read -r boot_identity_surplus && return 73
    } < "$boot_identity_path"
    [ -z "$boot_identity_surplus" ] || return 73
    valid_boot_identity "$boot_identity_value" || return 73
    printf '%s\n' "$boot_identity_value"
}

process_identity_is_live() {
    process_identity_pid=$1
    process_identity_start=$2
    process_identity_boot=$3
    process_identity_current_boot=$(boot_identity) || return 73
    [ "$process_identity_current_boot" = "$process_identity_boot" ] || return 1
    is_pid "$process_identity_pid" || return 73
    case $process_identity_start in ''|*[!0-9]*|0) return 73 ;; esac
    [ -e "/proc/$process_identity_pid" ] || return 1
    case ${path_owner:-} in ''|*[!0-9]*) return 73 ;; esac

    process_identity_actual_start=
    process_identity_state=
    process_identity_uid=
    if read_process_stat_fields "$process_identity_pid"; then
        process_identity_actual_start=$process_stat_start
        process_identity_state=$process_stat_state
    fi
    if read_process_status_ids "$process_identity_pid"; then
        process_identity_uid=$process_status_uid
    fi
    if [ -z "$process_identity_actual_start" ] || [ -z "$process_identity_uid" ] || \
        [ -z "$process_identity_state" ]; then
        [ -e "/proc/$process_identity_pid" ] || return 1
        return 73
    fi
    [ "$process_identity_actual_start" = "$process_identity_start" ] && \
        [ "$process_identity_uid" = "$path_owner" ] || return 73

    # Recheck the exact tuple immediately before classifying it. A stale lock
    # may be recovered only after this process is absent or terminal; a reused,
    # partially readable, or unknown PID remains fail closed.
    process_identity_start_recheck=
    process_identity_state_recheck=
    process_identity_uid_recheck=
    if read_process_stat_fields "$process_identity_pid"; then
        process_identity_start_recheck=$process_stat_start
        process_identity_state_recheck=$process_stat_state
    fi
    if read_process_status_ids "$process_identity_pid"; then
        process_identity_uid_recheck=$process_status_uid
    fi
    if [ -z "$process_identity_start_recheck" ] || [ -z "$process_identity_uid_recheck" ] || \
        [ -z "$process_identity_state_recheck" ]; then
        [ -e "/proc/$process_identity_pid" ] || return 1
        return 73
    fi
    [ "$process_identity_start_recheck" = "$process_identity_start" ] && \
        [ "$process_identity_uid_recheck" = "$path_owner" ] || return 73
    case $process_identity_state_recheck in
        Z|X|x) return 1 ;;
        R|S|D|T|t|K|W|P|I) return 0 ;;
        *) return 73 ;;
    esac
}

read_private_lock_owner() {
    lock_owner_path=$1
    [ -f "$lock_owner_path" ] && [ ! -L "$lock_owner_path" ] || return 1
    [ -n "$path_owner" ] || return 1
    lock_owner_mode=$(stat -c '%a' "$lock_owner_path" 2>/dev/null || true)
    lock_owner_uid=$(stat -c '%u' "$lock_owner_path" 2>/dev/null || true)
    lock_owner_size=$(wc -c 2>/dev/null < "$lock_owner_path" | tr -d ' ')
    [ "$lock_owner_mode" = 600 ] && [ "$lock_owner_uid" = "$path_owner" ] || return 1
    case $lock_owner_size in ''|*[!0-9]*) return 1 ;; esac
    [ "$lock_owner_size" -le 96 ] || return 1
    lock_owner_lines=$(awk 'END { print NR }' "$lock_owner_path" 2>/dev/null || true)
    lock_owner_pid=$(sed -n '1p' "$lock_owner_path" 2>/dev/null || true)
    is_pid "$lock_owner_pid" || return 1
    case $lock_owner_lines in
        1)
            lock_owner_start=
            lock_owner_boot=
            lock_owner_legacy=true
            ;;
        3)
            lock_owner_start=$(sed -n '2p' "$lock_owner_path" 2>/dev/null || true)
            lock_owner_boot=$(sed -n '3p' "$lock_owner_path" 2>/dev/null || true)
            case $lock_owner_start in ''|*[!0-9]*|0) return 1 ;; esac
            valid_boot_identity "$lock_owner_boot" || return 1
            lock_owner_legacy=false
            ;;
        *) return 1 ;;
    esac
    lock_owner_links=$(stat -c '%h' "$lock_owner_path" 2>/dev/null || true)
    case $lock_owner_links in
        1) ;;
        2)
            [ "$lock_owner_legacy" = false ] || return 1
            lock_owner_identity=$(stat -c '%d:%i' "$lock_owner_path" 2>/dev/null || true)
            [ -n "$lock_owner_identity" ] || return 1
            lock_owner_topology_valid=false
            for lock_owner_companion in \
                "$event_log_lock.claim.$lock_owner_pid.$lock_owner_start.$lock_owner_boot" \
                "$event_log_lock.pending.$lock_owner_pid.$lock_owner_start.$lock_owner_boot" \
                "$event_log_lock/pid"; do
                [ "$lock_owner_companion" != "$lock_owner_path" ] || continue
                companion_identity=$(stat -c '%d:%i' "$lock_owner_companion" 2>/dev/null || true)
                if [ -n "$companion_identity" ] && [ "$companion_identity" = "$lock_owner_identity" ]; then
                    lock_owner_topology_valid=true
                    break
                fi
            done
            if [ "$lock_owner_topology_valid" != true ]; then
                lock_owner_current_identity=$(stat -c '%d:%i' "$lock_owner_path" 2>/dev/null || true)
                lock_owner_current_links=$(stat -c '%h' "$lock_owner_path" 2>/dev/null || true)
                if [ "$lock_owner_current_identity" = "$lock_owner_identity" ] && [ "$lock_owner_current_links" = 1 ]; then
                    lock_owner_topology_valid=true
                fi
            fi
            [ "$lock_owner_topology_valid" = true ] || return 1
            ;;
        *) return 1 ;;
    esac
}

loaded_lock_owner_is_live() {
    if [ "$lock_owner_legacy" = true ]; then
        # A PID-only legacy owner cannot be distinguished from PID reuse and
        # therefore cannot remain a live exclusion after package upgrade.
        return 1
    else
        process_identity_is_live "$lock_owner_pid" "$lock_owner_start" "$lock_owner_boot"
    fi
}

event_recovery_owner_is_live() {
    checked_recovery_path=$1
    checked_recovery_suffix=${checked_recovery_path#"$event_log_lock".recover.}
    checked_recovery_pid=${checked_recovery_suffix%%.*}
    checked_recovery_remainder=${checked_recovery_suffix#*.}
    [ "$checked_recovery_remainder" != "$checked_recovery_suffix" ] || return 73
    checked_recovery_start=${checked_recovery_remainder%%.*}
    checked_recovery_boot=${checked_recovery_remainder#*.}
    [ "$checked_recovery_boot" != "$checked_recovery_remainder" ] || return 73
    case $checked_recovery_boot in *.*) return 73 ;; esac
    case $checked_recovery_start in ''|*[!0-9]*|0) return 73 ;; esac
    valid_boot_identity "$checked_recovery_boot" || return 73
    is_pid "$checked_recovery_pid" || return 73
    read_private_lock_owner "$checked_recovery_path" || return 73
    process_identity_is_live "$checked_recovery_pid" "$checked_recovery_start" "$checked_recovery_boot"
}

private_claim_artifact() {
    checked_claim_path=$1
    checked_claim_prefix=$2
    checked_claim_suffix=${checked_claim_path#"$checked_claim_prefix"}
    [ "$checked_claim_suffix" != "$checked_claim_path" ] || return 1
    checked_claim_pid=${checked_claim_suffix%%.*}
    checked_claim_remainder=${checked_claim_suffix#*.}
    [ "$checked_claim_remainder" != "$checked_claim_suffix" ] || return 1
    checked_claim_start=${checked_claim_remainder%%.*}
    checked_claim_boot=${checked_claim_remainder#*.}
    [ "$checked_claim_boot" != "$checked_claim_remainder" ] || return 1
    case $checked_claim_boot in *.*) return 1 ;; esac
    case $checked_claim_start in ''|*[!0-9]*|0) return 1 ;; esac
    valid_boot_identity "$checked_claim_boot" || return 1
    is_pid "$checked_claim_pid" || return 1
    [ -f "$checked_claim_path" ] && [ ! -L "$checked_claim_path" ] || return 1
    [ -n "$path_owner" ] || return 1
    checked_claim_mode=$(stat -c '%a' "$checked_claim_path" 2>/dev/null || true)
    checked_claim_uid=$(stat -c '%u' "$checked_claim_path" 2>/dev/null || true)
    checked_claim_links=$(stat -c '%h' "$checked_claim_path" 2>/dev/null || true)
    checked_claim_size=$(wc -c 2>/dev/null < "$checked_claim_path" | tr -d ' ')
    [ "$checked_claim_mode" = 600 ] && [ "$checked_claim_uid" = "$path_owner" ] || return 1
    case $checked_claim_size in ''|*[!0-9]*) return 1 ;; esac
    [ "$checked_claim_size" -le 96 ] || return 1
    case $checked_claim_links in
        1) ;;
        2)
            checked_claim_identity=$(stat -c '%d:%i' "$checked_claim_path" 2>/dev/null || true)
            [ -n "$checked_claim_identity" ] || return 1
            checked_claim_topology_valid=false
            for checked_claim_companion in \
                "$event_log_lock.claim.$checked_claim_pid.$checked_claim_start.$checked_claim_boot" \
                "$event_log_lock.pending.$checked_claim_pid.$checked_claim_start.$checked_claim_boot" \
                "$event_log_lock/pid"; do
                [ "$checked_claim_companion" != "$checked_claim_path" ] || continue
                companion_identity=$(stat -c '%d:%i' "$checked_claim_companion" 2>/dev/null || true)
                if [ -n "$companion_identity" ] && [ "$companion_identity" = "$checked_claim_identity" ]; then
                    checked_claim_topology_valid=true
                    break
                fi
            done
            if [ "$checked_claim_topology_valid" != true ]; then
                checked_claim_current_identity=$(stat -c '%d:%i' "$checked_claim_path" 2>/dev/null || true)
                checked_claim_current_links=$(stat -c '%h' "$checked_claim_path" 2>/dev/null || true)
                if [ "$checked_claim_current_identity" = "$checked_claim_identity" ] && [ "$checked_claim_current_links" = 1 ]; then
                    checked_claim_topology_valid=true
                fi
            fi
            [ "$checked_claim_topology_valid" = true ] || return 1
            ;;
        *) return 1 ;;
    esac
}

prune_orphan_claim_quarantines() {
    quarantine_prefix=$event_log_lock.claim-quarantine.
    for quarantine_path in "$quarantine_prefix"*; do
        [ -e "$quarantine_path" ] || [ -L "$quarantine_path" ] || continue
        quarantine_suffix=${quarantine_path#"$quarantine_prefix"}
        quarantine_pid=${quarantine_suffix%%.*}
        quarantine_remainder=${quarantine_suffix#*.}
        quarantine_start=${quarantine_remainder%%.*}
        quarantine_remainder=${quarantine_remainder#*.}
        quarantine_boot=${quarantine_remainder%%.*}
        quarantine_remainder=${quarantine_remainder#*.}
        quarantine_owner_pid=${quarantine_remainder%%.*}
        quarantine_remainder=${quarantine_remainder#*.}
        quarantine_owner_start=${quarantine_remainder%%.*}
        quarantine_owner_boot=${quarantine_remainder#*.}
        [ "$quarantine_owner_boot" != "$quarantine_remainder" ] || return 73
        case $quarantine_owner_boot in *.*) return 73 ;; esac
        case $quarantine_start in ''|*[!0-9]*|0) return 73 ;; esac
        case $quarantine_owner_start in ''|*[!0-9]*|0) return 73 ;; esac
        valid_boot_identity "$quarantine_boot" || return 73
        valid_boot_identity "$quarantine_owner_boot" || return 73
        is_pid "$quarantine_pid" || return 73
        is_pid "$quarantine_owner_pid" || return 73
        if ! private_claim_artifact "$quarantine_path" "$quarantine_prefix$quarantine_pid.$quarantine_start.$quarantine_boot."; then
            [ ! -e "$quarantine_path" ] && [ ! -L "$quarantine_path" ] && continue
            return 73
        fi
        quarantine_live_status=0
        process_identity_is_live "$quarantine_pid" "$quarantine_start" "$quarantine_boot" || quarantine_live_status=$?
        case $quarantine_live_status in 0) return 75 ;; 1) ;; *) return 73 ;; esac
        if ! rm -f "$quarantine_path"; then
            [ ! -e "$quarantine_path" ] && [ ! -L "$quarantine_path" ] || return 73
        fi
    done
}

prune_orphan_event_claims() {
    current_claim_path=$1
    prune_orphan_claim_quarantines || return $?
    for checked_claim_prefix in "$event_log_lock".claim. "$event_log_lock".pending.; do
        for checked_claim_path in "$checked_claim_prefix"*; do
            [ -e "$checked_claim_path" ] || [ -L "$checked_claim_path" ] || continue
            [ "$checked_claim_path" = "$current_claim_path" ] && continue
            if ! private_claim_artifact "$checked_claim_path" "$checked_claim_prefix"; then
                [ ! -e "$checked_claim_path" ] && [ ! -L "$checked_claim_path" ] && continue
                return 73
            fi
            checked_artifact_pid=$checked_claim_pid
            checked_artifact_start=$checked_claim_start
            checked_artifact_boot=$checked_claim_boot
            checked_artifact_live_status=0
            process_identity_is_live "$checked_artifact_pid" "$checked_artifact_start" "$checked_artifact_boot" || checked_artifact_live_status=$?
            if [ "$checked_artifact_live_status" -eq 0 ]; then
                # A contender can still be filling its private pending file.
                # It is not ownership until the complete inode is hard-linked
                # under the claim name, so never parse a live artifact here.
                continue
            fi
            [ "$checked_artifact_live_status" -eq 1 ] || return 73
            checked_artifact_identity=$(stat -c '%d:%i' "$checked_claim_path" 2>/dev/null || true)
            [ -n "$checked_artifact_identity" ] || continue
            quarantine_path=$event_log_lock.claim-quarantine.$$.$event_claim_start.$event_claim_boot.$checked_artifact_pid.$checked_artifact_start.$checked_artifact_boot
            [ ! -e "$quarantine_path" ] && [ ! -L "$quarantine_path" ] || return 73
            mv "$checked_claim_path" "$quarantine_path" 2>/dev/null || continue
            quarantine_identity=$(stat -c '%d:%i' "$quarantine_path" 2>/dev/null || true)
            [ "$quarantine_identity" = "$checked_artifact_identity" ] || return 73
            if ! rm -f "$quarantine_path"; then
                [ ! -e "$quarantine_path" ] && [ ! -L "$quarantine_path" ] || return 73
            fi
        done
    done
}

remove_orphan_event_recovery() {
    orphan_recovery_path=$1
    read_private_lock_owner "$orphan_recovery_path" || return 73
    orphan_lock_pid=$lock_owner_pid
    orphan_lock_start=$lock_owner_start
    orphan_lock_boot=$lock_owner_boot
    orphan_lock_legacy=$lock_owner_legacy
    orphan_reaper_status=0
    event_recovery_owner_is_live "$orphan_recovery_path" || orphan_reaper_status=$?
    case $orphan_reaper_status in 0) return 75 ;; 1) ;; *) return 73 ;; esac
    lock_owner_pid=$orphan_lock_pid
    lock_owner_start=$orphan_lock_start
    lock_owner_boot=$orphan_lock_boot
    lock_owner_legacy=$orphan_lock_legacy
    orphan_owner_status=0
    loaded_lock_owner_is_live || orphan_owner_status=$?
    if [ "$orphan_owner_status" -eq 0 ]; then
        # A recovery process can die after moving a newly-published live owner.
        # Restore that exact owner if no replacement exists; never discard it.
        [ ! -e "$event_log_lock/pid" ] && [ ! -L "$event_log_lock/pid" ] || return 75
        mv "$orphan_recovery_path" "$event_log_lock/pid" 2>/dev/null || return 73
        return 75
    fi
    [ "$orphan_owner_status" -eq 1 ] || return 73
    rm -f "$orphan_recovery_path"
}

create_event_log_lock_directory() {
    if [ ! -e "$event_log_lock" ] && [ ! -L "$event_log_lock" ]; then
        (umask 077; mkdir "$event_log_lock") 2>/dev/null || true
    fi
    private_event_lock_directory "$event_log_lock" || return 1
}

# Poll bucket C -- do not convert the `sleep 1` calls below to poll_wait. The
# `event_lock_attempt -lt 10` bounds throughout this function count *attempts*,
# not seconds, so the ~10 s of lock tolerance they provide is a product of the
# interval and the bound. There is no timeout-named variable here, which is
# what makes it dangerous: a search for `*_timeout` finds nothing and a
# fractional interval would quietly cut the tolerance to about half a second.
#
# The `event_stale_observations` check further down is bucket D and is worse
# still; see the comment there.
acquire_event_log_lock() {
    [ "$event_log_lock_held" != true ] || return 0
    create_event_log_lock_directory || return 73
    event_claim_start=$(process_start_time "$$" 2>/dev/null || true)
    event_claim_boot=$(boot_identity) || return 73
    [ -n "$event_claim_start" ] || return 73
    event_claim_path=$event_log_lock.claim.$$.$event_claim_start.$event_claim_boot
    event_pending_path=$event_log_lock.pending.$$.$event_claim_start.$event_claim_boot
    [ ! -e "$event_claim_path" ] && [ ! -L "$event_claim_path" ] || return 73
    [ ! -e "$event_pending_path" ] && [ ! -L "$event_pending_path" ] || return 73
    (umask 077; printf '%s\n%s\n%s\n' "$$" "$event_claim_start" "$event_claim_boot" > "$event_pending_path") || {
        [ -L "$event_pending_path" ] || rm -f "$event_pending_path" 2>/dev/null || true
        return 73
    }
    finish_private_file "$event_pending_path" || { rm -f "$event_pending_path"; return 73; }
    ln "$event_pending_path" "$event_claim_path" 2>/dev/null || { rm -f "$event_pending_path"; return 73; }
    rm -f "$event_pending_path" || { rm -f "$event_claim_path"; return 73; }
    event_claim_identity=$(stat -c '%d:%i' "$event_claim_path" 2>/dev/null || true)
    [ -n "$event_claim_identity" ] || { rm -f "$event_claim_path"; return 73; }
    event_lock_attempt=0
    event_stale_identity=
    event_stale_observations=0
    while :; do
        claim_prune_status=0
        prune_orphan_event_claims "$event_claim_path" || claim_prune_status=$?
        case $claim_prune_status in
            0) ;;
            75)
                event_lock_attempt=$((event_lock_attempt + 1))
                [ "$event_lock_attempt" -lt 10 ] || { rm -f "$event_claim_path"; return 75; }
                sleep 1
                continue
                ;;
            *) rm -f "$event_claim_path"; return 73 ;;
        esac
        event_recovery_active=false
        event_recovery_removed=false
        for event_recovery_path in "$event_log_lock".recover.*; do
            [ -e "$event_recovery_path" ] || [ -L "$event_recovery_path" ] || continue
            recovery_owner_status=0
            event_recovery_owner_is_live "$event_recovery_path" || recovery_owner_status=$?
            case $recovery_owner_status in
                0) event_recovery_active=true; break ;;
                1) ;;
                *)
                    [ ! -e "$event_recovery_path" ] && [ ! -L "$event_recovery_path" ] && continue
                    rm -f "$event_claim_path"
                    return 73
                    ;;
            esac
            recovery_cleanup_status=0
            remove_orphan_event_recovery "$event_recovery_path" || recovery_cleanup_status=$?
            case $recovery_cleanup_status in
                0) event_recovery_removed=true ;;
                75) event_recovery_active=true; break ;;
                *)
                    if [ ! -e "$event_recovery_path" ] && [ ! -L "$event_recovery_path" ]; then
                        event_recovery_removed=true
                    else
                        rm -f "$event_claim_path"
                        return 73
                    fi
                    ;;
            esac
        done
        if [ "$event_recovery_active" = true ]; then
            event_lock_attempt=$((event_lock_attempt + 1))
            [ "$event_lock_attempt" -lt 10 ] || { rm -f "$event_claim_path"; return 75; }
            sleep 1
            continue
        fi
        [ "$event_recovery_removed" != true ] || continue
        if ln "$event_claim_path" "$event_log_lock/pid" 2>/dev/null; then
            published_identity=$(stat -c '%d:%i' "$event_log_lock/pid" 2>/dev/null || true)
            [ "$published_identity" = "$event_claim_identity" ] || { rm -f "$event_claim_path"; return 73; }
            # A stale-owner recovery can begin between the pre-check and the
            # atomic link. Do not enter the critical section until it settles.
            event_recovery_active=false
            for event_recovery_path in "$event_log_lock".recover.*; do
                [ -e "$event_recovery_path" ] || [ -L "$event_recovery_path" ] || continue
                recovery_owner_status=0
                event_recovery_owner_is_live "$event_recovery_path" || recovery_owner_status=$?
                case $recovery_owner_status in
                    0) event_recovery_active=true; break ;;
                    1) ;;
                    *)
                        [ ! -e "$event_recovery_path" ] && [ ! -L "$event_recovery_path" ] && continue
                        rm -f "$event_claim_path"
                        return 73
                        ;;
                esac
                recovery_cleanup_status=0
                remove_orphan_event_recovery "$event_recovery_path" || recovery_cleanup_status=$?
                case $recovery_cleanup_status in
                    0) ;;
                    75) event_recovery_active=true; break ;;
                    *)
                        [ ! -e "$event_recovery_path" ] && [ ! -L "$event_recovery_path" ] && continue
                        rm -f "$event_claim_path"
                        return 73
                        ;;
                esac
            done
            if [ "$event_recovery_active" = true ]; then
                current_published_identity=$(stat -c '%d:%i' "$event_log_lock/pid" 2>/dev/null || true)
                if [ "$current_published_identity" = "$event_claim_identity" ]; then
                    rm -f "$event_log_lock/pid" || { rm -f "$event_claim_path"; return 73; }
                fi
                event_lock_attempt=$((event_lock_attempt + 1))
                [ "$event_lock_attempt" -lt 10 ] || { rm -f "$event_claim_path"; return 75; }
                sleep 1
                continue
            fi
            rm -f "$event_claim_path" || return 73
            event_log_lock_held=true
            break
        fi
        if ! private_event_lock_directory "$event_log_lock"; then
            # A previous owner can release and remove the verified empty lock
            # directory while this waiter sleeps. Recreate only an absent path;
            # an existing path that fails validation remains a hard failure.
            if create_event_log_lock_directory; then
                continue
            fi
            rm -f "$event_claim_path"
            return 73
        fi
        event_observed_owner_identity=$(stat -c '%d:%i' "$event_log_lock/pid" 2>/dev/null || true)
        if ! read_private_lock_owner "$event_log_lock/pid"; then
            event_current_owner_identity=$(stat -c '%d:%i' "$event_log_lock/pid" 2>/dev/null || true)
            if [ -z "$event_current_owner_identity" ] || [ "$event_current_owner_identity" != "$event_observed_owner_identity" ]; then
                event_lock_attempt=$((event_lock_attempt + 1))
                [ "$event_lock_attempt" -lt 10 ] || { rm -f "$event_claim_path"; return 75; }
                if ! create_event_log_lock_directory; then
                    if [ -e "$event_log_lock" ] || [ -L "$event_log_lock" ]; then
                        private_event_lock_directory "$event_log_lock" || { rm -f "$event_claim_path"; return 73; }
                    fi
                fi
                continue
            fi
            rm -f "$event_claim_path"
            return 73
        fi
        event_lock_pid=$lock_owner_pid
        event_lock_start=$lock_owner_start
        event_lock_boot=$lock_owner_boot
        event_lock_legacy=$lock_owner_legacy
        event_owner_status=0
        loaded_lock_owner_is_live || event_owner_status=$?
        if [ "$event_owner_status" -eq 0 ]; then
            event_lock_attempt=$((event_lock_attempt + 1))
            [ "$event_lock_attempt" -lt 10 ] || { rm -f "$event_claim_path"; return 75; }
            sleep 1
            continue
        fi
        [ "$event_owner_status" -eq 1 ] || { rm -f "$event_claim_path"; return 73; }
        event_lock_identity=$(stat -c '%d:%i' "$event_log_lock/pid" 2>/dev/null || true)
        if [ -z "$event_lock_identity" ]; then
            if [ ! -e "$event_log_lock/pid" ] && [ ! -L "$event_log_lock/pid" ]; then
                event_lock_attempt=$((event_lock_attempt + 1))
                [ "$event_lock_attempt" -lt 10 ] || { rm -f "$event_claim_path"; return 75; }
                create_event_log_lock_directory || {
                    [ ! -e "$event_log_lock" ] && [ ! -L "$event_log_lock" ] || { rm -f "$event_claim_path"; return 73; }
                }
                continue
            fi
            rm -f "$event_claim_path"
            return 73
        fi
        if [ "$event_stale_identity" = "$event_lock_identity" ]; then
            event_stale_observations=$((event_stale_observations + 1))
        else
            event_stale_identity=$event_lock_identity
            event_stale_observations=1
        fi
        # Poll bucket D -- the duration is the evidence, not the sampling rate.
        # This declares the lock stale only after two observations of an
        # unchanged, non-live identity, and the sleep between them is what makes
        # the second observation independent. It reads exactly like a bucket-A
        # poll and is not one: shorten it and "unchanged for a second" becomes
        # "unchanged for fifty milliseconds", which can recover a lock from an
        # owner that is merely mid-write. Leave it at one second.
        if [ "$event_stale_observations" -lt 2 ]; then
            sleep 1
            continue
        fi
        event_recovery_path=$event_log_lock.recover.$$.$event_claim_start.$event_claim_boot
        [ ! -e "$event_recovery_path" ] && [ ! -L "$event_recovery_path" ] || { rm -f "$event_claim_path"; return 73; }
        mv "$event_log_lock/pid" "$event_recovery_path" 2>/dev/null || continue
        recovered_identity=$(stat -c '%d:%i' "$event_recovery_path" 2>/dev/null || true)
        read_private_lock_owner "$event_recovery_path" || { rm -f "$event_claim_path"; return 73; }
        recovered_pid=$lock_owner_pid
        recovered_start=$lock_owner_start
        recovered_boot=$lock_owner_boot
        recovered_legacy=$lock_owner_legacy
        recovered_owner_status=0
        loaded_lock_owner_is_live || recovered_owner_status=$?
        [ "$recovered_owner_status" -ne 73 ] || { rm -f "$event_claim_path"; return 73; }
        if [ "$recovered_identity" != "$event_lock_identity" ] || [ "$recovered_owner_status" -eq 0 ]; then
            if [ ! -e "$event_log_lock/pid" ] && [ ! -L "$event_log_lock/pid" ]; then
                mv "$event_recovery_path" "$event_log_lock/pid" 2>/dev/null || true
            fi
            sleep 1
            continue
        fi
        rm -f "$event_recovery_path" || { rm -f "$event_claim_path"; return 73; }
        event_stale_identity=
        event_stale_observations=0
    done
}

release_event_log_lock() {
    [ "$event_log_lock_held" = true ] || return 0
    read_private_lock_owner "$event_log_lock/pid" || return 73
    event_release_start=$(process_start_time "$$" 2>/dev/null || true)
    event_release_boot=$(boot_identity) || return 73
    [ "$lock_owner_pid" = "$$" ] && [ "$lock_owner_start" = "$event_release_start" ] \
        && [ "$lock_owner_boot" = "$event_release_boot" ] || return 73
    rm -f "$event_log_lock/pid" || return 73
    rmdir "$event_log_lock" 2>/dev/null || true
    event_log_lock_held=false
}

# Reuse the atomic hard-link owner publication protocol for the longer-lived
# manager, policy, controller, and run locks. The caller owns normal release;
# the event-log lock globals are restored before any package work runs.
acquire_private_process_lock() {
    process_lock_path=$1
    saved_event_log_lock=$event_log_lock
    saved_event_log_lock_held=$event_log_lock_held
    [ "$saved_event_log_lock_held" != true ] || return 73
    event_log_lock=$process_lock_path
    event_log_lock_held=false
    process_lock_status=0
    acquire_event_log_lock || process_lock_status=$?
    event_log_lock=$saved_event_log_lock
    event_log_lock_held=$saved_event_log_lock_held
    return "$process_lock_status"
}

private_process_lock_is_live() {
    checked_process_lock=$1
    saved_event_log_lock=$event_log_lock
    event_log_lock=$checked_process_lock
    if ! private_event_lock_directory "$checked_process_lock"; then
        if [ ! -e "$checked_process_lock" ] && [ ! -L "$checked_process_lock" ]; then
            event_log_lock=$saved_event_log_lock
            return 1
        fi
        event_log_lock=$saved_event_log_lock
        return 73
    fi
    if [ ! -e "$checked_process_lock/pid" ] && [ ! -L "$checked_process_lock/pid" ]; then
        event_log_lock=$saved_event_log_lock
        return 1
    fi
    if ! read_private_lock_owner "$checked_process_lock/pid"; then
        event_log_lock=$saved_event_log_lock
        return 73
    fi
    process_lock_live_status=0
    loaded_lock_owner_is_live || process_lock_live_status=$?
    event_log_lock=$saved_event_log_lock
    return "$process_lock_live_status"
}

release_private_process_lock() {
    released_process_lock=$1
    saved_event_log_lock=$event_log_lock
    saved_event_log_lock_held=$event_log_lock_held
    event_log_lock=$released_process_lock
    event_log_lock_held=true
    release_process_status=0
    release_event_log_lock || release_process_status=$?
    event_log_lock=$saved_event_log_lock
    event_log_lock_held=$saved_event_log_lock_held
    return "$release_process_status"
}

setting() {
    setting_file=$1
    setting_name=$2
    setting_default=$3
    if [ -L "$setting_file" ] || [ ! -f "$setting_file" ]; then
        printf '%s\n' "$setting_default"
        return
    fi
    setting_value=$(sed -n "s/^${setting_name}=//p" "$setting_file" | sed -n '1p')
    if [ -n "$setting_value" ]; then
        printf '%s\n' "$setting_value"
    else
        printf '%s\n' "$setting_default"
    fi
}

# How much of the NAS this package may take, as one named choice rather than a
# pile of independent numbers. Every knob derives from the level, so the three
# levels stay reviewable and cannot be combined into a state nobody has
# reasoned about:
#
#   full     -- the historical behaviour. The core runs at the priority it
#               inherits, and admission keeps its widest fast-path window.
#   balanced -- the default. The core is nice 10, so DSM's own interface keeps
#               the CPU whenever the two compete, and admission gives up its
#               fast path sooner.
#   gentle   -- for the smallest armv7 units. Nice 19 and the shortest window.
#
# Two things are deliberately not knobs. The API bridge is never renice'd at
# any level: it serves the interactive request path, and throttling that is
# what makes a package feel broken rather than considerate. And the file holds
# exactly one key. A policy writer that stores several independent fields has
# to decide, for each one, whether a save replaces it or defaults it to what is
# stored -- get that wrong and a save from a form that sends a subset silently
# discards the rest, which is the bug configure_alert_policy documents at
# length in bin/sdsync-dsm. One derived level cannot have a subset.
load_performance_policy_runtime() {
    performance_runtime_level=balanced
    performance_stored_level=$(setting "$performance_policy_file" level balanced)
    case $performance_stored_level in
        full|balanced|gentle) performance_runtime_level=$performance_stored_level ;;
        *) ;;
    esac
    # The I/O class is carried separately because setpriority(2) does not touch
    # it: CPU priority reaches the core through the supervisor, and I/O
    # priority through an ionice prefix in sdsync-run. Class 0 means "leave the
    # inherited class alone", 2 is best-effort at the given level, 3 is idle.
    case $performance_runtime_level in
        full)
            performance_core_nice=0
            performance_admission_yields=32
            performance_io_class=0
            performance_io_level=0
            ;;
        balanced)
            performance_core_nice=10
            performance_admission_yields=8
            performance_io_class=2
            performance_io_level=6
            ;;
        *)
            performance_core_nice=19
            performance_admission_yields=4
            performance_io_class=3
            performance_io_level=0
            ;;
    esac
}

load_security_policy_runtime() {
    security_runtime_policy_version=1
    security_runtime_require_https=false
    security_runtime_allow_interface_changes=true
    security_runtime_allow_profile_changes=true
    security_runtime_allow_secret_changes=true
    security_runtime_allow_routine_changes=true
    security_runtime_allow_notification_changes=true
    security_runtime_allow_operational_actions=true
    security_runtime_allow_http_targets=true
    security_runtime_allow_invalid_tls=true
    security_runtime_allow_destructive_sync=true
    security_runtime_allow_doctor_write_test=true
    security_runtime_allow_remote_logging=true
    security_runtime_allow_empty_source=true
    security_runtime_result_retention=3600
    security_runtime_max_outstanding=256
    security_runtime_audit_level=info
    security_runtime_bridge_level=info
    security_runtime_authentication_level=warn
    security_runtime_security_level=warn
    security_runtime_configuration_level=info
    security_runtime_secrets_level=info
    security_runtime_routines_level=info
    security_runtime_operations_level=info
    security_runtime_notifications_level=warn
    security_runtime_sync_level=info
    security_runtime_controller_level=info
    security_runtime_scheduler_level=info
    [ ! -L "$security_policy_file" ] || return 73
    [ -e "$security_policy_file" ] || return 0
    private_secret_file "$security_policy_file" || return 73
    security_runtime_size=$(wc -c < "$security_policy_file" | tr -d ' ')
    case $security_runtime_size in ''|*[!0-9]*) return 73 ;; esac
    [ "$security_runtime_size" -ge 1 ] && [ "$security_runtime_size" -le 8192 ] || return 73
    # POSIX shell variables cannot preserve NUL. Strip every forbidden raw
    # non-LF control byte before assignment and require the resulting byte
    # length (minus the one canonical trailing LF removed by command
    # substitution) to equal the original. The tr stage status is checked
    # directly, without a pipeline whose earlier failure could be hidden.
    security_runtime_sanitized=$(LC_ALL=C tr -d '\000-\011\013-\037\177' < "$security_policy_file") || return 73
    [ "${#security_runtime_sanitized}" -eq $((security_runtime_size - 1)) ] || return 73
    # The canonical v1 document has exactly 29 LF-terminated records. Counting
    # newline bytes keeps an otherwise complete unterminated last record from
    # drifting away from the Rust parser's exact-format contract.
    security_runtime_newline_count=$(wc -l < "$security_policy_file" | tr -d ' ')
    case $security_runtime_newline_count in ''|*[!0-9]*) return 73 ;; esac
    [ "$security_runtime_newline_count" -eq 29 ] || return 73
    security_runtime_seen=,
    security_runtime_count=0
    while IFS= read -r security_runtime_line || [ -n "$security_runtime_line" ]; do
        case $security_runtime_line in ''|*=*=*) return 73 ;; esac
        security_runtime_key=${security_runtime_line%%=*}
        security_runtime_value=${security_runtime_line#*=}
        [ "$security_runtime_key" != "$security_runtime_line" ] && [ -n "$security_runtime_value" ] || return 73
        case $security_runtime_seen in *,$security_runtime_key,*) return 73 ;; esac
        security_runtime_seen=$security_runtime_seen$security_runtime_key,
        security_runtime_count=$((security_runtime_count + 1))
        case $security_runtime_key in
            policy_version)
                [ "$security_runtime_value" = 1 ] || return 73
                security_runtime_policy_version=1
                ;;
            require_https|allow_interface_changes|allow_profile_changes|allow_secret_changes|allow_routine_changes|\
            allow_notification_changes|allow_operational_actions|allow_http_targets|allow_invalid_tls|\
            allow_destructive_sync|allow_doctor_write_test|allow_remote_logging|allow_empty_source)
                case $security_runtime_value in true|false) ;; *) return 73 ;; esac
                case $security_runtime_key in
                    require_https) security_runtime_require_https=$security_runtime_value ;;
                    allow_interface_changes) security_runtime_allow_interface_changes=$security_runtime_value ;;
                    allow_profile_changes) security_runtime_allow_profile_changes=$security_runtime_value ;;
                    allow_secret_changes) security_runtime_allow_secret_changes=$security_runtime_value ;;
                    allow_routine_changes) security_runtime_allow_routine_changes=$security_runtime_value ;;
                    allow_notification_changes) security_runtime_allow_notification_changes=$security_runtime_value ;;
                    allow_operational_actions) security_runtime_allow_operational_actions=$security_runtime_value ;;
                    allow_http_targets) security_runtime_allow_http_targets=$security_runtime_value ;;
                    allow_invalid_tls) security_runtime_allow_invalid_tls=$security_runtime_value ;;
                    allow_destructive_sync) security_runtime_allow_destructive_sync=$security_runtime_value ;;
                    allow_doctor_write_test) security_runtime_allow_doctor_write_test=$security_runtime_value ;;
                    allow_remote_logging) security_runtime_allow_remote_logging=$security_runtime_value ;;
                    allow_empty_source) security_runtime_allow_empty_source=$security_runtime_value ;;
                esac
                ;;
            csrf_lifetime_seconds)
                case $security_runtime_value in ''|*[!0-9]*|0[0-9]*) return 73 ;; esac
                [ "$security_runtime_value" -ge 60 ] && [ "$security_runtime_value" -le 900 ] || return 73
                ;;
            result_retention_seconds)
                case $security_runtime_value in ''|*[!0-9]*|0[0-9]*) return 73 ;; esac
                [ "$security_runtime_value" -ge 300 ] && [ "$security_runtime_value" -le 86400 ] || return 73
                security_runtime_result_retention=$security_runtime_value
                ;;
            max_outstanding_jobs)
                case $security_runtime_value in ''|*[!0-9]*|0[0-9]*) return 73 ;; esac
                [ "$security_runtime_value" -ge 1 ] && [ "$security_runtime_value" -le 256 ] || return 73
                security_runtime_max_outstanding=$security_runtime_value
                ;;
            audit_log_level|bridge_log_level|authentication_log_level|security_log_level|\
            configuration_log_level|secrets_log_level|routines_log_level|operations_log_level|\
            notifications_log_level|sync_log_level|controller_log_level|scheduler_log_level)
                case $security_runtime_value in off|trace|debug|info|warn|error) ;; *) return 73 ;; esac
                case $security_runtime_key in
                    audit_log_level) security_runtime_audit_level=$security_runtime_value ;;
                    bridge_log_level) security_runtime_bridge_level=$security_runtime_value ;;
                    authentication_log_level) security_runtime_authentication_level=$security_runtime_value ;;
                    security_log_level) security_runtime_security_level=$security_runtime_value ;;
                    configuration_log_level) security_runtime_configuration_level=$security_runtime_value ;;
                    secrets_log_level) security_runtime_secrets_level=$security_runtime_value ;;
                    routines_log_level) security_runtime_routines_level=$security_runtime_value ;;
                    operations_log_level) security_runtime_operations_level=$security_runtime_value ;;
                    notifications_log_level) security_runtime_notifications_level=$security_runtime_value ;;
                    sync_log_level) security_runtime_sync_level=$security_runtime_value ;;
                    controller_log_level) security_runtime_controller_level=$security_runtime_value ;;
                    scheduler_log_level) security_runtime_scheduler_level=$security_runtime_value ;;
                esac
                ;;
            *) return 73 ;;
        esac
    done < "$security_policy_file"
    [ "$security_runtime_count" -eq 29 ] || return 73
}

epoch_now() {
    date +%s
}

# Interval and realtime routines are deliberately independent of the NAS
# calendar. Only daily routines are admitted through the configured weekday
# and local-clock window.
routine_clock_allows() {
    routine_clock_mode=$1
    routine_clock_weekdays=$2
    routine_clock_start=$3
    routine_clock_end=$4
    case $routine_clock_mode in
        interval|realtime) return 0 ;;
        daily) ;;
        *) return 1 ;;
    esac
    routine_clock_weekday=$(date +%u)
    case ,$routine_clock_weekdays, in *,$routine_clock_weekday,*) ;; *) return 1 ;; esac
    routine_clock_now=$(date +%H%M)
    routine_clock_start_number=$(printf '%s' "$routine_clock_start" | tr -d ':')
    routine_clock_end_number=$(printf '%s' "$routine_clock_end" | tr -d ':')
    routine_clock_now=${routine_clock_now#0}; [ -n "$routine_clock_now" ] || routine_clock_now=0
    routine_clock_start_number=${routine_clock_start_number#0}; [ -n "$routine_clock_start_number" ] || routine_clock_start_number=0
    routine_clock_end_number=${routine_clock_end_number#0}; [ -n "$routine_clock_end_number" ] || routine_clock_end_number=0
    if [ "$routine_clock_start_number" -le "$routine_clock_end_number" ]; then
        [ "$routine_clock_now" -ge "$routine_clock_start_number" ] && [ "$routine_clock_now" -le "$routine_clock_end_number" ]
    else
        [ "$routine_clock_now" -ge "$routine_clock_start_number" ] || [ "$routine_clock_now" -le "$routine_clock_end_number" ]
    fi
}

# Return the whole-action retry delay. Missing retry_exponential fields from
# pre-toggle routine files preserve the former exponential behavior at their
# call sites; every fixed or exponential delay is bounded to five minutes.
routine_retry_delay() {
    routine_retry_base=$1
    routine_retry_attempt=$2
    routine_retry_exponential=$3
    case $routine_retry_base in ''|*[!0-9]*) return 64 ;; esac
    case $routine_retry_attempt in ''|*[!0-9]*) return 64 ;; esac
    case $routine_retry_exponential in true|false) ;; *) return 64 ;; esac
    [ "$routine_retry_base" -ge 10 ] || return 64
    [ "$routine_retry_attempt" -ge 1 ] && [ "$routine_retry_attempt" -le 5 ] || return 64
    routine_retry_result=$routine_retry_base
    [ "$routine_retry_result" -le 300 ] || routine_retry_result=300
    if [ "$routine_retry_exponential" = true ]; then
        routine_retry_index=1
        while [ "$routine_retry_index" -lt "$routine_retry_attempt" ]; do
            if [ "$routine_retry_result" -ge 150 ]; then
                routine_retry_result=300
                break
            fi
            routine_retry_result=$((routine_retry_result * 2))
            routine_retry_index=$((routine_retry_index + 1))
        done
    fi
    printf '%s\n' "$routine_retry_result"
}

# A native watcher event becomes runnable only after the event file has been
# quiet for the complete debounce period. Return 1 while a valid event remains
# pending and 73 for unsafe or malformed state so callers can fail closed.
realtime_event_due() {
    realtime_event_path=$1
    realtime_event_now=$2
    realtime_event_debounce=$3
    realtime_event_identity=
    case $realtime_event_now in ''|*[!0-9]*) return 73 ;; esac
    case $realtime_event_debounce in ''|*[!0-9]*) return 73 ;; esac
    [ "$realtime_event_debounce" -ge 1 ] && [ "$realtime_event_debounce" -le 3600 ] || return 73
    [ ! -L "$realtime_event_path" ] && [ -f "$realtime_event_path" ] && [ -r "$realtime_event_path" ] || return 73
    [ -s "$realtime_event_path" ] || return 1
    realtime_event_stat=$(stat -c '%i:%s:%Y' "$realtime_event_path" 2>/dev/null) || return 73
    case $realtime_event_stat in ''|*[!0-9:]*) return 73 ;; esac
    realtime_event_old_ifs=$IFS
    IFS=:
    set -- $realtime_event_stat
    IFS=$realtime_event_old_ifs
    [ "$#" -eq 3 ] || return 73
    case $1:$2:$3 in *[!0-9:]*) return 73 ;; esac
    [ "$2" -gt 0 ] || return 73
    realtime_event_mtime=$3
    [ "$realtime_event_mtime" -le "$realtime_event_now" ] || return 73
    if [ $((realtime_event_now - realtime_event_mtime)) -ge "$realtime_event_debounce" ]; then
        # The controller revalidates this inode/size/mtime generation while the
        # native writer is stopped before consuming the marker.
        realtime_event_identity=$realtime_event_stat
        return 0
    fi
    return 1
}

write_controller_state() {
    controller_status=$1
    controller_pid=${2:-0}
    controller_next=${3:-0}
    controller_active=${4:-0}
    controller_temp=$controller_state.tmp.$$
    umask 077
    {
        printf 'state=%s\n' "$controller_status"
        printf 'pid=%s\n' "$controller_pid"
        printf 'next_run_epoch=%s\n' "$controller_next"
        printf 'active_pid=%s\n' "$controller_active"
        printf 'updated_epoch=%s\n' "$(epoch_now)"
    } > "$controller_temp"
    finish_private_file "$controller_temp"
    mv -f "$controller_temp" "$controller_state"
}

write_run_state() {
    run_status=$1
    run_started=${2:-0}
    run_finished=${3:-0}
    run_exit=${4:--1}
    run_scope=${5:-none}
    run_operation=${6:-none}
    run_temp=$run_state.tmp.$$
    umask 077
    {
        printf 'state=%s\n' "$run_status"
        printf 'started_epoch=%s\n' "$run_started"
        printf 'finished_epoch=%s\n' "$run_finished"
        printf 'exit_code=%s\n' "$run_exit"
        printf 'scope=%s\n' "$run_scope"
        printf 'operation=%s\n' "$run_operation"
    } > "$run_temp"
    finish_private_file "$run_temp"
    mv -f "$run_temp" "$run_state"
}

private_log_path_safe_or_absent() {
    private_log_path=$1
    if [ ! -e "$private_log_path" ] && [ ! -L "$private_log_path" ]; then
        return 0
    fi
    case ${path_owner:-} in ''|*[!0-9]*) return 73 ;; esac
    [ ! -L "$private_log_path" ] && [ -f "$private_log_path" ] || {
        echo "refusing unsafe package log file: $private_log_path" >&2
        return 73
    }
    private_log_contract=$(stat -c '%u:%a:%h' "$private_log_path" 2>/dev/null || true)
    [ "$private_log_contract" = "$path_owner:600:1" ] || {
        echo "refusing unsafe package log ownership, mode, or link count: $private_log_path" >&2
        return 73
    }
}

rotate_log() {
    rotate_path=$1
    rotate_limit=${2:-10485760}
    rotate_keep=${3:-5}
    case $rotate_limit in ''|*[!0-9]*|0) return 73 ;; esac
    case $rotate_keep in ''|*[!0-9]*|0) return 73 ;; esac
    [ "$rotate_keep" -le 64 ] 2>/dev/null || return 73

    # Validate the complete active/rotation set before appending or moving any
    # pathname. Package logs are private regular files; silently repairing an
    # existing hard link, symlink, foreign owner, or permissive mode could
    # modify or replace a different file.
    rotate_contract_index=0
    while [ "$rotate_contract_index" -le "$rotate_keep" ]; do
        if [ "$rotate_contract_index" -eq 0 ]; then
            rotate_contract_path=$rotate_path
        else
            rotate_contract_path=$rotate_path.$rotate_contract_index
        fi
        private_log_path_safe_or_absent "$rotate_contract_path" || return $?
        rotate_contract_index=$((rotate_contract_index + 1))
    done

    [ -f "$rotate_path" ] || return 0
    rotate_size=$(wc -c < "$rotate_path" | tr -d ' ')
    case $rotate_size in ''|*[!0-9]*) return 73 ;; esac
    [ "$rotate_size" -ge "$rotate_limit" ] || return 0
    rotate_index=$rotate_keep
    while [ "$rotate_index" -gt 1 ]; do
        rotate_previous=$((rotate_index - 1))
        if [ -f "$rotate_path.$rotate_previous" ] && [ ! -L "$rotate_path.$rotate_previous" ]; then
            mv -f "$rotate_path.$rotate_previous" "$rotate_path.$rotate_index"
        fi
        rotate_index=$rotate_previous
    done
    mv -f "$rotate_path" "$rotate_path.1"
}

append_rotating_log() {
    append_path=$1
    append_limit=$2
    append_keep=$3
    append_line=$4
    append_old_umask=$(umask)
    umask 077
    append_status=0
    rotate_log "$append_path" "$append_limit" "$append_keep" || append_status=$?
    if [ "$append_status" -eq 0 ]; then
        printf '%s\n' "$append_line" >> "$append_path" || append_status=$?
    fi
    if [ "$append_status" -eq 0 ]; then
        finish_private_file "$append_path" || append_status=$?
    fi
    if [ "$append_status" -eq 0 ]; then
        private_log_path_safe_or_absent "$append_path" || append_status=$?
    fi
    umask "$append_old_umask"
    return "$append_status"
}

json_quote() {
    # All package-authored configuration rejects newlines and control bytes, but
    # logs can still contain them.  Keep this encoder self-contained so the DSM
    # package does not depend on Python, jq, or a particular BusyBox extension.
    printf '%s' "${1:-}" | LC_ALL=C awk '
        BEGIN {
            slash = sprintf("%c", 92)
            printf "\""
        }
        {
            if (NR > 1) printf "%sn", slash
            for (cursor = 1; cursor <= length($0); cursor++) {
                character = substr($0, cursor, 1)
                if (character == slash) printf "%s%s", slash, slash
                else if (character == "\"") printf "%s\"", slash
                else if (character == "\t") printf "%st", slash
                else if (character == "\r") printf "%sr", slash
                else if (character ~ /[\001-\010\013\014\016-\037]/) printf "?"
                else printf "%s", character
            }
        }
        END { printf "\"" }
    '
}

append_activity() {
    activity_code=$1
    activity_profile=${2:-none}
    activity_state=$3
    activity_message=$4
    activity_category=${5:-operations}
    activity_level=${6:-info}
    activity_mandatory=${7:-false}
    activity_actor_uid=${8:-}
    activity_actor=${9:-}
    case $activity_code in
        run.started|run.succeeded|run.failed|routine.deferred|routine.retry_scheduled|\
        doctor.succeeded|doctor.failed|doctor.inventory|configuration.changed|notification.unavailable|\
        audit.requested|audit.succeeded|audit.failed|audit.outcome_unknown|\
        module.requested|module.succeeded|module.failed|module.outcome_unknown|\
        security.policy_changed|security.log_tail_recovered|security.failed|\
        authentication.failed|bridge.failed|\
        service.started|service.stopped|service.restarted|service.start_failed) ;;
        *) return 64 ;;
    esac
    case $activity_profile in none|all|''|*[!A-Za-z0-9_-]*)
        [ "$activity_profile" = none ] || [ "$activity_profile" = all ] || return 64
        ;;
    esac
    case $activity_state in running|succeeded|failed|deferred|scheduled|changed|unavailable|requested) ;;
        *) return 64 ;;
    esac
    case $activity_category in
        audit|bridge|authentication|security|configuration|secrets|routines|operations|notifications|sync|controller|scheduler) ;;
        *) return 64 ;;
    esac
    case $activity_level in trace|debug|info|warn|error) ;; *) return 64 ;; esac
    case $activity_mandatory in true|false) ;; *) return 64 ;; esac
    if [ -n "$activity_actor_uid" ] || [ -n "$activity_actor" ]; then
        case $activity_actor_uid in ''|*[!0-9]*|0|0[0-9]*) return 64 ;; esac
        [ "$activity_actor_uid" -le 4294967295 ] 2>/dev/null || return 64
        case $activity_actor in ''|*'|'*) return 64 ;; esac
        if ! printf '%s\n' "$activity_actor" | LC_ALL=C awk '
            NR != 1 { invalid = 1 }
            NR == 1 && length($0) >= 1 && length($0) <= 256 && $0 !~ /[[:cntrl:]]/ { valid = 1 }
            NR == 1 && !valid { invalid = 1 }
            END { exit NR == 1 && valid && !invalid ? 0 : 1 }
        '; then return 64; fi
    fi
    case $activity_message in
        *'|'*|*'
'*) return 64 ;;
    esac
    if printf '%s' "$activity_message" | LC_ALL=C grep '[[:cntrl:]]' >/dev/null 2>&1; then
        return 64
    fi
    if [ "$activity_mandatory" != true ]; then
        activity_configured_level=$(security_category_level "$activity_category") || return $?
        [ "$activity_configured_level" != off ] || return 0
        case $activity_configured_level in trace) activity_threshold=0 ;; debug) activity_threshold=1 ;; info) activity_threshold=2 ;; warn) activity_threshold=3 ;; error) activity_threshold=4 ;; esac
        case $activity_level in trace) activity_severity=0 ;; debug) activity_severity=1 ;; info) activity_severity=2 ;; warn) activity_severity=3 ;; error) activity_severity=4 ;; esac
        [ "$activity_severity" -ge "$activity_threshold" ] || return 0
    fi
    activity_owns_event_lock=false
    if [ "$event_log_lock_held" != true ]; then
        acquire_event_log_lock || return $?
        activity_owns_event_lock=true
    fi
    activity_append_status=0
    activity_tail_state=$(repair_durable_log_tail activity) || activity_append_status=$?
    if [ "$activity_append_status" -eq 0 ]; then
        case $activity_tail_state in clean|repaired) ;; *) activity_append_status=73 ;; esac
    fi
    if [ "$activity_append_status" -eq 0 ]; then
        if [ -n "$activity_actor_uid" ]; then
            activity_record="$(epoch_now)|$activity_code|${activity_profile:-none}|$activity_state|$activity_category|$activity_level|$activity_actor_uid|$activity_actor|$activity_message"
        else
            activity_record="$(epoch_now)|$activity_code|${activity_profile:-none}|$activity_state|$activity_category|$activity_level|$activity_message"
        fi
        append_rotating_log "$activity_log" 1048576 3 "$activity_record" || activity_append_status=$?
    fi
    if [ "$activity_append_status" -eq 0 ]; then
        finish_private_file "$activity_log" || activity_append_status=$?
    fi
    if [ "$activity_owns_event_lock" = true ]; then
        release_event_log_lock || activity_append_status=$?
    fi
    return "$activity_append_status"
}

security_category_level() {
    security_category=$1
    load_security_policy_runtime || return $?
    case $security_category in
        audit) security_level=$security_runtime_audit_level ;;
        bridge) security_level=$security_runtime_bridge_level ;;
        authentication) security_level=$security_runtime_authentication_level ;;
        security) security_level=$security_runtime_security_level ;;
        configuration) security_level=$security_runtime_configuration_level ;;
        secrets) security_level=$security_runtime_secrets_level ;;
        routines) security_level=$security_runtime_routines_level ;;
        operations) security_level=$security_runtime_operations_level ;;
        notifications) security_level=$security_runtime_notifications_level ;;
        sync) security_level=$security_runtime_sync_level ;;
        controller) security_level=$security_runtime_controller_level ;;
        scheduler) security_level=$security_runtime_scheduler_level ;;
        *) return 64 ;;
    esac
    printf '%s\n' "$security_level"
}

# Exit 0 when an optional event meets its persisted category threshold, 1 when
# it is intentionally suppressed, and preserve strict policy/runtime failures.
security_event_enabled() {
    security_event_category=$1
    security_event_level=$2
    security_event_mandatory=${3:-false}
    case $security_event_level in trace) security_event_rank=0 ;; debug) security_event_rank=1 ;; info) security_event_rank=2 ;; warn) security_event_rank=3 ;; error) security_event_rank=4 ;; *) return 64 ;; esac
    case $security_event_mandatory in true) return 0 ;; false) ;; *) return 64 ;; esac
    security_event_threshold=$(security_category_level "$security_event_category") || return $?
    case $security_event_threshold in
        off) return 1 ;;
        trace) security_threshold_rank=0 ;;
        debug) security_threshold_rank=1 ;;
        info) security_threshold_rank=2 ;;
        warn) security_threshold_rank=3 ;;
        error) security_threshold_rank=4 ;;
        *) return 73 ;;
    esac
    [ "$security_event_rank" -ge "$security_threshold_rank" ]
}

append_controller_log_event() {
    controller_event_level=$1
    controller_event_name=$2
    controller_event_detail=${3:-}
    controller_event_category=${4:-controller}
    controller_event_mandatory=${5:-false}
    controller_event_actor_uid=${6:-}
    controller_event_actor=${7:-}
    case $controller_event_level in trace|debug|info|warn|error) ;; *) return 64 ;; esac
    case $controller_event_name in ''|*[!a-z0-9_]*) return 64 ;; esac
    case $controller_event_category in controller|scheduler) ;; *) return 64 ;; esac
    case $controller_event_mandatory in true|false) ;; *) return 64 ;; esac
    case $controller_event_detail in *'
'*) return 64 ;; esac
    if printf '%s' "$controller_event_detail" | LC_ALL=C grep '[[:cntrl:]]' >/dev/null 2>&1; then
        return 64
    fi
    controller_event_actor_fields=
    if [ -n "$controller_event_actor_uid" ] || [ -n "$controller_event_actor" ]; then
        case $controller_event_actor_uid in ''|*[!0-9]*|0|0[0-9]*) return 64 ;; esac
        [ "$controller_event_actor_uid" -le 4294967295 ] 2>/dev/null || return 64
        case $controller_event_actor in ''|*'|'*) return 64 ;; esac
        if ! printf '%s\n' "$controller_event_actor" | LC_ALL=C awk '
            NR != 1 { invalid = 1 }
            NR == 1 && length($0) >= 1 && length($0) <= 256 && $0 !~ /[[:cntrl:]]/ { valid = 1 }
            NR == 1 && !valid { invalid = 1 }
            END { exit NR == 1 && valid && !invalid ? 0 : 1 }
        '; then return 64; fi
        controller_event_actor_fields=",\"actor_uid\":$controller_event_actor_uid,\"actor\":$(json_quote "$controller_event_actor")"
    fi
    controller_event_enabled_status=0
    security_event_enabled "$controller_event_category" "$controller_event_level" \
        "$controller_event_mandatory" || controller_event_enabled_status=$?
    case $controller_event_enabled_status in
        0) ;;
        1) return 0 ;;
        *) return "$controller_event_enabled_status" ;;
    esac
    controller_event_epoch=$(epoch_now)
    case $controller_event_epoch in ''|*[!0-9]*) return 69 ;; esac
    controller_event_json=$(printf '{"epoch":%s,"level":%s,"category":%s,"event":%s,"detail":%s%s}' \
        "$controller_event_epoch" "$(json_quote "$controller_event_level")" \
        "$(json_quote "$controller_event_category")" \
        "$(json_quote "$controller_event_name")" "$(json_quote "$controller_event_detail")" \
        "$controller_event_actor_fields")
    controller_event_owns_lock=false
    if [ "$event_log_lock_held" != true ]; then
        acquire_event_log_lock || return $?
        controller_event_owns_lock=true
    fi
    controller_event_status=0
    append_rotating_log "$controller_log" 10485760 5 "$controller_event_json" \
        || controller_event_status=$?
    if [ "$controller_event_owns_lock" = true ]; then
        release_event_log_lock || controller_event_status=$?
    fi
    return "$controller_event_status"
}

append_lifecycle_event() {
    lifecycle_event=$1
    case $lifecycle_event in
        started)
            lifecycle_code=service.started
            lifecycle_state=succeeded
            lifecycle_level=info
            lifecycle_message="Package service started"
            ;;
        stopped)
            lifecycle_code=service.stopped
            lifecycle_state=succeeded
            lifecycle_level=info
            lifecycle_message="Package service stopped"
            ;;
        restarted)
            lifecycle_code=service.restarted
            lifecycle_state=succeeded
            lifecycle_level=info
            lifecycle_message="Package service restarted"
            ;;
        start_failed)
            lifecycle_code=service.start_failed
            lifecycle_state=failed
            lifecycle_level=error
            lifecycle_message="Package service failed to start"
            ;;
        *) return 64 ;;
    esac
    lifecycle_event_status=0
    append_controller_log_event "$lifecycle_level" "service_$lifecycle_event" \
        "service=synology-drive-sync state=$lifecycle_state" controller false \
        "$path_owner" package-service || lifecycle_event_status=$?
    append_activity "$lifecycle_code" none "$lifecycle_state" "$lifecycle_message" \
        controller "$lifecycle_level" false "$path_owner" package-service \
        || lifecycle_event_status=$?
    dsm_log_event "service_$lifecycle_event"
    return "$lifecycle_event_status"
}

write_service_stop_marker() {
    stop_marker_temp=$service_stop_marker.tmp.$$
    [ ! -e "$stop_marker_temp" ] && [ ! -L "$stop_marker_temp" ] || return 73
    printf 'stopped\n' > "$stop_marker_temp" || { rm -f "$stop_marker_temp"; return 73; }
    finish_private_file "$stop_marker_temp" || { rm -f "$stop_marker_temp"; return 73; }
    if [ -e "$service_stop_marker" ] || [ -L "$service_stop_marker" ]; then
        private_secret_file "$service_stop_marker" || { rm -f "$stop_marker_temp"; return 73; }
        [ "$(wc -c 2>/dev/null < "$service_stop_marker" | tr -d ' ')" = 8 ] \
            || { rm -f "$stop_marker_temp"; return 73; }
        [ "$(sed -n '1p' "$service_stop_marker" 2>/dev/null || true)" = stopped ] \
            || { rm -f "$stop_marker_temp"; return 73; }
    fi
    mv -f "$stop_marker_temp" "$service_stop_marker" || { rm -f "$stop_marker_temp"; return 73; }
}

service_restart_pending() {
    [ -e "$service_stop_marker" ] || [ -L "$service_stop_marker" ] || return 1
    private_secret_file "$service_stop_marker" || return 73
    [ "$(wc -c 2>/dev/null < "$service_stop_marker" | tr -d ' ')" = 8 ] || return 73
    [ "$(sed -n '1p' "$service_stop_marker" 2>/dev/null || true)" = stopped ] || return 73
}

consume_service_stop_marker() {
    service_restart_pending || return $?
    stop_marker_identity=$(stat -c '%d:%i' "$service_stop_marker" 2>/dev/null || true)
    [ -n "$stop_marker_identity" ] || return 73
    service_restart_pending || return 73
    stop_marker_recheck=$(stat -c '%d:%i' "$service_stop_marker" 2>/dev/null || true)
    [ "$stop_marker_recheck" = "$stop_marker_identity" ] || return 73
    rm -f "$service_stop_marker"
}

verify_durable_audit_event() {
    [ -x "$api_bridge" ] && [ ! -L "$api_bridge" ] || return 73
    "$api_bridge" --audit-transaction verify "$1" "$2" "$3" "$4" "$5" "$6" "$7"
}

repair_durable_log_tail() {
    repair_log_kind=$1
    case $repair_log_kind in audit|activity) ;; *) return 64 ;; esac
    [ -x "$api_bridge" ] && [ ! -L "$api_bridge" ] || return 73
    "$api_bridge" --audit-transaction repair-log-tail "$repair_log_kind"
}

validate_audit_identity() {
    [ -x "$api_bridge" ] && [ ! -L "$api_bridge" ] || return 73
    "$api_bridge" --audit-transaction validate "$1" "$2" "$3" "$4" "$5" "$6"
}

append_audit_event() {
    audit_operation=$1
    audit_state=$2
    audit_profile=${3:-all}
    audit_policy_mode=${4:-strict}
    audit_actor=${SDSYNC_DSM_AUDIT_ACTOR:-dsm-administrator}
    audit_actor_uid=${SDSYNC_DSM_AUDIT_ACTOR_UID:-$path_owner}
    audit_origin=${SDSYNC_DSM_AUDIT_ORIGIN:-cli}
    audit_client_request_id=${SDSYNC_DSM_CLIENT_REQUEST_ID:-}
    case $audit_origin in bridge|cli|manager|scheduler|controller) ;; *) return 64 ;; esac
    case $audit_client_request_id in
        '') ;;
        *[!0-9a-f]*) return 64 ;;
    esac
    if [ -n "$audit_client_request_id" ]; then
        [ "${#audit_client_request_id}" -eq 32 ] || return 64
    fi
    ensure_audit_transaction || return $?
    audit_transaction=$SDSYNC_DSM_AUDIT_TRANSACTION
    case $audit_transaction in ''|*[!A-Za-z0-9_-]*) return 64 ;; esac
    [ "${#audit_transaction}" -le 96 ] || return 64
    case $audit_operation in
        configure-profile|remove-profile|set-default|schedule|alert-policy|performance-policy|enable|disable) audit_category=configuration ;;
        set-secret|set-password|set-totp|set-remote-log-token|remove-password|remove-totp|remove-remote-log-token) audit_category=secrets ;;
        test-profile-auth|browse-remote) audit_category=authentication ;;
        routine|configure-routine|remove-routine) audit_category=routines ;;
        security-policy) audit_category=security ;;
        rejected-post) audit_category=bridge ;;
        interface-settings) audit_category=configuration ;;
        session-notifications) audit_category=notifications ;;
        action|doctor|plan|run|sync-status|resync) audit_category=operations ;;
        *) return 64 ;;
    esac
    case $audit_state in requested|succeeded|failed|outcome_unknown) ;; *) return 64 ;; esac
    case $audit_policy_mode in
        strict) ;;
        recovery) [ "$audit_operation" = security-policy ] || return 64 ;;
        *) return 64 ;;
    esac
    case $audit_profile in all|none|''|*[!A-Za-z0-9_-]*)
        [ "$audit_profile" = all ] || [ "$audit_profile" = none ] || return 64
        ;;
    esac
    # The authenticated DSM account is used only as a JSON value. Keep actor
    # validation separate from profile/path identifiers so documented UTF-8
    # local or directory identities (including spaces) remain attributable without ever
    # becoming a delimiter, command, or filesystem component.
    case $audit_actor in ''|*'|'*) return 64 ;; esac
    if ! printf '%s\n' "$audit_actor" | LC_ALL=C awk '
        NR != 1 { invalid = 1 }
        NR == 1 && length($0) >= 1 && length($0) <= 256 && $0 !~ /[[:cntrl:]]/ { valid = 1 }
        NR == 1 && !valid { invalid = 1 }
        END { exit NR == 1 && valid && !invalid ? 0 : 1 }
    '; then return 64; fi
    case $audit_actor_uid in ''|*[!0-9]*|0|0[0-9]*) return 64 ;; esac
    [ "$audit_actor_uid" -le 4294967295 ] 2>/dev/null || return 64
    validate_audit_identity "$audit_operation" "${audit_profile:-none}" "$audit_actor" \
        "$audit_actor_uid" "$audit_origin" "$audit_transaction" || return $?
    if [ "$audit_policy_mode" = recovery ]; then
        # Repairing an incomplete/corrupt/dangling security policy must remain
        # auditable without trusting that broken document. Mandatory records
        # use fixed conservative metadata until the replacement is installed.
        audit_configured_level=warn
        audit_subject_level=warn
    else
        audit_configured_level=$(security_category_level audit) || return $?
        audit_subject_level=$(security_category_level "$audit_category") || return $?
    fi
    # Accountability is non-disableable. "off" disables optional category
    # detail, but each mutation still receives this minimal audit record.
    case $audit_state in failed) audit_level=error ;; outcome_unknown) audit_level=warn ;; *) audit_level=info ;; esac
    audit_epoch=$(epoch_now)
    case $audit_epoch in ''|*[!0-9]*) return 69 ;; esac
    audit_operation_json=$(json_quote "$audit_operation") || return $?
    audit_state_json=$(json_quote "$audit_state") || return $?
    audit_transaction_json=$(json_quote "$audit_transaction") || return $?
    audit_origin_json=$(json_quote "$audit_origin") || return $?
    audit_actor_json=$(json_quote "$audit_actor") || return $?
    audit_profile_json=$(json_quote "${audit_profile:-none}") || return $?
    audit_client_request_field=
    audit_client_request_needle=
    audit_activity_message="Module $audit_operation $audit_state [$audit_transaction]"
    if [ -n "$audit_client_request_id" ]; then
        audit_client_request_json=$(json_quote "$audit_client_request_id") || return $?
        audit_client_request_field=",\"client_request_id\":$audit_client_request_json"
        audit_client_request_needle="\"client_request_id\":$audit_client_request_json"
        audit_activity_message="$audit_activity_message request_id=$audit_client_request_id"
    fi
    case $audit_state in
        requested) audit_code=audit.requested; audit_activity_state=requested ;;
        succeeded) audit_code=audit.succeeded; audit_activity_state=succeeded ;;
        failed) audit_code=audit.failed; audit_activity_state=failed ;;
        outcome_unknown) audit_code=audit.outcome_unknown; audit_activity_state=unavailable ;;
    esac
    acquire_event_log_lock || return $?
    audit_append_status=0
    audit_record_exists=false
    activity_record_exists=false
    audit_tail_state=$(repair_durable_log_tail audit) || audit_append_status=$?
    if [ "$audit_append_status" -eq 0 ]; then
        activity_tail_state=$(repair_durable_log_tail activity) || audit_append_status=$?
    fi
    if [ "$audit_append_status" -eq 0 ]; then
        case $audit_tail_state:$activity_tail_state in
            clean:clean|clean:repaired|repaired:clean|repaired:repaired) ;;
            *) audit_append_status=73 ;;
        esac
    fi
    if [ "$audit_append_status" -eq 0 ] \
        && { [ "$audit_tail_state" = repaired ] || [ "$activity_tail_state" = repaired ]; }; then
        case $audit_tail_state:$activity_tail_state in
            repaired:clean) audit_recovery_message="Recovered incomplete active audit log tail" ;;
            clean:repaired) audit_recovery_message="Recovered incomplete active activity log tail" ;;
            repaired:repaired) audit_recovery_message="Recovered incomplete active audit and activity log tails" ;;
        esac
        append_activity security.log_tail_recovered none changed \
            "$audit_recovery_message" security warn true \
            || audit_append_status=$?
    fi
    if [ "$audit_append_status" -eq 0 ]; then
        for audit_existing in "$audit_log" "$audit_log.1" "$audit_log.2" "$audit_log.3" "$audit_log.4" "$audit_log.5"; do
            [ -e "$audit_existing" ] || [ -L "$audit_existing" ] || continue
            [ -f "$audit_existing" ] && [ ! -L "$audit_existing" ] \
                && [ "$(stat -c '%u:%a:%h' "$audit_existing" 2>/dev/null || true)" = "$path_owner:600:1" ] || { audit_append_status=73; break; }
            # One awk pass per file instead of a grep pipeline per counter.
            # The old form spawned four processes for the match count and ten
            # for the exact count and read the file twice, all while holding
            # the event log lock -- roughly 120 processes per audit write once
            # the activity half below is included. index() is the same
            # substring test grep -F applies per line, so both counters are
            # unchanged; only the process count and the re-reads are.
            #
            # Needles travel through the environment rather than -v: json_quote
            # emits backslash escapes, and awk expands escape sequences in a -v
            # assignment but never in ENVIRON.
            audit_counts=$(AUDIT_TX="\"transaction\":$audit_transaction_json" \
                AUDIT_ST="\"state\":$audit_state_json" \
                AUDIT_OP="\"operation\":$audit_operation_json" \
                AUDIT_OG="\"origin\":$audit_origin_json" \
                AUDIT_AC="\"actor\":$audit_actor_json" \
                AUDIT_AU="\"actor_uid\":$audit_actor_uid" \
                AUDIT_PR="\"profile\":$audit_profile_json" \
                AUDIT_CR="$audit_client_request_needle" \
                LC_ALL=C awk '
                BEGIN {
                    needle_tx = ENVIRON["AUDIT_TX"]; needle_st = ENVIRON["AUDIT_ST"]
                    needle_op = ENVIRON["AUDIT_OP"]; needle_og = ENVIRON["AUDIT_OG"]
                    needle_ac = ENVIRON["AUDIT_AC"]; needle_au = ENVIRON["AUDIT_AU"]
                    needle_pr = ENVIRON["AUDIT_PR"]; needle_cr = ENVIRON["AUDIT_CR"]
                    # An empty needle would be a silent dedup failure: index(s, "")
                    # is 1 on some awks and 0 on others, so an unavailable ENVIRON
                    # either matches everything or nothing. Refuse to guess. Only
                    # needle_cr may legitimately be empty.
                    needles_ok = 1
                    if (needle_tx == "" || needle_st == "" || needle_op == "" ||
                        needle_og == "" || needle_ac == "" || needle_au == "" ||
                        needle_pr == "") { needles_ok = 0; exit 73 }
                }
                index($0, needle_tx) == 0 || index($0, needle_st) == 0 { next }
                { matched++ }
                index($0, needle_op) && index($0, needle_og) &&
                index($0, needle_ac) && index($0, needle_au) &&
                index($0, needle_pr) &&
                (needle_cr == "" || index($0, needle_cr)) { exact++ }
                END {
                    # exit in BEGIN still runs END, so the guard has to hold here too.
                    if (!needles_ok) exit 73
                    printf "%d:%d\n", matched + 0, exact + 0
                }
                ' "$audit_existing" 2>/dev/null)
            # Stricter than the old wc -l output, which was numeric by
            # construction: an awk that failed to run must not read as zero.
            case $audit_counts in
                ''|*[!0-9:]*|:*|*:|*:*:*) audit_append_status=73; break ;;
            esac
            audit_match_count=${audit_counts%%:*}
            audit_exact_count=${audit_counts#*:}
            [ "$audit_match_count" -eq "$audit_exact_count" ] || { audit_append_status=73; break; }
            [ "$audit_exact_count" -eq 0 ] || audit_record_exists=true
        done
    fi
    if [ "$audit_append_status" -eq 0 ]; then
        for activity_existing in "$activity_log" "$activity_log.1" "$activity_log.2" "$activity_log.3"; do
            [ -e "$activity_existing" ] || [ -L "$activity_existing" ] || continue
            [ -f "$activity_existing" ] && [ ! -L "$activity_existing" ] \
                && [ "$(stat -c '%u:%a:%h' "$activity_existing" 2>/dev/null || true)" = "$path_owner:600:1" ] || { audit_append_status=73; break; }
            activity_counts=$(ACTIVITY_CODE="|$audit_code|" \
                ACTIVITY_TX="[$audit_transaction]" \
                ACTIVITY_EXACT="|$audit_code|${audit_profile:-none}|$audit_activity_state|audit|$audit_level|$audit_actor_uid|$audit_actor|$audit_activity_message" \
                LC_ALL=C awk '
                BEGIN {
                    needle_code = ENVIRON["ACTIVITY_CODE"]
                    needle_tx = ENVIRON["ACTIVITY_TX"]
                    needle_exact = ENVIRON["ACTIVITY_EXACT"]
                    needles_ok = 1
                    if (needle_code == "" || needle_tx == "" || needle_exact == "")
                        { needles_ok = 0; exit 73 }
                }
                index($0, needle_code) && index($0, needle_tx) { matched++ }
                index($0, needle_exact) { exact++ }
                END {
                    if (!needles_ok) exit 73
                    printf "%d:%d\n", matched + 0, exact + 0
                }
                ' "$activity_existing" 2>/dev/null)
            case $activity_counts in
                ''|*[!0-9:]*|:*|*:|*:*:*) audit_append_status=73; break ;;
            esac
            activity_match_count=${activity_counts%%:*}
            activity_exact_count=${activity_counts#*:}
            [ "$activity_match_count" -eq "$activity_exact_count" ] || { audit_append_status=73; break; }
            [ "$activity_exact_count" -eq 0 ] || activity_record_exists=true
        done
    fi
    if [ "$audit_append_status" -eq 0 ] && [ "$activity_record_exists" = true ] && [ "$audit_record_exists" != true ]; then
        audit_append_status=73
    fi
    if [ "$audit_append_status" -eq 0 ] && [ "$activity_record_exists" = true ] && [ "$audit_record_exists" = true ]; then
        if [ "$audit_append_status" -eq 0 ]; then
            verify_durable_audit_event "$audit_operation" "${audit_profile:-none}" "$audit_actor" \
                "$audit_actor_uid" "$audit_origin" "$audit_transaction" "$audit_state" || audit_append_status=$?
        fi
        release_event_log_lock || audit_append_status=$?
        return "$audit_append_status"
    fi
    if [ "$audit_append_status" -eq 0 ] && [ "$audit_record_exists" != true ]; then
        append_rotating_log "$audit_log" 10485760 5 \
            "{\"epoch\":$audit_epoch,\"level\":$(json_quote "$audit_level"),\"configured_level\":$(json_quote "$audit_configured_level"),\"subject_level\":$(json_quote "$audit_subject_level"),\"mandatory\":true,\"category\":\"audit\",\"subject_category\":$(json_quote "$audit_category"),\"operation\":$audit_operation_json,\"state\":$audit_state_json,\"transaction\":$audit_transaction_json,\"origin\":$audit_origin_json,\"actor\":$audit_actor_json,\"actor_uid\":$audit_actor_uid,\"profile\":$audit_profile_json$audit_client_request_field}" || audit_append_status=$?
        if [ "$audit_append_status" -eq 0 ]; then
            finish_private_file "$audit_log" || audit_append_status=$?
        fi
    fi
    if [ "$audit_append_status" -eq 0 ] && [ "$activity_record_exists" != true ]; then
        append_activity "$audit_code" "${audit_profile:-none}" "$audit_activity_state" \
            "$audit_activity_message" audit "$audit_level" true \
            "$audit_actor_uid" "$audit_actor" || audit_append_status=$?
    fi
    if [ "$audit_append_status" -eq 0 ] && [ "$audit_policy_mode" = recovery ]; then
        if [ "$audit_append_status" -eq 0 ]; then
            verify_durable_audit_event "$audit_operation" "${audit_profile:-none}" "$audit_actor" \
                "$audit_actor_uid" "$audit_origin" "$audit_transaction" "$audit_state" || audit_append_status=$?
        fi
        release_event_log_lock || audit_append_status=$?
        return "$audit_append_status"
    fi
    if [ "$audit_append_status" -eq 0 ]; then
        case $audit_state in
            requested) audit_subject_code=module.requested; audit_subject_event_level=debug ;;
            succeeded) audit_subject_code=module.succeeded; audit_subject_event_level=info ;;
            failed) audit_subject_code=module.failed; audit_subject_event_level=error ;;
            outcome_unknown) audit_subject_code=module.outcome_unknown; audit_subject_event_level=warn ;;
        esac
        append_activity "$audit_subject_code" "${audit_profile:-none}" "$audit_activity_state" \
            "$audit_activity_message" "$audit_category" "$audit_subject_event_level" false >/dev/null 2>&1 || true
    fi
    if [ "$audit_append_status" -eq 0 ] && [ "$audit_state" = requested ] && [ "$audit_origin" = bridge ]; then
        append_activity module.requested "${audit_profile:-none}" requested \
            "DSM administrator authentication accepted" authentication debug false >/dev/null 2>&1 || true
    fi
    if [ "$audit_append_status" -eq 0 ] && [ "$audit_state" = requested ] && [ "$audit_origin" = bridge ]; then
        append_activity module.requested "${audit_profile:-none}" requested \
            "Authenticated bridge mutation accepted" bridge trace false >/dev/null 2>&1 || true
    fi
    if [ "$audit_append_status" -eq 0 ]; then
        append_activity "$audit_subject_code" "${audit_profile:-none}" "$audit_activity_state" \
            "Mandatory audit transaction recorded" audit debug false >/dev/null 2>&1 || true
    fi
    if [ "$audit_append_status" -eq 0 ]; then
        verify_durable_audit_event "$audit_operation" "${audit_profile:-none}" "$audit_actor" \
            "$audit_actor_uid" "$audit_origin" "$audit_transaction" "$audit_state" || audit_append_status=$?
    fi
    release_event_log_lock || audit_append_status=$?
    return "$audit_append_status"
}

ensure_audit_transaction() {
    ensured_audit_origin=${SDSYNC_DSM_AUDIT_ORIGIN:-cli}
    case $ensured_audit_origin in bridge|cli|manager|scheduler|controller) ;; *) return 64 ;; esac
    if [ -z "${SDSYNC_DSM_AUDIT_TRANSACTION:-}" ]; then
        [ -x "$api_bridge" ] && [ ! -L "$api_bridge" ] || return 73
        SDSYNC_DSM_AUDIT_TRANSACTION=$("$api_bridge" --audit-transaction create "$ensured_audit_origin") || return $?
        export SDSYNC_DSM_AUDIT_TRANSACTION
    fi
    case $SDSYNC_DSM_AUDIT_TRANSACTION in ''|*[!A-Za-z0-9_-]*) return 64 ;; esac
    [ "${#SDSYNC_DSM_AUDIT_TRANSACTION}" -le 96 ] || return 64
}

audit_outbox_begin() {
    [ -x "$api_bridge" ] && [ ! -L "$api_bridge" ] || return 73
    "$api_bridge" --audit-transaction begin "$1" "$2" "$3" "$4" "$5" "$6"
}

audit_outbox_complete() {
    [ -x "$api_bridge" ] && [ ! -L "$api_bridge" ] || return 73
    "$api_bridge" --audit-transaction complete "$1" "$2"
}

audit_outbox_execute() {
    [ -x "$api_bridge" ] && [ ! -L "$api_bridge" ] || return 73
    "$api_bridge" --audit-transaction execute "$1"
}

reconcile_audit_outbox() {
    [ -x "$api_bridge" ] && [ ! -L "$api_bridge" ] || return 73
    "$api_bridge" --audit-transaction reconcile
}

safe_notify() {
    notify_key=$1
    notify_profile=${2:-all}
    notify_exit=${3:-0}
    case $notify_key in sync_succeeded|sync_failed|doctor_failed) ;; *) return 64 ;; esac
    case $notify_profile in all|*[!A-Za-z0-9_-]*)
        [ "$notify_profile" = all ] || return 64
        ;;
    esac
    case $notify_exit in ''|*[!0-9]*) return 64 ;; esac
    notify_status=69
    if [ -x /usr/syno/bin/synodsmnotify ] && [ ! -L /usr/syno/bin/synodsmnotify ]; then
        # DSM receives only reviewed application and I18N identifiers. Dynamic
        # profile, exit, log, and secret material never enters notifier argv.
        case $notify_key in
            sync_succeeded)
                if /usr/syno/bin/synodsmnotify -c SYNO.SDS.App.SynologyDriveSync.Instance \
                    @administrators \
                    synology-drive-sync:notifications:sync_succeeded_title \
                    synology-drive-sync:notifications:sync_succeeded_message \
                    >/dev/null 2>&1; then return 0; else notify_status=$?; fi
                ;;
            sync_failed)
                if /usr/syno/bin/synodsmnotify -c SYNO.SDS.App.SynologyDriveSync.Instance \
                    @administrators \
                    synology-drive-sync:notifications:sync_failed_title \
                    synology-drive-sync:notifications:sync_failed_message \
                    >/dev/null 2>&1; then return 0; else notify_status=$?; fi
                ;;
            doctor_failed)
                if /usr/syno/bin/synodsmnotify -c SYNO.SDS.App.SynologyDriveSync.Instance \
                    @administrators \
                    synology-drive-sync:notifications:doctor_failed_title \
                    synology-drive-sync:notifications:doctor_failed_message \
                    >/dev/null 2>&1; then return 0; else notify_status=$?; fi
                ;;
        esac
    fi
    append_activity notification.unavailable "$notify_profile" unavailable \
        "DSM desktop notification delivery unavailable" notifications warn 2>/dev/null || true
    return "$notify_status"
}

handle_alert_result() {
    alert_profile=$1
    alert_result=$2
    alert_exit=$3
    case $alert_profile in all|*[!A-Za-z0-9_-]*) [ "$alert_profile" = all ] || return 64 ;; esac
    case $alert_result in succeeded|failed) ;; *) return 64 ;; esac
    case $alert_exit in ''|*[!0-9]*) return 64 ;; esac
    [ ! -L "$alert_policy_file" ] && [ ! -L "$alert_state" ] || return 73
    policy_enabled=$(setting "$alert_policy_file" enabled true)
    policy_success=$(setting "$alert_policy_file" on_success false)
    policy_failure=$(setting "$alert_policy_file" on_failure true)
    policy_threshold=$(setting "$alert_policy_file" failure_threshold 1)
    policy_cooldown=$(setting "$alert_policy_file" cooldown_seconds 3600)
    case $policy_enabled:$policy_success:$policy_failure in
        true:true:true|true:true:false|true:false:true|true:false:false|false:true:true|false:true:false|false:false:true|false:false:false) ;;
        *) return 73 ;;
    esac
    case $policy_threshold:$policy_cooldown in *[!0-9:]*) return 73 ;; esac
    [ "$policy_threshold" -ge 1 ] && [ "$policy_threshold" -le 100 ] || return 73
    [ "$policy_cooldown" -ge 60 ] && [ "$policy_cooldown" -le 2592000 ] || return 73
    failure_count=$(setting "$alert_state" failure_count 0)
    last_notify=$(setting "$alert_state" last_notify_epoch 0)
    case $failure_count:$last_notify in *[!0-9:]*) return 73 ;; esac
    alert_now=$(epoch_now)
    should_notify=false
    notify_key=sync_failed
    if [ "$alert_result" = succeeded ]; then
        failure_count=0
        if [ "$policy_enabled" = true ] && [ "$policy_success" = true ]; then should_notify=true; notify_key=sync_succeeded; fi
    else
        failure_count=$((failure_count + 1))
        if [ "$policy_enabled" = true ] && [ "$policy_failure" = true ] && [ "$failure_count" -ge "$policy_threshold" ]; then should_notify=true; fi
    fi
    # System logging follows the failure threshold but not the desktop toggles:
    # an administrator who silenced toasts still wants the durable record, and
    # the facility carries its own enable and its own cooldown.
    if [ "$alert_result" = succeeded ]; then
        dsm_log_event sync_succeeded "$alert_now"
    elif [ "$failure_count" -ge "$policy_threshold" ]; then
        dsm_log_event sync_failed "$alert_now"
    fi
    if [ "$should_notify" = true ] && [ "$last_notify" -gt 0 ] && [ $((alert_now - last_notify)) -lt "$policy_cooldown" ]; then
        should_notify=false
    fi
    if [ "$should_notify" = true ]; then
        if safe_notify "$notify_key" "$alert_profile" "$alert_exit"; then last_notify=$alert_now; fi
    fi
    alert_state_temp=$alert_state.tmp.$$
    printf 'failure_count=%s\nlast_notify_epoch=%s\n' "$failure_count" "$last_notify" > "$alert_state_temp"
    finish_private_file "$alert_state_temp"
    mv -f "$alert_state_temp" "$alert_state"
}

handle_doctor_alert() {
    doctor_profile=$1
    doctor_exit=$2
    case $doctor_profile in all|*[!A-Za-z0-9_-]*) [ "$doctor_profile" = all ] || return 64 ;; esac
    case $doctor_exit in ''|*[!0-9]*) return 64 ;; esac
    [ ! -L "$alert_policy_file" ] && [ ! -L "$doctor_state" ] || return 73
    doctor_enabled=$(setting "$alert_policy_file" enabled true)
    doctor_failure=$(setting "$alert_policy_file" on_failure true)
    doctor_threshold=$(setting "$alert_policy_file" failure_threshold 1)
    doctor_cooldown=$(setting "$alert_policy_file" cooldown_seconds 3600)
    case $doctor_enabled:$doctor_failure in true:true|true:false|false:true|false:false) ;; *) return 73 ;; esac
    case $doctor_threshold:$doctor_cooldown in *[!0-9:]*) return 73 ;; esac
    doctor_failures=$(setting "$doctor_state" failure_count 0)
    doctor_last_notify=$(setting "$doctor_state" last_notify_epoch 0)
    case $doctor_failures:$doctor_last_notify in *[!0-9:]*) return 73 ;; esac
    doctor_failures=$((doctor_failures + 1))
    doctor_now=$(epoch_now)
    if [ "$doctor_failures" -ge "$doctor_threshold" ]; then
        dsm_log_event doctor_failed "$doctor_now"
    fi
    if [ "$doctor_enabled" = true ] && [ "$doctor_failure" = true ] && [ "$doctor_failures" -ge "$doctor_threshold" ]; then
        if [ "$doctor_last_notify" -eq 0 ] || [ $((doctor_now - doctor_last_notify)) -ge "$doctor_cooldown" ]; then
            if safe_notify doctor_failed "$doctor_profile" "$doctor_exit"; then doctor_last_notify=$doctor_now; fi
        fi
    fi
    doctor_temp=$doctor_state.tmp.$$
    printf 'failure_count=%s\nlast_notify_epoch=%s\n' "$doctor_failures" "$doctor_last_notify" > "$doctor_temp"
    finish_private_file "$doctor_temp"
    mv -f "$doctor_temp" "$doctor_state"
}

# ---------------------------------------------------------------------------
# DSM system log facility
#
# safe_notify above delivers a desktop toast to signed-in administrators. That
# is not a log: it is not durable, it is not searchable, and an administrator
# who was not signed in when it fired never learns it happened. This block is
# the durable half -- one entry point, one event catalogue -- for the events an
# administrator would want to find after the fact.
#
# What Synology actually offers a third-party package here, taken from the
# developer guide rather than assumed:
#
#   * the conf/resource `sysnotify` worker registers package events into
#     Control Panel > Notification > Rules, the surface that fans out to
#     desktop, email, SMS, mobile, and CMS. It is the only documented route to
#     that surface.
#   * the conf/resource `syslog-config` worker installs a syslog-ng patterndb
#     and a logrotate config, the only documented route by which a package's
#     own log file is parsed into Log Center.
#
# This package deliberately acquires no conf/resource worker and validate_spk.py
# rejects one, so neither route is open from here. docs/dsm/operations.md
# records the boundary that leaves and what it would cost to change it.
#
# What remains is /usr/syno/bin/synologset1, DSM's own system-log writer. The
# binary is real and DSM's scripts use it, but Synology publishes no
# developer-guide contract for it, and its message identifiers come from a
# Synology-owned catalogue a third party cannot extend. So this package ships
# no identifier of its own invention: delivery stays inert until an
# administrator supplies one they have verified on their DSM build, and until
# then every event still reaches Activity exactly as it did before.
#
# Cost: the default configuration reads no file and spawns no process. The
# policy load is one builtin read of alerts.conf per process, cached, and the
# emit path is reached at most once per bucket per cooldown -- a sync failing
# every five minutes costs one synologset1 fork an hour, not 288 entries a day.

dsm_system_log_policy_loaded=false
dsm_system_log_enabled=false
dsm_system_log_message_id=
dsm_system_log_min_rank=2
dsm_system_log_cooldown=3600
dsm_system_log_rank_value=2

# Sets dsm_system_log_rank_value rather than printing it: this sits on the
# per-event path, and a $( ) here would be a fork per event on an armv7 NAS.
set_dsm_system_log_rank() {
    case ${1:-} in
        info) dsm_system_log_rank_value=1 ;;
        warn) dsm_system_log_rank_value=2 ;;
        err) dsm_system_log_rank_value=3 ;;
        *) return 64 ;;
    esac
}

load_dsm_system_log_policy() {
    [ "$dsm_system_log_policy_loaded" != true ] || return 0
    dsm_system_log_policy_loaded=true
    dsm_system_log_enabled=false
    dsm_system_log_message_id=
    dsm_system_log_min_rank=2
    dsm_system_log_cooldown=3600
    [ -f "$alert_policy_file" ] && [ ! -L "$alert_policy_file" ] || return 0
    dsm_policy_enable=false
    dsm_policy_identifier=
    dsm_policy_level=warn
    dsm_policy_cooldown=3600
    # One builtin read of the whole policy. Four `setting` calls would be four
    # subshells and eight `sed` processes on a path every run, every schedule
    # tick, and every dashboard request crosses.
    while IFS='=' read -r dsm_policy_name dsm_policy_value; do
        case $dsm_policy_name in
            system_log) dsm_policy_enable=$dsm_policy_value ;;
            system_log_message_id) dsm_policy_identifier=$dsm_policy_value ;;
            system_log_level) dsm_policy_level=$dsm_policy_value ;;
            cooldown_seconds) dsm_policy_cooldown=$dsm_policy_value ;;
        esac
    done < "$alert_policy_file"
    [ "$dsm_policy_enable" = true ] || return 0
    set_dsm_system_log_rank "$dsm_policy_level" || return 0
    case $dsm_policy_cooldown in ''|*[!0-9]*) return 0 ;; esac
    [ "$dsm_policy_cooldown" -ge 60 ] && [ "$dsm_policy_cooldown" -le 2592000 ] || return 0
    # A message identifier belongs to Synology's catalogue, so accept only the
    # shape DSM's own callers use and never substitute a default of our own.
    case $dsm_policy_identifier in 0x*) ;; *) return 0 ;; esac
    dsm_policy_digits=${dsm_policy_identifier#0x}
    case $dsm_policy_digits in ''|*[!0-9A-Fa-f]*) return 0 ;; esac
    [ "${#dsm_policy_digits}" -le 8 ] || return 0
    dsm_system_log_message_id=$dsm_policy_identifier
    dsm_system_log_min_rank=$dsm_system_log_rank_value
    dsm_system_log_cooldown=$dsm_policy_cooldown
    dsm_system_log_enabled=true
}

# Bound delivery with the administrator's existing alert cooldown, per event
# bucket, so one failing routine cannot fill the system log. The ledger is read
# and rewritten whole because the bucket set is fixed and small; that keeps the
# read on shell builtins instead of one `sed` subshell per bucket.
dsm_system_log_gate() {
    dsm_gate_bucket=$1
    dsm_gate_now=${2:-}
    [ -d "$state_root" ] || return 1
    [ ! -L "$dsm_system_log_state" ] || return 1
    case $dsm_gate_now in ''|*[!0-9]*) dsm_gate_now=$(epoch_now) ;; esac
    case $dsm_gate_now in ''|*[!0-9]*) return 1 ;; esac
    dsm_gate_sync=0
    dsm_gate_doctor=0
    dsm_gate_authentication=0
    dsm_gate_security=0
    dsm_gate_bridge=0
    dsm_gate_lifecycle=0
    dsm_gate_queue=0
    if [ -f "$dsm_system_log_state" ]; then
        while IFS='=' read -r dsm_gate_name dsm_gate_value; do
            case $dsm_gate_value in ''|*[!0-9]*) continue ;; esac
            case $dsm_gate_name in
                sync_epoch) dsm_gate_sync=$dsm_gate_value ;;
                doctor_epoch) dsm_gate_doctor=$dsm_gate_value ;;
                authentication_epoch) dsm_gate_authentication=$dsm_gate_value ;;
                security_epoch) dsm_gate_security=$dsm_gate_value ;;
                bridge_epoch) dsm_gate_bridge=$dsm_gate_value ;;
                lifecycle_epoch) dsm_gate_lifecycle=$dsm_gate_value ;;
                queue_epoch) dsm_gate_queue=$dsm_gate_value ;;
            esac
        done < "$dsm_system_log_state"
    fi
    case $dsm_gate_bucket in
        sync) dsm_gate_last=$dsm_gate_sync ;;
        doctor) dsm_gate_last=$dsm_gate_doctor ;;
        authentication) dsm_gate_last=$dsm_gate_authentication ;;
        security) dsm_gate_last=$dsm_gate_security ;;
        bridge) dsm_gate_last=$dsm_gate_bridge ;;
        lifecycle) dsm_gate_last=$dsm_gate_lifecycle ;;
        queue) dsm_gate_last=$dsm_gate_queue ;;
        *) return 1 ;;
    esac
    # A NAS whose clock is corrected backwards must not silence its own system
    # log until real time catches up, so a stamp in the future opens the gate.
    if [ "$dsm_gate_last" -gt 0 ] && [ "$dsm_gate_now" -ge "$dsm_gate_last" ] \
        && [ $((dsm_gate_now - dsm_gate_last)) -lt "$dsm_system_log_cooldown" ]; then
        return 1
    fi
    case $dsm_gate_bucket in
        sync) dsm_gate_sync=$dsm_gate_now ;;
        doctor) dsm_gate_doctor=$dsm_gate_now ;;
        authentication) dsm_gate_authentication=$dsm_gate_now ;;
        security) dsm_gate_security=$dsm_gate_now ;;
        bridge) dsm_gate_bridge=$dsm_gate_now ;;
        lifecycle) dsm_gate_lifecycle=$dsm_gate_now ;;
        queue) dsm_gate_queue=$dsm_gate_now ;;
    esac
    # The stamp is committed before delivery is attempted, so an unavailable
    # binary costs one probe per cooldown rather than one per event.
    dsm_gate_temp=$dsm_system_log_state.tmp.$$
    {
        printf 'sync_epoch=%s\ndoctor_epoch=%s\nauthentication_epoch=%s\n' \
            "$dsm_gate_sync" "$dsm_gate_doctor" "$dsm_gate_authentication"
        printf 'security_epoch=%s\nbridge_epoch=%s\nlifecycle_epoch=%s\nqueue_epoch=%s\n' \
            "$dsm_gate_security" "$dsm_gate_bridge" "$dsm_gate_lifecycle" "$dsm_gate_queue"
    } > "$dsm_gate_temp" 2>/dev/null || { rm -f "$dsm_gate_temp"; return 1; }
    finish_private_file "$dsm_gate_temp" 2>/dev/null || { rm -f "$dsm_gate_temp"; return 1; }
    mv -f "$dsm_gate_temp" "$dsm_system_log_state" 2>/dev/null || { rm -f "$dsm_gate_temp"; return 1; }
}

dsm_system_log_emit() {
    dsm_emit_level=$1
    dsm_emit_key=$2
    case $dsm_emit_level in info|warn|err) ;; *) return 64 ;; esac
    # DSM receives only a reviewed fixed sentence and the administrator's own
    # message identifier. Profile names, exit codes, paths, URLs, account names,
    # log or error text, cookies, tokens, passwords, and TOTP material never
    # enter this argv, exactly as they never enter the desktop notifier's.
    case $dsm_emit_key in
        sync_succeeded)
            dsm_emit_text='Synology Drive Sync completed a synchronization run.' ;;
        sync_failed)
            dsm_emit_text='Synology Drive Sync failed a synchronization run. Open the package Activity page for details.' ;;
        doctor_failed)
            dsm_emit_text='Synology Drive Sync diagnostics reported a failure. Open the package Activity page for details.' ;;
        authentication_failed)
            dsm_emit_text='Synology Drive Sync rejected a dashboard authentication attempt.' ;;
        security_failed)
            dsm_emit_text='Synology Drive Sync refused a dashboard request that failed a runtime identity check.' ;;
        bridge_failed)
            dsm_emit_text='Synology Drive Sync could not serve a dashboard request.' ;;
        bridge_rejected)
            dsm_emit_text='Synology Drive Sync rejected an unauthorized dashboard change.' ;;
        service_started)
            dsm_emit_text='Synology Drive Sync package service started.' ;;
        service_stopped)
            dsm_emit_text='Synology Drive Sync package service stopped.' ;;
        service_restarted)
            dsm_emit_text='Synology Drive Sync package service restarted.' ;;
        service_start_failed)
            dsm_emit_text='Synology Drive Sync package service failed to start.' ;;
        package_installed)
            dsm_emit_text='Synology Drive Sync package was installed.' ;;
        package_upgraded)
            dsm_emit_text='Synology Drive Sync package was upgraded.' ;;
        queue_saturated)
            dsm_emit_text='Synology Drive Sync discarded completed dashboard results after reaching its queue limit.' ;;
        *) return 64 ;;
    esac
    dsm_emit_status=69
    if [ -x /usr/syno/bin/synologset1 ] && [ ! -L /usr/syno/bin/synologset1 ]; then
        if /usr/syno/bin/synologset1 sys "$dsm_emit_level" "$dsm_system_log_message_id" \
            "$dsm_emit_text" >/dev/null 2>&1; then return 0; else dsm_emit_status=$?; fi
    fi
    append_activity notification.unavailable none unavailable \
        "DSM system log delivery unavailable" notifications warn 2>/dev/null || true
    return "$dsm_emit_status"
}

# The single entry point every DSM-visible package event travels through.
# Callers pass a catalogue key and, when they already hold one, the epoch they
# are reasoning about. Best effort by contract: an absent binary, a denied
# write, or a chroot without DSM tooling leaves the caller's own result and its
# Activity record untouched, so no caller has to guard the call.
dsm_log_event() {
    dsm_event_key=$1
    dsm_event_now=${2:-}
    case $dsm_event_key in
        sync_succeeded) dsm_event_level=info; dsm_event_bucket=sync ;;
        sync_failed) dsm_event_level=err; dsm_event_bucket=sync ;;
        doctor_failed) dsm_event_level=err; dsm_event_bucket=doctor ;;
        authentication_failed) dsm_event_level=warn; dsm_event_bucket=authentication ;;
        security_failed) dsm_event_level=err; dsm_event_bucket=security ;;
        bridge_failed) dsm_event_level=warn; dsm_event_bucket=bridge ;;
        bridge_rejected) dsm_event_level=warn; dsm_event_bucket=bridge ;;
        service_started) dsm_event_level=info; dsm_event_bucket=lifecycle ;;
        service_stopped) dsm_event_level=info; dsm_event_bucket=lifecycle ;;
        service_restarted) dsm_event_level=info; dsm_event_bucket=lifecycle ;;
        service_start_failed) dsm_event_level=err; dsm_event_bucket=lifecycle ;;
        package_installed) dsm_event_level=info; dsm_event_bucket=lifecycle ;;
        package_upgraded) dsm_event_level=info; dsm_event_bucket=lifecycle ;;
        queue_saturated) dsm_event_level=warn; dsm_event_bucket=queue ;;
        *) return 64 ;;
    esac
    load_dsm_system_log_policy || return 0
    [ "$dsm_system_log_enabled" = true ] || return 0
    set_dsm_system_log_rank "$dsm_event_level" || return 0
    [ "$dsm_system_log_rank_value" -ge "$dsm_system_log_min_rank" ] || return 0
    dsm_system_log_gate "$dsm_event_bucket" "$dsm_event_now" || return 0
    dsm_system_log_emit "$dsm_event_level" "$dsm_event_key" || return 0
}

profile_exists() {
    case ${1:-} in
        ''|*[!A-Za-z0-9_-]*) return 1 ;;
    esac
    [ -f "$profiles_dir/$1.toml" ] && [ ! -L "$profiles_dir/$1.toml" ]
}

profile_secret_exists() {
    profile_exists "$1" || return 1
    password_path=$secret_root/$1.password
    private_secret_file "$password_path"
}

private_secret_file() {
    secret_path=$1
    [ -f "$secret_path" ] && [ ! -L "$secret_path" ] && [ -r "$secret_path" ] || return 1
    secret_mode=$(stat -c '%a' "$secret_path" 2>/dev/null || true)
    secret_owner=$(stat -c '%u' "$secret_path" 2>/dev/null || true)
    secret_links=$(stat -c '%h' "$secret_path" 2>/dev/null || true)
    [ "$secret_mode" = 600 ] && [ -n "$path_owner" ] && [ "$secret_owner" = "$path_owner" ] \
        && [ "$secret_links" = 1 ]
}

# ---------------------------------------------------------------------------
# Response cache for the read-only DSM API endpoints
#
# The dashboard re-reads `api snapshot` every five seconds for every open
# browser tab, and that response is a pure function of private package files.
# An entry therefore stores the exact bytes that would have been served --
# always the finished, post-redaction response, never an intermediate --
# keyed by a fingerprint of every file the response was derived from.
#
# The fingerprint is the stat identity of every input plus a content witness.
# Every package state document is published by rename, so its inode moves on
# each write, but an operator can still rewrite a config file in place; the
# witness closes the gaps stat alone leaves, principally a write inside the
# same mtime second. It reads content rather than sampling a boundary line
# because a boundary cannot see an edit that leaves the last line alone -- a
# failure measured here, not imagined -- and because these inputs are a few
# kilobytes against the ~1000 process spawns being removed.
#
# That trade does not generalise. An input whose size is the cost -- a
# megabyte-scale append-only log -- would need a seek-based window read from
# the end holding its newest record instead, and note that on busybox
# `tail -n 1` is not such a seek: measured on 1.36 it reads 983040 bytes of a
# 2.4 MB file, where `tail -c 4096` reads 4096. Witnessing the wrong end of
# such a file serves stale data indefinitely while every check looks healthy.
#
# Secret material is fingerprinted by stat alone and is never witnessed: a
# witness reads file content, and no secret byte may be written into a cache
# entry. Callers pass secret paths in the stat-only list.
# ---------------------------------------------------------------------------
cache_schema=sdsync.cache.v1
cache_entry_limit=16
cache_total_limit=4194304
cache_body_limit=1048576
cache_content_witness_limit=1048576
cache_fingerprint_line_limit=4096
cache_flight_stale_seconds=120
cache_newline='
'
cache_fingerprint=
cache_body=
cache_body_bytes=
cache_flight_path=
cache_temp_path=

cache_name_is_safe() {
    case ${1:-} in
        ''|.*|*[!A-Za-z0-9._-]*) return 1 ;;
        *..*) return 1 ;;
    esac
    [ "${#1}" -le 64 ]
}

# Build the invalidation fingerprint for one cache key.
#   $1 cache key
#   $2 input paths fingerprinted by stat alone (secret material belongs here)
#   $3 input paths that also contribute a content witness
#
# The witnessed inputs are read in full. That is only correct while they stay
# small; see the note above this section before pointing this at anything
# whose size is itself the cost.
#
# Package paths are fixed and profile and routine names are validated, so no
# input path can contain whitespace. Any failure leaves the fingerprint empty,
# which makes every lookup and store a miss rather than a wrong answer.
cache_build_fingerprint() {
    cache_fingerprint=
    cache_fp_key=$1
    cache_fp_stat_only=$2
    cache_fp_witnessed=$3
    cache_name_is_safe "$cache_fp_key" || return 1
    cache_fp_present=
    cache_fp_witness_present=
    cache_fp_absent=
    for cache_fp_path in $cache_fp_stat_only; do
        if [ -e "$cache_fp_path" ] || [ -L "$cache_fp_path" ]; then
            cache_fp_present="$cache_fp_present $cache_fp_path"
        else
            cache_fp_absent="$cache_fp_absent $cache_fp_path"
        fi
    done
    for cache_fp_path in $cache_fp_witnessed; do
        if [ -e "$cache_fp_path" ] || [ -L "$cache_fp_path" ]; then
            cache_fp_present="$cache_fp_present $cache_fp_path"
            # Witness only a plain file the package itself owns the shape of.
            # tail and cat both follow a symlink, and no fingerprint may read
            # through one; stat records the anomaly without opening it, which
            # is enough to keep the entry from matching.
            if [ -f "$cache_fp_path" ] && [ ! -L "$cache_fp_path" ]; then
                cache_fp_witness_present="$cache_fp_witness_present $cache_fp_path"
            fi
        else
            cache_fp_absent="$cache_fp_absent $cache_fp_path"
        fi
    done
    # One stat covers both package scripts -- so an upgrade retires every entry
    # -- and every present input. %d:%i alone already moves on each write of a
    # rename-published document; %u:%g:%a:%h keep an entry from outliving a
    # change of owner, mode, or link count that the uncached path refuses to
    # serve. %y carries the nanosecond mtime where the platform records one and
    # is inert where it does not, so it narrows the same-second window without
    # being relied on. A file that disappears between the test above and this
    # stat makes stat fail, which is a miss.
    cache_fp_identity=$(stat -c '%n %d:%i:%u:%g:%a:%h:%s:%Y %y' \
        "$manager" "$package_root/libexec/sdsync-common" $cache_fp_present 2>/dev/null) || return 1
    cache_fp_witness=
    if [ -n "$cache_fp_witness_present" ]; then
        # Folded to a single line so the entry stays cheap to read back; the
        # per-file byte counts above already separate the inputs, so the fold
        # cannot make two different states look alike.
        cache_fp_witness=$(cat $cache_fp_witness_present 2>/dev/null | tr '\n' '\037') || return 1
        [ "${#cache_fp_witness}" -le "$cache_content_witness_limit" ] || return 1
    fi
    cache_fingerprint="$cache_schema
key $cache_fp_key
absent$cache_fp_absent
identity
$cache_fp_identity
witness
$cache_fp_witness"
}

# Serve the entry matching the fingerprint built above. On success the body is
# in $cache_body and its byte count in $cache_body_bytes; every field is read
# with shell builtins, so a hit spawns no process at all. One open serves the
# whole entry, so a concurrent publish can never splice two generations
# together, and the trailing sentinel turns a truncated entry into a miss
# rather than a malformed response.
cache_lookup() {
    cache_body=
    cache_body_bytes=
    cache_lookup_key=$1
    cache_name_is_safe "$cache_lookup_key" || return 1
    [ -n "$cache_fingerprint" ] || return 1
    cache_lookup_path=$cache_root/$cache_lookup_key
    [ ! -L "$cache_lookup_path" ] && [ -f "$cache_lookup_path" ] && [ -r "$cache_lookup_path" ] || return 1
    {
        IFS=' ' read -r cache_lookup_schema cache_lookup_bytes cache_lookup_lines cache_lookup_surplus || return 1
        [ "$cache_lookup_schema" = "$cache_schema" ] || return 1
        [ -z "$cache_lookup_surplus" ] || return 1
        case $cache_lookup_bytes in ''|*[!0-9]*) return 1 ;; esac
        case $cache_lookup_lines in ''|*[!0-9]*) return 1 ;; esac
        [ "$cache_lookup_bytes" -ge 1 ] && [ "$cache_lookup_bytes" -le "$cache_body_limit" ] || return 1
        [ "$cache_lookup_lines" -ge 1 ] && [ "$cache_lookup_lines" -le "$cache_fingerprint_line_limit" ] || return 1
        cache_lookup_blob=
        cache_lookup_index=0
        while [ "$cache_lookup_index" -lt "$cache_lookup_lines" ]; do
            IFS= read -r cache_lookup_line || return 1
            if [ "$cache_lookup_index" -eq 0 ]; then
                cache_lookup_blob=$cache_lookup_line
            else
                cache_lookup_blob=$cache_lookup_blob$cache_newline$cache_lookup_line
            fi
            cache_lookup_index=$((cache_lookup_index + 1))
        done
        [ "$cache_lookup_blob" = "$cache_fingerprint" ] || return 1
        IFS= read -r cache_lookup_body || return 1
        IFS= read -r cache_lookup_sentinel || return 1
        [ "$cache_lookup_sentinel" = "$cache_schema.end" ] || return 1
        if IFS= read -r cache_lookup_trailing; then return 1; fi
        cache_body=$cache_lookup_body
        cache_body_bytes=$cache_lookup_bytes
    } < "$cache_lookup_path"
}

# Publish the response in $2 under key $1 for the fingerprint built above.
# The entry is written to a private temporary file and renamed into place, so
# a concurrent reader sees either the previous entry or this one whole.
cache_store() {
    cache_store_key=$1
    cache_store_body_path=$2
    cache_name_is_safe "$cache_store_key" || return 1
    [ -n "$cache_fingerprint" ] || return 1
    [ -d "$cache_root" ] && [ ! -L "$cache_root" ] || return 1
    [ -f "$cache_store_body_path" ] && [ ! -L "$cache_store_body_path" ] || return 1
    cache_store_bytes=$(wc -c < "$cache_store_body_path" 2>/dev/null | tr -d ' ') || return 1
    case $cache_store_bytes in ''|*[!0-9]*) return 1 ;; esac
    [ "$cache_store_bytes" -ge 1 ] && [ "$cache_store_bytes" -le "$cache_body_limit" ] || return 1
    # The reader replays the body with shell builtins, which is byte-exact only
    # for a single newline-terminated line. Every cached response is one line of
    # JSON; anything else is simply not cached.
    cache_store_lines=$(wc -l < "$cache_store_body_path" 2>/dev/null | tr -d ' ') || return 1
    [ "$cache_store_lines" = 1 ] || return 1
    cache_store_fp_lines=$(printf '%s\n' "$cache_fingerprint" | wc -l | tr -d ' ') || return 1
    case $cache_store_fp_lines in ''|*[!0-9]*) return 1 ;; esac
    [ "$cache_store_fp_lines" -ge 1 ] && [ "$cache_store_fp_lines" -le "$cache_fingerprint_line_limit" ] || return 1
    cache_retire_foreign_package || return 1
    # rename onto a directory would move the temporary file inside it instead
    # of replacing it, leaving a private file behind that nothing reclaims.
    cache_store_target=$cache_root/$cache_store_key
    if [ -e "$cache_store_target" ] || [ -L "$cache_store_target" ]; then
        [ -f "$cache_store_target" ] && [ ! -L "$cache_store_target" ] || return 1
    fi
    cache_temp_path=$cache_root/.tmp.$cache_store_key.$$
    [ ! -e "$cache_temp_path" ] && [ ! -L "$cache_temp_path" ] || { cache_temp_path=; return 1; }
    cache_store_status=0
    {
        printf '%s %s %s\n' "$cache_schema" "$cache_store_bytes" "$cache_store_fp_lines"
        printf '%s\n' "$cache_fingerprint"
        cat "$cache_store_body_path"
        printf '%s.end\n' "$cache_schema"
    } > "$cache_temp_path" || cache_store_status=$?
    if [ "$cache_store_status" -ne 0 ]; then
        rm -f "$cache_temp_path" 2>/dev/null || true
        cache_temp_path=
        return 1
    fi
    finish_private_file "$cache_temp_path" || {
        rm -f "$cache_temp_path" 2>/dev/null || true
        cache_temp_path=
        return 1
    }
    mv -f "$cache_temp_path" "$cache_root/$cache_store_key" || {
        rm -f "$cache_temp_path" 2>/dev/null || true
        cache_temp_path=
        return 1
    }
    cache_temp_path=
    cache_prune || true
}

# An upgrade replaces both package scripts, so every stored fingerprint stops
# matching and no stale entry can be served. Retire the files themselves the
# first time anything is cached afterwards rather than leaving unusable entries
# for the size bound to reclaim. Uninstall already removes the whole state tree.
cache_retire_foreign_package() {
    cache_package_marker=$cache_root/.package
    cache_package_identity=$(stat -c '%d:%i:%s:%Y' \
        "$manager" "$package_root/libexec/sdsync-common" 2>/dev/null) || return 1
    cache_package_recorded=
    if [ -f "$cache_package_marker" ] && [ ! -L "$cache_package_marker" ]; then
        IFS= read -r cache_package_recorded < "$cache_package_marker" 2>/dev/null || cache_package_recorded=
    fi
    # stat prints one line per file and the marker holds one line; the format
    # contains no spaces, so re-splitting on whitespace folds it safely.
    set -- $cache_package_identity
    cache_package_flat=$*
    [ "$cache_package_recorded" != "$cache_package_flat" ] || return 0
    for cache_package_entry in "$cache_root"/*; do
        [ -e "$cache_package_entry" ] || [ -L "$cache_package_entry" ] || continue
        [ -L "$cache_package_entry" ] || rm -f "$cache_package_entry" 2>/dev/null || true
    done
    if [ -e "$cache_package_marker" ] || [ -L "$cache_package_marker" ]; then
        [ -f "$cache_package_marker" ] && [ ! -L "$cache_package_marker" ] || return 1
    fi
    cache_package_temp=$cache_root/.package.$$
    printf '%s\n' "$cache_package_flat" > "$cache_package_temp" || return 1
    finish_private_file "$cache_package_temp" || { rm -f "$cache_package_temp" 2>/dev/null || true; return 1; }
    mv -f "$cache_package_temp" "$cache_package_marker" || {
        rm -f "$cache_package_temp" 2>/dev/null || true
        return 1
    }
}

# Bound what the cache may occupy. Entries are retired newest-first past the
# count and byte ceilings, so a client walking the whole --lines range cannot
# grow the package state tree without limit.
cache_prune() {
    cache_prune_entries=
    for cache_prune_entry in "$cache_root"/*; do
        [ -f "$cache_prune_entry" ] && [ ! -L "$cache_prune_entry" ] || continue
        cache_prune_entries="$cache_prune_entries $cache_prune_entry"
    done
    [ -n "$cache_prune_entries" ] || return 0
    cache_prune_victims=$(stat -c '%Y %s %n' $cache_prune_entries 2>/dev/null | sort -rn |
        LC_ALL=C awk -v max_entries="$cache_entry_limit" -v max_bytes="$cache_total_limit" '
            { kept++; total += $2
              if (kept > max_entries || total > max_bytes) print $3 }') || return 0
    for cache_prune_victim in $cache_prune_victims; do
        case $cache_prune_victim in
            "$cache_root"/*) [ -L "$cache_prune_victim" ] || rm -f "$cache_prune_victim" 2>/dev/null || true ;;
        esac
    done
}

# Several dashboard tabs meeting a cold cache must not all recompute the same
# response: on a four-worker bridge pool that is exactly the exhaustion this
# cache exists to prevent. The flight is advisory and never blocks -- a caller
# that loses it serves the previous entry when there is one, and otherwise
# computes its own response without publishing it.
cache_flight_begin() {
    cache_flight_path=
    cache_flight_key=$1
    cache_name_is_safe "$cache_flight_key" || return 1
    cache_flight_candidate=$cache_root/.$cache_flight_key.flight
    [ ! -L "$cache_flight_candidate" ] || return 1
    if cache_flight_claim "$cache_flight_candidate"; then
        cache_flight_path=$cache_flight_candidate
        return 0
    fi
    cache_flight_is_abandoned "$cache_flight_candidate" || return 1
    rm -f "$cache_flight_candidate/owner" 2>/dev/null || true
    rmdir "$cache_flight_candidate" 2>/dev/null || true
    cache_flight_claim "$cache_flight_candidate" || return 1
    cache_flight_path=$cache_flight_candidate
}

cache_flight_claim() {
    cache_flight_claimed=$1
    mkdir "$cache_flight_claimed" 2>/dev/null || return 1
    chmod 0700 "$cache_flight_claimed" 2>/dev/null || true
    set_private_owner "$cache_flight_claimed" 2>/dev/null || true
    # A losing caller may reclaim an abandoned flight out from under this
    # write, so the redirection itself has to be able to fail quietly: the
    # shell reports a failed redirection before the command's own 2>/dev/null
    # is in effect, which is why the whole compound is wrapped.
    { printf '%s\n' "$$" > "$cache_flight_claimed/owner"; } 2>/dev/null || return 0
    finish_private_file "$cache_flight_claimed/owner" 2>/dev/null || true
    return 0
}

# Reclaim only on positive evidence: an owner that is gone, or a flight that
# has outlived its bound. A directory whose owner file has not been written yet
# is younger than the bound and is left alone, so a caller that merely lost the
# race computes its own response instead of stealing a live flight.
cache_flight_is_abandoned() {
    cache_flight_checked=$1
    [ -d "$cache_flight_checked" ] && [ ! -L "$cache_flight_checked" ] || return 0
    cache_flight_owner=
    if [ -f "$cache_flight_checked/owner" ] && [ ! -L "$cache_flight_checked/owner" ]; then
        IFS= read -r cache_flight_owner < "$cache_flight_checked/owner" 2>/dev/null || cache_flight_owner=
    fi
    case ${cache_flight_owner:-} in
        ''|*[!0-9]*) ;;
        *) kill -0 "$cache_flight_owner" 2>/dev/null || return 0 ;;
    esac
    # A live pid can still be a reused number, so a flight that outlives its
    # bound becomes reclaimable regardless.
    cache_flight_now=$(epoch_now 2>/dev/null || true)
    cache_flight_stamp=$(stat -c '%Y' "$cache_flight_checked" 2>/dev/null || true)
    case ${cache_flight_now:-} in ''|*[!0-9]*) return 1 ;; esac
    case ${cache_flight_stamp:-} in ''|*[!0-9]*) return 1 ;; esac
    [ "$((cache_flight_now - cache_flight_stamp))" -ge "$cache_flight_stale_seconds" ]
}

cache_flight_end() {
    [ -n "${cache_flight_path:-}" ] || return 0
    case $cache_flight_path in
        "$cache_root"/.*.flight)
            rm -f "$cache_flight_path/owner" 2>/dev/null || true
            rmdir "$cache_flight_path" 2>/dev/null || true
            ;;
    esac
    cache_flight_path=
}
