# Run daily at 03:00. The wrapper holds its private state-directory flock for
# the complete validation and sync process, including a sequential batch.
# Create the state directory, replace USER, and set a monitored address.
# Successful runs are quiet. Every nonzero result, including overlap, emits mail-worthy stderr.
MAILTO=ops@example.com
0 3 * * * /home/USER/.local/bin/synology-drive-sync-cron /home/USER/.config/synology-drive-sync/cron.env || { status=$?; if [ "$status" -eq 75 ]; then echo 'synology-drive-sync skipped because another managed run holds the lock' >&2; else echo "synology-drive-sync failed with exit status $status" >&2; fi; exit "$status"; }
