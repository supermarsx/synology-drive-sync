# Protect the installed copy of this file with mode 0600.
SDSYNC_EXECUTABLE=/home/mirror-bot/.local/bin/synology-drive-sync
SDSYNC_URL=https://files.example.com
SDSYNC_USERNAME=mirror-bot
SDSYNC_SOURCE=/srv/export
SDSYNC_REMOTE=/team/export
SDSYNC_PASSWORD_FILE=/home/mirror-bot/.config/synology-drive-sync/dsm-password
# Optional path to a separate mode-0600 TOTP seed file. Never put the seed here.
# SDSYNC_TOTP_SECRET_FILE=/home/mirror-bot/.config/synology-drive-sync/dsm-totp
SDSYNC_JOBS=2
SDSYNC_LOCK_FILE=/home/mirror-bot/.local/state/synology-drive-sync/service.lock

# Alternative profile modes. Keep direct URL/USERNAME/SOURCE/REMOTE above, or
# comment all four out and configure one profile mode. One batch holds one lock
# while targets run sequentially. It fails closed unless you explicitly confirm
# that all selected profiles use this common password/TOTP file override.
# SDSYNC_CONFIG=/home/mirror-bot/.config/synology-drive-sync/config.toml
# SDSYNC_PROFILE=production
# SDSYNC_PROFILES=nas-a,nas-b
# SDSYNC_ALL_PROFILES=true
# SDSYNC_MAX_TOTAL_DELETE=150
SDSYNC_BATCH_SHARED_CREDENTIALS=false

# Keep unattended diagnostics in the application's bounded rotating file sink.
# --quiet still records this file while leaving cron mail silent on success.
SDSYNC_LOG_FILE=/home/mirror-bot/.local/state/synology-drive-sync/sync.log
SDSYNC_LOG_FORMAT=json
SDSYNC_PROGRESS=never
SDSYNC_QUIET=true

# Optional remote logging accepts a private token file only; indirect token
# environment names and token values are rejected by the cron wrapper.
# SDSYNC_REMOTE_LOG_URL=https://logs.example.com/v1/events
# SDSYNC_REMOTE_LOG_TOKEN_FILE=/home/mirror-bot/.config/synology-drive-sync/log-token
# SDSYNC_REMOTE_LOG_MODE=required

# Destructive mirror mode is deliberately opt-in.
SDSYNC_DELETE=false
SDSYNC_MAX_DELETE=100
